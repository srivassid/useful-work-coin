[Unit]
Description=UWC testnet job gateway (web page and OpenAI-compatible API: chat, completions, embeddings, batches)
After=uwc-node.service uwc-data.service
Requires=uwc-node.service

[Service]
User=uwc
Group=uwc
WorkingDirectory=/opt/uwc/app
Environment=HOME=/opt/uwc/gateway PYTHONPATH=/opt/uwc/app
EnvironmentFile=/opt/uwc/gateway/env
ExecStart=/opt/uwc/venv/bin/python -m agent.gateway --net /opt/uwc/net --data http://127.0.0.1:18692 --home /opt/uwc/gateway/state --models /opt/uwc/gateway/models.json --bind 127.0.0.1:18693 --faucet-key /opt/uwc/gateway/faucet.json --faucet-coins 100 --cors-origin *
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uwc/gateway
PrivateTmp=true
MemoryMax=800M

[Install]
WantedBy=multi-user.target
