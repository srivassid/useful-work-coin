[Unit]
Description=UWC testnet job data service (signed uploads)
After=uwc-node.service
Requires=uwc-node.service

[Service]
User=uwc
Group=uwc
WorkingDirectory=/opt/uwc/app
Environment=HOME=/opt/uwc/data
ExecStart=/usr/bin/python3 -m agent.data serve --auth --chain /opt/uwc/net --root /opt/uwc/data --bind 0.0.0.0:18692 --max-conn 64
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/uwc/data
PrivateTmp=true
MemoryMax=200M

[Install]
WantedBy=multi-user.target
