diff --git a/node/jobstate/detmath.go b/node/jobstate/detmath.go
new file mode 100644
index 00000000..df069f2a
--- /dev/null
+++ b/node/jobstate/detmath.go
@@ -0,0 +1,125 @@
+package jobstate
+
+import "math"
+
+// Deterministic arithmetic of the reference runtime (runtime/detrt/core.py), mirrored op for
+// op. Each fp32 op is evaluated in float64 and rounded once to float32 (exactly the correctly
+// rounded fp32 result); the explicit float32 conversions also stop the Go compiler from fusing
+// multiply-adds, which the language spec otherwise permits.
+
+func c32(v float64) float32         { return float32(v) }
+func fadd(a, b float32) float32     { return float32(float64(a) + float64(b)) }
+func fsub(a, b float32) float32     { return float32(float64(a) - float64(b)) }
+func fmul(a, b float32) float32     { return float32(float64(a) * float64(b)) }
+func fdiv(a, b float32) float32     { return float32(float64(a) / float64(b)) }
+func fsqrt(a float32) float32       { return float32(math.Sqrt(float64(a))) }
+func roundEven32(a float32) float32 { return float32(math.RoundToEven(float64(a))) }
+
+var exp2Coef = [8]float64{1.0, 0.6931471824645996, 0.2402263879776001, 0.055505119264125824,
+	0.00961404386907816, 0.001342222560197115, 0.0001435537706129253, 2.1489791834028438e-05}
+
+const log2e = 1.4426950408889634
+
+// detExp mirrors core.det_exp.
+func detExp(z float32) float32 {
+	if math.IsNaN(float64(z)) {
+		return z
+	}
+	t := fmul(z, c32(log2e))
+	if t < -126 {
+		return 0
+	}
+	if t >= 128 {
+		return float32(math.Inf(1))
+	}
+	n := float32(math.Floor(float64(t)))
+	f := fsub(t, n)
+	p := c32(exp2Coef[7])
+	for i := 6; i >= 0; i-- {
+		p = fadd(fmul(p, f), c32(exp2Coef[i]))
+	}
+	return fmul(p, float32(math.Ldexp(1, int(n))))
+}
+
+func detSilu(x float32) float32 { return fdiv(x, fadd(1, detExp(-x))) }
+
+// exactRowSum mirrors core.exact_rowsum.
+func exactRowSum(x []float32, maxTerms int) float32 {
+	L := int(math.Ceil(math.Log2(float64(maxTerms))))
+	if L < 1 {
+		L = 1
+	}
+	var amax float32
+	for _, v := range x {
+		if a := float32(math.Abs(float64(v))); a > amax {
+			amax = a
+		}
+	}
+	_, e := math.Frexp(float64(amax))
+	shift := (62 - L) - e
+	shift = max(-1000, min(1000, shift))
+	var s int64
+	for _, v := range x {
+		s += int64(math.RoundToEven(math.Ldexp(float64(v), shift)))
+	}
+	return float32(math.Ldexp(float64(s), -shift))
+}
+
+// detRMSNorm mirrors core.det_rmsnorm for one row.
+func detRMSNorm(x, w []float32, eps float32) []float32 {
+	sq := make([]float32, len(x))
+	for i, v := range x {
+		sq[i] = fmul(v, v)
+	}
+	ss := exactRowSum(sq, len(x))
+	mean := fmul(ss, c32(1.0/float64(len(x))))
+	r := fdiv(1, fsqrt(fadd(mean, eps)))
+	out := make([]float32, len(x))
+	for i, v := range x {
+		out[i] = fmul(fmul(v, r), w[i])
+	}
+	return out
+}
+
+// quantSym mirrors core.quant_sym for one row: integer values and the scale.
+func quantSym(x []float32, qmax int) ([]int32, float32) {
+	var amax float32
+	for _, v := range x {
+		if a := float32(math.Abs(float64(v))); a > amax {
+			amax = a
+		}
+	}
+	s := fdiv(max(amax, c32(1e-8)), float32(qmax))
+	q := make([]int32, len(x))
+	for i, v := range x {
+		r := roundEven32(fdiv(v, s))
+		q[i] = int32(max(-float32(qmax), min(float32(qmax), r)))
+	}
+	return q, s
+}
+
+// fwht mirrors core.fwht (unnormalized block Walsh-Hadamard, same add order).
+func fwht(x []float32, bs int) []float32 {
+	v := append([]float32(nil), x...)
+	if bs <= 1 {
+		return v
+	}
+	for h := 1; h < bs; h <<= 1 {
+		for blk := 0; blk < len(v); blk += 2 * h {
+			for j := 0; j < h; j++ {
+				a, b := v[blk+j], v[blk+h+j]
+				v[blk+j], v[blk+h+j] = fadd(a, b), fsub(a, b)
+			}
+		}
+	}
+	return v
+}
+
+// quantAct mirrors core.quant_act: q in [-64, 64] and the dequant scale s / sqrt(bs).
+func quantAct(x []float32, bs int) ([]int32, float32) {
+	q, s := quantSym(fwht(x, bs), 64)
+	if bs > 1 {
+		s = fmul(s, fdiv(1, fsqrt(float32(bs))))
+	}
+	return q, s
+}
