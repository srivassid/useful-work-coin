+++ b/node/jobstate/engine.go
@@ -0,0 +1,68 @@
+package jobstate
+
+import "fmt"
+
+// MemSource serves rows from memory: a full weights table, the stage input and the leaves
+// computed so far. It backs the trace engine (and tests); consensus uses ProvenSource.
+type MemSource struct {
+	Weights map[WeightRow][]uint32
+	Input   [][]uint32 // stage input rows (l0 > 0)
+	Toks    []uint32   // token ids (l0 == 0)
+	Leaves  map[LeafDesc][]uint32
+}
+
+func (m *MemSource) Leaf(d LeafDesc) ([]uint32, error) {
+	if r, ok := m.Leaves[d]; ok {
+		return r, nil
+	}
+	return nil, fmt.Errorf("missing leaf %+v", d)
+}
+
+func (m *MemSource) Weight(w WeightRow) ([]uint32, error) {
+	if r, ok := m.Weights[w]; ok {
+		return r, nil
+	}
+	return nil, fmt.Errorf("missing weight row %+v", w)
+}
+
+func (m *MemSource) StageInput(t int) ([]uint32, error) {
+	if t < 0 || t >= len(m.Input) {
+		return nil, fmt.Errorf("missing stage input row %d", t)
+	}
+	return m.Input[t], nil
+}
+
+func (m *MemSource) Tokens() ([]uint32, error) {
+	if m.Toks == nil {
+		return nil, fmt.Errorf("missing tokens")
+	}
+	return m.Toks, nil
+}
+
+// ComputeTrace runs a whole stage with the referee's rules (honest provider / verifier in Go).
+// It returns the rows in program order.
+func (st Stage) ComputeTrace(src *MemSource) ([][]uint32, error) {
+	prog := Program(st.Cfg, st.T, st.L0, st.L1)
+	if src.Leaves == nil {
+		src.Leaves = map[LeafDesc][]uint32{}
+	}
+	rows := make([][]uint32, len(prog))
+	for i, d := range prog {
+		r, err := st.RecomputeRow(d, src)
+		if err != nil {
+			return nil, fmt.Errorf("leaf %d %+v: %w", i, d, err)
+		}
+		src.Leaves[d] = r
+		rows[i] = r
+	}
+	return rows, nil
+}
+
+// TraceRoot commits rows given in program order.
+func TraceRoot(rows [][]uint32) (Hash, []Hash) {
+	leaves := make([]Hash, len(rows))
+	for i, r := range rows {
+		leaves[i] = TraceLeaf(i, RowRoot(r))
+	}
+	return MerkleRoot(leaves), leaves
+}
diff --git a/node/jobstate/program.go b/node/jobstate/program.go
new file mode 100644
index 00000000..ff263510
--- /dev/null
+++ b/node/jobstate/program.go
@@ -0,0 +1,268 @@
+package jobstate
+
+import (
+	"encoding/binary"
+	"fmt"
+	"math"
+)
+
+// ModelCfg is the architecture a model registration commits to (Qwen3 family, deterministic
+// runtime of build step 2). It fixes every stage's program and so the dispute referee.
+type ModelCfg struct {
+	D, H, Hkv, Hd, I, L, V int
+	Eps                    float32
+	Bs                     int // Hadamard block of the activation quantizer (0 or 1 = none)
+	MaxPos                 int // rows of the RoPE tables in the weights tree
+}
+
+func (c ModelCfg) valid() bool {
+	return c.D > 0 && c.H > 0 && c.Hkv > 0 && c.H%c.Hkv == 0 && c.Hd > 1 && c.Hd%2 == 0 && c.I > 0 &&
+		c.L > 0 && c.V > 0 && c.MaxPos > 0 && c.D%8 == 0 && c.D <= 1<<16 && c.I <= 1<<18 && c.H <= 256
+}
+
+// Stage row-op codes, in their per-layer order (runtime/detrt/stage.py).
+const (
+	LEmbed uint8 = iota
+	LN1
+	LQA1
+	LQKV
+	LQN
+	LKN
+	LQR
+	LKR
+	LKQ
+	LVQ
+	LQQ
+	LVT
+	LVS
+	LS
+	LP
+	LO
+	LQA2
+	LOP
+	LR1
+	LN2
+	LQA3
+	LGU
+	LSM
+	LQA4
+	LDN
+	LR2
+)
+
+// LeafDesc is one leaf of a stage program: op, layer, token t (channel d for VT) and head.
+type LeafDesc struct {
+	Op    uint8
+	Layer int
+	T, H  int
+}
+
+// Program is the canonical leaf list of a stage: one sequence of T tokens through [l0, l1).
+func Program(c ModelCfg, T, l0, l1 int) []LeafDesc {
+	var out []LeafDesc
+	perT := func(op uint8, l int) {
+		for t := 0; t < T; t++ {
+			out = append(out, LeafDesc{op, l, t, -1})
+		}
+	}
+	perTH := func(op uint8, l, nh int) {
+		for t := 0; t < T; t++ {
+			for h := 0; h < nh; h++ {
+				out = append(out, LeafDesc{op, l, t, h})
+			}
+		}
+	}
+	if l0 == 0 {
+		perT(LEmbed, 0)
+	}
+	for l := l0; l < l1; l++ {
+		perT(LN1, l)
+		perT(LQA1, l)
+		perT(LQKV, l)
+		perTH(LQN, l, c.H)
+		perTH(LKN, l, c.Hkv)
+		perTH(LQR, l, c.H)
+		perTH(LKR, l, c.Hkv)
+		perTH(LKQ, l, c.Hkv)
+		perTH(LVQ, l, c.Hkv)
+		perTH(LQQ, l, c.H)
+		for h := 0; h < c.Hkv; h++ {
+			for d := 0; d < c.Hd; d++ {
+				out = append(out, LeafDesc{LVT, l, d, h})
+			}
+		}
+		for h := 0; h < c.Hkv; h++ {
+			out = append(out, LeafDesc{LVS, l, -1, h})
+		}
+		perTH(LS, l, c.H)
+		perTH(LP, l, c.H)
+		perTH(LO, l, c.H)
+		for _, op := range []uint8{LQA2, LOP, LR1, LN2, LQA3, LGU, LSM, LQA4, LDN, LR2} {
+			perT(op, l)
+		}
+	}
+	return out
+}
+
+// RowLen is the number of 4-byte words in a leaf's output row (stage of T tokens).
+func (c ModelCfg) RowLen(d LeafDesc, T int) int {
+	nqkv := (c.H + 2*c.Hkv) * c.Hd
+	switch d.Op {
+	case LEmbed, LN1, LOP, LR1, LN2, LDN, LR2:
+		return c.D
+	case LQA1, LQA3:
+		return c.D + 1
+	case LQKV:
+		return nqkv
+	case LQN, LKN, LQR, LKR, LO:
+		return c.Hd
+	case LKQ, LVQ, LQQ:
+		return c.Hd + 1
+	case LVT, LVS:
+		return T
+	case LS:
+		return d.T + 1
+	case LP:
+		return d.T + 2
+	case LQA2:
+		return c.H*c.Hd + 1
+	case LGU:
+		return 2 * c.I
+	case LSM:
+		return c.I
+	case LQA4:
+		return c.I + 1
+	}
+	return 0
+}
+
+// leafIndex finds the index of a descriptor in a program (consensus helper; programs are
+// regular, but a map keeps this obviously correct).
+type programIndex map[LeafDesc]int
+
+func indexProgram(p []LeafDesc) programIndex {
+	m := make(programIndex, len(p))
+	for i, d := range p {
+		m[d] = i
+	}
+	return m
+}
+
+// ---------------------------------------------------------------- weights tree layout
+
+// WeightRow identifies a row of the committed weights tree.
+type WeightRow struct {
+	Name  string
+	Layer int
+	Row   int
+}
+
+// weightLayout is the leaf order of runtime/detrt/stage.py:weight_rows.
+func (c ModelCfg) weightIndex(w WeightRow) (int, int, error) {
+	nqkv := (c.H + 2*c.Hkv) * c.Hd
+	per := 4 + nqkv + c.D + 2*c.I + c.D // norms + qkv + o + gu + down rows per layer
+	base := c.V
+	lay := func(off, rows, wordLen int) (int, int, error) {
+		if w.Layer < 0 || w.Layer >= c.L || w.Row < 0 || w.Row >= rows {
+			return 0, 0, fmt.Errorf("weight row out of range: %+v", w)
+		}
+		return base + w.Layer*per + off + w.Row, wordLen, nil
+	}
+	switch w.Name {
+	case "embed":
+		if w.Row < 0 || w.Row >= c.V {
+			return 0, 0, fmt.Errorf("embed row out of range")
+		}
+		return w.Row, c.D, nil
+	case "in_norm":
+		return lay(0, 1, c.D)
+	case "post_norm":
+		return lay(1, 1, c.D)
+	case "q_norm":
+		return lay(2, 1, c.Hd)
+	case "k_norm":
+		return lay(3, 1, c.Hd)
+	case "qkv":
+		return lay(4, nqkv, c.D+1)
+	case "o":
+		return lay(4+nqkv, c.D, c.H*c.Hd+1)
+	case "gu":
+		return lay(4+nqkv+c.D, 2*c.I, c.D+1)
+	case "down":
+		return lay(4+nqkv+c.D+2*c.I, c.D, c.I+1)
+	case "rope.cos", "rope.sin":
+		if w.Row < 0 || w.Row >= c.MaxPos {
+			return 0, 0, fmt.Errorf("rope row out of range")
+		}
+		off := base + c.L*per
+		if w.Name == "rope.sin" {
+			off += c.MaxPos
+		}
+		return off + w.Row, c.Hd, nil
+	}
+	return 0, 0, fmt.Errorf("unknown weight tensor %q", w.Name)
+}
+
+// ---------------------------------------------------------------- row hashing (matches stage.py)
+
+const RowBlock = 1024
+
+func rowWords(words []uint32) []byte {
+	b := make([]byte, 4*len(words))
+	for i, w := range words {
+		binary.LittleEndian.PutUint32(b[4*i:], w)
+	}
+	return b
+}
+
+func rowBlocks(b []byte) [][]byte {
+	var out [][]byte
+	for i := 0; i < max(len(b), 1); i += RowBlock {
+		out = append(out, b[i:min(len(b), i+RowBlock)])
+	}
+	return out
+}
+
+func blockLeaves(b []byte) []Hash {
+	bl := rowBlocks(b)
+	hs := make([]Hash, len(bl))
+	for i, x := range bl {
+		hs[i] = leafHash(x)
+	}
+	return hs
+}
+
+// RowRoot commits one row (4-byte words) as a Merkle root over 1 KiB blocks.
+func RowRoot(words []uint32) Hash { return MerkleRoot(blockLeaves(rowWords(words))) }
+
+// TraceLeaf is the trace-tree leaf for row-op `index` with the given row root.
+func TraceLeaf(index int, rowRoot Hash) Hash {
+	var b [4 + 4 + 32]byte
+	copy(b[:4], "leaf")
+	binary.LittleEndian.PutUint32(b[4:8], uint32(index))
+	copy(b[8:], rowRoot[:])
+	return leafHash(b[:])
+}
+
+// WeightLeaf is the weights-tree leaf of row index i.
+func WeightLeaf(index int, rowRoot Hash) Hash {
+	var b [1 + 4 + 32]byte
+	b[0] = 'w'
+	binary.LittleEndian.PutUint32(b[1:5], uint32(index))
+	copy(b[5:], rowRoot[:])
+	return leafHash(b[:])
+}
+
+// TokenLeaf is the job input-tree leaf of batch b (its token ids as int32 words).
+func TokenLeaf(batch int, rowRoot Hash) Hash {
+	var b [3 + 4 + 32]byte
+	copy(b[:3], "tok")
+	binary.LittleEndian.PutUint32(b[3:7], uint32(batch))
+	copy(b[7:], rowRoot[:])
+	return leafHash(b[:])
+}
+
+func f32w(v float32) uint32 { return math.Float32bits(v) }
+func wf32(w uint32) float32 { return math.Float32frombits(w) }
+
+func sqrtF64(x float64) float64 { return math.Sqrt(x) }
diff --git a/node/jobstate/referee.go b/node/jobstate/referee.go
new file mode 100644
index 00000000..0b3dfbd0
--- /dev/null
+++ b/node/jobstate/referee.go
@@ -0,0 +1,398 @@
+package jobstate
+
+import (
+	"errors"
+	"fmt"
+)
+
+// RowSource supplies the input rows an element depends on. In consensus every row comes
+// with a Merkle proof (ProvenSource); the test engine serves rows it computed itself.
+type RowSource interface {
+	Leaf(d LeafDesc) ([]uint32, error)    // an earlier leaf of the same stage
+	Weight(w WeightRow) ([]uint32, error) // a row of the registered weights tree
+	StageInput(t int) ([]uint32, error)   // x row t of the stage input (l0 > 0)
+	Tokens() ([]uint32, error)            // token ids of the stage's sequence (l0 == 0)
+}
+
+// Stage identifies a stage's shape for the referee.
+type Stage struct {
+	Cfg    ModelCfg
+	T      int
+	L0, L1 int
+}
+
+const maxKeys = 1 << 20
+const pLevels = 16383
+
+var errShape = errors.New("referee: input row has the wrong length")
+
+func (st Stage) bsFor(k int) int {
+	if st.Cfg.Bs <= 1 {
+		return 0
+	}
+	return min(st.Cfg.Bs, k&-k)
+}
+
+func floats(w []uint32) []float32 {
+	o := make([]float32, len(w))
+	for i, x := range w {
+		o[i] = wf32(x)
+	}
+	return o
+}
+
+func words(f []float32) []uint32 {
+	o := make([]uint32, len(f))
+	for i, x := range f {
+		o[i] = f32w(x)
+	}
+	return o
+}
+
+func qwords(q []int32, s float32) []uint32 {
+	o := make([]uint32, len(q)+1)
+	for i, x := range q {
+		o[i] = uint32(x)
+	}
+	o[len(q)] = f32w(s)
+	return o
+}
+
+func (st Stage) need(src RowSource, d LeafDesc, n int) ([]uint32, error) {
+	r, err := src.Leaf(d)
+	if err != nil {
+		return nil, err
+	}
+	if len(r) != n {
+		return nil, errShape
+	}
+	return r, nil
+}
+
+func (st Stage) weight(src RowSource, name string, l, row, n int) ([]uint32, error) {
+	r, err := src.Weight(WeightRow{name, l, row})
+	if err != nil {
+		return nil, err
+	}
+	if len(r) != n {
+		return nil, errShape
+	}
+	return r, nil
+}
+
+// xRow is the residual-stream input of layer l for token t.
+func (st Stage) xRow(src RowSource, l, t int) ([]float32, error) {
+	c := st.Cfg
+	switch {
+	case l > st.L0:
+		r, err := st.need(src, LeafDesc{LR2, l - 1, t, -1}, c.D)
+		return floats(r), err
+	case st.L0 == 0:
+		r, err := st.need(src, LeafDesc{LEmbed, 0, t, -1}, c.D)
+		return floats(r), err
+	default:
+		r, err := src.StageInput(t)
+		if err != nil {
+			return nil, err
+		}
+		if len(r) != c.D {
+			return nil, errShape
+		}
+		return floats(r), nil
+	}
+}
+
+// linearElem: output j of an int8 linear layer = (float(q . W_j) * s_x) * s_wj.
+func (st Stage) linearElem(src RowSource, qa LeafDesc, k int, wname string, l, j int) (uint32, error) {
+	q, err := st.need(src, qa, k+1)
+	if err != nil {
+		return 0, err
+	}
+	w, err := st.weight(src, wname, l, j, k+1)
+	if err != nil {
+		return 0, err
+	}
+	var acc int64
+	for i := 0; i < k; i++ {
+		acc += int64(int32(q[i])) * int64(int32(w[i]))
+	}
+	return f32w(fmul(fmul(float32(acc), wf32(q[k])), wf32(w[k]))), nil
+}
+
+func isRowOp(op uint8) bool {
+	switch op {
+	case LN1, LQA1, LQN, LKN, LKQ, LVQ, LQQ, LP, LQA2, LN2, LQA3, LQA4:
+		return true
+	}
+	return false
+}
+
+// Recompute returns the true value (4-byte word) of element e of leaf d.
+func (st Stage) Recompute(d LeafDesc, e int, src RowSource) (uint32, error) {
+	n := st.Cfg.RowLen(d, st.T)
+	if e < 0 || e >= n {
+		return 0, fmt.Errorf("referee: element %d out of range %d", e, n)
+	}
+	if isRowOp(d.Op) {
+		row, err := st.RecomputeRow(d, src)
+		if err != nil {
+			return 0, err
+		}
+		return row[e], nil
+	}
+	return st.elem(d, e, src)
+}
+
+// RecomputeRow returns the whole output row of leaf d.
+func (st Stage) RecomputeRow(d LeafDesc, src RowSource) ([]uint32, error) {
+	c := st.Cfg
+	nqkv := (c.H + 2*c.Hkv) * c.Hd
+	switch d.Op {
+	case LN1, LN2:
+		var x []float32
+		var err error
+		name := "in_norm"
+		if d.Op == LN1 {
+			x, err = st.xRow(src, d.Layer, d.T)
+		} else {
+			var r []uint32
+			r, err = st.need(src, LeafDesc{LR1, d.Layer, d.T, -1}, c.D)
+			x, name = floats(r), "post_norm"
+		}
+		if err != nil {
+			return nil, err
+		}
+		w, err := st.weight(src, name, d.Layer, 0, c.D)
+		if err != nil {
+			return nil, err
+		}
+		return words(detRMSNorm(x, floats(w), c.Eps)), nil
+	case LQA1, LQA3, LQA2, LQA4:
+		var x []float32
+		switch d.Op {
+		case LQA1, LQA3:
+			src0 := LN1
+			if d.Op == LQA3 {
+				src0 = LN2
+			}
+			r, err := st.need(src, LeafDesc{src0, d.Layer, d.T, -1}, c.D)
+			if err != nil {
+				return nil, err
+			}
+			x = floats(r)
+		case LQA2:
+			for h := 0; h < c.H; h++ {
+				r, err := st.need(src, LeafDesc{LO, d.Layer, d.T, h}, c.Hd)
+				if err != nil {
+					return nil, err
+				}
+				x = append(x, floats(r)...)
+			}
+		case LQA4:
+			r, err := st.need(src, LeafDesc{LSM, d.Layer, d.T, -1}, c.I)
+			if err != nil {
+				return nil, err
+			}
+			x = floats(r)
+		}
+		q, s := quantAct(x, st.bsFor(len(x)))
+		return qwords(q, s), nil
+	case LQN, LKN:
+		r, err := st.need(src, LeafDesc{LQKV, d.Layer, d.T, -1}, nqkv)
+		if err != nil {
+			return nil, err
+		}
+		off, name := d.H*c.Hd, "q_norm"
+		if d.Op == LKN {
+			off, name = (c.H+d.H)*c.Hd, "k_norm"
+		}
+		w, err := st.weight(src, name, d.Layer, 0, c.Hd)
+		if err != nil {
+			return nil, err
+		}
+		return words(detRMSNorm(floats(r[off:off+c.Hd]), floats(w), c.Eps)), nil
+	case LKQ, LQQ, LVQ:
+		var x []float32
+		switch d.Op {
+		case LKQ, LQQ:
+			from := LKR
+			if d.Op == LQQ {
+				from = LQR
+			}
+			r, err := st.need(src, LeafDesc{from, d.Layer, d.T, d.H}, c.Hd)
+			if err != nil {
+				return nil, err
+			}
+			x = floats(r)
+		case LVQ:
+			r, err := st.need(src, LeafDesc{LQKV, d.Layer, d.T, -1}, nqkv)
+			if err != nil {
+				return nil, err
+			}
+			off := (c.H + c.Hkv + d.H) * c.Hd
+			x = floats(r[off : off+c.Hd])
+		}
+		q, s := quantSym(x, 127)
+		return qwords(q, s), nil
+	case LP:
+		sr, err := st.need(src, LeafDesc{LS, d.Layer, d.T, d.H}, d.T+1)
+		if err != nil {
+			return nil, err
+		}
+		vs, err := st.need(src, LeafDesc{LVS, d.Layer, -1, d.H / (c.H / c.Hkv)}, st.T)
+		if err != nil {
+			return nil, err
+		}
+		s := floats(sr)
+		mx := s[0]
+		for _, v := range s {
+			mx = max(mx, v)
+		}
+		e := make([]float32, len(s))
+		for j, v := range s {
+			e[j] = detExp(fsub(v, mx))
+		}
+		den := exactRowSum(e, maxKeys)
+		pv := make([]float32, len(s))
+		var pmax float32
+		for j := range s {
+			pv[j] = fmul(fdiv(e[j], den), wf32(vs[j]))
+			pmax = max(pmax, pv[j])
+		}
+		sp := fdiv(max(pmax, c32(1e-30)), c32(pLevels))
+		q := make([]int32, len(s))
+		for j := range s {
+			q[j] = int32(max(0, min(pLevels, roundEven32(fdiv(pv[j], sp)))))
+		}
+		return qwords(q, sp), nil
+	}
+	// element ops: compute every element
+	nn := c.RowLen(d, st.T)
+	out := make([]uint32, nn)
+	for e := 0; e < nn; e++ {
+		v, err := st.elem(d, e, src)
+		if err != nil {
+			return nil, err
+		}
+		out[e] = v
+	}
+	return out, nil
+}
+
+func (st Stage) elem(d LeafDesc, e int, src RowSource) (uint32, error) {
+	c := st.Cfg
+	rep := c.H / c.Hkv
+	switch d.Op {
+	case LEmbed:
+		toks, err := src.Tokens()
+		if err != nil {
+			return 0, err
+		}
+		if len(toks) != st.T || int(toks[d.T]) >= c.V {
+			return 0, errShape
+		}
+		w, err := st.weight(src, "embed", 0, int(toks[d.T]), c.D)
+		if err != nil {
+			return 0, err
+		}
+		return w[e], nil
+	case LQKV:
+		return st.linearElem(src, LeafDesc{LQA1, d.Layer, d.T, -1}, c.D, "qkv", d.Layer, e)
+	case LOP:
+		return st.linearElem(src, LeafDesc{LQA2, d.Layer, d.T, -1}, c.H*c.Hd, "o", d.Layer, e)
+	case LGU:
+		return st.linearElem(src, LeafDesc{LQA3, d.Layer, d.T, -1}, c.D, "gu", d.Layer, e)
+	case LDN:
+		return st.linearElem(src, LeafDesc{LQA4, d.Layer, d.T, -1}, c.I, "down", d.Layer, e)
+	case LQR, LKR:
+		from := LQN
+		if d.Op == LKR {
+			from = LKN
+		}
+		x, err := st.need(src, LeafDesc{from, d.Layer, d.T, d.H}, c.Hd)
+		if err != nil {
+			return 0, err
+		}
+		cos, err := st.weight(src, "rope.cos", 0, d.T, c.Hd)
+		if err != nil {
+			return 0, err
+		}
+		sin, err := st.weight(src, "rope.sin", 0, d.T, c.Hd)
+		if err != nil {
+			return 0, err
+		}
+		half := c.Hd / 2
+		var rot float32
+		if e < half {
+			rot = -wf32(x[e+half])
+		} else {
+			rot = wf32(x[e-half])
+		}
+		return f32w(fadd(fmul(wf32(x[e]), wf32(cos[e])), fmul(rot, wf32(sin[e])))), nil
+	case LVT, LVS:
+		r, err := st.need(src, LeafDesc{LVQ, d.Layer, e, d.H}, c.Hd+1)
+		if err != nil {
+			return 0, err
+		}
+		if d.Op == LVT {
+			return r[d.T], nil
+		}
+		return r[c.Hd], nil
+	case LS:
+		q, err := st.need(src, LeafDesc{LQQ, d.Layer, d.T, d.H}, c.Hd+1)
+		if err != nil {
+			return 0, err
+		}
+		k, err := st.need(src, LeafDesc{LKQ, d.Layer, e, d.H / rep}, c.Hd+1)
+		if err != nil {
+			return 0, err
+		}
+		var dot int64
+		for i := 0; i < c.Hd; i++ {
+			dot += int64(int32(q[i])) * int64(int32(k[i]))
+		}
+		inv := c32(1.0 / sqrtF64(float64(c.Hd)))
+		return f32w(fmul(fmul(fmul(float32(dot), wf32(q[c.Hd])), wf32(k[c.Hd])), inv)), nil
+	case LO:
+		p, err := st.need(src, LeafDesc{LP, d.Layer, d.T, d.H}, d.T+2)
+		if err != nil {
+			return 0, err
+		}
+		v, err := st.need(src, LeafDesc{LVT, d.Layer, e, d.H / rep}, st.T)
+		if err != nil {
+			return 0, err
+		}
+		var acc int64
+		for j := 0; j <= d.T; j++ {
+			acc += int64(int32(p[j])) * int64(int32(v[j]))
+		}
+		return f32w(fmul(float32(acc), wf32(p[d.T+1]))), nil
+	case LR1:
+		x, err := st.xRow(src, d.Layer, d.T)
+		if err != nil {
+			return 0, err
+		}
+		op, err := st.need(src, LeafDesc{LOP, d.Layer, d.T, -1}, c.D)
+		if err != nil {
+			return 0, err
+		}
+		return f32w(fadd(x[e], wf32(op[e]))), nil
+	case LR2:
+		r1, err := st.need(src, LeafDesc{LR1, d.Layer, d.T, -1}, c.D)
+		if err != nil {
+			return 0, err
+		}
+		dn, err := st.need(src, LeafDesc{LDN, d.Layer, d.T, -1}, c.D)
+		if err != nil {
+			return 0, err
+		}
+		return f32w(fadd(wf32(r1[e]), wf32(dn[e]))), nil
+	case LSM:
+		gu, err := st.need(src, LeafDesc{LGU, d.Layer, d.T, -1}, 2*c.I)
+		if err != nil {
+			return 0, err
+		}
+		return f32w(fmul(detSilu(wf32(gu[e])), wf32(gu[c.I+e]))), nil
+	}
+	return 0, fmt.Errorf("referee: no element rule for op %d", d.Op)
+}
diff --git a/node/jobstate/referee_test.go b/node/jobstate/referee_test.go
new file mode 100644
index 00000000..f6e53adb
--- /dev/null
+++ b/node/jobstate/referee_test.go
@@ -0,0 +1,193 @@
+package jobstate
+
+import (
+	"compress/gzip"
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/hex"
+	"encoding/json"
+	"math"
+	"os"
+	"testing"
+)
+
+// Fixtures written by runtime/bench/export_fixtures.py (the Python reference runtime).
+
+type fxStage struct {
+	T, L0, L1 int
+	Tokens    []uint32
+	Input     []string
+	Rows      []string
+	Root      string
+}
+
+type fxWeight struct {
+	Name  string
+	Layer int
+	Row   int
+	W     string
+}
+
+type fixture struct {
+	Cfg struct {
+		D, H, Hkv, Hd, I, L, V int
+		EpsBits                uint32
+		Bs, MaxPos             int
+	}
+	Stages      []fxStage
+	Weights     []fxWeight
+	FullWeights bool   `json:"full_weights"`
+	WeightsRoot string `json:"weights_root"`
+}
+
+func loadFixture(t *testing.T, path string) (*fixture, ModelCfg, map[WeightRow][]uint32) {
+	t.Helper()
+	f, err := os.Open(path)
+	if err != nil {
+		t.Skipf("fixture %s missing: %v", path, err)
+	}
+	defer f.Close()
+	gz, err := gzip.NewReader(f)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fx fixture
+	if err := json.NewDecoder(gz).Decode(&fx); err != nil {
+		t.Fatal(err)
+	}
+	c := fx.Cfg
+	cfg := ModelCfg{D: c.D, H: c.H, Hkv: c.Hkv, Hd: c.Hd, I: c.I, L: c.L, V: c.V, Eps: math.Float32frombits(c.EpsBits),
+		Bs: c.Bs, MaxPos: c.MaxPos}
+	w := map[WeightRow][]uint32{}
+	for _, x := range fx.Weights {
+		w[WeightRow{x.Name, x.Layer, x.Row}] = dec(t, x.W)
+	}
+	return &fx, cfg, w
+}
+
+func dec(t *testing.T, s string) []uint32 {
+	b, err := base64.StdEncoding.DecodeString(s)
+	if err != nil {
+		t.Fatal(err)
+	}
+	o := make([]uint32, len(b)/4)
+	for i := range o {
+		o[i] = binary.LittleEndian.Uint32(b[4*i:])
+	}
+	return o
+}
+
+func eqWords(a, b []uint32) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for i := range a {
+		if a[i] != b[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// The Go engine reproduces every row of the Python runtime bit for bit, and the trace and
+// weights roots match, on a tiny Qwen3 with all weights.
+func TestRefereeMatchesPythonTiny(t *testing.T) {
+	fx, cfg, w := loadFixture(t, "testdata/tiny.json.gz")
+	// weights root over the canonical row order
+	leaves := make([]Hash, len(w))
+	for k, row := range w {
+		idx, n, err := cfg.weightIndex(k)
+		if err != nil || n != len(row) {
+			t.Fatalf("weight %+v: idx err %v, len %d want %d", k, err, len(row), n)
+		}
+		leaves[idx] = WeightLeaf(idx, RowRoot(row))
+	}
+	if hex.EncodeToString(func() []byte { r := MerkleRoot(leaves); return r[:] }()) != fx.WeightsRoot {
+		t.Fatal("weights root differs from Python")
+	}
+	for si, s := range fx.Stages {
+		st := Stage{Cfg: cfg, T: s.T, L0: s.L0, L1: s.L1}
+		src := &MemSource{Weights: w, Toks: s.Tokens}
+		for _, r := range s.Input {
+			src.Input = append(src.Input, dec(t, r))
+		}
+		rows, err := st.ComputeTrace(src)
+		if err != nil {
+			t.Fatalf("stage %d: %v", si, err)
+		}
+		prog := Program(cfg, s.T, s.L0, s.L1)
+		if len(rows) != len(s.Rows) {
+			t.Fatalf("stage %d: %d leaves, Python has %d", si, len(rows), len(s.Rows))
+		}
+		for i, r := range rows {
+			if !eqWords(r, dec(t, s.Rows[i])) {
+				t.Fatalf("stage %d leaf %d %+v differs from Python", si, i, prog[i])
+			}
+		}
+		root, _ := TraceRoot(rows)
+		if hex.EncodeToString(root[:]) != s.Root {
+			t.Fatalf("stage %d root differs", si)
+		}
+	}
+}
+
+// On Qwen3-1.7B (two one-layer stages, 8 tokens): every non-linear leaf is recomputed in full
+// from Python's rows, and sampled linear outputs from their weight rows, all bit-exact.
+func TestRefereeMatchesPythonQwen3(t *testing.T) {
+	fx, cfg, w := loadFixture(t, "testdata/qwen3_1p7b.json.gz")
+	checked := map[uint8]int{}
+	for si, s := range fx.Stages {
+		st := Stage{Cfg: cfg, T: s.T, L0: s.L0, L1: s.L1}
+		prog := Program(cfg, s.T, s.L0, s.L1)
+		src := &MemSource{Weights: w, Toks: s.Tokens, Leaves: map[LeafDesc][]uint32{}}
+		for _, r := range s.Input {
+			src.Input = append(src.Input, dec(t, r))
+		}
+		rows := make([][]uint32, len(prog))
+		for i, d := range prog {
+			rows[i] = dec(t, s.Rows[i])
+			src.Leaves[d] = rows[i]
+		}
+		if root, _ := TraceRoot(rows); hex.EncodeToString(root[:]) != s.Root {
+			t.Fatalf("stage %d: trace root differs", si)
+		}
+		for i, d := range prog {
+			switch d.Op {
+			case LQKV, LOP, LGU, LDN, LEmbed:
+				name := map[uint8]string{LQKV: "qkv", LOP: "o", LGU: "gu", LDN: "down"}[d.Op]
+				for e := range rows[i] {
+					if d.Op == LEmbed {
+						if e%97 != 0 {
+							continue
+						}
+					} else if _, ok := w[WeightRow{name, d.Layer, e}]; !ok {
+						continue
+					}
+					v, err := st.Recompute(d, e, src)
+					if err != nil {
+						t.Fatalf("stage %d leaf %+v e=%d: %v", si, d, e, err)
+					}
+					if v != rows[i][e] {
+						t.Fatalf("stage %d leaf %+v element %d: Go %08x Python %08x", si, d, e, v, rows[i][e])
+					}
+					checked[d.Op]++
+				}
+			default:
+				r, err := st.RecomputeRow(d, src)
+				if err != nil {
+					t.Fatalf("stage %d leaf %+v: %v", si, d, err)
+				}
+				if !eqWords(r, rows[i]) {
+					t.Fatalf("stage %d leaf %+v: Go row differs from Python", si, d)
+				}
+				checked[d.Op] += len(r)
+			}
+		}
+	}
+	for op := LEmbed; op <= LR2; op++ {
+		if checked[op] == 0 {
+			t.Fatalf("op %d never checked", op)
+		}
+	}
+	t.Logf("elements checked per op: %v", checked)
+}
