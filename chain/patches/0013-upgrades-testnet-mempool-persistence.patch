@@ -0,0 +1,26 @@
+package chaincfg
+
+import "testing"
+
+func TestUWCNetworks(t *testing.T) {
+	for _, p := range []*Params{&UWCDevNetParams, &UWCTestNetParams} {
+		if p.JobModule == nil || !p.JobModule.ValidUpgrades() {
+			t.Fatalf("%s: job module missing or upgrades out of order", p.Name)
+		}
+		if *p.GenesisHash != p.GenesisBlock.BlockHash() {
+			t.Fatalf("%s: genesis hash", p.Name)
+		}
+		if p.JobModule.CouncilThreshold < 1 || p.JobModule.CouncilThreshold > len(p.JobModule.Council) {
+			t.Fatalf("%s: council threshold", p.Name)
+		}
+	}
+	if *UWCTestNetParams.GenesisHash == *UWCDevNetParams.GenesisHash || UWCTestNetParams.Net == UWCDevNetParams.Net {
+		t.Fatal("testnet must not share the devnet's genesis or magic")
+	}
+	tp := UWCTestNetParams.JobModule
+	for _, w := range []int32{tp.VerifyCommitWindow, tp.VerifyRevealWindow, tp.ProviderRevealWindow, tp.GameWindow, tp.ServeWindow} {
+		if w < 30 {
+			t.Fatal("testnet reply windows must be at least 30 blocks")
+		}
+	}
+}
