index 06cacc9e..f41a8823 100644
--- a/node/jobstate/types.go
+++ b/node/jobstate/types.go
@@ -84,6 +84,45 @@ type Params struct {
 	// re-roll the committee by discarding seed blocks (spec/step6-results.md, sim.py part H).
 	LargeJobRewards int64
 	MinKLarge       int
+
+	// Rules is the version of rule changes that live in code rather than in parameter values:
+	//   1: pool claims are bonded against min(last payout, InitPrice) (devnet finding, step 7)
+	Rules int
+
+	// Upgrades change the parameters (and Rules) from a block height on, so a node replaying the
+	// chain from genesis applies each rule set exactly where the network adopted it. Heights
+	// strictly increase; each entry is a complete parameter set (its own Upgrades are ignored).
+	Upgrades []Upgrade
+}
+
+// Upgrade is a scheduled rule change: Params apply from Height on.
+type Upgrade struct {
+	Height int32
+	Params Params
+}
+
+// At returns the parameters in force for the block at height h.
+func (p Params) At(h int32) Params {
+	cur := p
+	for _, u := range p.Upgrades {
+		if h >= u.Height {
+			cur = u.Params
+		}
+	}
+	cur.Upgrades = nil
+	return cur
+}
+
+// ValidUpgrades reports whether the schedule's heights strictly increase and are positive.
+func (p Params) ValidUpgrades() bool {
+	last := int32(0)
+	for _, u := range p.Upgrades {
+		if u.Height <= last {
+			return false
+		}
+		last = u.Height
+	}
+	return true
 }
 
 // DefaultParams follow the starting values of Design v3 (fee split 98/1/1, bond >= 50% of fee,
