+package chaincfg
+
+import (
+	"encoding/hex"
+	"time"
+
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+	"github.com/pearl-research-labs/pearl/node/wire"
+)
+
+// Useful-Work Coin test network (build step 7, after the devnet). A fresh genesis with the
+// rules the devnet ended with, and reply windows sized from the devnet's lessons:
+//   - every window a party must answer in is 30 blocks (the devnet lost honest providers with
+//     10-block windows when blocks came fast or a node restarted);
+//   - job-module rule changes after launch go in JobModule.Upgrades with an activation height
+//     (the devnet could not be synced from genesis after unscheduled changes).
+
+var uwcTestNetCouncil = []string{
+	"e76e2e5010ac5053eb244c3fcbdb1e05dfa6718a9b9ebdd5209ade4bee133a3b",
+	"09184ca4effd1eb33612b59c72b5d43681b8c34fc1000f316ec0b88bc7176cc4",
+	"37f0708628c5322786f58d239ddd80679faf65ad41d8109f7e9be277b52e9adf",
+}
+
+func uwcTestNetJobParams() *jobstate.Params {
+	p := jobstate.DefaultParams()
+	for _, h := range uwcTestNetCouncil {
+		b, err := hex.DecodeString(h)
+		if err != nil || len(b) != 32 {
+			panic("chaincfg: bad UWC testnet council account " + h)
+		}
+		var a jobstate.AccountID
+		copy(a[:], b)
+		p.Council = append(p.Council, a)
+	}
+	p.CouncilThreshold = 2
+	p.CommitteeDelay = 2
+	p.VerifyCommitWindow, p.VerifyRevealWindow, p.ProviderRevealWindow = 30, 30, 30
+	p.GameWindow, p.ServeWindow = 30, 30
+	p.ChallengeWindow = 240 // about 4 hours: time for watchers to check
+	p.UnbondDelay = 1440
+	p.Rules = 1
+	return &p
+}
+
+var uwcTestNetGenesisBlock = func() wire.MsgBlock {
+	b := wire.MsgBlock{
+		MsgHeader: wire.MsgHeader{
+			BlockHeader: wire.BlockHeader{
+				Version:    1,
+				MerkleRoot: genesisMerkleRoot,
+				Timestamp:  time.Unix(1793966400, 0), // 2026-11-06 12:00:00 UTC
+				Bits:       0x1a020000,               // 2^201: about one block a minute at 550 TMAC/s
+			},
+		},
+		Transactions: []*wire.MsgTx{&genesisCoinbaseTx},
+	}
+	h := b.BlockHash()
+	b.MsgHeader.MsgCertificate = wire.MsgCertificate{Certificate: &wire.CertificateV1{
+		Hash: h, ProofData: []byte{0x75, 0x77, 0x63, 0x74}, // genesis is not verified
+	}}
+	return b
+}()
+
+var uwcTestNetGenesisHash = uwcTestNetGenesisBlock.BlockHash()
+
+// UWCTestNetParams are the parameters of the Useful-Work Coin test network.
+var UWCTestNetParams = func() Params {
+	p := UWCDevNetParams
+	p.Name = "uwc-testnet"
+	p.Net = wire.UWCTestNet
+	p.DefaultPort = "18690"
+	p.GenesisBlock = &uwcTestNetGenesisBlock
+	p.GenesisHash = &uwcTestNetGenesisHash
+	p.WTEMAHalfLife = 2 * time.Hour
+	p.CoinbaseMaturity = 20
+	p.JobModule = uwcTestNetJobParams()
+	return p
+}()
