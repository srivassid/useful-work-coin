diff --git a/node/mempool_persist.go b/node/mempool_persist.go
new file mode 100644
index 00000000..41539807
--- /dev/null
+++ b/node/mempool_persist.go
@@ -0,0 +1,139 @@
+package main
+
+import (
+	"bytes"
+	"encoding/binary"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+	"sort"
+
+	"github.com/pearl-research-labs/pearl/node/btcutil"
+	"github.com/pearl-research-labs/pearl/node/mempool"
+	"github.com/pearl-research-labs/pearl/node/wire"
+)
+
+// Mempool persistence (Useful-Work Coin, build step 7). Job-module protocols have reply windows:
+// a provider that misses one loses its bond. On the devnet, restarting nodes dropped pending
+// moves from the mempool and three honest providers were slashed. The mempool is now written to
+// mempool.dat on shutdown and re-admitted (validated as new) on startup.
+
+var mempoolFileMagic = [4]byte{'U', 'W', 'C', 'M'}
+
+const mempoolFileName = "mempool.dat"
+
+func mempoolPath() string { return filepath.Join(cfg.DataDir, mempoolFileName) }
+
+// writeMempool serializes txs (parents before children: oldest first).
+func writeMempool(w io.Writer, descs []*mempool.TxDesc) error {
+	sort.Slice(descs, func(i, j int) bool { return descs[i].Added.Before(descs[j].Added) })
+	var b bytes.Buffer
+	b.Write(mempoolFileMagic[:])
+	b.WriteByte(1)
+	_ = binary.Write(&b, binary.LittleEndian, uint32(len(descs)))
+	for _, d := range descs {
+		var tx bytes.Buffer
+		if err := d.Tx.MsgTx().Serialize(&tx); err != nil {
+			return err
+		}
+		_ = binary.Write(&b, binary.LittleEndian, uint32(tx.Len()))
+		b.Write(tx.Bytes())
+	}
+	_, err := w.Write(b.Bytes())
+	return err
+}
+
+// readMempool parses a mempool file.
+func readMempool(r io.Reader) ([]*btcutil.Tx, error) {
+	var magic [4]byte
+	if _, err := io.ReadFull(r, magic[:]); err != nil || magic != mempoolFileMagic {
+		return nil, fmt.Errorf("not a mempool file")
+	}
+	var ver [1]byte
+	if _, err := io.ReadFull(r, ver[:]); err != nil || ver[0] != 1 {
+		return nil, fmt.Errorf("unknown mempool file version")
+	}
+	var n uint32
+	if err := binary.Read(r, binary.LittleEndian, &n); err != nil {
+		return nil, err
+	}
+	if n > 1_000_000 {
+		return nil, fmt.Errorf("mempool file claims %d transactions", n)
+	}
+	txs := make([]*btcutil.Tx, 0, n)
+	for i := uint32(0); i < n; i++ {
+		var l uint32
+		if err := binary.Read(r, binary.LittleEndian, &l); err != nil {
+			return nil, err
+		}
+		if l > wire.MaxBlockPayload {
+			return nil, fmt.Errorf("transaction %d too large", i)
+		}
+		raw := make([]byte, l)
+		if _, err := io.ReadFull(r, raw); err != nil {
+			return nil, err
+		}
+		var msg wire.MsgTx
+		if err := msg.Deserialize(bytes.NewReader(raw)); err != nil {
+			return nil, err
+		}
+		txs = append(txs, btcutil.NewTx(&msg))
+	}
+	return txs, nil
+}
+
+// saveMempool writes the mempool to disk (called on shutdown).
+func (s *server) saveMempool() {
+	descs := s.txMemPool.TxDescs()
+	if len(descs) == 0 {
+		_ = os.Remove(mempoolPath())
+		return
+	}
+	tmp := mempoolPath() + ".tmp"
+	f, err := os.Create(tmp)
+	if err != nil {
+		srvrLog.Warnf("Unable to save the mempool: %v", err)
+		return
+	}
+	err = writeMempool(f, descs)
+	if cerr := f.Close(); err == nil {
+		err = cerr
+	}
+	if err == nil {
+		err = os.Rename(tmp, mempoolPath())
+	}
+	if err != nil {
+		srvrLog.Warnf("Unable to save the mempool: %v", err)
+		return
+	}
+	srvrLog.Infof("Saved %d mempool transactions", len(descs))
+}
+
+// loadMempool re-admits the saved transactions (each validated as if just received) and
+// announces the accepted ones to peers.
+func (s *server) loadMempool() {
+	f, err := os.Open(mempoolPath())
+	if err != nil {
+		return
+	}
+	txs, err := readMempool(f)
+	f.Close()
+	_ = os.Remove(mempoolPath())
+	if err != nil {
+		srvrLog.Warnf("Ignoring saved mempool: %v", err)
+		return
+	}
+	var accepted []*mempool.TxDesc
+	for _, tx := range txs {
+		descs, err := s.txMemPool.ProcessTransaction(tx, true, false, 0)
+		if err != nil {
+			continue // mined meanwhile, or no longer valid
+		}
+		accepted = append(accepted, descs...)
+	}
+	if len(accepted) > 0 {
+		s.AnnounceNewTransactions(accepted)
+	}
+	srvrLog.Infof("Restored %d of %d saved mempool transactions", len(accepted), len(txs))
+}
