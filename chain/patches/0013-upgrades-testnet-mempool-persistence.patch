+// TestUpgradesActivateAtHeight: scheduled parameter sets apply exactly from their height, so a
+// node replaying from genesis applies each rule change where the network adopted it.
+func TestUpgradesActivateAtHeight(t *testing.T) {
+	w := newWorld(t, 830, 4)
+	w.subsidy = 10_000_000
+	base := w.p
+	base.LargeJobRewards = 0 // no large-job rule at first
+	up := base
+	up.LargeJobRewards = 5
+	base.Upgrades = []Upgrade{{Height: w.h + 3, Params: up}}
+	if !base.ValidUpgrades() || base.At(w.h+2).LargeJobRewards != 0 || base.At(w.h+3).LargeJobRewards != 5 {
+		t.Fatal("At does not follow the schedule")
+	}
+	w.p = base
+	big := (w.subsidy - PoolIssuance(w.p, w.subsidy)) * 5
+	post := func() *Op {
+		return &Op{Kind: OpJobPost, Actor: w.client, Model: w.model, H1: w.randHash(), U1: 8, Amount: big,
+			Deadline: w.h + 20, K: 2, N: 2, U2: 4}
+	}
+	w.block([]Deposit{{w.client, 10 * big}}, nil, nil) // height start+1
+	if r := w.block(nil, []*Op{post()}, nil); r.OpErrors[0] != nil {
+		t.Fatalf("before the upgrade k = 2 is allowed: %v", r.OpErrors[0])
+	}
+	if r := w.block(nil, []*Op{post()}, nil); r.OpErrors[0] == nil {
+		t.Fatal("from the upgrade height k = 2 must be refused for a large job")
+	}
+	bad := base
+	bad.Upgrades = []Upgrade{{Height: 5, Params: up}, {Height: 5, Params: up}}
+	if bad.ValidUpgrades() {
+		t.Fatal("non-increasing heights accepted")
+	}
+}
+
+// TestRulesVersionGatesBondBasis: the bond-basis fix applies only from Rules 1, so chains
+// that predate it replay as they were validated.
+func TestRulesVersionGatesBondBasis(t *testing.T) {
+	for _, rules := range []int{0, 1} {
+		w := newPoolWorld(t, 831, 3)
+		w.p.Rules = rules
+		w.p.PoolEpoch = 200
+		w.income = 50_000_000_000
+		cat := w.openCategory(w.spec(4))
+		prov := acct(76)
+		w.block([]Deposit{{prov, 1e9}}, nil, nil)
+		tr := w.newTrace(8)
+		id := w.runUnit(cat, prov, 0, tr, tr)
+		for w.st.Jobs[id].Status != StatusSettled {
+			w.block(nil, nil, nil)
+		}
+		w.runTo(w.nextEpochEnd())
+		w.block(nil, nil, nil)
+		o := w.claimOp(cat, prov, 1)
+		o.Amount = minBond(w.p, w.st.Categories[cat].Spec.InitPrice)
+		r := w.block(nil, []*Op{o}, nil)
+		if (r.OpErrors[0] == nil) != (rules >= 1) {
+			t.Fatalf("rules %d: claim bonded against the reference cost: %v", rules, r.OpErrors[0])
+		}
+	}
+}
