diff --git a/node/jobstate/dispute.go b/node/jobstate/dispute.go
new file mode 100644
index 00000000..0340e9f6
--- /dev/null
+++ b/node/jobstate/dispute.go
@@ -0,0 +1,509 @@
+package jobstate
+
+import (
+	"errors"
+	"fmt"
+)
+
+// Dispute games (design doc: "bisect inside the stage to one int8 operation; full nodes
+// recompute it on CPU"). A game is played between the provider and Disputes[0] over one stage:
+//
+//	GReveal   provider must open the disputed stage's root (if it was never sampled)
+//	GTree     bisect the stage trace tree: each round both post the two children of their
+//	          current node; play continues in the leftmost subtree where they differ
+//	GLeaf     both post the row root of the first differing leaf
+//	GBlocks   bisect that row's block tree the same way
+//	GBlock    both post the bytes of the first differing 1 KiB block
+//	GOneStep  the first differing 4-byte element is fixed; the provider posts the element's
+//	          inputs (rows with Merkle proofs) and every full node recomputes it
+//
+// A party that does not make a valid move before the round's deadline loses. Leaves before the
+// differing one hash identically in both trees, so inputs taken from them are agreed values.
+
+const (
+	GReveal uint8 = iota + 1
+	GTree
+	GLeaf
+	GBlocks
+	GBlock
+	GOneStep
+)
+
+// Game is the state of the dispute currently being played on a job.
+type Game struct {
+	Stage          uint32
+	Phase          uint8
+	ProvRoot       Hash
+	ChalRoot       Hash
+	N              int // leaves in the stage program
+	Lo, Size       int // current subtree (leaf range) of the trace or block tree
+	HP, HC         Hash
+	PMoved, CMoved bool
+	PL, PR, CL, CR Hash
+	PData, CData   []byte
+	Leaf           int
+	RowLen         int
+	Block          int
+	Elem           int
+	PWord, CWord   uint32
+	Deadline       int32
+}
+
+// DataReq is a committee member's on-chain request for a stage's input (serve-or-slash).
+type DataReq struct {
+	Stage     uint32
+	Requester AccountID
+	Due       int32
+	Served    []bool
+}
+
+// ---------------------------------------------------------------- stage geometry
+
+func (s *State) stageShape(j *Job, stage uint32) (Stage, int, int, error) {
+	m := s.Models[j.Model]
+	if m == nil || stage >= j.Stages {
+		return Stage{}, 0, 0, errors.New("bad stage")
+	}
+	G := int(m.LayerGroups)
+	b, g := int(stage)/G, int(stage)%G
+	lpg := m.Cfg.L / G
+	return Stage{Cfg: m.Cfg, T: int(j.SeqLen), L0: g * lpg, L1: (g + 1) * lpg}, b, g, nil
+}
+
+func revealedRoot(j *Job, stage uint32) (Hash, bool) {
+	for _, r := range j.Revealed {
+		if r.Stage == stage {
+			return r.Root, true
+		}
+	}
+	return Hash{}, false
+}
+
+// reveal opens a stage root against StageRoot (any stage, while the job is active).
+func (s *State) reveal(j *Job, r StageReveal) error {
+	if r.Stage >= j.Stages {
+		return errors.New("stage out of range")
+	}
+	if _, ok := revealedRoot(j, r.Stage); ok {
+		return nil
+	}
+	if !VerifyMerkleProof(j.StageRoot, StageLeaf(r.Stage, r.Salt, r.Root), int(r.Stage), int(j.Stages), r.Proof) {
+		return errors.New("stage proof does not open the committed stage root")
+	}
+	j.Revealed = append(j.Revealed, StageReveal{Stage: r.Stage, Salt: r.Salt, Root: r.Root})
+	for i := len(j.Revealed) - 1; i > 0 && j.Revealed[i].Stage < j.Revealed[i-1].Stage; i-- {
+		j.Revealed[i], j.Revealed[i-1] = j.Revealed[i-1], j.Revealed[i]
+	}
+	return nil
+}
+
+// ---------------------------------------------------------------- proven inputs
+
+// ProvenSource serves referee inputs that were each checked against a commitment.
+type ProvenSource struct {
+	MemSource
+}
+
+func (s *State) provenSource(j *Job, g *Game, rows []ProvenRow) (*ProvenSource, Stage, error) {
+	st, b, grp, err := s.stageShape(j, g.Stage)
+	if err != nil {
+		return nil, st, err
+	}
+	m := s.Models[j.Model]
+	c := m.Cfg
+	prog := Program(c, st.T, st.L0, st.L1)
+	idx := indexProgram(prog)
+	nw := c.V + c.L*(4+(c.H+2*c.Hkv)*c.Hd+c.D+2*c.I+c.D) + 2*c.MaxPos
+	ps := &ProvenSource{MemSource{Weights: map[WeightRow][]uint32{}, Leaves: map[LeafDesc][]uint32{}}}
+	var prevRoot Hash
+	var prevIdx programIndex
+	if grp > 0 {
+		r, ok := revealedRoot(j, g.Stage-1)
+		if !ok {
+			return nil, st, errors.New("previous stage not opened")
+		}
+		prevRoot = r
+		prevIdx = indexProgram(Program(c, st.T, st.L0-(st.L1-st.L0), st.L0))
+	}
+	inputs := map[int][]uint32{}
+	for _, in := range rows {
+		rr := RowRoot(in.Words)
+		switch in.Kind {
+		case RowLeaf:
+			i, ok := idx[in.Leaf]
+			if !ok || i >= g.Leaf || len(in.Words) != c.RowLen(in.Leaf, st.T) {
+				return nil, st, errors.New("input leaf not an earlier leaf of the stage")
+			}
+			if !VerifyMerkleProof(g.ProvRoot, TraceLeaf(i, rr), i, g.N, in.Proof) {
+				return nil, st, errors.New("input leaf proof fails")
+			}
+			ps.Leaves[in.Leaf] = in.Words
+		case RowWeight:
+			i, n, err := c.weightIndex(in.W)
+			if err != nil || n != len(in.Words) {
+				return nil, st, errors.New("bad weight row")
+			}
+			if !VerifyMerkleProof(m.WeightsRoot, WeightLeaf(i, rr), i, nw, in.Proof) {
+				return nil, st, errors.New("weight proof fails")
+			}
+			ps.Weights[in.W] = in.Words
+		case RowInput:
+			if grp == 0 || in.Index < 0 || in.Index >= st.T || len(in.Words) != c.D {
+				return nil, st, errors.New("bad stage input row")
+			}
+			i := prevIdx[LeafDesc{LR2, st.L0 - 1, in.Index, -1}]
+			if !VerifyMerkleProof(prevRoot, TraceLeaf(i, rr), i, len(prevIdx), in.Proof) {
+				return nil, st, errors.New("stage input proof fails")
+			}
+			inputs[in.Index] = in.Words
+		case RowTokens:
+			nb := int(j.Stages) / int(m.LayerGroups)
+			if grp != 0 || in.Index != b || len(in.Words) != st.T {
+				return nil, st, errors.New("bad token row")
+			}
+			if !VerifyMerkleProof(j.InputRoot, TokenLeaf(b, rr), b, nb, in.Proof) {
+				return nil, st, errors.New("token proof fails")
+			}
+			ps.Toks = in.Words
+		default:
+			return nil, st, errors.New("bad input kind")
+		}
+	}
+	if len(inputs) > 0 {
+		ps.Input = make([][]uint32, st.T)
+		for t, r := range inputs {
+			ps.Input[t] = r
+		}
+	}
+	return ps, st, nil
+}
+
+func (p *ProvenSource) StageInput(t int) ([]uint32, error) {
+	if t < 0 || t >= len(p.Input) || p.Input[t] == nil {
+		return nil, fmt.Errorf("missing stage input row %d", t)
+	}
+	return p.Input[t], nil
+}
+
+// ---------------------------------------------------------------- game lifecycle
+
+// startGame begins playing Disputes[0], if no game is running.
+func (s *State) startGame(p Params, h int32, j *Job) {
+	if j.Game != nil || len(j.Disputes) == 0 {
+		return
+	}
+	d := j.Disputes[0]
+	g := &Game{Stage: d.Stage, ChalRoot: d.ClaimedRoot, Deadline: h + p.GameWindow}
+	st, _, _, err := s.stageShape(j, d.Stage)
+	if err != nil {
+		g.Phase = GReveal // cannot happen for validated disputes; provider must answer anyway
+	}
+	g.N = len(Program(st.Cfg, st.T, st.L0, st.L1))
+	j.Game = g
+	if r, ok := revealedRoot(j, d.Stage); ok {
+		s.beginTree(p, h, j, r)
+	} else {
+		g.Phase = GReveal
+	}
+}
+
+func (s *State) beginTree(p Params, h int32, j *Job, provRoot Hash) {
+	g := j.Game
+	g.ProvRoot = provRoot
+	if provRoot == g.ChalRoot { // nothing to dispute: the disputant was wrong
+		s.endGame(p, h, j, false, true)
+		return
+	}
+	g.Phase, g.Lo, g.Size, g.HP, g.HC = GTree, 0, g.N, provRoot, g.ChalRoot
+	if g.Size == 1 {
+		g.Phase = GLeaf
+	}
+	s.newRound(p, h, g)
+}
+
+func (s *State) newRound(p Params, h int32, g *Game) {
+	g.PMoved, g.CMoved, g.PData, g.CData = false, false, nil, nil
+	g.Deadline = h + p.GameWindow
+}
+
+// move records one party's move (DISPUTE_MOVE).
+func (s *State) move(p Params, h int32, j *Job, o *Op) error {
+	g := j.Game
+	if g == nil || j.Status != StatusDisputed {
+		return errors.New("no game")
+	}
+	prov := o.Actor == j.Provider
+	if !prov && o.Actor != j.Disputes[0].Challenger {
+		return errors.New("not a party to the game")
+	}
+	if (prov && g.PMoved) || (!prov && g.CMoved) {
+		return errors.New("already moved this round")
+	}
+	own := g.HC
+	if prov {
+		own = g.HP
+	}
+	switch g.Phase {
+	case GTree, GBlocks:
+		if g.Size <= 1 || nodeHash(o.H1, o.H2) != own {
+			return errors.New("children do not hash to your node")
+		}
+		if prov {
+			g.PL, g.PR = o.H1, o.H2
+		} else {
+			g.CL, g.CR = o.H1, o.H2
+		}
+	case GLeaf:
+		if TraceLeaf(g.Lo, o.H1) != own {
+			return errors.New("row root does not hash to your leaf")
+		}
+		if prov {
+			g.PL = o.H1
+		} else {
+			g.CL = o.H1
+		}
+	case GBlock:
+		want := min(RowBlock, 4*g.RowLen-g.Block*RowBlock)
+		if len(o.Data) != want || leafHash(o.Data) != own {
+			return errors.New("block does not hash to your block leaf")
+		}
+		if prov {
+			g.PData = append([]byte(nil), o.Data...)
+		} else {
+			g.CData = append([]byte(nil), o.Data...)
+		}
+	default:
+		return errors.New("no move expected in this phase")
+	}
+	if prov {
+		g.PMoved = true
+	} else {
+		g.CMoved = true
+	}
+	return nil
+}
+
+// oneStep checks the provider's inputs and decides the game.
+func (s *State) oneStep(p Params, h int32, j *Job, o *Op) error {
+	g := j.Game
+	if g == nil || g.Phase != GOneStep || o.Actor != j.Provider {
+		return errors.New("no one-step proof expected")
+	}
+	for _, r := range o.Reveals {
+		if err := s.reveal(j, r); err != nil {
+			return err
+		}
+	}
+	src, st, err := s.provenSource(j, g, o.Inputs)
+	if err != nil {
+		return err
+	}
+	prog := Program(st.Cfg, st.T, st.L0, st.L1)
+	v, err := st.Recompute(prog[g.Leaf], g.Elem, src)
+	if err != nil {
+		return err
+	}
+	s.endGame(p, h, j, v != g.PWord, v != g.CWord)
+	return nil
+}
+
+// advanceGame runs at the end of each block while a job is disputed.
+func (s *State) advanceGame(p Params, h int32, j *Job) {
+	g := j.Game
+	if g == nil {
+		s.startGame(p, h, j)
+		return
+	}
+	switch g.Phase {
+	case GReveal:
+		if r, ok := revealedRoot(j, g.Stage); ok {
+			s.beginTree(p, h, j, r)
+		} else if h >= g.Deadline {
+			s.endGame(p, h, j, true, false)
+		}
+		return
+	case GOneStep:
+		if h >= g.Deadline {
+			s.endGame(p, h, j, true, false) // the provider could not justify its value
+		}
+		return
+	}
+	if !(g.PMoved && g.CMoved) {
+		if h >= g.Deadline {
+			s.endGame(p, h, j, !g.PMoved, g.PMoved) // a silent provider loses first
+		}
+		return
+	}
+	switch g.Phase {
+	case GTree, GBlocks:
+		k := splitPoint(g.Size)
+		if g.PL != g.CL {
+			g.Size, g.HP, g.HC = k, g.PL, g.CL
+		} else {
+			g.Lo, g.Size, g.HP, g.HC = g.Lo+k, g.Size-k, g.PR, g.CR
+		}
+		if g.Size == 1 {
+			if g.Phase == GTree {
+				g.Phase = GLeaf
+			} else {
+				g.Phase, g.Block = GBlock, g.Lo
+			}
+		}
+	case GLeaf:
+		st, _, _, _ := s.stageShape(j, g.Stage)
+		prog := Program(st.Cfg, st.T, st.L0, st.L1)
+		g.Leaf, g.RowLen = g.Lo, st.Cfg.RowLen(prog[g.Lo], st.T)
+		nb := (4*g.RowLen + RowBlock - 1) / RowBlock
+		g.Phase, g.Lo, g.Size, g.HP, g.HC = GBlocks, 0, nb, g.PL, g.CL
+		if nb == 1 { // the row root is the single block's leaf hash
+			g.Phase, g.Block = GBlock, 0
+		}
+	case GBlock:
+		w := 0
+		for w*4 < len(g.PData) && string(g.PData[4*w:4*w+4]) == string(g.CData[4*w:4*w+4]) {
+			w++
+		}
+		g.Elem = g.Block*(RowBlock/4) + w
+		g.PWord = le32(g.PData[4*w:])
+		g.CWord = le32(g.CData[4*w:])
+		g.Phase, g.Deadline = GOneStep, h+p.GameWindow
+		return
+	}
+	s.newRound(p, h, g)
+}
+
+func le32(b []byte) uint32 {
+	return uint32(b[0]) | uint32(b[1])<<8 | uint32(b[2])<<16 | uint32(b[3])<<24
+}
+
+// endGame applies the outcome of the current game.
+func (s *State) endGame(p Params, h int32, j *Job, providerWrong, challengerWrong bool) {
+	d := j.Disputes[0]
+	j.Game = nil
+	penalize := func() {
+		if d.Verifier {
+			s.credit(TreasuryAccount, s.slash(d.Challenger, p.VerifierNoShowPenalty))
+			if v := j.seat(d.Challenger); v != nil {
+				v.Flagged = true
+			}
+		} else {
+			half := d.Bond / 2
+			s.credit(j.Provider, half)
+			s.credit(TreasuryAccount, d.Bond-half)
+		}
+	}
+	if providerWrong {
+		var catchers []AccountID
+		if challengerWrong {
+			penalize()
+		} else {
+			s.credit(d.Challenger, d.Bond)
+			catchers = append(catchers, d.Challenger)
+		}
+		for _, other := range j.Disputes[1:] { // queued disputants get their bonds back
+			s.credit(other.Challenger, other.Bond)
+		}
+		j.Disputes = nil
+		s.failProvider(j, catchers)
+		return
+	}
+	penalize()
+	j.Disputes = j.Disputes[1:]
+	if len(j.Disputes) > 0 {
+		s.startGame(p, h, j)
+		return
+	}
+	j.Disputes = nil
+	if h < j.ChallengeEnd {
+		j.Status, j.PhaseEnd = StatusChallenge, j.ChallengeEnd
+	} else {
+		s.settle(j)
+	}
+}
+
+// ---------------------------------------------------------------- serve-or-slash
+
+func (s *State) dataRequest(p Params, h int32, j *Job, o *Op) error {
+	if j.Status != StatusVerifyCommit && j.Status != StatusVerifyReveal {
+		return errors.New("data requests are taken during verification")
+	}
+	if j.seat(o.Actor) == nil {
+		return errors.New("only committee members may request stage inputs")
+	}
+	m := s.Models[j.Model]
+	if o.U1 >= j.Stages || o.U1%m.LayerGroups == 0 {
+		return errors.New("stage has no provider-held input (first layer groups read the job input)")
+	}
+	for _, r := range j.DataReqs {
+		if r.Requester == o.Actor {
+			return errors.New("one request per verifier")
+		}
+	}
+	j.DataReqs = append(j.DataReqs, DataReq{Stage: o.U1, Requester: o.Actor, Due: h + p.ServeWindow,
+		Served: make([]bool, j.SeqLen)})
+	return nil
+}
+
+func (s *State) dataServe(p Params, h int32, j *Job, o *Op) error {
+	if o.Actor != j.Provider {
+		return errors.New("not the provider")
+	}
+	var req *DataReq
+	for i := range j.DataReqs {
+		if j.DataReqs[i].Stage == o.U1 {
+			req = &j.DataReqs[i]
+		}
+	}
+	if req == nil {
+		return errors.New("no request for this stage")
+	}
+	for _, r := range o.Reveals {
+		if err := s.reveal(j, r); err != nil {
+			return err
+		}
+	}
+	prevRoot, ok := revealedRoot(j, o.U1-1)
+	if !ok {
+		return errors.New("previous stage not opened")
+	}
+	st, _, _, _ := s.stageShape(j, o.U1)
+	prev := indexProgram(Program(st.Cfg, st.T, st.L0-(st.L1-st.L0), st.L0))
+	for _, in := range o.Inputs {
+		if in.Kind != RowInput || in.Index < 0 || in.Index >= st.T || len(in.Words) != st.Cfg.D {
+			return errors.New("bad served row")
+		}
+		i := prev[LeafDesc{LR2, st.L0 - 1, in.Index, -1}]
+		if !VerifyMerkleProof(prevRoot, TraceLeaf(i, RowRoot(in.Words)), i, len(prev), in.Proof) {
+			return errors.New("served row does not open the previous stage")
+		}
+	}
+	for _, in := range o.Inputs { // all rows valid: mark them (whole op is all-or-nothing)
+		req.Served[in.Index] = true
+	}
+	return nil
+}
+
+func (r *DataReq) complete() bool {
+	for _, x := range r.Served {
+		if !x {
+			return false
+		}
+	}
+	return true
+}
+
+// dataHold reports whether verification must wait for stage inputs, and fails the provider
+// if a request went unserved past its due height.
+func (s *State) dataHold(p Params, h int32, j *Job) (hold, failed bool) {
+	for _, r := range j.DataReqs {
+		if r.complete() {
+			continue
+		}
+		if h >= r.Due {
+			s.failProvider(j, []AccountID{r.Requester})
+			return false, true
+		}
+		hold = true
+	}
+	return hold, false
+}
