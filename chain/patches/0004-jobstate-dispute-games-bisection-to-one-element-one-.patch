@@ -0,0 +1,642 @@
+package jobstate
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"math/rand/v2"
+	"testing"
+)
+
+// Fault-injection suite for build step 4: every injected fault must be caught and the right
+// party slashed. A tiny Qwen3 (all weights, real commitments) runs real stage programs; each
+// party plays the bisection game from its own trace; the provider builds one-step proofs from
+// whatever the referee actually reads.
+
+// ---------------------------------------------------------------- model + commitments
+
+type tinyModel struct {
+	cfg     ModelCfg
+	weights map[WeightRow][]uint32
+	wleaves []Hash
+	wroot   Hash
+	tokens  [][]uint32 // per batch
+}
+
+func loadTiny(t *testing.T) *tinyModel {
+	fx, cfg, w := loadFixture(t, "testdata/tiny.json.gz")
+	leaves := make([]Hash, len(w))
+	for k, row := range w {
+		i, _, _ := cfg.weightIndex(k)
+		leaves[i] = WeightLeaf(i, RowRoot(row))
+	}
+	tm := &tinyModel{cfg: cfg, weights: w, wleaves: leaves, wroot: MerkleRoot(leaves)}
+	t0 := fx.Stages[0].Tokens
+	t1 := make([]uint32, len(t0))
+	for i := range t0 {
+		t1[i] = t0[len(t0)-1-i] // second batch: the first one reversed
+	}
+	tm.tokens = [][]uint32{t0, t1}
+	return tm
+}
+
+func (tm *tinyModel) inputTree() ([]Hash, Hash) {
+	var lv []Hash
+	for b, toks := range tm.tokens {
+		lv = append(lv, TokenLeaf(b, RowRoot(toks)))
+	}
+	return lv, MerkleRoot(lv)
+}
+
+// trace computes one stage. corrupt (optional) edits a leaf right after it is computed, so later
+// leaves are recomputed consistently from the edited value (a "consistent liar").
+func (tm *tinyModel) trace(t *testing.T, w map[WeightRow][]uint32, toks []uint32, input [][]uint32, l0, l1 int,
+	corrupt func(i int, row []uint32)) [][]uint32 {
+	st := Stage{Cfg: tm.cfg, T: len(toks), L0: l0, L1: l1}
+	src := &MemSource{Weights: w, Toks: toks, Input: input, Leaves: map[LeafDesc][]uint32{}}
+	prog := Program(tm.cfg, st.T, l0, l1)
+	rows := make([][]uint32, len(prog))
+	for i, d := range prog {
+		r, err := st.RecomputeRow(d, src)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if corrupt != nil {
+			corrupt(i, r)
+		}
+		src.Leaves[d] = r
+		rows[i] = r
+	}
+	return rows
+}
+
+// ---------------------------------------------------------------- parties
+
+type party struct {
+	acct    AccountID
+	weights map[WeightRow][]uint32
+	tokens  [][]uint32
+	rows    map[uint32][][]uint32 // by stage
+	leaves  map[uint32][]Hash
+	silent  bool // never moves in games
+	badMove bool // posts garbage children
+}
+
+func (tm *tinyModel) newParty(t *testing.T, a AccountID, w map[WeightRow][]uint32, tokens [][]uint32,
+	fault func(stage uint32) func(int, []uint32), inputFault func(stage uint32, rows [][]uint32)) *party {
+	p := &party{acct: a, weights: w, tokens: tokens, rows: map[uint32][][]uint32{}, leaves: map[uint32][]Hash{}}
+	G := 2
+	lpg := tm.cfg.L / G
+	for b := range tokens {
+		var prevOut [][]uint32
+		for g := 0; g < G; g++ {
+			s := uint32(b*G + g)
+			var cor func(int, []uint32)
+			if fault != nil {
+				cor = fault(s)
+			}
+			var input [][]uint32
+			if g > 0 {
+				input = prevOut
+				if inputFault != nil {
+					input = cloneRows(prevOut)
+					inputFault(s, input)
+				}
+			}
+			rows := tm.trace(t, w, tokens[b], input, g*lpg, (g+1)*lpg, cor)
+			p.rows[s] = rows
+			_, p.leaves[s] = TraceRoot(rows)
+			prog := Program(tm.cfg, len(tokens[b]), g*lpg, (g+1)*lpg)
+			prevOut = nil
+			for i, d := range prog {
+				if d.Op == LR2 && d.Layer == (g+1)*lpg-1 {
+					prevOut = append(prevOut, rows[i])
+				}
+			}
+		}
+	}
+	return p
+}
+
+func cloneRows(r [][]uint32) [][]uint32 {
+	o := make([][]uint32, len(r))
+	for i := range r {
+		o[i] = append([]uint32(nil), r[i]...)
+	}
+	return o
+}
+
+func (p *party) root(s uint32) Hash { return MerkleRoot(p.leaves[s]) }
+
+func rangeRoot(l []Hash) Hash { return MerkleRoot(l) }
+
+// move returns this party's DISPUTE_MOVE for the game's current round.
+func (p *party) move(tm *tinyModel, j *Job, g *Game) *Op {
+	if p.silent {
+		return nil
+	}
+	rows := p.rows[g.Stage]
+	leaves := p.leaves[g.Stage]
+	o := &Op{Kind: OpDisputeMove, Actor: p.acct, Job: j.ID}
+	switch g.Phase {
+	case GTree:
+		k := splitPoint(g.Size)
+		o.H1, o.H2 = rangeRoot(leaves[g.Lo:g.Lo+k]), rangeRoot(leaves[g.Lo+k:g.Lo+g.Size])
+	case GLeaf:
+		o.H1 = RowRoot(rows[g.Lo])
+	case GBlocks:
+		bl := blockLeaves(rowWords(rows[g.Leaf]))
+		k := splitPoint(g.Size)
+		o.H1, o.H2 = rangeRoot(bl[g.Lo:g.Lo+k]), rangeRoot(bl[g.Lo+k:g.Lo+g.Size])
+	case GBlock:
+		o.Data = rowBlocks(rowWords(rows[g.Leaf]))[g.Block]
+	default:
+		return nil
+	}
+	if p.badMove {
+		o.H1, o.H2 = Hash{1}, Hash{2}
+	}
+	return o
+}
+
+// recorder notes which rows the referee reads.
+type recorder struct {
+	inner   *MemSource
+	leaves  []LeafDesc
+	weights []WeightRow
+	inputs  []int
+	tokens  bool
+}
+
+func (r *recorder) Leaf(d LeafDesc) ([]uint32, error) {
+	r.leaves = append(r.leaves, d)
+	return r.inner.Leaf(d)
+}
+func (r *recorder) Weight(w WeightRow) ([]uint32, error) {
+	r.weights = append(r.weights, w)
+	return r.inner.Weight(w)
+}
+func (r *recorder) StageInput(t int) ([]uint32, error) {
+	r.inputs = append(r.inputs, t)
+	return r.inner.StageInput(t)
+}
+func (r *recorder) Tokens() ([]uint32, error) { r.tokens = true; return r.inner.Tokens() }
+
+// oneStep builds the provider's ONE_STEP from its own data (which fails if that data is false).
+func (p *party) oneStep(tm *tinyModel, w *world, j *Job, g *Game, salts []Hash, stageLeaves []Hash) *Op {
+	if p.silent {
+		return nil
+	}
+	G := 2
+	b, grp := int(g.Stage)/G, int(g.Stage)%G
+	lpg := tm.cfg.L / G
+	T := len(p.tokens[b])
+	st := Stage{Cfg: tm.cfg, T: T, L0: grp * lpg, L1: (grp + 1) * lpg}
+	prog := Program(tm.cfg, T, st.L0, st.L1)
+	mem := &MemSource{Weights: p.weights, Toks: p.tokens[b], Leaves: map[LeafDesc][]uint32{}}
+	for i, d := range prog {
+		mem.Leaves[d] = p.rows[g.Stage][i]
+	}
+	var prevIdx programIndex
+	if grp > 0 {
+		pp := Program(tm.cfg, T, st.L0-lpg, st.L0)
+		prevIdx = indexProgram(pp)
+		for t := 0; t < T; t++ {
+			mem.Input = append(mem.Input, p.rows[g.Stage-1][prevIdx[LeafDesc{LR2, st.L0 - 1, t, -1}]])
+		}
+	}
+	rec := &recorder{inner: mem}
+	if _, err := st.Recompute(prog[g.Leaf], g.Elem, rec); err != nil {
+		return nil
+	}
+	idx := indexProgram(prog)
+	o := &Op{Kind: OpOneStep, Actor: p.acct, Job: j.ID}
+	for _, d := range rec.leaves {
+		i := idx[d]
+		o.Inputs = append(o.Inputs, ProvenRow{Kind: RowLeaf, Leaf: d, Words: p.rows[g.Stage][i], Proof: MerkleProof(p.leaves[g.Stage], i)})
+	}
+	for _, wr := range rec.weights {
+		i, _, _ := tm.cfg.weightIndex(wr)
+		o.Inputs = append(o.Inputs, ProvenRow{Kind: RowWeight, W: wr, Words: p.weights[wr], Proof: MerkleProof(tm.wleaves, i)})
+	}
+	for _, t := range rec.inputs {
+		i := prevIdx[LeafDesc{LR2, st.L0 - 1, t, -1}]
+		o.Inputs = append(o.Inputs, ProvenRow{Kind: RowInput, Index: t, Words: mem.Input[t], Proof: MerkleProof(p.leaves[g.Stage-1], i)})
+	}
+	if rec.tokens {
+		lv, _ := tm.inputTree()
+		o.Inputs = append(o.Inputs, ProvenRow{Kind: RowTokens, Index: b, Words: p.tokens[b], Proof: MerkleProof(lv, b)})
+	}
+	if grp > 0 {
+		o.Reveals = []StageReveal{{Stage: g.Stage - 1, Salt: salts[g.Stage-1], Root: p.root(g.Stage - 1),
+			Proof: MerkleProof(stageLeaves, int(g.Stage-1))}}
+	}
+	return o
+}
+
+// ---------------------------------------------------------------- scenario driver
+
+type scenario struct {
+	providerFault   func(stage uint32) func(int, []uint32)
+	providerInput   func(stage uint32, rows [][]uint32)
+	providerWeights map[WeightRow][]uint32
+	providerTokens  [][]uint32
+	providerSilent  bool
+	providerBadMove bool
+	verifierFault   func(stage uint32) func(int, []uint32) // applied to the first committee seat
+	challenge       *struct {
+		stage  uint32
+		fault  func(stage uint32) func(int, []uint32)
+		silent bool
+	}
+	dataRequest bool
+	serve       string // "ok", "none", "bad"
+}
+
+type outcome struct {
+	status        JobStatus
+	provider      Amount // balance change
+	client        Amount
+	verifierStake Amount // change of the first seat's stake
+	verifierBal   Amount
+	challenger    Amount
+	bond          Amount
+	games         int
+	oneStepOK     int // ONE_STEP ops accepted (verdict by recomputation)
+	oneStepBad    int // ONE_STEP ops rejected (forged or inconsistent inputs)
+}
+
+func runScenario(t *testing.T, tm *tinyModel, sc scenario, seed uint64) outcome {
+	t.Helper()
+	w := newSim(t, seed)
+	wd := &world{sim: w, client: acct(1), provider: acct(2)}
+	var deps []Deposit
+	var ops []*Op
+	deps = append(deps, Deposit{wd.client, 1e9}, Deposit{wd.provider, 1e9})
+	for i := 0; i < 3; i++ {
+		v := acct(100 + i)
+		wd.verifiers = append(wd.verifiers, v)
+		deps = append(deps, Deposit{v, 1e8})
+		ops = append(ops, &Op{Kind: OpStake, Actor: v, Amount: w.p.MinVerifierStake * 2})
+	}
+	reg := &Op{Kind: OpModelReg, Actor: wd.client, H1: tm.wroot, H2: Hash{7}, U1: 2, U2: uint32(tm.cfg.Bs), Cfg: tm.cfg}
+	ops = append(ops, reg)
+	mustOK(t, w.block(deps, ops, nil))
+	model := tagHash("model", reg.Ref[:])
+	_, inRoot := tm.inputTree()
+	const fee = 20_000_000
+	c0, p0 := w.st.Accounts[wd.client], w.st.Accounts[wd.provider] // before the fee and bond are escrowed
+	post := &Op{Kind: OpJobPost, Actor: wd.client, Model: model, H1: inRoot, U1: 4, Amount: fee, Deadline: w.h + 40,
+		K: 2, N: 4, U2: uint32(len(tm.tokens[0]))}
+	mustOK(t, w.block(nil, []*Op{post}, nil))
+	jid := tagHash("job", post.Ref[:])
+
+	pw, ptok := tm.weights, tm.tokens
+	if sc.providerWeights != nil {
+		pw = sc.providerWeights
+	}
+	if sc.providerTokens != nil {
+		ptok = sc.providerTokens
+	}
+	prov := tm.newParty(t, wd.provider, pw, ptok, sc.providerFault, sc.providerInput)
+	prov.silent, prov.badMove = sc.providerSilent, sc.providerBadMove
+	salts := make([]Hash, 4)
+	sl := make([]Hash, 4)
+	for s := range salts {
+		salts[s] = sha256.Sum256([]byte{byte(s), 0x5a})
+		sl[s] = StageLeaf(uint32(s), salts[s], prov.root(uint32(s)))
+	}
+	bond := minBond(w.p, fee)
+	mustOK(t, w.block(nil, []*Op{{Kind: OpJobAccept, Actor: wd.provider, Job: jid, Amount: bond}}, nil))
+	mustOK(t, w.block(nil, []*Op{{Kind: OpTraceCommit, Actor: wd.provider, Job: jid, H1: MerkleRoot(sl), H2: Hash{3}}}, nil))
+	for w.st.Jobs[jid].Status == StatusCommitted {
+		w.block(nil, nil, nil)
+	}
+	j := w.st.Jobs[jid]
+	seats := map[AccountID]*party{}
+	for i, s := range j.Committee {
+		var f func(uint32) func(int, []uint32)
+		if i == 0 {
+			f = sc.verifierFault
+		}
+		seats[s.Account] = tm.newParty(t, s.Account, tm.weights, tm.tokens, f, nil)
+	}
+	first := j.Committee[0].Account
+	vs0, vb0 := w.st.Stakes[first], w.st.Accounts[first]
+	// optional serve-or-slash round before committing
+	if sc.dataRequest {
+		mustOK(t, w.block(nil, []*Op{{Kind: OpDataRequest, Actor: first, Job: jid, U1: 1}}, nil))
+		switch sc.serve {
+		case "ok", "bad":
+			var rows []ProvenRow
+			pp := Program(tm.cfg, len(tm.tokens[0]), 0, 1)
+			idx := indexProgram(pp)
+			for tt := 0; tt < len(tm.tokens[0]); tt++ {
+				i := idx[LeafDesc{LR2, 0, tt, -1}]
+				words := append([]uint32(nil), prov.rows[0][i]...)
+				if sc.serve == "bad" && tt == 3 {
+					words[5] ^= 1
+				}
+				rows = append(rows, ProvenRow{Kind: RowInput, Index: tt, Words: words, Proof: MerkleProof(prov.leaves[0], i)})
+			}
+			w.block(nil, []*Op{{Kind: OpDataServe, Actor: wd.provider, Job: jid, U1: 1, Inputs: rows,
+				Reveals: []StageReveal{{Stage: 0, Salt: salts[0], Root: prov.root(0), Proof: MerkleProof(sl, 0)}}}}, nil)
+		}
+	}
+	// verifiers commit to and reveal their roots for all stages (n >= S samples everything)
+	vsalt := map[AccountID]Hash{}
+	var commits []*Op
+	for _, s := range j.Committee {
+		salt := sha256.Sum256(s.Account[:])
+		vsalt[s.Account] = salt
+		var roots []Hash
+		for _, pos := range Positions(salt, 4, 4) {
+			roots = append(roots, seats[s.Account].root(pos))
+		}
+		commits = append(commits, &Op{Kind: OpVerifyCommit, Actor: s.Account, Job: jid, H1: sha256.Sum256(salt[:]),
+			H2: ResultHash(roots, s.Account, salt)})
+	}
+	w.block(nil, commits, nil)
+	for i := 0; i < 40 && w.st.Jobs[jid].Status == StatusVerifyCommit; i++ {
+		w.block(nil, nil, nil)
+	}
+	var reveals []*Op
+	for _, s := range j.Committee {
+		var roots []Hash
+		for _, pos := range Positions(vsalt[s.Account], 4, 4) {
+			roots = append(roots, seats[s.Account].root(pos))
+		}
+		reveals = append(reveals, &Op{Kind: OpVerifyReveal, Actor: s.Account, Job: jid, H1: vsalt[s.Account], Roots: roots})
+	}
+	if w.st.Jobs[jid].Status == StatusVerifyReveal {
+		w.block(nil, reveals, nil)
+	}
+	if w.st.Jobs[jid].Status == StatusProviderReveal {
+		var rv []StageReveal
+		for s := uint32(0); s < 4; s++ {
+			rv = append(rv, StageReveal{Stage: s, Salt: salts[s], Root: prov.root(s), Proof: MerkleProof(sl, int(s))})
+		}
+		w.block(nil, []*Op{{Kind: OpTraceReveal, Actor: wd.provider, Job: jid, Reveals: rv}}, nil)
+		w.block(nil, nil, nil)
+	}
+	// an outside bonded challenger, if any
+	var chal *party
+	ch := acct(77)
+	ch0 := Amount(0)
+	if sc.challenge != nil && w.st.Jobs[jid].Status == StatusChallenge {
+		chal = tm.newParty(t, ch, tm.weights, tm.tokens, sc.challenge.fault, nil)
+		chal.silent = sc.challenge.silent
+		w.block([]Deposit{{ch, 1e8}}, nil, nil)
+		ch0 = w.st.Accounts[ch]
+		mustOK(t, w.block(nil, []*Op{{Kind: OpChallenge, Actor: ch, Job: jid, U1: sc.challenge.stage,
+			H1: chal.root(sc.challenge.stage), Amount: w.p.ChallengeBondMin}}, nil))
+		ch0 -= 0
+	}
+	// play games until the job ends
+	games, okSteps, badSteps := 0, 0, 0
+	for i := 0; i < 2000 && !w.st.Jobs[jid].Status.Terminal(); i++ {
+		j = w.st.Jobs[jid]
+		var ops []*Op
+		if g := j.Game; g != nil && j.Status == StatusDisputed {
+			if g.Phase == GTree && g.Lo == 0 && g.Size == g.N && !g.PMoved && !g.CMoved {
+				games++
+			}
+			disputant := seats[j.Disputes[0].Challenger]
+			if j.Disputes[0].Challenger == ch {
+				disputant = chal
+			}
+			switch g.Phase {
+			case GOneStep:
+				if o := prov.oneStep(tm, wd, j, g, salts, sl); o != nil {
+					ops = append(ops, o)
+				}
+			case GReveal:
+				ops = append(ops, &Op{Kind: OpTraceReveal, Actor: wd.provider, Job: jid, Reveals: []StageReveal{
+					{Stage: g.Stage, Salt: salts[g.Stage], Root: prov.root(g.Stage), Proof: MerkleProof(sl, int(g.Stage))}}})
+			default:
+				if !g.PMoved {
+					if o := prov.move(tm, j, g); o != nil {
+						ops = append(ops, o)
+					}
+				}
+				if !g.CMoved {
+					if o := disputant.move(tm, j, g); o != nil {
+						ops = append(ops, o)
+					}
+				}
+			}
+		}
+		res := w.block(nil, ops, nil)
+		for k, o := range ops {
+			if o.Kind == OpOneStep {
+				if res.OpErrors[k] == nil {
+					okSteps++
+				} else {
+					badSteps++
+				}
+			}
+		}
+	}
+	j = w.st.Jobs[jid]
+	if !j.Status.Terminal() {
+		t.Fatalf("job stuck in %v (game %+v)", j.Status, j.Game)
+	}
+	out := outcome{status: j.Status, provider: w.st.Accounts[wd.provider] - p0, client: w.st.Accounts[wd.client] - c0,
+		verifierStake: w.st.Stakes[first] - vs0, verifierBal: w.st.Accounts[first] - vb0, bond: bond, games: games,
+		oneStepOK: okSteps, oneStepBad: badSteps}
+	if chal != nil {
+		out.challenger = w.st.Accounts[ch] - ch0
+	}
+	return out
+}
+
+// ---------------------------------------------------------------- the faults
+
+// corruptAt flips element e of leaf i (in stage s) and lets later leaves follow consistently.
+func corruptAt(s uint32, i, e int) func(uint32) func(int, []uint32) {
+	return func(st uint32) func(int, []uint32) {
+		if st != s {
+			return nil
+		}
+		return func(k int, row []uint32) {
+			if k == i {
+				row[e%len(row)] ^= 0x00400001
+			}
+		}
+	}
+}
+
+func expectProviderSlashed(t *testing.T, o outcome, name string) {
+	t.Helper()
+	if o.status != StatusFailed || o.provider != -o.bond || o.client != 0 {
+		t.Fatalf("%s: status %v provider %d client %d (bond %d)", name, o.status, o.provider, o.client, o.bond)
+	}
+}
+
+func TestFaultsAreCaughtAndTheRightPartyIsSlashed(t *testing.T) {
+	tm := loadTiny(t)
+	progLen := len(Program(tm.cfg, len(tm.tokens[0]), 0, 1))
+
+	t.Run("honest job settles", func(t *testing.T) {
+		o := runScenario(t, tm, scenario{}, 1)
+		if o.status != StatusSettled || o.provider <= 0 || o.games != 0 {
+			t.Fatalf("%+v", o)
+		}
+	})
+	t.Run("provider fakes a whole stage", func(t *testing.T) {
+		fake := func(s uint32) func(int, []uint32) {
+			if s != 2 {
+				return nil
+			}
+			return func(_ int, row []uint32) {
+				for i := range row {
+					row[i] = 0x3f800000
+				}
+			}
+		}
+		o := runScenario(t, tm, scenario{providerFault: fake}, 2)
+		expectProviderSlashed(t, o, "fake stage")
+		if o.verifierBal <= 0 {
+			t.Fatalf("catching verifier not rewarded: %+v", o)
+		}
+	})
+	t.Run("provider substitutes a weight row (model substitution)", func(t *testing.T) {
+		sub := map[WeightRow][]uint32{}
+		for k, v := range tm.weights {
+			sub[k] = v
+		}
+		row := append([]uint32(nil), tm.weights[WeightRow{"gu", 1, 7}]...)
+		row[3] = uint32(int32(row[3]) + 9)
+		sub[WeightRow{"gu", 1, 7}] = row
+		o := runScenario(t, tm, scenario{providerWeights: sub}, 3)
+		expectProviderSlashed(t, o, "weights")
+		if o.oneStepOK != 0 || o.oneStepBad == 0 {
+			t.Fatalf("substituted weights must fail the weights-root proof: %+v", o)
+		}
+	})
+	t.Run("provider computes on the wrong tokens", func(t *testing.T) {
+		toks := [][]uint32{append([]uint32(nil), tm.tokens[0]...), tm.tokens[1]}
+		toks[0][4] = (toks[0][4] + 1) % uint32(tm.cfg.V)
+		o := runScenario(t, tm, scenario{providerTokens: toks}, 4)
+		expectProviderSlashed(t, o, "tokens")
+		if o.oneStepOK != 0 || o.oneStepBad == 0 {
+			t.Fatalf("wrong tokens must fail the input-root proof: %+v", o)
+		}
+	})
+	t.Run("provider computes a stage on a wrong input", func(t *testing.T) {
+		in := func(s uint32, rows [][]uint32) {
+			if s == 1 {
+				rows[5][9] ^= 1 << 20
+			}
+		}
+		expectProviderSlashed(t, runScenario(t, tm, scenario{providerInput: in}, 5), "stage input")
+	})
+	t.Run("provider silent in the game", func(t *testing.T) {
+		expectProviderSlashed(t, runScenario(t, tm, scenario{providerFault: corruptAt(0, 40, 3), providerSilent: true}, 6), "silent")
+	})
+	t.Run("provider posts invalid moves", func(t *testing.T) {
+		expectProviderSlashed(t, runScenario(t, tm, scenario{providerFault: corruptAt(3, 100, 1), providerBadMove: true}, 7), "bad moves")
+	})
+	t.Run("lying verifier against an honest provider", func(t *testing.T) {
+		o := runScenario(t, tm, scenario{verifierFault: corruptAt(1, 77, 2)}, 8)
+		if o.status != StatusSettled || o.verifierStake != -DefaultParams().VerifierNoShowPenalty || o.games != 1 {
+			t.Fatalf("%+v", o)
+		}
+	})
+	t.Run("provider and verifier wrong differently at the same element", func(t *testing.T) {
+		pf := corruptAt(0, 60, 5)
+		vf := func(s uint32) func(int, []uint32) {
+			if s != 0 {
+				return nil
+			}
+			return func(k int, row []uint32) {
+				if k == 60 {
+					row[5%len(row)] ^= 0x00800002
+				}
+			}
+		}
+		o := runScenario(t, tm, scenario{providerFault: pf, verifierFault: vf}, 9)
+		if o.status != StatusFailed || o.provider != -o.bond || o.verifierStake != -DefaultParams().VerifierNoShowPenalty {
+			t.Fatalf("both wrong: %+v", o)
+		}
+	})
+	t.Run("lying bonded challenger loses its bond", func(t *testing.T) {
+		o := runScenario(t, tm, scenario{challenge: &struct {
+			stage  uint32
+			fault  func(uint32) func(int, []uint32)
+			silent bool
+		}{stage: 3, fault: corruptAt(3, 150, 4)}}, 10)
+		if o.status != StatusSettled || o.challenger != -DefaultParams().ChallengeBondMin {
+			t.Fatalf("%+v", o)
+		}
+	})
+	t.Run("silent challenger loses its bond", func(t *testing.T) {
+		o := runScenario(t, tm, scenario{challenge: &struct {
+			stage  uint32
+			fault  func(uint32) func(int, []uint32)
+			silent bool
+		}{stage: 2, fault: corruptAt(2, 9, 0), silent: true}}, 11)
+		if o.status != StatusSettled || o.challenger != -DefaultParams().ChallengeBondMin {
+			t.Fatalf("%+v", o)
+		}
+	})
+	t.Run("data served: no slash", func(t *testing.T) {
+		o := runScenario(t, tm, scenario{dataRequest: true, serve: "ok"}, 12)
+		if o.status != StatusSettled {
+			t.Fatalf("%+v", o)
+		}
+	})
+	t.Run("data not served: provider slashed", func(t *testing.T) {
+		expectProviderSlashed(t, runScenario(t, tm, scenario{dataRequest: true, serve: "none"}, 13), "no serve")
+	})
+	t.Run("corrupted data served: rejected, provider slashed", func(t *testing.T) {
+		expectProviderSlashed(t, runScenario(t, tm, scenario{dataRequest: true, serve: "bad"}, 14), "bad serve")
+	})
+
+	// property: a consistent lie at a random element of a random leaf, covering every op type,
+	// is always caught; the same for a lying verifier against an honest provider
+	rng := rand.New(rand.NewPCG(5, 6))
+	prog0 := Program(tm.cfg, len(tm.tokens[0]), 0, 1)
+	prog1 := Program(tm.cfg, len(tm.tokens[0]), 1, 2)
+	seen := map[uint8]bool{}
+	for trial := 0; trial < 60; trial++ {
+		stage := uint32(rng.IntN(4))
+		prog := prog0
+		if stage%2 == 1 {
+			prog = prog1
+		}
+		i := rng.IntN(len(prog))
+		if trial < 52 { // first, one leaf of each op type in turn
+			want := uint8(trial % 26)
+			for k, d := range prog {
+				if d.Op == want {
+					i = k + rng.IntN(4)%(len(prog)-k)
+					if prog[i].Op != want {
+						i = k
+					}
+					break
+				}
+			}
+		}
+		e := rng.IntN(tm.cfg.RowLen(prog[i], len(tm.tokens[0])))
+		seen[prog[i].Op] = true
+		name := fmt.Sprintf("trial %d stage %d leaf %d (%d) elem %d", trial, stage, i, prog[i].Op, e)
+		if trial%2 == 0 {
+			o := runScenario(t, tm, scenario{providerFault: corruptAt(stage, i, e)}, uint64(100+trial))
+			expectProviderSlashed(t, o, name)
+			if o.oneStepOK != 1 {
+				t.Fatalf("%s: verdict must come from one accepted recomputation: %+v", name, o)
+			}
+		} else {
+			o := runScenario(t, tm, scenario{verifierFault: corruptAt(stage, i, e)}, uint64(100+trial))
+			if o.status != StatusSettled || o.verifierStake != -DefaultParams().VerifierNoShowPenalty || o.oneStepOK != 1 {
+				t.Fatalf("%s: lying verifier not penalized by recomputation: %+v", name, o)
+			}
+		}
+	}
+	for op := uint8(0); op <= LR2; op++ {
+		if !seen[op] && !(op == LEmbed) {
+			t.Fatalf("op %d never corrupted", op)
+		}
+	}
+	_ = progLen
+}
