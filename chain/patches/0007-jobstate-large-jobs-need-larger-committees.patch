--- a/node/jobstate/pool_test.go
+++ b/node/jobstate/pool_test.go
@@ -1117,3 +1117,24 @@ func TestStep5Vectors(t *testing.T) {
 		t.Fatal("canary proof from the Python tool does not verify")
 	}
 }
+
+// TestLargeJobsNeedLargerCommittees: a fee of LargeJobRewards block rewards or more needs
+// k >= MinKLarge (build step 6, sim.py part H: re-rolling committees by withholding blocks).
+func TestLargeJobsNeedLargerCommittees(t *testing.T) {
+	w := newWorld(t, 801, 4)
+	w.subsidy = 10_000_000
+	reward := w.subsidy - PoolIssuance(w.p, w.subsidy) // 9,000,000 to the miner
+	big := reward * w.p.LargeJobRewards
+	post := func(fee Amount, k uint8) *Op {
+		return &Op{Kind: OpJobPost, Actor: w.client, Model: w.model, H1: w.randHash(), U1: 8, Amount: fee,
+			Deadline: w.h + 20, K: k, N: 2, U2: 4}
+	}
+	r := w.block([]Deposit{{w.client, 10 * big}}, []*Op{post(big, 2), post(big, 3), post(big-1, 2)}, nil)
+	if r.OpErrors[0] == nil || r.OpErrors[1] != nil || r.OpErrors[2] != nil {
+		t.Fatalf("large-job rule: %v", r.OpErrors)
+	}
+	w.subsidy = 0 // no subsidy information: the rule is off
+	if r := w.block(nil, []*Op{post(big, 2)}, nil); r.OpErrors[0] != nil {
+		t.Fatal(r.OpErrors[0])
+	}
+}
