-	return c.D > 0 && c.H > 0 && c.Hkv > 0 && c.H%c.Hkv == 0 && c.Hd > 1 && c.Hd%2 == 0 && c.I > 0 &&
+	return c.Arch <= ArchLlama && c.D > 0 && c.H > 0 && c.Hkv > 0 && c.H%c.Hkv == 0 && c.Hd > 1 && c.Hd%2 == 0 && c.I > 0 &&
 		c.L > 0 && c.V > 0 && c.MaxPos > 0 && c.D%8 == 0 && c.D <= 1<<16 && c.I <= 1<<18 && c.H <= 256
 }
 
