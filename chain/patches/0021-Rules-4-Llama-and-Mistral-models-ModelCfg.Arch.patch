+++ b/node/jobstate/rules4_test.go
@@ -0,0 +1,84 @@
+package jobstate
+
+import "testing"
+
+// Rules 4: Llama and Mistral models (ModelCfg.Arch = ArchLlama).
+
+func TestRules4ModelRegWireFormat(t *testing.T) {
+	cfg := ModelCfg{D: 8, H: 2, Hkv: 1, Hd: 4, I: 8, L: 2, V: 16, Bs: 64, MaxPos: 8}
+	qwen := &Op{Kind: OpModelReg, H1: Hash{4}, U1: 2, U2: 64, Cfg: cfg}
+	qwenGen := &Op{Kind: OpModelReg, H1: Hash{4}, U1: 2, U2: 64, Cfg: cfg, Gen: true}
+	base, baseGen := qwen.Encode(), qwenGen.Encode()
+	llama := cfg
+	llama.Arch = ArchLlama
+	for _, o := range []*Op{
+		{Kind: OpModelReg, H1: Hash{4}, U1: 2, U2: 64, Cfg: llama},
+		{Kind: OpModelReg, H1: Hash{4}, U1: 2, U2: 64, Cfg: llama, Gen: true},
+	} {
+		b := o.Encode()
+		d, err := DecodeOp(b)
+		if err != nil || d.Cfg != o.Cfg || d.Gen != o.Gen {
+			t.Fatalf("round trip (gen %v): %v %+v", o.Gen, err, d)
+		}
+		prefix := base
+		if o.Gen {
+			prefix = baseGen
+		}
+		if string(b[:len(prefix)]) != string(prefix) || len(b) != len(prefix)+2 {
+			t.Fatal("the architecture is not a pure two-byte suffix")
+		}
+	}
+	// Qwen3 registrations encode exactly as before Rules 4
+	if d, err := DecodeOp(base); err != nil || d.Cfg.Arch != ArchQwen3 || d.Gen {
+		t.Fatalf("qwen3 decode: %v %+v", err, d)
+	}
+	for name, b := range map[string][]byte{
+		"explicit qwen3 arch":     append(append([]byte(nil), base...), archMarker, ArchQwen3),
+		"unknown marker":          append(append([]byte(nil), base...), 'X', ArchLlama),
+		"gen marker in arch slot": append(append([]byte(nil), base...), genMarker, genMarker, ArchLlama),
+		"arch without byte":       append(append([]byte(nil), base...), genMarker, archMarker),
+		"trailing after arch":     append(append([]byte(nil), base...), archMarker, ArchLlama, 0),
+	} {
+		if _, err := DecodeOp(b); err == nil {
+			t.Fatalf("%s: decoded", name)
+		}
+	}
+	if (ModelCfg{D: 8, H: 2, Hkv: 1, Hd: 4, I: 8, L: 2, V: 16, MaxPos: 8, Arch: 2}).valid() {
+		t.Fatal("an unknown architecture is valid")
+	}
+}
+
+func TestRules4ModelRegActivation(t *testing.T) {
+	w := newPoolWorld(t, 612, 2)
+	reg := acct(941)
+	w.block([]Deposit{{reg, 10 * w.p.ModelRegBond}}, nil, nil)
+	cfg := ModelCfg{D: 8, H: 2, Hkv: 1, Hd: 4, I: 8, L: 2, V: 16, Bs: 64, MaxPos: 8, Arch: ArchLlama}
+	op := func() *Op {
+		return &Op{Kind: OpModelReg, Actor: reg, H1: w.randHash(), H2: w.randHash(), U1: 2, U2: 64, Cfg: cfg}
+	}
+	w.p.Rules = 3
+	before := len(w.st.Models)
+	if r := w.block(nil, []*Op{op()}, nil); r.OpErrors[0] == nil || len(w.st.Models) != before {
+		t.Fatal("a Llama model was registered before Rules 4")
+	}
+	w.p.Rules = 4
+	if r := w.block(nil, []*Op{op()}, nil); r.OpErrors[0] != nil {
+		t.Fatalf("Rules 4 Llama registration: %v", r.OpErrors[0])
+	}
+	var m *Model
+	for _, x := range w.st.Models {
+		if x.Cfg.Arch == ArchLlama {
+			m = x
+		}
+	}
+	if m == nil {
+		t.Fatal("no Llama model in the state")
+	}
+	// the architecture is part of the state root
+	root := w.st.Root()
+	m.Cfg.Arch = ArchQwen3
+	if w.st.Root() == root {
+		t.Fatal("the state root does not commit the architecture")
+	}
+	m.Cfg.Arch = ArchLlama
+}
