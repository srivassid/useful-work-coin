+func (r *reader) outProofs(rs []StageReveal) {
+	if len(r.b) == 0 || r.err != nil {
+		return
+	}
+	n := r.uvar(uint64(len(rs)))
+	if n == 0 {
+		r.err = errDecode // an empty list is not encoded
+		return
+	}
+	last := -1
+	for k := 0; k < n && r.err == nil; k++ {
+		i := r.uvar(uint64(len(rs) - 1))
+		if i <= last {
+			r.err = errDecode
+			return
+		}
+		last = i
+		d := r.uvar(maxProofDepth)
+		if d == 0 {
+			r.err = errDecode
+			return
+		}
+		for j := 0; j < d && r.err == nil; j++ {
+			rs[i].OutProof = append(rs[i].OutProof, r.hash())
+		}
+	}
+}
