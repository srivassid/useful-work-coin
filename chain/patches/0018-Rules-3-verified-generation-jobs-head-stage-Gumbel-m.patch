diff --git a/node/jobstate/types.go b/node/jobstate/types.go
index d5f38218..208b9ac3 100644
--- a/node/jobstate/types.go
+++ b/node/jobstate/types.go
@@ -191,6 +191,17 @@ type Model struct {
 	RotationBlock uint32
 	Bond          Amount
 	Cfg           ModelCfg // architecture: fixes every stage program and the dispute referee
+	Gen           bool     // Rules >= 3: the weights tree also commits the final norm and lm_head (generation jobs)
+}
+
+// NumWeights is the number of rows of the model's weights tree.
+func (m *Model) NumWeights() int {
+	c := m.Cfg
+	n := c.V + c.L*(4+(c.H+2*c.Hkv)*c.Hd+c.D+2*c.I+c.D) + 2*c.MaxPos
+	if m.Gen {
+		n += 1 + c.V
+	}
+	return n
 }
 
 // Verifier is one committee seat on a job.
@@ -217,11 +228,13 @@ type Challenge struct {
 }
 
 // StageReveal is one opened stage: its output root, salt and Merkle path in StageRoot.
+// OutProof (a generation job's head stage, Rules >= 3) is the root's path in the job's output root.
 type StageReveal struct {
-	Stage uint32
-	Salt  Hash
-	Root  Hash
-	Proof []Hash
+	Stage    uint32
+	Salt     Hash
+	Root     Hash
+	Proof    []Hash
+	OutProof []Hash
 }
 
 // Job is one escrowed batch-inference job.
@@ -270,6 +283,27 @@ type Job struct {
 	Directed    AccountID // the only provider that may accept (zero: any)
 	Caught      bool      // failed with a known stage: a game or an unserved stage input
 	CaughtStage uint32    // the stage the provider was caught on (forced-error jackpots need the decoy's wrong stage)
+
+	// Rules >= 3 (encoded only when set)
+	Gen       bool   // a generation job: each batch has a head stage after its layer groups
+	TempMilli uint32 // its sampling temperature in thousandths (0: greedy); the seed is the job id
+}
+
+// StagesPerBatch is the number of stages of each batch: the layer groups, plus the head stage
+// of a generation job.
+func (j *Job) StagesPerBatch(m *Model) int {
+	if j.Gen {
+		return int(m.LayerGroups) + 1
+	}
+	return int(m.LayerGroups)
+}
+
+// GenSpec is the job's sampling, for its head stages (nil for other jobs).
+func (j *Job) GenSpec() *GenSpec {
+	if !j.Gen {
+		return nil
+	}
+	return &GenSpec{TempMilli: j.TempMilli, Key: GumbelKey(j.ID)}
 }
 
 // IsPool reports whether the job is a public-good pool unit.
