diff --git a/node/jobstate/program_gen.go b/node/jobstate/program_gen.go
new file mode 100644
index 00000000..01acaab0
--- /dev/null
+++ b/node/jobstate/program_gen.go
@@ -0,0 +1,272 @@
+package jobstate
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"math"
+)
+
+// Generation jobs (Rules >= 3): runtime/detgen/head.py is the reference.
+//
+// A generation batch is one sequence of the job's SeqLen T. Its input row holds the prompt, then
+// GenSentinel for every generated position. Each batch has its layer-group stages, then one head
+// stage: for every position t in [0, T-2], HN (final norm of the last layer's R2 row), HQ (lm_head
+// activation quantization), per vocabulary chunk c an HL row (the chunk's scores) and an HC row
+// (its best [token, score]), and HS (the sample [token, score], the stage's output rows). Token
+// t+1 >= P of the sequence is HS(t).token; layer stage 0 reads it from the head stage's outputs.
+// The sampling seed is the job id; the temperature is Job.TempMilli / 1000 (0: greedy).
+
+const (
+	LHN uint8 = 100 + iota // head ops (op codes of runtime/detgen/head.py)
+	LHQ
+	LHL
+	LHC
+	LHS
+)
+
+const (
+	VChunk      = 1024       // vocabulary chunk of an HL / HC leaf
+	GenSentinel = 0xFFFFFFFF // input-row marker of a generated position
+	MaxTempMilli = 4000
+)
+
+// GenSpec is the sampling of a generation job.
+type GenSpec struct {
+	TempMilli uint32
+	Key       uint64 // GumbelKey(job id)
+}
+
+func isHeadOp(op uint8) bool { return op >= LHN && op <= LHS }
+
+func (c ModelCfg) vocabChunks() int { return (c.V + VChunk - 1) / VChunk }
+
+func (c ModelCfg) chunkWidth(ch int) int { return min(VChunk, c.V-ch*VChunk) }
+
+// HeadProgram is the leaf list of a head stage over a sequence of T tokens.
+func HeadProgram(c ModelCfg, T int) []LeafDesc {
+	nc := c.vocabChunks()
+	out := make([]LeafDesc, 0, (T-1)*(3+2*nc))
+	for t := 0; t < T-1; t++ {
+		out = append(out, LeafDesc{LHN, c.L, t, -1}, LeafDesc{LHQ, c.L, t, -1})
+		for ch := 0; ch < nc; ch++ {
+			out = append(out, LeafDesc{LHL, c.L, t, ch}, LeafDesc{LHC, c.L, t, ch})
+		}
+		out = append(out, LeafDesc{LHS, c.L, t, -1})
+	}
+	return out
+}
+
+func (c ModelCfg) headRowLen(d LeafDesc) int {
+	switch d.Op {
+	case LHN:
+		return c.D
+	case LHQ:
+		return c.D + 1
+	case LHL:
+		if d.H < 0 || d.H >= c.vocabChunks() {
+			return 0
+		}
+		return c.chunkWidth(d.H)
+	case LHC, LHS:
+		return 2
+	}
+	return 0
+}
+
+// ---------------------------------------------------------------- stage-shape helpers
+
+// Program is the stage's leaf list (a layer-group stage or a head stage).
+func (st Stage) Program() []LeafDesc {
+	if st.Head {
+		return HeadProgram(st.Cfg, st.T)
+	}
+	return Program(st.Cfg, st.T, st.L0, st.L1)
+}
+
+// RowLen is the number of words of leaf d's row in this stage.
+func (st Stage) RowLen(d LeafDesc) int {
+	if st.Head {
+		if !isHeadOp(d.Op) || d.T < 0 || d.T >= st.T-1 {
+			return 0
+		}
+		return st.Cfg.headRowLen(d)
+	}
+	return st.Cfg.RowLen(d, st.T)
+}
+
+// NumOutputs is the number of the stage's output rows (its committed root's leaves).
+func (st Stage) NumOutputs() int {
+	if st.Head {
+		return st.T - 1
+	}
+	return st.T
+}
+
+func (st Stage) isOutput(d LeafDesc) bool {
+	if st.Head {
+		return d.Op == LHS
+	}
+	return isOutput(d, st.L1)
+}
+
+// Split returns the stage's body leaves (program order, outputs removed), the program index of
+// each body leaf and of each output row.
+func (st Stage) Split(prog []LeafDesc) (body []LeafDesc, bodyAt []int, outAt []int) {
+	for i, d := range prog {
+		if st.isOutput(d) {
+			outAt = append(outAt, i)
+		} else {
+			body = append(body, d)
+			bodyAt = append(bodyAt, i)
+		}
+	}
+	return
+}
+
+// TraceCommit is SplitProgram + TraceCommit for any stage.
+func (st Stage) TraceCommit(prog []LeafDesc, rows [][]uint32) (bodyLeaves, outLeaves []Hash, commit Hash) {
+	_, bodyAt, outAt := st.Split(prog)
+	for bi, pi := range bodyAt {
+		bodyLeaves = append(bodyLeaves, TraceLeaf(bi, RowRoot(rows[pi])))
+	}
+	for t, pi := range outAt {
+		outLeaves = append(outLeaves, StageOutLeaf(t, RowRoot(rows[pi])))
+	}
+	return bodyLeaves, outLeaves, nodeHash(MerkleRoot(bodyLeaves), MerkleRoot(outLeaves))
+}
+
+// GenOutLeaf is the leaf of batch b in a generation job's output root: its head output root.
+func GenOutLeaf(b int, headRoot Hash) Hash {
+	var x [4 + 4 + 32]byte
+	copy(x[:4], "gout")
+	binary.LittleEndian.PutUint32(x[4:8], uint32(b))
+	copy(x[8:], headRoot[:])
+	return leafHash(x[:])
+}
+
+// ---------------------------------------------------------------- sampling
+
+// GumbelKey is the noise key of a job: the first 8 bytes (big-endian) of sha256("uwc-gumbel" || seed).
+func GumbelKey(seed Hash) uint64 {
+	h := sha256.Sum256(append([]byte("uwc-gumbel"), seed[:]...))
+	return binary.BigEndian.Uint64(h[:8])
+}
+
+func mix64(x uint64) uint64 {
+	x ^= x >> 30
+	x *= 0xBF58476D1CE4E5B9
+	x ^= x >> 27
+	x *= 0x94D049BB133111EB
+	return x ^ (x >> 31)
+}
+
+// gumbelU is the uniform u(t, v): an odd multiple of 2^-24 in (0, 1), exact in float32.
+func gumbelU(key uint64, t, v int) float32 {
+	x := mix64(key ^ mix64(uint64(t)<<32|uint64(uint32(v))))
+	return float32(float64((x>>41)*2+1) * 0x1p-24)
+}
+
+func gumbel(key uint64, t, v int) float32 {
+	return -detLog(-detLog(gumbelU(key, t, v)))
+}
+
+// detLog is runtime/detrt/core.py det_log: x = m 2^e, m in [1, 2), log m = 2 atanh((m-1)/(m+1)).
+func detLog(x float32) float32 {
+	fr, e := math.Frexp(float64(x)) // fr in [0.5, 1), exact for a float32
+	m := fmul(float32(fr), 2)
+	ef := float32(e - 1)
+	s := fdiv(fsub(m, 1), fadd(m, 1))
+	s2 := fmul(s, s)
+	acc := c32(1.0 / 15)
+	for k := 13; k >= 1; k -= 2 {
+		acc = fadd(fmul(acc, s2), c32(1.0/float64(k)))
+	}
+	lm := fmul(fmul(acc, s), 2)
+	return fadd(fmul(ef, c32(0.6931471805599453)), lm)
+}
+
+// score of token v at position t from its logit.
+func (g *GenSpec) score(logit float32, t, v int) float32 {
+	if g == nil || g.TempMilli == 0 {
+		return logit
+	}
+	temp := fdiv(float32(g.TempMilli), 1000)
+	return fadd(fdiv(logit, temp), gumbel(g.Key, t, v))
+}
+
+// firstMax returns the index of the first maximum of scores (the lowest index on ties).
+func firstMax(sc []float32) int {
+	best := 0
+	for i := 1; i < len(sc); i++ {
+		if sc[i] > sc[best] {
+			best = i
+		}
+	}
+	return best
+}
+
+var errNotHead = errors.New("referee: head op outside a head stage")
+
+// headRow recomputes a head stage's row op (HN, HQ, HC, HS).
+func (st Stage) headRow(d LeafDesc, src RowSource) ([]uint32, error) {
+	c := st.Cfg
+	switch d.Op {
+	case LHN:
+		x, err := src.StageInput(d.T)
+		if err != nil {
+			return nil, err
+		}
+		if len(x) != c.D {
+			return nil, errShape
+		}
+		w, err := st.weight(src, "norm", 0, 0, c.D)
+		if err != nil {
+			return nil, err
+		}
+		return words(detRMSNorm(floats(x), floats(w), c.Eps)), nil
+	case LHQ:
+		r, err := st.need(src, LeafDesc{LHN, c.L, d.T, -1}, c.D)
+		if err != nil {
+			return nil, err
+		}
+		q, s := quantAct(floats(r), st.bsFor(c.D))
+		return qwords(q, s), nil
+	case LHC:
+		r, err := st.need(src, LeafDesc{LHL, c.L, d.T, d.H}, c.headRowLen(LeafDesc{Op: LHL, H: d.H}))
+		if err != nil {
+			return nil, err
+		}
+		sc := floats(r)
+		i := firstMax(sc)
+		return []uint32{uint32(d.H*VChunk + i), f32w(sc[i])}, nil
+	case LHS:
+		nc := c.vocabChunks()
+		sc := make([]float32, nc)
+		tok := make([]uint32, nc)
+		for ch := 0; ch < nc; ch++ {
+			r, err := st.need(src, LeafDesc{LHC, c.L, d.T, ch}, 2)
+			if err != nil {
+				return nil, err
+			}
+			tok[ch], sc[ch] = r[0], wf32(r[1])
+		}
+		i := firstMax(sc)
+		return []uint32{tok[i], f32w(sc[i])}, nil
+	}
+	return nil, errNotHead
+}
+
+// headElem recomputes element e of an HL leaf: the score of token chunk*VChunk + e.
+func (st Stage) headElem(d LeafDesc, e int, src RowSource) (uint32, error) {
+	if d.Op != LHL {
+		return 0, errNotHead
+	}
+	c := st.Cfg
+	v := d.H*VChunk + e
+	lg, err := st.linearElem(src, LeafDesc{LHQ, c.L, d.T, -1}, c.D, "lm_head", 0, v)
+	if err != nil {
+		return 0, err
+	}
+	return f32w(st.Gen.score(wf32(lg), d.T, v)), nil
+}
