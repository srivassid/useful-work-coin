+func writeOutProofs(b *bytes.Buffer, uv func(uint64), rs []StageReveal) {
+	n := 0
+	for _, r := range rs {
+		if len(r.OutProof) > 0 {
+			n++
+		}
+	}
+	if n == 0 {
+		return
