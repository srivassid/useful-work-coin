+package jobstate
+
+import (
+	"compress/gzip"
+	"encoding/hex"
+	"encoding/json"
+	"math"
+	"os"
+	"strconv"
+	"testing"
+)
+
+// Generation jobs (Rules 3) against runtime/bench/export_gen_fixture.py: the Go referee reproduces
+// the Python head stage bit for bit, and dispute games on a generation job end with the right
+// party slashed.
+
+type genFixture struct {
+	Gen struct {
+		TempMilli      uint32 `json:"temp_milli"`
+		Seed           string
+		PromptLen      int      `json:"prompt_len"`
+		InputRow       []uint32 `json:"input_row"`
+		Sequence       []uint32
+		LayerGroups    int      `json:"layer_groups"`
+		HeadRows       []string `json:"head_rows"`
+		HeadOutputRoot string   `json:"head_output_root"`
+		Key            string
+		Gumbel         []struct{ T, V int; U, G uint32 }
+		Log            []struct{ X, Y uint32 }
+	}
+}
+
+type genWorld struct {
+	cfg     ModelCfg
+	w       map[WeightRow][]uint32
+	wleaves []Hash
+	wroot   Hash
+	spec    *GenSpec
+	seed    Hash
+	gf      *genFixture
+	T, P    int
+	rows    [3][][]uint32 // stage 0, stage 1, head stage
+	outputs [3][][]uint32
+}
+
+func hash32hex(t *testing.T, s string) Hash {
+	b, err := hex.DecodeString(s)
+	if err != nil || len(b) != 32 {
+		t.Fatalf("bad hash %q", s)
+	}
+	var h Hash
+	copy(h[:], b)
+	return h
+}
+
+func loadGen(t *testing.T) *genWorld {
+	t.Helper()
+	fx, cfg, w := loadFixture(t, "testdata/gen_tiny.json.gz")
+	f, err := os.Open("testdata/gen_tiny.json.gz")
+	if err != nil {
+		t.Skip(err)
+	}
+	defer f.Close()
+	gz, _ := gzip.NewReader(f)
+	var gf genFixture
+	if err := json.NewDecoder(gz).Decode(&gf); err != nil {
+		t.Fatal(err)
+	}
+	m := &Model{Cfg: cfg, Gen: true, LayerGroups: 2}
+	leaves := make([]Hash, m.NumWeights())
+	for k, row := range w {
+		i, n, err := cfg.weightIndex(k)
+		if err != nil || n != len(row) {
+			t.Fatalf("weight %+v: %v len %d want %d", k, err, len(row), n)
+		}
+		leaves[i] = WeightLeaf(i, RowRoot(row))
+	}
+	if len(w) != len(leaves) {
+		t.Fatalf("%d weight rows, the generation tree has %d", len(w), len(leaves))
+	}
+	gw := &genWorld{cfg: cfg, w: w, wleaves: leaves, wroot: MerkleRoot(leaves), gf: &gf, T: len(gf.Gen.Sequence),
+		P: gf.Gen.PromptLen, seed: hash32hex(t, gf.Gen.Seed)}
+	if hex.EncodeToString(gw.wroot[:]) != fx.WeightsRoot {
+		t.Fatal("generation weights root differs from Python")
+	}
+	gw.spec = &GenSpec{TempMilli: gf.Gen.TempMilli, Key: GumbelKey(gw.seed)}
+	gw.rows, gw.outputs = gw.compute(t, gw.w, nil)
+	for si, s := range fx.Stages {
+		for i, r := range gw.rows[si] {
+			if !eqWords(r, dec(t, s.Rows[i])) {
+				t.Fatalf("stage %d leaf %d differs from Python", si, i)
+			}
+		}
+	}
+	return gw
+}
+
+// compute runs the batch's two layer stages and its head stage in Go. corrupt (optional) edits
+// a row right after it is computed (stage, leaf index, row); later rows follow consistently.
+func (gw *genWorld) compute(t *testing.T, w map[WeightRow][]uint32, corrupt func(s, i int, r []uint32)) ([3][][]uint32, [3][][]uint32) {
+	var rows, outs [3][][]uint32
+	stages := gw.stages()
+	var input [][]uint32
+	for s, st := range stages {
+		src := &MemSource{Weights: w, Toks: gw.gf.Gen.Sequence, Input: input, Leaves: map[LeafDesc][]uint32{}}
+		prog := st.Program()
+		rows[s] = make([][]uint32, len(prog))
+		for i, d := range prog {
+			r, err := st.RecomputeRow(d, src)
+			if err != nil {
+				t.Fatalf("stage %d leaf %d %+v: %v", s, i, d, err)
+			}
+			if corrupt != nil {
+				corrupt(s, i, r)
+			}
+			src.Leaves[d] = r
+			rows[s][i] = r
+		}
+		_, _, outAt := st.Split(prog)
+		for _, pi := range outAt {
+			outs[s] = append(outs[s], rows[s][pi])
+		}
+		input = outs[s]
+	}
+	return rows, outs
+}
+
+func (gw *genWorld) stages() []Stage {
+	c, T := gw.cfg, gw.T
+	return []Stage{{Cfg: c, T: T, L0: 0, L1: 1}, {Cfg: c, T: T, L0: 1, L1: 2},
+		{Cfg: c, T: T, L0: c.L, L1: c.L, Head: true, Gen: gw.spec}}
+}
+
+func TestGenRefereeMatchesPython(t *testing.T) {
+	gw := loadGen(t)
+	g := gw.gf.Gen
+	if k, _ := strconv.ParseUint(g.Key, 10, 64); k != gw.spec.Key {
+		t.Fatalf("gumbel key %d, Python %s", gw.spec.Key, g.Key)
+	}
+	for _, v := range g.Gumbel {
+		if u := gumbelU(gw.spec.Key, v.T, v.V); math.Float32bits(u) != v.U {
+			t.Fatalf("u(%d, %d) = %08x, Python %08x", v.T, v.V, math.Float32bits(u), v.U)
+		}
+		if x := gumbel(gw.spec.Key, v.T, v.V); math.Float32bits(x) != v.G {
+			t.Fatalf("g(%d, %d) = %08x, Python %08x", v.T, v.V, math.Float32bits(x), v.G)
+		}
+	}
+	for _, l := range g.Log {
+		if y := detLog(math.Float32frombits(l.X)); math.Float32bits(y) != l.Y {
+			t.Fatalf("detLog(%v) = %08x, Python %08x", math.Float32frombits(l.X), math.Float32bits(y), l.Y)
+		}
+	}
+	if len(gw.rows[2]) != len(g.HeadRows) {
+		t.Fatalf("head stage: %d leaves, Python %d", len(gw.rows[2]), len(g.HeadRows))
+	}
+	prog := gw.stages()[2].Program()
+	for i, r := range gw.rows[2] {
+		if !eqWords(r, dec(t, g.HeadRows[i])) {
+			t.Fatalf("head leaf %d %+v differs from Python", i, prog[i])
+		}
+	}
+	if hr := StageOutputRoot(gw.outputs[2]); hex.EncodeToString(hr[:]) != g.HeadOutputRoot {
+		t.Fatal("head output root differs from Python")
+	}
+	for t2 := gw.P - 1; t2 < gw.T-1; t2++ { // the sequence follows the samples
+		if gw.outputs[2][t2][0] != g.Sequence[t2+1] {
+			t.Fatalf("token %d is not the sample of position %d", t2+1, t2)
+		}
+	}
+}
+
+// ---------------------------------------------------------------- games on a generation job
+
+type genGame struct {
+	gw         *genWorld
+	s          *State
+	p          Params
+	j          *Job
+	m          *Model
+	prov, chal AccountID
+	salts      [3]Hash
+	stageLv    []Hash
+	inputLv    []Hash
+}
+
+// newGenJob puts a committed generation job (one batch, the honest outputs) into a fresh state.
+func newGenJob(t *testing.T, gw *genWorld, provRows, provOuts [3][][]uint32) *genGame {
+	g := &genGame{gw: gw, s: NewState(), p: DefaultParams(), prov: acct(901), chal: acct(902)}
+	g.p.Rules = 3
+	g.m = &Model{ID: Hash{7}, WeightsRoot: gw.wroot, LayerGroups: 2, RotationBlock: uint32(gw.cfg.Bs), Cfg: gw.cfg, Gen: true}
+	g.s.Models[g.m.ID] = g.m
+	g.inputLv = []Hash{TokenLeaf(0, RowRoot(gw.gf.Gen.InputRow))}
+	for i := range g.salts {
+		g.salts[i] = Hash{byte(i + 1)}
+		g.stageLv = append(g.stageLv, StageLeaf(uint32(i), g.salts[i], StageOutputRoot(provOuts[i])))
+	}
+	headRoot := StageOutputRoot(provOuts[2])
+	g.j = &Job{ID: gw.seed, Client: acct(900), Provider: g.prov, Model: g.m.ID, InputRoot: MerkleRoot(g.inputLv),
+		Stages: 3, K: 2, N: 2, Fee: 1_000_000, Bond: 500_000, Status: StatusDisputed, SeqLen: uint32(gw.T),
+		StageRoot: MerkleRoot(g.stageLv), OutputRoot: MerkleRoot([]Hash{GenOutLeaf(0, headRoot)}),
+		Gen: true, TempMilli: gw.spec.TempMilli, ChallengeEnd: 1000}
+	g.s.Jobs[g.j.ID] = g.j
+	return g
+}
+
+func (g *genGame) reveal(s int, outs [3][][]uint32) StageReveal {
+	r := StageReveal{Stage: uint32(s), Salt: g.salts[s], Root: StageOutputRoot(outs[s]), Proof: MerkleProof(g.stageLv, s)}
+	if s == 2 {
+		r.OutProof = MerkleProof([]Hash{GenOutLeaf(0, r.Root)}, 0)
+	}
+	return r
+}
+
+// play sets up the last round of a game on (stage, leaf, element) with the provider's and the
+// challenger's words, lets the provider prove its value, and reports whether it was slashed.
+func (g *genGame) play(t *testing.T, stage, leaf, elem int, pRows, pOuts [3][][]uint32, cWord uint32,
+	tamper func(o *Op)) (slashed bool, err error) {
+	t.Helper()
+	gw := g.gw
+	st := gw.stages()[stage]
+	prog := st.Program()
+	body, _, _ := st.TraceCommit(prog, pRows[stage])
+	g.j.Disputes = []Challenge{{Challenger: g.chal, Stage: uint32(stage), Bond: 100_000}}
+	g.j.Game = &Game{Stage: uint32(stage), Phase: GOneStep, Leaf: leaf, Elem: elem, PWord: pRows[stage][leaf][elem],
+		CWord: cWord, PB: MerkleRoot(body), NB: len(body), Deadline: 50}
+	g.j.Status = StatusDisputed
+	in := OneStepInput{Cfg: gw.cfg, LayerGroups: 2, Stage: uint32(stage), Leaf: leaf, Elem: elem, Rows: pRows[stage],
+		Tokens: gw.gf.Gen.Sequence, InputLeaves: g.inputLv, StageLeaves: g.stageLv, Weights: genWeights{gw},
+		Gen: gw.spec, InputRow: gw.gf.Gen.InputRow, HeadOutputs: pOuts[2]}
+	if stage > 0 {
+		in.PrevOutputs = pOuts[stage-1]
+		r := g.reveal(stage-1, pOuts)
+		in.PrevReveal = &r
+	}
+	if stage == 0 {
+		r := g.reveal(2, pOuts)
+		in.HeadReveal = &r
+	}
+	o, _, err := BuildOneStep(in)
+	if err != nil {
+		t.Fatalf("build one-step: %v", err)
+	}
+	if tamper != nil {
+		tamper(o)
+	}
+	o.Actor, o.Job = g.prov, g.j.ID
+	op, err := DecodeOp(o.Encode()) // the wire format carries every field
+	if err != nil {
+		t.Fatalf("encoding: %v", err)
+	}
+	op.Actor = g.prov
+	g.j.Revealed = nil
+	if err := g.s.oneStep(g.p, 10, g.j, op); err != nil {
+		return false, err
+	}
+	return g.j.Status == StatusFailed, nil
+}
+
+type genWeights struct{ gw *genWorld }
+
+func (w genWeights) Row(r WeightRow) ([]uint32, error) {
+	row, ok := w.gw.w[r]
+	if !ok {
+		return nil, errShape
+	}
+	return row, nil
+}
+func (w genWeights) Leaves() []Hash { return w.gw.wleaves }
+
+// leafIndex finds the program index of the first leaf with op (and position t).
+func leafIndex(prog []LeafDesc, op uint8, t, h int) int {
+	for i, d := range prog {
+		if d.Op == op && d.T == t && (h < 0 || d.H == h) {
+			return i
+		}
+	}
+	return -1
+}
+
+func TestGenGames(t *testing.T) {
+	gw := loadGen(t)
+	honest := func() (*genGame, [3][][]uint32, [3][][]uint32) {
+		return newGenJob(t, gw, gw.rows, gw.outputs), gw.rows, gw.outputs
+	}
+	head := gw.stages()[2].Program()
+	pos := gw.P + 2 // a generated position
+	hl := leafIndex(head, LHL, pos, 1)
+	hc := leafIndex(head, LHC, pos, 1)
+	hs := leafIndex(head, LHS, pos, -1)
+
+	t.Run("honest provider, lying challenger: head score", func(t *testing.T) {
+		g, r, o := honest()
+		slashed, err := g.play(t, 2, hl, 5, r, o, r[2][hl][5]^1, nil)
+		if err != nil || slashed {
+			t.Fatalf("an honest provider lost (err %v)", err)
+		}
+	})
+	for _, c := range []struct {
+		name       string
+		leaf, elem int
+	}{{"head score", hl, 7}, {"chunk best token", hc, 0}, {"sample", hs, 1}} {
+		t.Run("lying provider: "+c.name, func(t *testing.T) {
+			pr, po := gw.compute(t, gw.w, func(s, i int, row []uint32) {
+				if s == 2 && i == c.leaf {
+					row[c.elem] ^= 1
+				}
+			})
+			g := newGenJob(t, gw, pr, po)
+			slashed, err := g.play(t, 2, c.leaf, c.elem, pr, po, gw.rows[2][c.leaf][c.elem], nil)
+			if err != nil || !slashed {
+				t.Fatalf("a lying provider was not slashed (err %v)", err)
+			}
+		})
+	}
+	// layer stage 0 at a generated position reads its token from the head stage's samples
+	s0 := gw.stages()[0].Program()
+	emb := leafIndex(s0, LEmbed, pos+1, -1)
+	t.Run("honest provider: a generated token's embedding", func(t *testing.T) {
+		g, r, o := honest()
+		slashed, err := g.play(t, 0, emb, 3, r, o, r[0][emb][3]^1, nil)
+		if err != nil || slashed {
+			t.Fatalf("an honest provider lost (err %v)", err)
+		}
+	})
+	t.Run("lying provider: embeds a token other than its sample", func(t *testing.T) {
+		other := gw.gf.Gen.Sequence[pos+1] ^ 3
+		wrong := gw.w[WeightRow{"embed", 0, int(other)}]
+		pr, po := gw.compute(t, gw.w, func(s, i int, row []uint32) {
+			if s == 0 && i == emb {
+				copy(row, wrong)
+			}
+		})
+		g := newGenJob(t, gw, pr, po)
+		slashed, err := g.play(t, 0, emb, 3, pr, po, gw.rows[0][emb][3], nil)
+		if err != nil || !slashed {
+			t.Fatalf("an inconsistent provider was not slashed (err %v)", err)
+		}
+	})
+	t.Run("a head stage needs its path in the output root", func(t *testing.T) {
+		g, r, o := honest()
+		_, err := g.play(t, 0, emb, 3, r, o, r[0][emb][3]^1, func(op *Op) {
+			for i := range op.Reveals {
+				if op.Reveals[i].Stage == 2 {
+					op.Reveals[i].OutProof = []Hash{{9}}
+				}
+			}
+		})
+		if err == nil || err.Error() != "a head stage must open with its path in the job's output root" {
+			t.Fatalf("a head stage opened without its output-root path (err %v)", err)
+		}
+	})
+	t.Run("a prompt token cannot be replaced", func(t *testing.T) {
+		g, r, o := honest()
+		pe := leafIndex(s0, LEmbed, 2, -1)
+		_, err := g.play(t, 0, pe, 3, r, o, r[0][pe][3]^1, func(op *Op) {
+			op.Inputs = append(op.Inputs, ProvenRow{Kind: RowGenToken, Index: 2, Words: o[2][1],
+				Proof: MerkleProof(func() []Hash {
+					var l []Hash
+					for i, x := range o[2] {
+						l = append(l, StageOutLeaf(i, RowRoot(x)))
+					}
+					return l
+				}(), 1)})
+			op.Reveals = append(op.Reveals, g.reveal(2, o))
+		})
+		if err == nil || err.Error() != "a prompt token is not generated" {
+			t.Fatalf("a generated-token row replaced a prompt token (err %v)", err)
+		}
+	})
+}
+
+func TestGenOpsWireFormat(t *testing.T) {
+	post := &Op{Kind: OpJobPost, Model: Hash{1}, H1: Hash{2}, U1: 6, Amount: 5, Deadline: 9, K: 2, N: 2, U2: 32}
+	base := post.Encode()
+	for _, o := range []*Op{
+		{Kind: OpJobPost, Model: Hash{1}, H1: Hash{2}, U1: 6, Amount: 5, Deadline: 9, K: 2, N: 2, U2: 32, Gen: true, TempMilli: 700},
+		{Kind: OpJobPost, Model: Hash{1}, H1: Hash{2}, U1: 6, Amount: 5, Deadline: 9, K: 2, N: 2, U2: 32, Gen: true, Provider: acct(3)},
+		{Kind: OpModelReg, H1: Hash{4}, U1: 2, U2: 64, Cfg: ModelCfg{D: 8, H: 2, Hkv: 1, Hd: 4, I: 8, L: 2, V: 16, Bs: 64, MaxPos: 8}, Gen: true},
+		{Kind: OpTraceReveal, Job: Hash{5}, Reveals: []StageReveal{{Stage: 1, Proof: []Hash{{6}}}, {Stage: 2, OutProof: []Hash{{7}, {8}}}}},
+	} {
+		d, err := DecodeOp(o.Encode())
+		if err != nil || d.Gen != o.Gen || d.TempMilli != o.TempMilli || d.Provider != o.Provider {
+			t.Fatalf("%v round trip: %v %+v", o.Kind, err, d)
+		}
+		if o.Kind == OpTraceReveal && (len(d.Reveals[0].OutProof) != 0 || len(d.Reveals[1].OutProof) != 2) {
+			t.Fatal("out proofs not attached to their reveals")
+		}
+	}
+	if d, _ := DecodeOp(base); d.Gen || string(post.Encode()) != string(base) {
+		t.Fatal("a job post without generation fields changed its encoding")
+	}
+	j := &Job{ID: Hash{1}, Stages: 3}
+	b0 := encodeJob(j)
+	j.Gen, j.TempMilli = true, 800
+	if got := encodeJob(j); string(got[:len(b0)]) != string(b0) || len(got) != len(b0)+1+4 {
+		t.Fatal("Rules 3 job fields are not a pure suffix")
+	}
+}
+
+func TestGenJobPostRules(t *testing.T) {
+	gw := loadGen(t)
+	w := newPoolWorld(t, 611, 2)
+	cl := acct(940)
+	w.block([]Deposit{{cl, 1e9}}, nil, nil)
+	m := &Model{ID: Hash{0xaa}, WeightsRoot: gw.wroot, LayerGroups: 2, RotationBlock: uint32(gw.cfg.Bs), Cfg: gw.cfg, Gen: true}
+	w.st.Models[m.ID] = m
+	post := func(stages uint32) *Op {
+		return &Op{Kind: OpJobPost, Actor: cl, Model: m.ID, H1: w.randHash(), U1: stages, Amount: 1_000_000,
+			Deadline: w.h + 60, K: 2, N: 2, U2: uint32(gw.T), Gen: true, TempMilli: 800}
+	}
+	if r := w.block(nil, []*Op{post(3)}, nil); r.OpErrors[0] == nil {
+		t.Fatal("a generation job was accepted before Rules 3")
+	}
+	w.p.Rules = 3
+	if r := w.block(nil, []*Op{post(2)}, nil); r.OpErrors[0] == nil {
+		t.Fatal("a generation job without head stages was accepted")
+	}
+	o := post(6) // two batches of (2 layer groups + head)
+	mustOK(t, w.block(nil, []*Op{o}, nil))
+	if j := w.st.Jobs[tagHash("job", o.Ref[:])]; !j.Gen || j.TempMilli != 800 {
+		t.Fatal("generation fields not recorded")
+	}
+}
