+// buildBlockOn builds an empty block on any parent from the parent's job state (side-chain
+// parents have no cached state until the chain validates them), returning the new state.
+func (c *jchain) buildBlockOn(parent *btcutil.Block, ps *jobstate.State) (*btcutil.Block, *jobstate.State) {
+	c.t.Helper()
+	height := parent.Height() + 1
+	subsidy := CalcBlockSubsidy(height, c.chain.chainParams)
+	pool := jobstate.PoolIssuance(c.jp, subsidy)
+	st := ps.Clone()
+	res := jobstate.ApplyBlock(st, c.jp, jobstate.BlockInput{Height: height, PrevHash: jobstate.Hash(*parent.Hash()),
+		Deposits: []jobstate.Deposit{{Account: jobstate.PoolAccount, Amount: pool}}})
+	cbScript, _ := txscript.NewScriptBuilder().AddInt64(int64(height)).AddInt64(time.Now().UnixNano()).Script()
+	cb := wire.NewMsgTx(1)
+	cb.AddTxIn(&wire.TxIn{PreviousOutPoint: *wire.NewOutPoint(&chainhash.Hash{}, wire.MaxPrevOutIndex),
+		Sequence: wire.MaxTxInSequenceNum, SignatureScript: cbScript})
+	cb.AddTxOut(wire.NewTxOut(subsidy-pool, c.miner.script))
+	cb.AddTxOut(wire.NewTxOut(pool, JobDepositScript(jobstate.PoolAccount)))
+	for _, w := range res.Withdrawals {
+		cb.AddTxOut(wire.NewTxOut(w.Amount, w.PkScript))
+	}
+	cb.AddTxOut(wire.NewTxOut(0, JobStateRootScript(res.Root)))
+	all := []*wire.MsgTx{cb}
+	header := wire.BlockHeader{Version: 1, PrevBlock: *parent.Hash(), MerkleRoot: calcMerkleRoot(all),
+		Bits: c.chain.chainParams.PowLimitBits, Timestamp: parent.MsgBlock().BlockHeader().Timestamp.Add(2 * time.Second)}
+	cert, err := SolveBlock(&header, c.chain.chainParams, height)
+	if err != nil {
+		c.t.Fatal(err)
+	}
+	blk := btcutil.NewBlock(&wire.MsgBlock{MsgHeader: wire.MsgHeader{BlockHeader: header,
+		MsgCertificate: wire.MsgCertificate{Certificate: cert}}, Transactions: all})
+	blk.SetHeight(height)
+	return blk, st
+}
