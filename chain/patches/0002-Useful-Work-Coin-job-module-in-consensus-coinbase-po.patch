+func (c *jchain) mustMine(txs ...*wire.MsgTx) {
+	c.t.Helper()
+	if err := c.mine(txs, nil); err != nil {
+		c.t.Fatalf("block rejected: %v", err)
+	}
+}
+
+var jkeys = map[jobstate.AccountID]jkey{}
+
+func (c *jchain) keys() []jkey {
+	out := []jkey{c.miner}
+	for _, k := range jkeys {
+		out = append(out, k)
+	}
+	return out
+}
+
+func (c *jchain) spent(op wire.OutPoint) {
+	for a, list := range c.coins {
+		kept := list[:0]
+		for _, u := range list {
+			if u.op != op {
+				kept = append(kept, u)
+			}
+		}
+		c.coins[a] = kept
+	}
+}
+
+// tx spends one coin of `from` (so `from` authorizes any job op in it), pays the outputs and
+// returns the change to `from`.
+func (c *jchain) tx(from jkey, outs ...*wire.TxOut) *wire.MsgTx {
+	c.t.Helper()
+	coins := c.coins[from.acct]
+	if len(coins) == 0 {
+		c.t.Fatalf("no coins for %v", from.acct)
+	}
+	u := coins[len(coins)-1]
+	tx := wire.NewMsgTx(1)
+	tx.AddTxIn(&wire.TxIn{PreviousOutPoint: u.op, Sequence: wire.MaxTxInSequenceNum})
+	var sum int64
+	for _, o := range outs {
+		tx.AddTxOut(o)
+		sum += o.Value
+	}
+	const fee = 2_000
+	if change := u.value - sum - fee; change > 0 {
+		tx.AddTxOut(wire.NewTxOut(change, from.script))
+	} else if change < 0 {
+		c.t.Fatalf("coin %d too small for %d", u.value, sum)
+	}
+	fetcher := txscript.NewMultiPrevOutFetcher(map[wire.OutPoint]*wire.TxOut{u.op: {Value: u.value, PkScript: from.script}})
+	wit, err := txscript.TaprootWitnessSignature(tx, txscript.NewTxSigHashes(tx, fetcher), 0, u.value, from.script,
+		txscript.SigHashDefault, from.priv)
+	if err != nil {
+		c.t.Fatal(err)
+	}
+	tx.TxIn[0].SetWitness(wit)
+	c.coins[from.acct] = coins[:len(coins)-1]
+	return tx
+}
+
+func opOut(t *testing.T, o *jobstate.Op) *wire.TxOut {
+	s, err := JobOpScript(o.Encode())
+	if err != nil {
+		t.Fatal(err)
+	}
+	return wire.NewTxOut(0, s)
+}
+
+func (c *jchain) state() *jobstate.State {
+	c.t.Helper()
+	st, err := c.chain.JobStateAtTip()
+	if err != nil {
+		c.t.Fatal(err)
+	}
+	return st
+}
