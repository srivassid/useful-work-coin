+package mining
+
+import (
+	"testing"
+
+	"github.com/pearl-research-labs/pearl/node/blockchain"
+	"github.com/pearl-research-labs/pearl/node/btcutil"
+	"github.com/pearl-research-labs/pearl/node/chaincfg"
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+	"github.com/stretchr/testify/require"
+)
+
+// TestNewBlockTemplateJobModule mines a UWC SimNet chain from the production template
+// generator: every template must carry the pool deposit and the job-state commitment and
+// pass CheckConnectBlockTemplate (run inside NewBlockTemplate), then connect to the chain.
+func TestNewBlockTemplateJobModule(t *testing.T) {
+	params := chaincfg.UWCSimNetParams
+	g := newTestGenerator(t, &params)
+	var pool int64
+	for i := 0; i < 12; i++ {
+		tmpl, err := g.NewBlockTemplate(nil)
+		require.NoError(t, err)
+		msg := tmpl.Block
+		cb := msg.Transactions[0]
+		var deposits, roots int
+		for _, out := range cb.TxOut {
+			tag, data := blockchain.ParseJobOutput(out.PkScript)
+			switch string(tag) {
+			case string(blockchain.JobDepositTag):
+				require.Equal(t, jobstate.PoolAccount[:], data)
+				deposits++
+			case string(blockchain.JobStateRootTag):
+				roots++
+			}
+		}
+		require.Equal(t, 1, deposits, "one pool deposit")
+		require.Equal(t, 1, roots, "one state commitment")
+		height := tmpl.Height
+		cert, err := blockchain.SolveBlock(&msg.MsgHeader.BlockHeader, &params, height)
+		require.NoError(t, err)
+		msg.MsgHeader.MsgCertificate.Certificate = cert
+		blk := btcutil.NewBlock(msg)
+		isMain, _, err := g.chain.ProcessBlock(blk, blockchain.BFNone)
+		require.NoError(t, err)
+		require.True(t, isMain)
+		pool += jobstate.PoolIssuance(*params.JobModule, blockchain.CalcBlockSubsidy(height, &params))
+	}
+	st, err := g.chain.JobStateAtTip()
+	require.NoError(t, err)
+	require.Equal(t, pool, st.Accounts[jobstate.PoolAccount])
+	require.Equal(t, st.TotalIn-st.PaidOut, st.Holdings())
+}
