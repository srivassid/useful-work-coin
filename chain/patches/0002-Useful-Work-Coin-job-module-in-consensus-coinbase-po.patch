+package blockchain
+
+import (
+	"crypto/sha256"
+	"errors"
+	"testing"
+	"time"
+
+	"github.com/pearl-research-labs/pearl/node/btcec"
+	"github.com/pearl-research-labs/pearl/node/btcutil"
+	"github.com/pearl-research-labs/pearl/node/chaincfg"
+	"github.com/pearl-research-labs/pearl/node/chaincfg/chainhash"
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+	"github.com/pearl-research-labs/pearl/node/txscript"
+	"github.com/pearl-research-labs/pearl/node/wire"
+)
+
+// ---------------------------------------------------------------- harness
+
+type jkey struct {
+	priv   *btcec.PrivateKey
+	script []byte
+	acct   jobstate.AccountID
+}
+
+func newJKey(i byte) jkey {
+	priv, _ := btcec.PrivKeyFromBytes([]byte{i, 0x55, 0xaa})
+	script, _ := txscript.PayToTaprootScript(txscript.ComputeTaprootKeyNoScript(priv.PubKey()))
+	return jkey{priv, script, jobstate.AccountForScript(script)}
+}
+
+type jutxo struct {
+	op    wire.OutPoint
+	value int64
+	key   jkey
+}
+
+type jchain struct {
+	t     *testing.T
+	chain *BlockChain
+	tip   *btcutil.Block
+	miner jkey
+	coins map[jobstate.AccountID][]jutxo
+	jp    jobstate.Params
+}
+
+func uwcTestParams() *chaincfg.Params {
+	p := chaincfg.UWCSimNetParams
+	jp := *p.JobModule
+	jp.ChallengeWindow, jp.DisputeTimeout, jp.WithdrawDelay, jp.UnbondDelay = 4, 6, 3, 5
+	jp.VerifyCommitWindow, jp.VerifyRevealWindow, jp.ProviderRevealWindow = 3, 3, 3
+	p.JobModule = &jp
+	return &p
+}
+
+func newJChain(t *testing.T) (*jchain, func()) {
+	params := uwcTestParams()
+	chain, teardown, err := chainSetup("jobmodule", params)
+	if err != nil {
+		t.Fatal(err)
+	}
+	chain.TstSetCoinbaseMaturity(1)
+	genesis := btcutil.NewBlock(params.GenesisBlock)
+	genesis.SetHeight(0)
+	return &jchain{t: t, chain: chain, tip: genesis, miner: newJKey(200), coins: map[jobstate.AccountID][]jutxo{},
+		jp: *params.JobModule}, teardown
+}
+
+// buildBlock assembles a block on the tip: coinbase with the job template's outputs, then txs.
+// mutate may tamper with the coinbase (negative tests).
+func (c *jchain) buildBlock(txs []*wire.MsgTx, mutate func(cb *wire.MsgTx, tpl *JobTemplate)) *btcutil.Block {
+	c.t.Helper()
+	height := c.tip.Height() + 1
+	utx := make([]*btcutil.Tx, len(txs))
+	for i, tx := range txs {
+		utx[i] = btcutil.NewTx(tx)
+	}
+	tpl, err := c.chain.JobTemplateFor(utx, nil)
+	if err != nil {
+		c.t.Fatal(err)
+	}
+	subsidy := CalcBlockSubsidy(height, c.chain.chainParams)
+	cbScript, _ := txscript.NewScriptBuilder().AddInt64(int64(height)).AddInt64(time.Now().UnixNano()).Script()
+	cb := wire.NewMsgTx(1)
+	cb.AddTxIn(&wire.TxIn{PreviousOutPoint: *wire.NewOutPoint(&chainhash.Hash{}, wire.MaxPrevOutIndex),
+		Sequence: wire.MaxTxInSequenceNum, SignatureScript: cbScript})
+	cb.AddTxOut(wire.NewTxOut(subsidy-tpl.PoolDeposit, c.miner.script))
+	cb.AddTxOut(wire.NewTxOut(tpl.PoolDeposit, JobDepositScript(jobstate.PoolAccount)))
+	for _, w := range tpl.Withdrawals {
+		cb.AddTxOut(wire.NewTxOut(w.Amount, w.PkScript))
+	}
+	cb.AddTxOut(wire.NewTxOut(0, JobStateRootScript(tpl.Root)))
+	if mutate != nil {
+		mutate(cb, tpl)
+	}
+	all := append([]*wire.MsgTx{cb}, txs...)
+	if len(txs) > 0 { // Taproot spends carry witnesses: commit them like mining.AddWitnessCommitment
+		ut := make([]*btcutil.Tx, len(all))
+		for i, tx := range all {
+			ut[i] = btcutil.NewTx(tx)
+		}
+		addTestWitnessCommitment(ut)
+	}
+	header := wire.BlockHeader{Version: 1, PrevBlock: *c.tip.Hash(), MerkleRoot: calcMerkleRoot(all),
+		Bits: c.chain.chainParams.PowLimitBits, Timestamp: c.tip.MsgBlock().BlockHeader().Timestamp.Add(time.Second)}
+	if height == 1 {
+		header.Timestamp = time.Unix(time.Now().Unix(), 0)
+	}
+	cert, err := SolveBlock(&header, c.chain.chainParams, height)
+	if err != nil {
+		c.t.Fatal(err)
+	}
+	blk := btcutil.NewBlock(&wire.MsgBlock{MsgHeader: wire.MsgHeader{BlockHeader: header,
+		MsgCertificate: wire.MsgCertificate{Certificate: cert}}, Transactions: all})
+	blk.SetHeight(height)
+	return blk
+}
+
+// mine processes a block and, if accepted onto the main chain, tracks its spendable outputs.
+func (c *jchain) mine(txs []*wire.MsgTx, mutate func(*wire.MsgTx, *JobTemplate)) error {
+	c.t.Helper()
+	blk := c.buildBlock(txs, mutate)
+	isMain, _, err := c.chain.ProcessBlock(blk, BFNone)
+	if err != nil {
+		return err
+	}
+	if !isMain {
+		return errors.New("block not on main chain")
+	}
+	c.tip = blk
+	for _, tx := range blk.Transactions() {
+		for _, in := range tx.MsgTx().TxIn {
+			c.spent(in.PreviousOutPoint)
+		}
+		for i, out := range tx.MsgTx().TxOut {
+			for _, k := range c.keys() {
+				if string(out.PkScript) == string(k.script) {
+					c.coins[k.acct] = append(c.coins[k.acct], jutxo{wire.OutPoint{Hash: *tx.Hash(), Index: uint32(i)}, out.Value, k})
+				}
+			}
+		}
+	}
+	return nil
+}
