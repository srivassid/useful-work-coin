+package mempool
+
+import (
+	"testing"
+	"time"
+
+	"github.com/pearl-research-labs/pearl/node/blockchain"
+	"github.com/pearl-research-labs/pearl/node/btcutil"
+	"github.com/pearl-research-labs/pearl/node/chaincfg/chainhash"
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+	"github.com/pearl-research-labs/pearl/node/wire"
+)
+
+func jobPolicyTx(outs ...*wire.TxOut) *btcutil.Tx {
+	tx := wire.NewMsgTx(1)
+	tx.AddTxIn(&wire.TxIn{PreviousOutPoint: wire.OutPoint{Hash: chainhash.Hash{1}}, Sequence: wire.MaxTxInSequenceNum})
+	p2tr := append([]byte{0x51, 0x20}, make([]byte, 32)...)
+	tx.AddTxOut(wire.NewTxOut(100_000, p2tr))
+	for _, o := range outs {
+		tx.AddTxOut(o)
+	}
+	return btcutil.NewTx(tx)
+}
+
+func TestJobOutputsStandardness(t *testing.T) {
+	op := &jobstate.Op{Kind: jobstate.OpStake, Amount: 5}
+	opScript, err := blockchain.JobOpScript(op.Encode())
+	if err != nil {
+		t.Fatal(err)
+	}
+	dep := wire.NewTxOut(50_000, blockchain.JobDepositScript(jobstate.AccountID{7}))
+	check := func(tx *btcutil.Tx) error {
+		return CheckTransactionStandard(tx, 100, time.Now(), DefaultMinRelayTxFee, 1)
+	}
+	if err := check(jobPolicyTx(dep, wire.NewTxOut(0, opScript))); err != nil {
+		t.Fatalf("deposit + op should be standard: %v", err)
+	}
+	if err := check(jobPolicyTx(wire.NewTxOut(0, blockchain.JobStateRootScript(jobstate.Hash{})))); err == nil {
+		t.Fatal("a state commitment outside the coinbase must be non-standard")
+	}
+	plain := wire.NewTxOut(0, []byte{0x6a, 0x01, 0x01})
+	if err := check(jobPolicyTx(plain, wire.NewTxOut(0, []byte{0x6a, 0x01, 0x02}))); err == nil {
+		t.Fatal("two plain OP_RETURN outputs must stay non-standard")
+	}
+	big := make([]byte, 3000) // multi-push op payloads (e.g. TRACE_REVEAL proofs) are allowed
+	bigScript, _ := blockchain.JobOpScript(big)
+	if err := check(jobPolicyTx(wire.NewTxOut(0, bigScript))); err != nil {
+		t.Fatalf("multi-push op payload should be standard: %v", err)
+	}
+}
