+func TestJobModuleConsensus(t *testing.T) {
+	c, teardown := newJChain(t)
+	defer teardown()
+	client, provider := newJKey(1), newJKey(2)
+	vs := []jkey{newJKey(10), newJKey(11), newJKey(12)}
+	for _, k := range append([]jkey{client, provider}, vs...) {
+		jkeys[k.acct] = k
+	}
+
+	// pool issuance is credited every block and the root is committed
+	var pool int64
+	for i := 0; i < 3; i++ {
+		c.mustMine()
+		pool += jobstate.PoolIssuance(c.jp, CalcBlockSubsidy(c.tip.Height(), c.chain.chainParams))
+	}
+	if got := c.state().Accounts[jobstate.PoolAccount]; got != pool || pool == 0 {
+		t.Fatalf("pool balance %d, want %d", got, pool)
+	}
+
+	// coinbase rules: wrong root, short pool deposit, overpaying miner are all rejected
+	expectRule(t, c.mine(nil, func(cb *wire.MsgTx, _ *JobTemplate) {
+		cb.TxOut[len(cb.TxOut)-1].PkScript = JobStateRootScript(jobstate.Hash{1})
+	}), "wrong state root")
+	expectRule(t, c.mine(nil, func(cb *wire.MsgTx, tpl *JobTemplate) {
+		cb.TxOut[0].Value += 1
+		cb.TxOut[1].Value -= 1
+	}), "short pool deposit")
+	expectRule(t, c.mine(nil, func(cb *wire.MsgTx, _ *JobTemplate) { cb.TxOut[0].Value += 1 }), "overpaying coinbase")
+
+	// fund everyone: one P2TR coin each, plus module deposits
+	var outs []*wire.TxOut
+	for _, k := range append([]jkey{client, provider}, vs...) {
+		outs = append(outs, wire.NewTxOut(50_000_000, k.script), wire.NewTxOut(30_000_000, JobDepositScript(k.acct)))
+	}
+	c.mustMine(c.tx(c.miner, outs...))
+	for _, k := range append([]jkey{client, provider}, vs...) {
+		if c.state().Accounts[k.acct] != 30_000_000 {
+			t.Fatalf("deposit not credited to %v", k.acct)
+		}
+	}
+
+	// a withdrawal must be paid by the coinbase exactly at its due height
+	wd := &jobstate.Op{Kind: jobstate.OpWithdraw, Amount: 1_234_567, PkScript: client.script}
+	c.mustMine(c.tx(client, opOut(t, wd)))
+	due := c.tip.Height() + c.jp.WithdrawDelay
+	for c.tip.Height() < due-1 {
+		c.mustMine()
+	}
+	expectRule(t, c.mine(nil, func(cb *wire.MsgTx, tpl *JobTemplate) {
+		if len(tpl.Withdrawals) != 1 {
+			t.Fatalf("template has %d withdrawals", len(tpl.Withdrawals))
+		}
+		cb.TxOut = append(cb.TxOut[:2], cb.TxOut[3:]...) // drop the payout
+	}), "unpaid withdrawal")
+	before := len(c.coins[client.acct])
+	c.mustMine()
+	if len(c.coins[client.acct]) != before+1 || c.coins[client.acct][before].value != 1_234_567 {
+		t.Fatal("withdrawal not paid to the client's script")
+	}
+
+	// stake verifiers, register a model, run one honest job end to end through consensus
+	var stakeTxs []*wire.MsgTx
+	for _, v := range vs {
+		stakeTxs = append(stakeTxs, c.tx(v, opOut(t, &jobstate.Op{Kind: jobstate.OpStake, Amount: c.jp.MinVerifierStake * 2})))
+	}
+	reg := &jobstate.Op{Kind: jobstate.OpModelReg, H1: jobstate.Hash{7}, H2: jobstate.Hash{8}, U1: 2, U2: 512}
+	regTx := c.tx(client, opOut(t, reg))
+	c.mustMine(append(stakeTxs, regTx)...)
+	var model jobstate.Hash
+	for id := range c.state().Models {
+		model = id
+	}
+	const stages, fee = 8, 4_000_000
+	roots, salts, leaves := make([]jobstate.Hash, stages), make([]jobstate.Hash, stages), make([]jobstate.Hash, stages)
+	for i := range roots {
+		roots[i], salts[i] = sha256.Sum256([]byte{byte(i), 1}), sha256.Sum256([]byte{byte(i), 2})
+		leaves[i] = jobstate.StageLeaf(uint32(i), salts[i], roots[i])
+	}
+	post := &jobstate.Op{Kind: jobstate.OpJobPost, Model: model, H1: jobstate.Hash{9}, U1: stages, Amount: fee,
+		Deadline: c.tip.Height() + 30, K: 2, N: 2}
+	c.mustMine(c.tx(client, opOut(t, post)))
+	var job *jobstate.Job
+	for _, j := range c.state().Jobs {
+		job = j
+	}
+	if job == nil || job.Status != jobstate.StatusPosted {
+		t.Fatal("job not posted")
+	}
+	bond := (fee*c.jp.MinBondBP + 9_999) / 10_000
+	c.mustMine(c.tx(provider, opOut(t, &jobstate.Op{Kind: jobstate.OpJobAccept, Job: job.ID, Amount: bond})))
+	c.mustMine(c.tx(provider, opOut(t, &jobstate.Op{Kind: jobstate.OpTraceCommit, Job: job.ID,
+		H1: jobstate.MerkleRoot(leaves), H2: jobstate.Hash{3}})))
+	for c.state().Jobs[job.ID].Status == jobstate.StatusCommitted {
+		c.mustMine()
+	}
+	job = c.state().Jobs[job.ID]
+	if job.Status != jobstate.StatusVerifyCommit || len(job.Committee) != 2 {
+		t.Fatalf("after draw: %v with %d seats", job.Status, len(job.Committee))
+	}
+	vsalt := map[jobstate.AccountID]jobstate.Hash{}
+	var commits []*wire.MsgTx
+	for i, seat := range job.Committee {
+		salt := sha256.Sum256([]byte{byte(i), 9})
+		vsalt[seat.Account] = salt
+		pos := jobstate.Positions(salt, stages, 2)
+		rs := []jobstate.Hash{roots[pos[0]], roots[pos[1]]}
+		commits = append(commits, c.tx(jkeys[seat.Account], opOut(t, &jobstate.Op{Kind: jobstate.OpVerifyCommit, Job: job.ID,
+			H1: sha256.Sum256(salt[:]), H2: jobstate.ResultHash(rs, seat.Account, salt)})))
+	}
+	c.mustMine(commits...)
+	var reveals []*wire.MsgTx
+	want := map[uint32]bool{}
+	for _, seat := range job.Committee {
+		salt := vsalt[seat.Account]
+		pos := jobstate.Positions(salt, stages, 2)
+		want[pos[0]], want[pos[1]] = true, true
+		reveals = append(reveals, c.tx(jkeys[seat.Account], opOut(t, &jobstate.Op{Kind: jobstate.OpVerifyReveal, Job: job.ID,
+			H1: salt, Roots: []jobstate.Hash{roots[pos[0]], roots[pos[1]]}})))
+	}
+	c.mustMine(reveals...)
+	var sr []jobstate.StageReveal
+	for st := range want {
+		sr = append(sr, jobstate.StageReveal{Stage: st, Salt: salts[st], Root: roots[st], Proof: jobstate.MerkleProof(leaves, int(st))})
+	}
+	c.mustMine(c.tx(provider, opOut(t, &jobstate.Op{Kind: jobstate.OpTraceReveal, Job: job.ID, Reveals: sr})))
+	p0 := c.state().Accounts[provider.acct]
+	for c.state().Jobs[job.ID].Status != jobstate.StatusSettled {
+		if c.tip.Height() > post.Deadline+50 {
+			t.Fatalf("job stuck in %v", c.state().Jobs[job.ID].Status)
+		}
+		c.mustMine()
+	}
+	vp, tc := jobstate.JobPay(c.jp, fee, 2, 2)
+	if got := c.state().Accounts[provider.acct] - p0; got != fee-vp-tc+bond {
+		t.Fatalf("provider received %d, want %d", got, fee-vp-tc+bond)
+	}
+
+	// conservation across UTXO set and module is implied by the coinbase rules; check the module side
+	st := c.state()
+	if st.Holdings() != st.TotalIn-st.PaidOut {
+		t.Fatal("module conservation broken on chain")
+	}
+
+	// restart: a fresh BlockChain on the same database reloads the job state from disk
+	chain2, err := New(&Config{DB: c.chain.db, ChainParams: c.chain.chainParams, TimeSource: NewMedianTime(),
+		SigCache: txscript.NewSigCache(10), HashCache: txscript.NewHashCache(10)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	st2, err := chain2.JobStateAtTip()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if st2.Root() != st.Root() {
+		t.Fatal("job state differs after reload from the database")
+	}
+}
+
+func TestJobModuleReorg(t *testing.T) {
+	c, teardown := newJChain(t)
+	defer teardown()
+	v := newJKey(30)
+	jkeys[v.acct] = v
+	c.mustMine()
+	c.mustMine(c.tx(c.miner, wire.NewTxOut(10_000_000, v.script), wire.NewTxOut(5_000_000, JobDepositScript(v.acct))))
+	fork := c.tip // common ancestor
+	forkCoins := map[jobstate.AccountID][]jutxo{}
+	for a, l := range c.coins {
+		forkCoins[a] = append([]jutxo(nil), l...)
+	}
+	// branch A: stake 2M
+	c.mustMine(c.tx(v, opOut(t, &jobstate.Op{Kind: jobstate.OpStake, Amount: 2_000_000})))
+	if c.state().Stakes[v.acct] != 2_000_000 {
+		t.Fatal("stake not applied on branch A")
+	}
+	// branch B from the ancestor: two empty blocks, so it becomes the best chain
+	c.tip, c.coins = fork, forkCoins
+	forkState, err := c.chain.jobStateAfter(fork.Hash())
+	if err != nil {
+		t.Fatal(err)
+	}
+	b1, s1 := c.buildBlockOn(fork, forkState)
+	if _, _, err := c.chain.ProcessBlock(b1, BFNone); err != nil {
+		t.Fatal(err)
+	}
+	b2, _ := c.buildBlockOn(b1, s1)
+	isMain, _, err := c.chain.ProcessBlock(b2, BFNone)
+	if err != nil || !isMain {
+		t.Fatalf("reorg block: main=%v err=%v", isMain, err)
+	}
+	st := c.state()
+	if st.Stakes[v.acct] != 0 || st.Accounts[v.acct] != 5_000_000 {
+		t.Fatalf("after reorg: stake %d balance %d (branch A's stake must be gone)", st.Stakes[v.acct], st.Accounts[v.acct])
+	}
+}
