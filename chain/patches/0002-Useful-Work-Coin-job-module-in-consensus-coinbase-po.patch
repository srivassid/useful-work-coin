+// Useful-Work Coin job module integration (spec/job-module.md).
+//
+// When chainParams.JobModule is non-nil every block must, in its coinbase:
+//   - deposit at least PoolIssuance(subsidy) to the pool account ("UWCD" output),
+//   - commit the job-state root after the block ("UWCS" output, exactly one),
+//   - pay every withdrawal that falls due at this height (exact value and script),
+// and the coinbase may pay out subsidy + fees + due withdrawals in total.
+// Job operations never make a block invalid: a failed op is a no-op.
+
+package blockchain
+
+import (
+	"bytes"
+	"encoding/gob"
+	"fmt"
+	"sync"
+
+	"github.com/pearl-research-labs/pearl/node/btcutil"
+	"github.com/pearl-research-labs/pearl/node/chaincfg/chainhash"
+	"github.com/pearl-research-labs/pearl/node/database"
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+	"github.com/pearl-research-labs/pearl/node/txscript"
+	"github.com/pearl-research-labs/pearl/node/wire"
+)
+
+// Output tags (first push after OP_RETURN).
+var (
+	JobDepositTag     = []byte("UWCD")
+	JobOpTag          = []byte("UWCJ")
+	JobStateRootTag   = []byte("UWCS")
+	jobStateBucket    = []byte("uwcjobstate")
+	maxJobDataPerPush = txscript.MaxScriptElementSize
+)
+
+// JobDepositScript credits the output's value to a module account.
+func JobDepositScript(a jobstate.AccountID) []byte {
+	s, _ := txscript.NewScriptBuilder().AddOp(txscript.OP_RETURN).AddData(JobDepositTag).AddData(a[:]).Script()
+	return s
+}
+
+// JobOpScript carries one encoded job operation, split into pushes of at most 520 bytes.
+func JobOpScript(payload []byte) ([]byte, error) {
+	b := txscript.NewScriptBuilder().AddOp(txscript.OP_RETURN).AddData(JobOpTag)
+	for len(payload) > 0 {
+		n := min(len(payload), maxJobDataPerPush)
+		b.AddFullData(payload[:n])
+		payload = payload[n:]
+	}
+	return b.Script()
+}
+
+// JobStateRootScript is the coinbase commitment to the job-state root.
+func JobStateRootScript(root jobstate.Hash) []byte {
+	s, _ := txscript.NewScriptBuilder().AddOp(txscript.OP_RETURN).AddData(JobStateRootTag).AddData(root[:]).Script()
+	return s
+}
+
+// ParseJobOutput returns the tag and the concatenated data pushes of a job-module output,
+// or nil tag if the script is not one.
+func ParseJobOutput(pkScript []byte) (tag []byte, data []byte) {
+	if len(pkScript) < 6 || pkScript[0] != txscript.OP_RETURN {
+		return nil, nil
+	}
+	tok := txscript.MakeScriptTokenizer(0, pkScript[1:])
+	first := true
+	for tok.Next() {
+		if tok.Opcode() > txscript.OP_PUSHDATA4 {
+			return nil, nil // only data pushes are allowed
+		}
+		if first {
+			t := tok.Data()
+			if !bytes.Equal(t, JobDepositTag) && !bytes.Equal(t, JobOpTag) && !bytes.Equal(t, JobStateRootTag) {
+				return nil, nil
+			}
+			tag, first = t, false
+			continue
+		}
+		data = append(data, tok.Data()...)
+	}
+	if tok.Err() != nil || first {
+		return nil, nil
+	}
+	return tag, data
+}
+
+// ---------------------------------------------------------------- state cache
+
+type jobCache struct {
+	mu     sync.Mutex
+	states map[chainhash.Hash]*jobstate.State
+}
+
+func (c *jobCache) get(h chainhash.Hash) *jobstate.State {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.states[h]
+}
+
+func (c *jobCache) put(h chainhash.Hash, s *jobstate.State) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if c.states == nil {
+		c.states = map[chainhash.Hash]*jobstate.State{}
+	}
+	c.states[h] = s
+}
+
+// jobStateAfter is the job state after block h (empty at genesis). It is read from the
+// in-memory cache, else from the database. The returned state must not be modified.
+func (b *BlockChain) jobStateAfter(h *chainhash.Hash) (*jobstate.State, error) {
+	if h.IsEqual(b.chainParams.GenesisHash) {
+		return jobstate.NewState(), nil
+	}
+	if s := b.jobs.get(*h); s != nil {
+		return s, nil
+	}
+	var st *jobstate.State
+	err := b.db.View(func(dbTx database.Tx) error {
+		bkt := dbTx.Metadata().Bucket(jobStateBucket)
+		if bkt == nil {
+			return nil
+		}
+		raw := bkt.Get(h[:])
+		if raw == nil {
+			return nil
+		}
+		st = jobstate.NewState()
+		return gob.NewDecoder(bytes.NewReader(raw)).Decode(st)
+	})
+	if err != nil {
+		return nil, err
+	}
+	if st == nil {
+		return nil, AssertError(fmt.Sprintf("no job state for block %v", h))
+	}
+	b.jobs.put(*h, st)
+	return st, nil
+}
+
+func dbPutJobState(dbTx database.Tx, h *chainhash.Hash, s *jobstate.State) error {
+	bkt, err := dbTx.Metadata().CreateBucketIfNotExists(jobStateBucket)
+	if err != nil {
+		return err
+	}
+	var buf bytes.Buffer
+	if err := gob.NewEncoder(&buf).Encode(s); err != nil {
+		return err
+	}
+	return bkt.Put(h[:], buf.Bytes())
+}
+
+// ---------------------------------------------------------------- block rules
+
+// jobOpsFromBlock collects deposits and ops in transaction order. It must run before the
+// block's transactions are connected to the view, so the first input's previous output
+// (which authorizes the op) is still there.
+func jobOpsFromBlock(block *btcutil.Block, view *UtxoViewpoint) ([]jobstate.Deposit, []*jobstate.Op) {
+	inBlock := map[chainhash.Hash]*wire.MsgTx{}
+	prevScript := func(_ *btcutil.Tx, op wire.OutPoint) []byte {
+		if tx, ok := inBlock[op.Hash]; ok { // created earlier in this block
+			if int(op.Index) < len(tx.TxOut) {
+				return tx.TxOut[op.Index].PkScript
+			}
+			return nil
+		}
+		if e := view.LookupEntry(op); e != nil {
+			return e.PkScript()
+		}
+		return nil
+	}
+	return extractJobOps(block, prevScript, func(tx *btcutil.Tx) { inBlock[*tx.Hash()] = tx.MsgTx() })
+}
+
+// jobOpsFromStxos does the same for a block already connected, using its spend journal
+// (spent outputs in input order, coinbase excluded).
+func jobOpsFromStxos(block *btcutil.Block, stxos []SpentTxOut) ([]jobstate.Deposit, []*jobstate.Op) {
+	first := map[chainhash.Hash][]byte{}
+	i := 0
+	for _, tx := range block.Transactions()[1:] {
+		if i < len(stxos) {
+			first[*tx.Hash()] = stxos[i].PkScript
+		}
+		i += len(tx.MsgTx().TxIn)
+	}
+	return extractJobOps(block, func(tx *btcutil.Tx, _ wire.OutPoint) []byte { return first[*tx.Hash()] },
+		func(*btcutil.Tx) {})
+}
+
+// extractJobOps walks the block in order. prevScript returns the pkScript spent by a
+// transaction's first input; seen is called after each transaction.
+func extractJobOps(block *btcutil.Block, prevScript func(*btcutil.Tx, wire.OutPoint) []byte,
+	seen func(*btcutil.Tx)) ([]jobstate.Deposit, []*jobstate.Op) {
+	var deps []jobstate.Deposit
+	var ops []*jobstate.Op
+	for ti, tx := range block.Transactions() {
+		var actor *jobstate.AccountID
+		for oi, out := range tx.MsgTx().TxOut {
+			tag, data := ParseJobOutput(out.PkScript)
+			switch {
+			case tag == nil:
+				continue
+			case bytes.Equal(tag, JobDepositTag):
+				if len(data) == 32 && out.Value > 0 {
+					var a jobstate.AccountID
+					copy(a[:], data)
+					deps = append(deps, jobstate.Deposit{Account: a, Amount: out.Value})
+				}
+			case bytes.Equal(tag, JobOpTag):
+				if ti == 0 {
+					continue // the coinbase cannot act: it has no authorizing input
+				}
+				op, err := jobstate.DecodeOp(data)
+				if err != nil {
+					continue
+				}
+				if actor == nil {
+					ps := prevScript(tx, tx.MsgTx().TxIn[0].PreviousOutPoint)
+					if ps == nil {
+						break
+					}
+					a := jobstate.AccountForScript(ps)
+					actor = &a
+				}
+				op.Actor = *actor
+				var ref [36]byte
+				copy(ref[:32], tx.Hash()[:])
+				ref[32], ref[33], ref[34], ref[35] = byte(oi), byte(oi>>8), byte(oi>>16), byte(oi>>24)
+				op.Ref = jobstate.Hash(chainhash.HashH(ref[:]))
+				ops = append(ops, op)
+			}
+		}
+		seen(tx)
+	}
+	return deps, ops
+}
+
+// checkJobRules applies the block to its parent's job state and checks the coinbase. It
+// returns the total of withdrawals paid by this coinbase (allowed on top of subsidy + fees)
+// and caches the resulting state under the block hash.
+func (b *BlockChain) checkJobRules(node *blockNode, block *btcutil.Block, deps []jobstate.Deposit,
+	ops []*jobstate.Op) (int64, error) {
+
+	jp := b.chainParams.JobModule
+	parentState, err := b.jobStateAfter(&node.parent.hash)
+	if err != nil {
+		return 0, err
+	}
+	st := parentState.Clone()
+	res := jobstate.ApplyBlock(st, *jp, jobstate.BlockInput{Height: node.height,
+		PrevHash: jobstate.Hash(node.parent.hash), Deposits: deps, Ops: ops})
+
+	subsidy := CalcBlockSubsidy(node.height, b.chainParams)
+	coinbase := block.Transactions()[0].MsgTx()
+	var pool int64
+	var commits [][]byte
+	for _, out := range coinbase.TxOut {
+		tag, data := ParseJobOutput(out.PkScript)
+		switch {
+		case bytes.Equal(tag, JobDepositTag) && len(data) == 32 && jobstate.AccountID(data) == jobstate.PoolAccount:
+			pool += out.Value
+		case bytes.Equal(tag, JobStateRootTag):
+			commits = append(commits, data)
+		}
+	}
+	if need := jobstate.PoolIssuance(*jp, subsidy); pool < need {
+		return 0, ruleError(ErrBadCoinbaseValue, fmt.Sprintf("coinbase deposits %d to the pool, needs %d", pool, need))
+	}
+	if len(commits) != 1 || !bytes.Equal(commits[0], res.Root[:]) {
+		return 0, ruleError(ErrBadCoinbaseValue, fmt.Sprintf("coinbase must commit job-state root %x", res.Root))
+	}
+	// every due withdrawal must be paid by a distinct coinbase output with that exact value and script
+	used := make([]bool, len(coinbase.TxOut))
+	var total int64
+	for _, w := range res.Withdrawals {
+		found := false
+		for i, out := range coinbase.TxOut {
+			if !used[i] && out.Value == w.Amount && bytes.Equal(out.PkScript, w.PkScript) {
+				used[i], found = true, true
+				break
+			}
+		}
+		if !found {
+			return 0, ruleError(ErrBadCoinbaseValue, fmt.Sprintf("coinbase does not pay due withdrawal %d of %d", w.Seq, w.Amount))
+		}
+		total += w.Amount
+	}
+	b.jobs.put(node.hash, st)
+	return total, nil
+}
+
+// ensureJobState computes the state for a block connected without checkConnectBlock
+// (checkpointed fast-add), from its spend journal. Coinbase rules are not re-checked.
+func (b *BlockChain) ensureJobState(node *blockNode, block *btcutil.Block, stxos []SpentTxOut) (*jobstate.State, error) {
+	if st := b.jobs.get(node.hash); st != nil {
+		return st, nil
+	}
+	parentState, err := b.jobStateAfter(&node.parent.hash)
+	if err != nil {
+		return nil, err
+	}
+	deps, ops := jobOpsFromStxos(block, stxos)
+	st := parentState.Clone()
+	jobstate.ApplyBlock(st, *b.chainParams.JobModule, jobstate.BlockInput{Height: node.height,
+		PrevHash: jobstate.Hash(node.parent.hash), Deposits: deps, Ops: ops})
+	b.jobs.put(node.hash, st)
+	return st, nil
+}
+
+// JobTemplate is what a miner must add to a coinbase for a block with the given
+// non-coinbase transactions on top of the current tip.
+type JobTemplate struct {
+	PoolDeposit int64                 // value of the pool deposit output
+	Withdrawals []jobstate.Withdrawal // outputs to pay
+	Root        jobstate.Hash         // state commitment
+}
+
+// JobTemplateFor evaluates txs (without the coinbase) on top of the tip. extraDeposits are
+// deposit outputs the miner itself puts in the coinbase besides the pool share.
+func (b *BlockChain) JobTemplateFor(txs []*btcutil.Tx, extraDeposits []jobstate.Deposit) (*JobTemplate, error) {
+	jp := b.chainParams.JobModule
+	if jp == nil {
+		return nil, nil
+	}
+	b.chainLock.RLock()
+	defer b.chainLock.RUnlock()
+	tip := b.bestChain.Tip()
+	height := tip.height + 1
+	parentState, err := b.jobStateAfter(&tip.hash)
+	if err != nil {
+		return nil, err
+	}
+	// A throwaway block (coinbase placeholder + txs) lets us reuse the same extraction code.
+	msg := &wire.MsgBlock{Transactions: []*wire.MsgTx{wire.NewMsgTx(1)}}
+	for _, tx := range txs {
+		msg.Transactions = append(msg.Transactions, tx.MsgTx())
+	}
+	blk := btcutil.NewBlock(msg)
+	view := NewUtxoViewpoint()
+	view.SetBestHash(&tip.hash)
+	if err := view.fetchInputUtxos(b.utxoCache, blk); err != nil {
+		return nil, err
+	}
+	deps, ops := jobOpsFromBlock(blk, view)
+	pool := jobstate.PoolIssuance(*jp, CalcBlockSubsidy(height, b.chainParams))
+	deps = append(append([]jobstate.Deposit{{Account: jobstate.PoolAccount, Amount: pool}}, extraDeposits...), deps...)
+	st := parentState.Clone()
+	res := jobstate.ApplyBlock(st, *jp, jobstate.BlockInput{Height: height, PrevHash: jobstate.Hash(tip.hash),
+		Deposits: deps, Ops: ops})
+	return &JobTemplate{PoolDeposit: pool, Withdrawals: res.Withdrawals, Root: res.Root}, nil
+}
+
+// JobStateAtTip returns a copy of the job state after the current best block.
+func (b *BlockChain) JobStateAtTip() (*jobstate.State, error) {
+	b.chainLock.RLock()
+	defer b.chainLock.RUnlock()
+	st, err := b.jobStateAfter(&b.bestChain.Tip().hash)
+	if err != nil {
+		return nil, err
+	}
+	return st.Clone(), nil
+}
