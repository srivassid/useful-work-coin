 		if p.JobModule == nil || !p.JobModule.ValidUpgrades() {
 			t.Fatalf("%s: job module missing or upgrades out of order", p.Name)
 		}
@@ -23,4 +23,19 @@ func TestUWCNetworks(t *testing.T) {
 			t.Fatal("testnet reply windows must be at least 30 blocks")
 		}
 	}
+	mp := UWCMainNetParams
+	for _, o := range []*Params{&UWCDevNetParams, &UWCTestNetParams, &MainNetParams} {
+		if *mp.GenesisHash == *o.GenesisHash || mp.Net == o.Net || mp.DefaultPort == o.DefaultPort || mp.Bech32HRPSegwit == o.Bech32HRPSegwit {
+			t.Fatalf("mainnet shares its genesis, magic, port or address prefix with %s", o.Name)
+		}
+	}
+	if j := mp.JobModule; j.Rules != 5 || len(j.Upgrades) != 0 || j.ChallengeBondBP != 1000 || j.ChallengeWindow != tp.ChallengeWindow {
+		t.Fatalf("mainnet job rules %d, %d upgrades, challenge bond %d", j.Rules, len(j.Upgrades), j.ChallengeBondBP)
+	}
+	if mp.CoinbaseMaturity != 100 || mp.JobModule.CouncilThreshold != 2 || len(mp.JobModule.Council) != 3 {
+		t.Fatal("mainnet maturity or council")
+	}
+	if mp.JobModule.Council[0] == UWCTestNetParams.JobModule.Council[0] {
+		t.Fatal("mainnet reuses the testnet council")
+	}
 }
