diff --git a/node/chaincfg/uwc_mainnet.go b/node/chaincfg/uwc_mainnet.go
new file mode 100644
index 00000000..678a3fd8
--- /dev/null
+++ b/node/chaincfg/uwc_mainnet.go
@@ -0,0 +1,91 @@
+package chaincfg
+
+import (
+	"encoding/hex"
+	"time"
+
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+	"github.com/pearl-research-labs/pearl/node/wire"
+)
+
+// Useful-Work Coin main network. It starts with the rules the testnet ended with (Rules 5 from
+// block 0, no scheduled upgrades), the testnet's reply windows, a coinbase maturity of 100 blocks,
+// its own network magic, ports and address prefix ("uwc1..."), and a dev fund paid once in block 1.
+
+var uwcMainNetCouncil = []string{
+	"46cf088fbc9dcde9492d00b2dc9cb8a03f7aaf72ee066cdc5e124d392c3a55e3",
+	"7abdfc09d1254a87a5faff023fc5a04a5e4ca969e978c097b9ae18ca486b3910",
+	"a3e34ef7eedcd55b6b19f9824a77d60d9f2a2319d00654988dc2b98869e1cad6",
+}
+
+// UWCMainNetDevFundCoins is the dev fund: 1% of the 2.1 billion coin supply, paid once.
+const UWCMainNetDevFundCoins = 21_000_000
+
+// uwcMainNetDevFundScript is the dev fund's P2TR output script.
+const uwcMainNetDevFundScript = "512035e1f79dc674e3e68a2b88d007411ed7448737fa6f2f5317e8d28bcdfc610ce5"
+
+func uwcMainNetJobParams() *jobstate.Params {
+	p := *uwcTestNetJobParams()
+	p.Council = nil
+	for _, h := range uwcMainNetCouncil {
+		b, err := hex.DecodeString(h)
+		if err != nil || len(b) != 32 {
+			panic("chaincfg: bad UWC mainnet council account " + h)
+		}
+		var a jobstate.AccountID
+		copy(a[:], b)
+		p.Council = append(p.Council, a)
+	}
+	// the testnet's final rules from the start
+	p.Rules, p.ChallengeBondBP = 5, 1000
+	p.Upgrades = nil
+	return &p
+}
+
+var uwcMainNetGenesisBlock = func() wire.MsgBlock {
+	b := wire.MsgBlock{
+		MsgHeader: wire.MsgHeader{
+			BlockHeader: wire.BlockHeader{
+				Version:    1,
+				MerkleRoot: genesisMerkleRoot,
+				Timestamp:  time.Unix(1794463200, 0), // 2026-11-12 06:00:00 UTC (in the past at launch)
+				Bits:       0x1a020000,               // 2^201: about one block a minute at 550 TMAC/s
+			},
+		},
+		Transactions: []*wire.MsgTx{&genesisCoinbaseTx},
+	}
+	h := b.BlockHash()
+	b.MsgHeader.MsgCertificate = wire.MsgCertificate{Certificate: &wire.CertificateV1{
+		Hash: h, ProofData: []byte{0x75, 0x77, 0x63, 0x6d}, // "uwcm"; genesis is not verified
+	}}
+	return b
+}()
+
+var uwcMainNetGenesisHash = uwcMainNetGenesisBlock.BlockHash()
+
+// UWCMainNetParams are the parameters of the Useful-Work Coin main network.
+var UWCMainNetParams = func() Params {
+	p := UWCTestNetParams
+	p.Name = "uwc-mainnet"
+	p.Net = wire.UWCMainNet
+	p.DefaultPort = "8690"
+	p.GenesisBlock = &uwcMainNetGenesisBlock
+	p.GenesisHash = &uwcMainNetGenesisHash
+	p.CoinbaseMaturity = 100
+	p.Bech32HRPSegwit = "uwc"
+	p.PrivateKeyID = 0x80
+	p.HDCoinType = HDCoinTypePearl + 1
+	p.JobModule = uwcMainNetJobParams()
+	script, err := hex.DecodeString(uwcMainNetDevFundScript)
+	if err != nil {
+		panic("chaincfg: bad UWC mainnet dev fund script")
+	}
+	p.DevFund = &DevFund{Height: 1, Amount: UWCMainNetDevFundCoins * 100_000_000, PkScript: script}
+	return p
+}()
+
+// The mainnet's address prefix (uwc1...) must be known for addresses to decode; the dev and test
+// networks share the sim network's (rprl1...).
+func init() {
+	mustRegister(&UWCMainNetParams)
+}
