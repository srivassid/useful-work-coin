+++ b/node/blockchain/devfund_test.go
@@ -0,0 +1,51 @@
+package blockchain
+
+import (
+	"testing"
+
+	"github.com/pearl-research-labs/pearl/node/btcutil"
+	"github.com/pearl-research-labs/pearl/node/chaincfg"
+	"github.com/pearl-research-labs/pearl/node/wire"
+)
+
+// The mainnet's dev fund (chaincfg.DevFund): block 1's coinbase must pay exactly the fund's amount
+// to its script, on top of subsidy and fees, and no other block may pay it.
+func TestDevFund(t *testing.T) {
+	params := uwcTestParams()
+	fund := newJKey(77)
+	params.DevFund = &chaincfg.DevFund{Height: 1, Amount: 5_000_000_000, PkScript: fund.script}
+	chain, teardown, err := chainSetup("devfund", params)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer teardown()
+	chain.TstSetCoinbaseMaturity(1)
+	c, done := newJChain(t)
+	done()
+	c.chain = chain
+	pay := func(amount int64, script []byte) func(*wire.MsgTx, *JobTemplate) {
+		return func(cb *wire.MsgTx, _ *JobTemplate) { cb.AddTxOut(wire.NewTxOut(amount, script)) }
+	}
+	expectRule(t, c.mine(nil, nil), "block 1 without the dev fund")
+	expectRule(t, c.mine(nil, pay(params.DevFund.Amount+1, fund.script)), "block 1 overpaying the dev fund")
+	expectRule(t, c.mine(nil, pay(params.DevFund.Amount, c.miner.script)), "block 1 paying the fund's amount elsewhere")
+	if err := c.mine(nil, pay(params.DevFund.Amount, fund.script)); err != nil {
+		t.Fatalf("block 1 paying the dev fund: %v", err)
+	}
+	expectRule(t, c.mine(nil, pay(params.DevFund.Amount, fund.script)), "block 2 paying the dev fund again")
+	c.mustMine()
+
+	// the mainnet's own parameters
+	mp := &chaincfg.UWCMainNetParams
+	if mp.DevFund == nil || mp.DevFund.Height != 1 || mp.DevFund.Amount != 21_000_000*100_000_000 || len(mp.DevFund.PkScript) != 34 {
+		t.Fatalf("mainnet dev fund %+v", mp.DevFund)
+	}
+	if got, want := mp.DevFund.Amount*100/2_100_000_000/100_000_000, int64(1); got != want {
+		t.Fatalf("dev fund is %d%% of supply, want %d%%", got, want)
+	}
+	// mainnet addresses decode (the node's --miningaddr, uwcctl send)
+	a, err := btcutil.DecodeAddress("uwc1peacvdmudg3hc56kaw9usgkd4ja6cjg69fgw647ld7uujpx2w3v4snjs0yw", mp)
+	if err != nil || !a.IsForNet(mp) {
+		t.Fatalf("mainnet address: %v", err)
+	}
+}
