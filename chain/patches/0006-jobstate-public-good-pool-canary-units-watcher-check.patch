+
+// tinyPool registers the tiny Qwen3 (2 layer groups) and opens a category whose units are the
+// tiny model's two-batch input (4 stages). With no stakers the committee is empty, so only
+// canaries and watchers check the units.
+func tinyPool(t *testing.T, tm *tinyModel, seed uint64, canary []Hash) (w *poolWorld, cat Hash, cSalt Hash, cLeaves []Hash) {
+	s := newSim(t, seed)
+	w = &poolWorld{world: &world{sim: s, client: acct(1), provider: acct(2)}, council: []AccountID{acct(900), acct(901), acct(902)}}
+	s.p.Council, s.p.CouncilThreshold, s.p.PoolEpoch = w.council, 2, 400
+	s.income = 1_000_000
+	reg := &Op{Kind: OpModelReg, Actor: w.client, H1: tm.wroot, H2: Hash{7}, U1: 2, U2: uint32(tm.cfg.Bs), Cfg: tm.cfg}
+	mustOK(t, s.block([]Deposit{{w.client, 1e9}, {acct(950), 1e9}, {TreasuryAccount, 1e8}}, []*Op{reg}, nil))
+	w.model = tagHash("model", reg.Ref[:])
+	lv, inRoot := tm.inputTree()
+	_ = lv
+	w.inputs = []Hash{inRoot, s.randHash()}
+	w.wleaves = []Hash{UnitLeaf(0, w.inputs[0]), UnitLeaf(1, w.inputs[1])}
+	sp := CategorySpec{Model: w.model, WorkRoot: MerkleRoot(w.wleaves), Units: 2, StagesPerUnit: 4,
+		SeqLen: uint32(len(tm.tokens[0])), K: 2, N: 2, UnitDeadline: 40, CapBP: 5000, InitPrice: 4_000_000, Curator: acct(950)}
+	if canary != nil {
+		cSalt = s.randHash()
+		cLeaves = []Hash{s.randHash(), CanaryLeaf(0, MerkleRoot(canary), cSalt)}
+		sp.CanaryRoot, sp.CanaryLeaves = MerkleRoot(cLeaves), 2
+	}
+	w.run(3)
+	cat = w.openCategory(sp)
+	w.run(2)
+	return
+}
