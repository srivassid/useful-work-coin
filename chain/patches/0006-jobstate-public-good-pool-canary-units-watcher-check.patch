+package jobstate
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"testing"
+)
+
+// Build step 5 tests: council threshold, pool budget accounting and unit pricing, claims,
+// canary units, watchers' checks and forced-error jackpots.
+
+// ---------------------------------------------------------------- harness
+
+type poolWorld struct {
+	*world
+	council []AccountID
+	inputs  []Hash // unit input roots of the last work list made
+	wleaves []Hash
+}
+
+func newPoolWorld(t *testing.T, seed uint64, nVerifiers int) *poolWorld {
+	w := newWorld(t, seed, nVerifiers)
+	pw := &poolWorld{world: w, council: []AccountID{acct(900), acct(901), acct(902)}}
+	w.p.Council, w.p.CouncilThreshold = pw.council, 2
+	w.p.PoolEpoch = 40
+	return pw
+}
+
+// councilDo proposes an action (council[0]) and approves it (council[1]); returns the proposal id.
+func (w *poolWorld) councilDo(action *Op) (Hash, *BlockResult) {
+	prop := &Op{Kind: OpPropose, Actor: w.council[0], Data: action.Encode()}
+	mustOK(w.t, w.block(nil, []*Op{prop}, nil))
+	id := tagHash("proposal", prop.Ref[:])
+	return id, w.block(nil, []*Op{{Kind: OpApprove, Actor: w.council[1], Job: id}}, nil)
+}
+
+// workList makes n units with random input roots.
+func (w *poolWorld) workList(n int) Hash {
+	w.inputs, w.wleaves = nil, nil
+	for i := 0; i < n; i++ {
+		in := w.randHash()
+		w.inputs = append(w.inputs, in)
+		w.wleaves = append(w.wleaves, UnitLeaf(uint32(i), in))
+	}
+	return MerkleRoot(w.wleaves)
+}
+
+func (w *poolWorld) spec(units int) CategorySpec {
+	return CategorySpec{Model: w.model, WorkRoot: w.workList(units), Units: uint32(units), StagesPerUnit: 8, SeqLen: 4,
+		K: 2, N: 2, UnitDeadline: 30, CapBP: 6000, InitPrice: 2_000_000, Curator: acct(950)}
+}
+
+func (w *poolWorld) openCategory(sp CategorySpec) Hash {
+	id, res := w.councilDo(&Op{Kind: OpPoolCategory, Cat: sp})
+	mustOK(w.t, res)
+	return tagHash("category", id[:])
+}
+
+func (w *poolWorld) claimOp(cat Hash, prov AccountID, unit int) *Op {
+	c := w.st.Categories[cat]
+	return &Op{Kind: OpPoolClaim, Actor: prov, Job: cat, U1: uint32(unit), H1: w.inputs[unit],
+		Proof: MerkleProof(w.wleaves, unit), Amount: minBond(w.p, c.Price), Ref: w.ref()}
+}
+
+// runUnit claims a unit, commits tr, lets the committee verify honestly against truth, and
+// reveals. It returns the job id with the job in its challenge window (or disputed).
+func (w *poolWorld) runUnit(cat Hash, prov AccountID, unit int, tr, truth *trace) Hash {
+	o := w.claimOp(cat, prov, unit)
+	mustOK(w.t, w.block(nil, []*Op{o}, nil))
+	id := tagHash("job", o.Ref[:])
+	w.commitAndVerify(id, prov, tr, truth)
+	return id
+}
+
+func (w *poolWorld) commitAndVerify(id Hash, prov AccountID, tr, truth *trace) {
+	mustOK(w.t, w.block(nil, []*Op{{Kind: OpTraceCommit, Actor: prov, Job: id, H1: tr.commit(), H2: w.randHash()}}, nil))
+	for w.st.Jobs[id].Status == StatusCommitted {
+		w.block(nil, nil, nil)
+	}
+	j := w.st.Jobs[id]
+	if j.Status == StatusVerifyCommit {
+		w.verify(j, truth, nil)
+	}
+	w.revealRequested(id, prov, tr)
+}
+
+func (w *poolWorld) revealRequested(id Hash, prov AccountID, tr *trace) {
+	j := w.st.Jobs[id]
+	if j.Status != StatusProviderReveal {
+		return
+	}
+	var want []uint32
+	for st := range j.requested() {
+		if _, ok := revealedRoot(j, st); !ok {
+			want = append(want, st)
+		}
+	}
+	mustOK(w.t, w.block(nil, []*Op{{Kind: OpTraceReveal, Actor: prov, Job: id, Reveals: tr.reveal(want)}}, nil))
+	w.block(nil, nil, nil)
+}
+
+// runTo runs empty blocks until height h (inclusive).
+func (w *poolWorld) runTo(h int32) {
+	for w.h < h {
+		w.block(nil, nil, nil)
+	}
+}
+
+// nextEpochEnd is the next height (after the current one) whose block closes an epoch.
+func (w *poolWorld) nextEpochEnd() int32 {
+	e := w.h + 1
+	for (e+1)%w.p.PoolEpoch != 0 {
+		e++
+	}
+	return e
+}
