+// ---------------------------------------------------------------- pool accounting and pricing
+
+func TestPoolBudgetAndUnitPricing(t *testing.T) {
+	w := newPoolWorld(t, 502, 4)
+	w.p.PoolEpoch = 100
+	const income = 1_000_000
+	w.income = income
+	cat := w.openCategory(w.spec(6))
+	c := w.st.Categories[cat]
+	// allocation: every block from now on moves CapBP of the income into the budget
+	b0, r0 := c.Budget, w.bal(PoolAccount)
+	w.run(5)
+	c = w.st.Categories[cat]
+	if c.Budget-b0 != 5*income*6000/10_000 || w.bal(PoolAccount)-r0 != 5*income*4000/10_000 {
+		t.Fatalf("allocation: budget +%d, reserve +%d", c.Budget-b0, w.bal(PoolAccount)-r0)
+	}
+	// claim rules
+	provs := []AccountID{acct(60), acct(61), acct(62)}
+	var deps []Deposit
+	for _, p := range provs {
+		deps = append(deps, Deposit{p, 1e9})
+	}
+	w.block(deps, nil, nil)
+	bad := w.claimOp(cat, provs[0], 0)
+	bad.H1 = w.randHash()
+	low := w.claimOp(cat, provs[0], 1)
+	low.Amount--
+	if r := w.block(nil, []*Op{bad, low, {Kind: OpPoolClaim, Actor: provs[0], Job: cat, U1: 99}}, nil); r.OpErrors[0] == nil || r.OpErrors[1] == nil || r.OpErrors[2] == nil {
+		t.Fatalf("bad claims accepted: %v", r.OpErrors)
+	}
+	c0 := w.claimOp(cat, provs[0], 0)
+	dup := w.claimOp(cat, provs[1], 0)
+	if r := w.block(nil, []*Op{c0, dup}, nil); r.OpErrors[0] != nil || r.OpErrors[1] == nil {
+		t.Fatalf("claim / double claim: %v", r.OpErrors)
+	}
+	j0 := tagHash("job", c0.Ref[:])
+	if j := w.st.Jobs[j0]; j.Client != PoolAccount || j.Fee != poolVerifierPay(w.p, &w.st.Categories[cat].Spec) || j.Status != StatusAccepted {
+		t.Fatalf("pool job %+v", j)
+	}
+	// unit 0 is abandoned: past the deadline the provider loses its bond, half to the category
+	budget := w.st.Categories[cat].Budget
+	w.run(int(w.st.Jobs[j0].Deadline-w.h) + 1)
+	if w.st.Jobs[j0].Status != StatusFailed || w.st.Categories[cat].Units[0] != (UnitState{}) {
+		t.Fatal("abandoned unit not released")
+	}
+	bond := w.st.Jobs[j0].Bond
+	grown := w.st.Categories[cat].Budget - budget
+	if grown < w.st.Jobs[j0].Fee+bond/2 { // plus income allocated meanwhile
+		t.Fatalf("abandoned unit's escrow not returned to the category (+%d)", grown)
+	}
+	// three units delivered by three providers in one epoch
+	end := w.nextEpochEnd()
+	if end-w.h < 60 {
+		w.runTo(end)
+		end = w.nextEpochEnd()
+	}
+	var ids []Hash
+	for i, p := range provs {
+		tr := w.newTrace(8)
+		ids = append(ids, w.runUnit(cat, p, i+1, tr, tr))
+	}
+	for _, id := range ids {
+		for w.st.Jobs[id].Status != StatusSettled {
+			w.block(nil, nil, nil)
+		}
+	}
+	w.block(nil, nil, nil)
+	if w.h >= end {
+		t.Fatalf("units took too long for the epoch (h %d, end %d)", w.h, end)
+	}
+	c = w.st.Categories[cat]
+	if len(c.Epoch) != 3 || c.Done != 3 || c.InFlight != 0 {
+		t.Fatalf("epoch deliveries %d done %d in flight %d", len(c.Epoch), c.Done, c.InFlight)
+	}
+	w.runTo(end - 1)
+	before := map[AccountID]Amount{}
+	for _, p := range provs {
+		before[p] = w.bal(p)
+	}
+	tr0 := w.bal(TreasuryAccount)
+	B := w.st.Categories[cat].Budget + income*6000/10_000 // the closing block's allocation comes first
+	w.block(nil, nil, nil)
+	per := B / 3
+	tc := per * w.p.TreasuryShareBP / 10_000
+	for _, p := range provs {
+		if d := w.bal(p) - before[p]; d != per-tc {
+			t.Fatalf("unit payout %d, want %d", d, per-tc)
+		}
+	}
+	if w.bal(TreasuryAccount)-tr0 != 3*tc {
+		t.Fatal("treasury share of unit payouts")
+	}
+	c = w.st.Categories[cat]
+	if c.Price != per || c.Budget != B-3*per || w.st.Stats.PoolUnits != 3 || w.st.Stats.PoolPaid != 3*per {
+		t.Fatalf("price %d budget %d stats %+v", c.Price, c.Budget, w.st.Stats)
+	}
+	// the next epoch has one delivery: the same budget goes to fewer units, so more per unit
+	end = w.nextEpochEnd()
+	if r := w.block(nil, []*Op{w.claimOp(cat, provs[0], 4)}, nil); r.OpErrors[0] == nil {
+		t.Fatal("a fully paid-out budget must not escrow verification before new income arrives")
+	}
+	tr := w.newTrace(8)
+	id := w.runUnit(cat, provs[0], 4, tr, tr)
+	for w.st.Jobs[id].Status != StatusSettled {
+		w.block(nil, nil, nil)
+	}
+	w.runTo(end - 1)
+	B1 := w.st.Categories[cat].Budget + income*6000/10_000
+	p0 := w.bal(provs[0])
+	w.block(nil, nil, nil)
+	if d := w.bal(provs[0]) - p0; d != B1-B1*w.p.TreasuryShareBP/10_000 || B1 <= per {
+		t.Fatalf("single delivery got %d of budget %d", d, B1)
+	}
+	if w.st.Categories[cat].Price != B1 {
+		t.Fatal("price is the last per-unit payout")
+	}
+	// a delivered unit cannot be claimed again
+	if r := w.block(nil, []*Op{w.claimOp(cat, provs[1], 4)}, nil); r.OpErrors[0] == nil {
+		t.Fatal("delivered unit claimed again")
+	}
+}
