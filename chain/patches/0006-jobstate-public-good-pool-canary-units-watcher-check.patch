+func TestPoolCategoryExhaustionAndRetirement(t *testing.T) {
+	w := newPoolWorld(t, 503, 3)
+	w.income = 500_000
+	w.run(2)
+	sp := w.spec(1)
+	sp.Grant = 300_000 // from the reserve
+	r0 := w.bal(PoolAccount)
+	cat := w.openCategory(sp)
+	if w.st.Categories[cat].Budget < sp.Grant || w.bal(PoolAccount) >= r0+3*w.income {
+		t.Fatal("grant not moved from the reserve")
+	}
+	prov := acct(70)
+	w.block([]Deposit{{prov, 1e9}}, nil, nil)
+	tr := w.newTrace(8)
+	id := w.runUnit(cat, prov, 0, tr, tr)
+	for w.st.Jobs[id].Status != StatusSettled {
+		w.block(nil, nil, nil)
+	}
+	w.runTo(w.nextEpochEnd())
+	c := w.st.Categories[cat]
+	if !c.Closed || c.Budget != 0 {
+		t.Fatalf("exhausted category not closed: %+v", c)
+	}
+	// closed categories receive no income and free their cap
+	res := w.st.Categories[cat].Budget
+	w.run(3)
+	if w.st.Categories[cat].Budget != res {
+		t.Fatal("closed category still allocated income")
+	}
+	cat2 := w.openCategory(w.spec(3)) // 60% cap available again
+	_, rr := w.councilDo(&Op{Kind: OpPoolRetire, Job: cat2})
+	mustOK(t, rr)
+	if r := w.block(nil, []*Op{w.claimOp(cat2, prov, 0)}, nil); r.OpErrors[0] == nil {
+		t.Fatal("claim on a retired category accepted")
+	}
+	w.runTo(w.nextEpochEnd())
+	if !w.st.Categories[cat2].Closed || w.st.Categories[cat2].Budget != 0 {
+		t.Fatal("retired category not closed")
+	}
+}
