+// ---------------------------------------------------------------- council
+
+func TestCouncilThreshold(t *testing.T) {
+	w := newPoolWorld(t, 501, 3)
+	w.income = 1_000_000
+	w.run(3)
+	sp := w.spec(4)
+	// an ordinary account cannot run a council action directly
+	r := w.block(nil, []*Op{{Kind: OpPoolCategory, Actor: w.client, Cat: sp}}, nil)
+	if r.OpErrors[0] == nil {
+		t.Fatal("POOL_CATEGORY outside the council accepted")
+	}
+	// non-members cannot propose or approve
+	r = w.block(nil, []*Op{{Kind: OpPropose, Actor: w.client, Data: (&Op{Kind: OpPoolCategory, Cat: sp}).Encode()}}, nil)
+	if r.OpErrors[0] == nil {
+		t.Fatal("non-member proposal accepted")
+	}
+	// a proposal may only carry council actions
+	r = w.block(nil, []*Op{{Kind: OpPropose, Actor: w.council[0], Data: (&Op{Kind: OpWithdraw, Amount: 1, PkScript: payTo(1)}).Encode()}}, nil)
+	if r.OpErrors[0] == nil {
+		t.Fatal("proposal of an ordinary op accepted")
+	}
+	prop := &Op{Kind: OpPropose, Actor: w.council[0], Data: (&Op{Kind: OpPoolCategory, Cat: sp}).Encode()}
+	mustOK(t, w.block(nil, []*Op{prop}, nil))
+	pid := tagHash("proposal", prop.Ref[:])
+	if len(w.st.Categories) != 0 || w.st.Proposals[pid] == nil {
+		t.Fatal("one approval of a 2-of-3 council must not execute")
+	}
+	r = w.block(nil, []*Op{{Kind: OpApprove, Actor: w.council[0], Job: pid}, {Kind: OpApprove, Actor: w.client, Job: pid}}, nil)
+	if r.OpErrors[0] == nil || r.OpErrors[1] == nil || len(w.st.Categories) != 0 {
+		t.Fatal("double or outside approval counted")
+	}
+	mustOK(t, w.block(nil, []*Op{{Kind: OpApprove, Actor: w.council[2], Job: pid}}, nil))
+	if len(w.st.Categories) != 1 || w.st.Proposals[pid] != nil {
+		t.Fatal("second approval did not execute the action")
+	}
+	// proposals expire
+	prop2 := &Op{Kind: OpPropose, Actor: w.council[1], Data: (&Op{Kind: OpFECommit, H1: Hash{1}, Amount: 0}).Encode()}
+	mustOK(t, w.block(nil, []*Op{prop2}, nil))
+	pid2 := tagHash("proposal", prop2.Ref[:])
+	w.run(int(w.p.ProposalWindow) + 1)
+	if w.st.Proposals[pid2] != nil {
+		t.Fatal("proposal did not expire")
+	}
+	if r := w.block(nil, []*Op{{Kind: OpApprove, Actor: w.council[0], Job: pid2}}, nil); r.OpErrors[0] == nil {
+		t.Fatal("expired proposal approved")
+	}
+	// caps of open categories cannot exceed 100% of pool income
+	sp2 := w.spec(2)
+	sp2.CapBP = 5000
+	if _, r := w.councilDo(&Op{Kind: OpPoolCategory, Cat: sp2}); r.OpErrors[0] == nil {
+		t.Fatal("caps above 100% accepted")
+	}
+}
