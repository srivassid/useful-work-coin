+// ---------------------------------------------------------------- canaries
+
+// canaryCategory makes a category whose unit 1 is a canary with the given expected roots,
+// hidden among dummy leaves.
+func (w *poolWorld) canaryCategory(expected []Hash) (cat Hash, salt Hash, leaves []Hash, pos int) {
+	sp := w.spec(4)
+	salt = w.randHash()
+	leaves = []Hash{w.randHash(), w.randHash(), CanaryLeaf(1, MerkleRoot(expected), salt), w.randHash()}
+	sp.CanaryRoot, sp.CanaryLeaves = MerkleRoot(leaves), 4
+	return w.openCategory(sp), salt, leaves, 2
+}
+
+func TestCanaryUnits(t *testing.T) {
+	for _, substituted := range []bool{false, true} {
+		w := newPoolWorld(t, 504, 3)
+		w.income = 1_000_000
+		w.run(2)
+		truth := w.newTrace(8)
+		cat, salt, leaves, pos := w.canaryCategory(truth.roots)
+		curator, prov := acct(950), acct(71)
+		w.block([]Deposit{{curator, 1e8}, {prov, 1e9}}, nil, nil)
+		// the provider runs unit 1; with a substituted model every stage root differs
+		tr := truth
+		if substituted {
+			tr = w.newTrace(8)
+		}
+		o := w.claimOp(cat, prov, 1)
+		mustOK(t, w.block(nil, []*Op{o}, nil))
+		id := tagHash("job", o.Ref[:])
+		mustOK(t, w.block(nil, []*Op{{Kind: OpTraceCommit, Actor: prov, Job: id, H1: tr.commit(), H2: w.randHash()}}, nil))
+		reveal := &Op{Kind: OpCanary, Actor: curator, Job: id, U1: uint32(pos), H1: salt, Roots: truth.roots, Proof: MerkleProof(leaves, pos)}
+		wrong := *reveal
+		wrong.Ref, wrong.H1 = Hash{}, w.randHash()
+		other := *reveal
+		other.Ref, other.Actor = Hash{}, acct(951)
+		r := w.block([]Deposit{{acct(951), 1e8}}, []*Op{&wrong, &other, reveal}, nil)
+		if r.OpErrors[0] == nil || r.OpErrors[1] == nil || r.OpErrors[2] != nil {
+			t.Fatalf("canary reveal checks: %v", r.OpErrors)
+		}
+		cur0 := w.bal(curator)
+		for w.st.Jobs[id].Status == StatusCommitted {
+			w.block(nil, nil, nil)
+		}
+		j := w.st.Jobs[id]
+		if j.Status == StatusVerifyCommit {
+			w.verify(j, truth, nil)
+		}
+		if got := len(w.st.Jobs[id].requested()); got != 8 {
+			t.Fatalf("canary must open all stages, requested %d", got)
+		}
+		w.revealRequested(id, prov, tr)
+		j = w.st.Jobs[id]
+		if !substituted {
+			if j.Status != StatusChallenge || w.bal(curator)-cur0 != w.p.ChallengeBondMin {
+				t.Fatalf("honest canary: status %v, curator %+d", j.Status, w.bal(curator)-cur0)
+			}
+			continue
+		}
+		if j.Status != StatusDisputed {
+			t.Fatalf("substituted model not disputed: %v", j.Status)
+		}
+		var mine bool
+		for _, d := range j.Disputes {
+			mine = mine || (d.Challenger == curator && d.ClaimedRoot == truth.roots[d.Stage])
+		}
+		if !mine {
+			t.Fatal("no curator dispute")
+		}
+		p0 := w.bal(prov)
+		w.block(nil, nil, []Verdict{{Job: id, ProviderAtFault: true}}) // the game's verdict (played for real in TestCanaryAndDecoyGamesOnTinyModel)
+		j = w.st.Jobs[id]
+		if j.Status != StatusFailed || w.bal(prov) != p0 || w.st.Categories[cat].Units[1] != (UnitState{}) {
+			t.Fatalf("substituted canary: status %v", j.Status)
+		}
+	}
+}
