+// agreedCheck ends a bonded CHALLENGE whose claimed root equals the provider's: the watcher
+// checked the stage and found it right. It pays WatchFee to the provider for opening the stage
+// and gets the rest of its bond back. Copying is impossible, because the claim is posted
+// before the provider opens the stage, and a guessed root loses the whole bond in the game.
+func (s *State) agreedCheck(p Params, h int32, j *Job) {
+	d := j.Disputes[0]
+	j.Game = nil
+	s.credit(j.Provider, p.WatchFee)
+	s.credit(d.Challenger, d.Bond-p.WatchFee)
+	s.Stats.Checks++
+	j.Disputes = j.Disputes[1:]
+	if len(j.Disputes) > 0 {
+		s.startGame(p, h, j)
+		return
+	}
+	j.Disputes = nil
+	if h < j.ChallengeEnd {
+		j.Status, j.PhaseEnd = StatusChallenge, j.ChallengeEnd
+	} else {
+		s.settle(j)
+	}
+}
