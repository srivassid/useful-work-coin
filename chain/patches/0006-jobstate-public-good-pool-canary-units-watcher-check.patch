+// ---------------------------------------------------------------- randomized property test
+
+// TestPoolAndWatchersRandomized runs pool units (honest, cheating, abandoned, canaries),
+// client jobs, forced-error decoys and watchers together. After every block the harness checks
+// conservation, replay determinism and that clones are independent. At the end: every job
+// ended, no honest provider was ever slashed, every cheater and every decoy found by a check was
+// caught, budgets add up, and the decoy catch rate matches the sampling odds.
+func TestPoolAndWatchersRandomized(t *testing.T) {
+	seeds := 6
+	if testing.Short() {
+		seeds = 2
+	}
+	var caught, decoys int
+	var wantP float64
+	for seed := 0; seed < seeds; seed++ {
+		c, d, p := poolRandomRun(t, uint64(700+seed))
+		caught, decoys, wantP = caught+c, decoys+d, p
+	}
+	rate := float64(caught) / float64(decoys)
+	sd := sqrt(wantP * (1 - wantP) / float64(decoys))
+	t.Logf("decoys %d, caught %d (%.3f); expected %.3f ± %.3f", decoys, caught, rate, wantP, sd)
+	if rate < wantP-4*sd || rate > wantP+4*sd {
+		t.Fatalf("decoy catch rate %.3f outside %.3f ± 4σ", rate, wantP)
+	}
+}
+
+func sqrt(x float64) float64 {
+	z := x
+	for i := 0; i < 50 && z > 0; i++ {
+		z = (z + x/z) / 2
+	}
+	return z
+}
+
+func poolRandomRun(t *testing.T, seed uint64) (caught, decoyCount int, wantP float64) {
+	w := newPoolWorld(t, seed, 6)
+	r := w.rng
+	w.income = 2_000_000
+	w.block([]Deposit{{TreasuryAccount, 500_000_000}}, nil, nil)
+	const units, S = 300, 8
+	sp := w.spec(units)
+	// canaries: every 10th unit, hidden among dummies
+	truths := make([]*trace, units)
+	for i := range truths {
+		truths[i] = w.newTrace(S)
+	}
+	cSalt := w.randHash()
+	var cLeaves []Hash
+	cPos := map[int]int{}
+	for i := 0; i < units; i += 10 {
+		cPos[i] = len(cLeaves)
+		cLeaves = append(cLeaves, CanaryLeaf(uint32(i), MerkleRoot(truths[i].roots), cSalt))
+		cLeaves = append(cLeaves, w.randHash())
+	}
+	sp.CanaryRoot, sp.CanaryLeaves = MerkleRoot(cLeaves), uint32(len(cLeaves))
+	sp.CapBP = 8000
+	cat := w.openCategory(sp)
+	curator := acct(950)
+	honest := []AccountID{acct(400), acct(401), acct(402)}
+	cheater, quitter := acct(410), acct(411)
+	watcher := acct(420)
+	decoyClient := acct(430)
+	var decoyProvs []AccountID
+	for i := 0; i < 40; i++ {
+		decoyProvs = append(decoyProvs, acct(440+i))
+	}
+	deps := []Deposit{{curator, 1e9}, {cheater, 1e10}, {quitter, 1e10}, {watcher, 1e10}, {decoyClient, 1e11}}
+	for _, a := range append(append([]AccountID{}, honest...), decoyProvs...) {
+		deps = append(deps, Deposit{a, 1e10})
+	}
+	w.block(deps, nil, nil)
+	record := EncodeFERecord(decoyProvs)
+	feSalt := w.randHash()
+	pid, res := w.councilDo(&Op{Kind: OpFECommit, H1: FECommitment(record, feSalt), Amount: 400_000_000})
+	mustOK(t, res)
+	fe := tagHash("fe", pid[:])
+
+	type live struct {
+		id         Hash
+		prov       AccountID
+		committed  *trace // what the provider committed
+		truth      *trace // what an honest recomputation gives
+		unit       int
+		pool, quit bool
+		decoy      bool
+		watched    bool
+		salts      map[AccountID]Hash
+	}
+	var jobs []*live
+	byID := map[Hash]*live{}
+	nextUnit := 0
+	const watchRate = 0.5
+	blocks := 500
+	for b := 0; b < blocks; b++ {
+		var ops []*Op
+		var verdicts []Verdict
+		if b < blocks-200 {
+			// pool claims
+			if r.IntN(2) == 0 && nextUnit < units {
+				prov := honest[r.IntN(len(honest))]
+				kind := r.IntN(10)
+				if kind == 0 {
+					prov = cheater
+				} else if kind == 1 {
+					prov = quitter
+				}
+				o := w.claimOp(cat, prov, nextUnit)
+				ops = append(ops, o)
+				truth := truths[nextUnit]
+				comm := truth
+				if prov == cheater { // a substituted model: every stage differs
+					comm = w.newTrace(S)
+				}
+				lj := &live{id: tagHash("job", o.Ref[:]), prov: prov, committed: comm, truth: truth, unit: nextUnit, pool: true,
+					quit: prov == quitter, salts: map[AccountID]Hash{}}
+				jobs, byID[lj.id] = append(jobs, lj), lj
+				nextUnit++
+			}
+			// decoys, looking like client jobs: one wrong stage root each
+			if r.IntN(3) == 0 {
+				fee := Amount(5_000_000 + r.IntN(5_000_000))
+				post := &Op{Kind: OpJobPost, Actor: decoyClient, Model: w.model, H1: w.randHash(), U1: S, Amount: fee,
+					Deadline: w.h + 30, K: 2, N: 2, U2: 4, Ref: w.ref()}
+				ops = append(ops, post)
+				comm := w.newTrace(S)
+				truth := &trace{roots: append([]Hash(nil), comm.roots...)}
+				truth.roots[r.IntN(S)] = w.randHash()
+				lj := &live{id: tagHash("job", post.Ref[:]), prov: decoyProvs[r.IntN(len(decoyProvs))], committed: comm, truth: truth,
+					decoy: true, salts: map[AccountID]Hash{}}
+				jobs, byID[lj.id] = append(jobs, lj), lj
+			}
+		}
+		for _, lj := range jobs {
+			j := w.st.Jobs[lj.id]
+			if j == nil || j.Status.Terminal() {
+				continue
+			}
+			switch j.Status {
+			case StatusPosted:
+				ops = append(ops, &Op{Kind: OpJobAccept, Actor: lj.prov, Job: j.ID, Amount: minBond(w.p, j.Fee)})
+			case StatusAccepted:
+				if !lj.quit {
+					ops = append(ops, &Op{Kind: OpTraceCommit, Actor: lj.prov, Job: j.ID, H1: lj.committed.commit(), H2: w.randHash()})
+				}
+			case StatusCommitted:
+				if p, ok := cPos[lj.unit]; ok && lj.pool && j.Canary == nil {
+					ops = append(ops, &Op{Kind: OpCanary, Actor: curator, Job: j.ID, U1: uint32(p), H1: cSalt,
+						Roots: truths[lj.unit].roots, Proof: MerkleProof(cLeaves, p)})
+				}
+			case StatusVerifyCommit, StatusVerifyReveal:
+				for _, v := range j.Committee {
+					if j.Status == StatusVerifyCommit && !v.Committed && lj.salts[v.Account] == (Hash{}) {
+						salt := w.randHash()
+						lj.salts[v.Account] = salt
+						pos := Positions(salt, j.Stages, int(j.N))
+						roots := make([]Hash, len(pos))
+						for i, p := range pos {
+							roots[i] = lj.truth.roots[p]
+						}
+						ops = append(ops, &Op{Kind: OpVerifyCommit, Actor: v.Account, Job: j.ID, H1: sha256.Sum256(salt[:]), H2: ResultHash(roots, v.Account, salt)})
+					}
+					if salt, ok := lj.salts[v.Account]; ok && j.Status == StatusVerifyReveal && v.Committed && !v.Revealed {
+						pos := Positions(salt, j.Stages, int(j.N))
+						roots := make([]Hash, len(pos))
+						for i, p := range pos {
+							roots[i] = lj.truth.roots[p]
+						}
+						ops = append(ops, &Op{Kind: OpVerifyReveal, Actor: v.Account, Job: j.ID, H1: salt, Roots: roots})
+					}
+				}
+			case StatusProviderReveal:
+				var want []uint32
+				for st := range j.requested() {
+					if _, ok := revealedRoot(j, st); !ok {
+						want = append(want, st)
+					}
+				}
+				if len(want) > 0 {
+					ops = append(ops, &Op{Kind: OpTraceReveal, Actor: lj.prov, Job: j.ID, Reveals: lj.committed.reveal(want)})
+				}
+			case StatusChallenge:
+				// a watcher checks a share of jobs (it cannot tell decoys from client jobs) with one sampled stage
+				if !lj.watched && !lj.pool {
+					lj.watched = true
+					if r.Float64() < watchRate {
+						st := uint32(r.IntN(S))
+						ops = append(ops, &Op{Kind: OpChallenge, Actor: watcher, Job: j.ID, U1: st, H1: lj.truth.roots[st], Amount: w.p.ChallengeBondMin})
+					}
+				}
+			case StatusDisputed:
+				g := j.Game
+				if g != nil && g.Phase == GReveal {
+					ops = append(ops, &Op{Kind: OpTraceReveal, Actor: lj.prov, Job: j.ID, Reveals: lj.committed.reveal([]uint32{g.Stage})})
+				} else if g != nil {
+					// the referee's verdict (step 4 plays these games for real): the provider is wrong iff
+					// its committed root differs from an honest recomputation
+					d := j.Disputes[0]
+					verdicts = append(verdicts, Verdict{Job: j.ID, ProviderAtFault: lj.committed.roots[d.Stage] != lj.truth.roots[d.Stage]})
+				}
+			}
+		}
+		w.block(nil, ops, verdicts)
+	}
+	w.run(int(w.p.ChallengeWindow + w.p.DisputeTimeout + 2*w.p.PoolEpoch))
+	// FE reveal
+	mustOK(t, w.block(nil, []*Op{{Kind: OpFEReveal, Actor: watcher, Job: fe, H1: feSalt, Data: record}}, nil))
+	w.runTo(w.nextEpochEnd())
+	settledUnits := 0
+	for _, lj := range jobs {
+		j := w.st.Jobs[lj.id]
+		if j == nil {
+			continue // a decoy posted in the same block as a junk op, or a claim that failed
+		}
+		if !j.Status.Terminal() {
+			t.Fatalf("job stuck in %v", j.Status)
+		}
+		cheat := false
+		for i := range lj.truth.roots {
+			cheat = cheat || lj.committed.roots[i] != lj.truth.roots[i]
+		}
+		switch {
+		case lj.quit:
+			if j.Status != StatusFailed {
+				t.Fatalf("abandoned unit %v", j.Status)
+			}
+		case !cheat && j.Status != StatusSettled:
+			t.Fatalf("honest provider not settled: %v (false slash)", j.Status)
+		case lj.pool && cheat && j.Canary != nil && j.Status != StatusFailed:
+			t.Fatal("canary missed a substituted model")
+		}
+		if lj.pool && j.Status == StatusSettled {
+			settledUnits++
+		}
+		if lj.decoy {
+			if !j.Decoy {
+				t.Fatal("decoy not revealed")
+			}
+			decoyCount++
+			if j.Status == StatusFailed {
+				caught++
+			}
+		}
+	}
+	st := w.st.Stats
+	if int(st.DecoysCaught) != caught || int(st.DecoysCaught+st.DecoysMissed) != decoyCount || int(st.PoolUnits) != settledUnits {
+		t.Fatalf("stats %+v vs caught %d decoys %d units %d", st, caught, decoyCount, settledUnits)
+	}
+	c := w.st.Categories[cat]
+	if c.InFlight != 0 || len(c.Epoch) != 0 || int(c.Done) != settledUnits {
+		t.Fatalf("category %+v", c)
+	}
+	if testing.Verbose() {
+		canaries, cheatersFailed := 0, 0
+		for _, lj := range jobs {
+			if j := w.st.Jobs[lj.id]; j != nil && lj.pool {
+				if j.Canary != nil {
+					canaries++
+				}
+				if lj.prov == cheater && j.Status == StatusFailed {
+					cheatersFailed++
+				}
+			}
+		}
+		t.Logf("seed %d: units settled %d, canaries opened %d, cheating units failed %d, checks %d, pool paid %d, jackpots %d",
+			seed, settledUnits, canaries, cheatersFailed, st.Checks, st.PoolPaid, st.JackpotsPaid)
+	}
+	// catch odds for one wrong stage of S: missed by both verifiers' n = 2 samples, and by the watcher
+	missV := float64((S-1)*(S-2)) / float64(S*(S-1))
+	wantP = 1 - missV*missV*(1-watchRate/float64(S))
+	return
+}
+
+// TestStep5Vectors checks the keyholder and curator tools (verifier/forced_errors.py) against
+// this package: record encoding, commitment, work-list and canary trees and proofs.
+func TestStep5Vectors(t *testing.T) {
+	raw, err := os.ReadFile("testdata/step5_vectors.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var v struct {
+		Record, Salt, Commitment string
+		Unit3Proof               []string `json:"unit3_proof"`
+		CanaryProof              []string `json:"canary_proof"`
+		WorkRootJ                string   `json:"work_root"`
+		CanaryRootJ              string   `json:"canary_root"`
+	}
+	if err := json.Unmarshal(raw, &v); err != nil {
+		t.Fatal(err)
+	}
+	hx := func(s string) Hash {
+		var h Hash
+		b, _ := hex.DecodeString(s)
+		copy(h[:], b)
+		return h
+	}
+	hs := func(ss []string) (o []Hash) {
+		for _, s := range ss {
+			o = append(o, hx(s))
+		}
+		return
+	}
+	record := EncodeFERecord([]AccountID{acct(1), acct(2), acct(3)})
+	salt := tagHash("salt")
+	if hex.EncodeToString(record) != v.Record || salt != hx(v.Salt) || FECommitment(record, salt) != hx(v.Commitment) {
+		t.Fatal("forced-error record or commitment differs from the Python tool")
+	}
+	var wl []Hash
+	for i := uint32(0); i < 5; i++ {
+		wl = append(wl, UnitLeaf(i, tagHash("in", u32b(i))))
+	}
+	if MerkleRoot(wl) != hx(v.WorkRootJ) || !VerifyMerkleProof(hx(v.WorkRootJ), wl[3], 3, 5, hs(v.Unit3Proof)) {
+		t.Fatal("work list tree differs")
+	}
+	var exp []Hash
+	for s := uint32(0); s < 4; s++ {
+		exp = append(exp, tagHash("root", u32b(s)))
+	}
+	leaf := CanaryLeaf(3, MerkleRoot(exp), salt)
+	if !VerifyMerkleProof(hx(v.CanaryRootJ), leaf, 1, 3, hs(v.CanaryProof)) {
+		t.Fatal("canary proof from the Python tool does not verify")
+	}
+}
