+// ---------------------------------------------------------------- watchers
+
+func TestWatcherCheckAgreesOrDisputes(t *testing.T) {
+	w := newPoolWorld(t, 505, 3)
+	watcher := acct(80)
+	w.block([]Deposit{{watcher, 1e8}}, nil, nil)
+	fee := Amount(10_000_000)
+	tr := w.newTrace(8)
+	j := w.startJob(fee, 8, 2, 2, tr)
+	w.verify(j, tr, nil)
+	w.revealRequested(j.ID, w.provider, tr)
+	// the watcher recomputes an unsampled stage and gets it right: a cheap check
+	var st uint32
+	for st = 0; st < 8; st++ {
+		if _, ok := revealedRoot(w.st.Jobs[j.ID], st); !ok {
+			break
+		}
+	}
+	w0, p0 := w.bal(watcher), w.bal(w.provider)
+	mustOK(t, w.block(nil, []*Op{{Kind: OpChallenge, Actor: watcher, Job: j.ID, U1: st, H1: tr.roots[st], Amount: w.p.ChallengeBondMin}}, nil))
+	if w.st.Jobs[j.ID].Game == nil || w.st.Jobs[j.ID].Game.Phase != GReveal {
+		t.Fatal("provider must open the checked stage")
+	}
+	mustOK(t, w.block(nil, []*Op{{Kind: OpTraceReveal, Actor: w.provider, Job: j.ID, Reveals: tr.reveal([]uint32{st})}}, nil))
+	if s := w.st.Jobs[j.ID].Status; s != StatusChallenge {
+		t.Fatalf("after an agreeing check: %v", s)
+	}
+	if w.bal(watcher)-w0 != -w.p.WatchFee || w.bal(w.provider)-p0 != w.p.WatchFee || w.st.Stats.Checks != 1 {
+		t.Fatalf("check cost: watcher %d provider %d", w.bal(watcher)-w0, w.bal(w.provider)-p0)
+	}
+	// checking an already-open stage with the same root resolves at once
+	mustOK(t, w.block(nil, []*Op{{Kind: OpChallenge, Actor: watcher, Job: j.ID, U1: st, H1: tr.roots[st], Amount: w.p.ChallengeBondMin}}, nil))
+	if w.st.Jobs[j.ID].Status != StatusChallenge || w.st.Stats.Checks != 2 {
+		t.Fatal("check of an open stage not resolved immediately")
+	}
+	// a wrong claim is a dispute, and the liar loses its whole bond
+	w0 = w.bal(watcher)
+	mustOK(t, w.block(nil, []*Op{{Kind: OpChallenge, Actor: watcher, Job: j.ID, U1: st, H1: w.randHash(), Amount: w.p.ChallengeBondMin}}, nil))
+	if w.st.Jobs[j.ID].Status != StatusDisputed {
+		t.Fatal("mismatching claim not disputed")
+	}
+	w.block(nil, nil, []Verdict{{Job: j.ID, ProviderAtFault: false}})
+	if w.bal(watcher)-w0 != -w.p.ChallengeBondMin {
+		t.Fatal("wrong watcher kept part of its bond")
+	}
+	w.run(int(w.p.ChallengeWindow) + 2)
+	if w.st.Jobs[j.ID].Status != StatusSettled {
+		t.Fatal("job did not settle")
+	}
+}
