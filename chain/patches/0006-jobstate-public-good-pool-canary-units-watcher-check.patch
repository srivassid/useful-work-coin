+package jobstate
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"sort"
+)
+
+// Build step 5: the public-good pool, canary units, watchers' checks and forced errors.
+// See spec/pool-and-watchers.md in the Useful-Work Coin repository.
+//
+// Pool. ρ of every block's subsidy is deposited to PoolAccount. Each block, that income is
+// split between the open categories by their cap shares; the rest stays in the pool reserve.
+// A category is a fixed public work list (a Merkle root over unit input roots) for one model.
+// Any provider claims a free unit with a bond and runs it as an ordinary job whose client is
+// the pool. Units that settle during an epoch share PoolSpendBP of the category's budget
+// equally at the epoch's end: fewer providers means more per unit, with no price to set.
+//
+// Canary units are units whose answers the category's curator knows. A Merkle root over
+// H(unit ‖ expected roots ‖ salt) is fixed with the category, so nobody can tell canaries from
+// other units; after a canary is committed the curator opens its leaf, every stage of the unit
+// is then checked, and the first stage that differs is disputed down to one operation.
+//
+// Forced errors. The council commits H(record ‖ salt) and reserves a budget from the
+// treasury. The record lists decoy provider accounts; the jobs those accounts accept after the
+// commitment are decoys run by the keyholders with a deliberately wrong stage root. After the
+// decoys end, anyone holding the record and salt (the keyholders reconstruct it from threshold
+// shares) reveals it: each caught decoy pays Jackpot to its catchers and the decoy's bond is
+// reimbursed; the rest of the reserve returns to the treasury.
+
+// CategorySpec is fixed when the council creates a category.
+type CategorySpec struct {
+	Model         Hash
+	WorkRoot      Hash   // Merkle root over UnitLeaf(i, input_root_i)
+	Units         uint32 // work list length
+	StagesPerUnit uint32 // batches x layer groups
+	SeqLen        uint32
+	K, N          uint8
+	UnitDeadline  int32  // blocks from claim to TRACE_COMMIT
+	CapBP         int64  // share of pool income
+	InitPrice     Amount // unit price used for bonds until the first payout
+	Grant         Amount // starting budget taken from the pool reserve
+	Curator       AccountID
+	CanaryRoot    Hash   // Merkle root over CanaryLeaf entries (zero: no canaries)
+	CanaryLeaves  uint32 // size of that tree (pad with dummy leaves to hide the count)
+}
+
+// UnitLeaf commits unit i of a work list to its input root.
+func UnitLeaf(i uint32, inputRoot Hash) Hash { return tagHash("unit", u32b(i), inputRoot[:]) }
+
+// CanaryLeaf commits a canary unit's expected stage roots (as their Merkle root).
+func CanaryLeaf(unit uint32, expected Hash, salt Hash) Hash {
+	return tagHash("canary", u32b(unit), expected[:], salt[:])
+}
+
+// FECommitment binds a forced-error record (decoy provider accounts) to a secret salt.
+func FECommitment(record []byte, salt Hash) Hash { return tagHash("fe-record", record, salt[:]) }
+
+// EncodeFERecord / DecodeFERecord: version byte, count, accounts.
+func EncodeFERecord(decoys []AccountID) []byte {
+	var e enc
+	e.WriteByte(1)
+	e.u(uint64(len(decoys)))
+	for _, a := range decoys {
+		e.Write(a[:])
+	}
+	return e.Bytes()
+}
+
+func DecodeFERecord(b []byte) ([]AccountID, error) {
+	r := &reader{b: b}
+	if r.u8() != 1 {
+		return nil, errors.New("bad forced-error record version")
+	}
+	n := r.uvar(1024)
+	var out []AccountID
+	for i := 0; i < n && r.err == nil; i++ {
+		var a AccountID
+		copy(a[:], r.take(32))
+		out = append(out, a)
+	}
+	if r.err != nil || len(r.b) != 0 {
+		return nil, errors.New("malformed forced-error record")
+	}
+	return out, nil
+}
+
+// UnitState is a unit that is in flight (Job set) or delivered (Done).
+type UnitState struct {
+	Job  Hash
+	Done bool
+}
+
+// Delivery is a unit settled in the current epoch, waiting for the epoch's payout.
+type Delivery struct {
+	Provider AccountID
+	Unit     uint32
+}
+
+// Category is a public-good work list and its budget.
+type Category struct {
+	ID       Hash
+	Spec     CategorySpec
+	Budget   Amount
+	Price    Amount // last per-unit payout (bond basis for new claims)
+	Retired  bool   // no new claims, no new income
+	Closed   bool   // retired or exhausted, nothing in flight; budget returned to the reserve
+	InFlight uint32
+	Done     uint32
+	Units    map[uint32]UnitState
+	Epoch    []Delivery
+}
+
+// Proposal is a council action waiting for approvals.
+type Proposal struct {
+	ID        Hash
+	Action    []byte
+	Approvals []AccountID // sorted
+	Expires   int32
+}
+
+// FECommit is a forced-error commitment with its reserved budget.
+type FECommit struct {
+	ID         Hash
+	Commitment Hash
+	Reserve    Amount
+	Height     int32
+	Expires    int32
+}
+
+// Stats are the testnet metrics the design asks for (useful share, decoy catch rate).
+type Stats struct {
+	SettledJobs   uint64
+	SettledStages uint64 // useful share: settled stage compute per block
+	PoolUnits     uint64
+	PoolPaid      Amount
+	Checks        uint64 // watcher checks that agreed with the provider
+	DecoysCaught  uint64
+	DecoysMissed  uint64
+	JackpotsPaid  Amount
+}
+
+// ---------------------------------------------------------------- council
+
+func (p Params) isCouncil(a AccountID) bool {
+	for _, c := range p.Council {
+		if c == a {
+			return true
+		}
+	}
+	return false
+}
+
+func isAction(k OpKind) bool { return k == OpPoolCategory || k == OpPoolRetire || k == OpFECommit }
+
+func (s *State) propose(p Params, h int32, o *Op) error {
+	if !p.isCouncil(o.Actor) || p.CouncilThreshold <= 0 || p.CouncilThreshold > len(p.Council) {
+		return errors.New("not a council member")
+	}
+	a, err := DecodeOp(o.Data)
+	if err != nil || !isAction(a.Kind) {
+		return errors.New("not a council action")
+	}
+	id := tagHash("proposal", o.Ref[:])
+	if _, ok := s.Proposals[id]; ok {
+		return errors.New("duplicate proposal")
+	}
+	pr := &Proposal{ID: id, Action: append([]byte(nil), o.Data...), Expires: h + p.ProposalWindow}
+	s.Proposals[id] = pr
+	return s.approveWith(p, h, pr, o.Actor)
+}
+
+func (s *State) approve(p Params, h int32, o *Op) error {
+	pr := s.Proposals[o.Job]
+	if pr == nil || !p.isCouncil(o.Actor) {
+		return errors.New("unknown proposal or not a council member")
+	}
+	return s.approveWith(p, h, pr, o.Actor)
+}
+
+// approveWith records an approval and executes the action once the threshold is reached. If
+// the action fails, the approving op fails, so the approval is not recorded either.
+func (s *State) approveWith(p Params, h int32, pr *Proposal, a AccountID) error {
+	for _, x := range pr.Approvals {
+		if x == a {
+			return errors.New("already approved")
+		}
+	}
+	pr.Approvals = append(pr.Approvals, a)
+	sort.Slice(pr.Approvals, func(i, j int) bool { return bytes.Compare(pr.Approvals[i][:], pr.Approvals[j][:]) < 0 })
+	if len(pr.Approvals) < p.CouncilThreshold {
+		return nil
+	}
+	act, _ := DecodeOp(pr.Action)
+	act.Actor, act.Ref = CouncilAccount, pr.ID
+	delete(s.Proposals, pr.ID)
+	return s.applyOp(p, h, act)
+}
+
+// ---------------------------------------------------------------- categories
+
+func (s *State) openCapBP() int64 {
+	t := int64(0)
+	for _, c := range s.Categories {
+		if !c.Retired {
+			t += c.Spec.CapBP
+		}
+	}
+	return t
+}
+
+func (s *State) poolCategory(p Params, o *Op) error {
+	if o.Actor != CouncilAccount {
+		return errors.New("only the council creates categories")
+	}
+	c := o.Cat
+	m := s.Models[c.Model]
+	switch {
+	case m == nil:
+		return errors.New("unknown model")
+	case c.Units == 0 || c.StagesPerUnit == 0 || c.StagesPerUnit > p.MaxStages || c.StagesPerUnit%m.LayerGroups != 0:
+		return errors.New("bad units or stages")
+	case int(c.K) < p.MinK || int(c.K) > p.MaxK || int(c.N) < p.MinN || int(c.N) > p.MaxN:
+		return errors.New("k or n out of range")
+	case c.SeqLen == 0 || int(c.SeqLen) > m.Cfg.MaxPos:
+		return errors.New("bad sequence length")
+	case c.UnitDeadline <= 0 || c.UnitDeadline > p.MaxDeadlineBlocks:
+		return errors.New("bad unit deadline")
+	case c.CapBP < 0 || s.openCapBP()+c.CapBP > 10_000 || c.InitPrice <= 0 || c.Grant < 0:
+		return errors.New("bad cap, price or grant")
+	case (c.CanaryRoot == Hash{}) != (c.CanaryLeaves == 0):
+		return errors.New("canary root and size must both be set")
+	case c.CanaryLeaves > 0 && c.StagesPerUnit > maxRoots:
+		return errors.New("canary units must fit one CANARY_REVEAL")
+	}
+	id := tagHash("category", o.Ref[:])
+	if _, ok := s.Categories[id]; ok {
+		return errors.New("duplicate category")
+	}
+	if err := s.debit(PoolAccount, c.Grant); err != nil {
+		return err
+	}
+	s.Categories[id] = &Category{ID: id, Spec: c, Budget: c.Grant, Price: c.InitPrice, Units: map[uint32]UnitState{}}
+	return nil
+}
+
+func (s *State) poolRetire(o *Op) error {
+	c := s.Categories[o.Job]
+	if o.Actor != CouncilAccount || c == nil || c.Retired {
+		return errors.New("only the council retires an open category")
+	}
+	c.Retired = true
+	return nil
+}
+
+// poolVerifierPay is escrowed from the category budget when a unit is claimed.
+func poolVerifierPay(p Params, c *CategorySpec) Amount {
+	return Amount(int(c.K)*int(c.N)) * p.VerifierFloorPerSample
+}
+
+func (s *State) poolClaim(p Params, h int32, o *Op) error {
+	c := s.Categories[o.Job]
+	switch {
+	case c == nil || c.Retired:
+		return errors.New("category is not open")
+	case o.U1 >= c.Spec.Units:
+		return errors.New("unit out of range")
+	case o.Actor == PoolAccount || o.Actor == TreasuryAccount || o.Actor == CouncilAccount:
+		return errors.New("system accounts cannot claim")
+	}
+	if u, ok := c.Units[o.U1]; ok {
+		if u.Done {
+			return errors.New("unit already delivered")
+		}
+		return errors.New("unit in flight")
+	}
+	if !VerifyMerkleProof(c.Spec.WorkRoot, UnitLeaf(o.U1, o.H1), int(o.U1), int(c.Spec.Units), o.Proof) {
+		return errors.New("input root is not this unit of the work list")
+	}
+	if o.Amount < minBond(p, c.Price) {
+		return errors.New("bond below minimum")
+	}
+	vp := poolVerifierPay(p, &c.Spec)
+	if c.Budget < vp {
+		return errors.New("category budget cannot pay verification")
+	}
+	id := tagHash("job", o.Ref[:])
+	if _, ok := s.Jobs[id]; ok {
+		return errors.New("duplicate job")
+	}
+	if err := s.debit(o.Actor, o.Amount); err != nil {
+		return err
+	}
+	c.Budget -= vp
+	c.Units[o.U1] = UnitState{Job: id}
+	c.InFlight++
+	sp := c.Spec
+	s.Jobs[id] = &Job{ID: id, Client: PoolAccount, Provider: o.Actor, Model: sp.Model, InputRoot: o.H1,
+		Stages: sp.StagesPerUnit, K: sp.K, N: sp.N, Fee: vp, VerifierPay: vp, Bond: o.Amount,
+		Deadline: h + sp.UnitDeadline, Status: StatusAccepted, PostHeight: h, AcceptHeight: h, SeqLen: sp.SeqLen,
+		Pool: c.ID, Unit: o.U1}
+	return nil
+}
+
+// refundClient returns money owed to a job's client; a pool unit's goes back to its category.
+func (s *State) refundClient(j *Job, v Amount) {
+	if j.IsPool() {
+		if c := s.Categories[j.Pool]; c != nil {
+			c.Budget += v
+			return
+		}
+	}
+	s.credit(j.Client, v)
+}
+
+// ---------------------------------------------------------------- canaries
+
+func (s *State) canaryReveal(p Params, h int32, o *Op) error {
+	j := s.Jobs[o.Job]
+	if j == nil || !j.IsPool() || j.Canary != nil {
+		return errors.New("not an unrevealed pool unit")
+	}
+	c := s.Categories[j.Pool]
+	if c == nil || o.Actor != c.Spec.Curator || c.Spec.CanaryLeaves == 0 {
+		return errors.New("not the category's curator")
+	}
+	switch j.Status {
+	case StatusCommitted, StatusVerifyCommit, StatusVerifyReveal, StatusProviderReveal, StatusChallenge:
+	default:
+		return errors.New("canaries are revealed after TRACE_COMMIT and outside disputes")
+	}
+	if len(o.Roots) != int(j.Stages) {
+		return errors.New("need one expected root per stage")
+	}
+	leaf := CanaryLeaf(j.Unit, MerkleRoot(o.Roots), o.H1)
+	if o.U1 >= c.Spec.CanaryLeaves || !VerifyMerkleProof(c.Spec.CanaryRoot, leaf, int(o.U1), int(c.Spec.CanaryLeaves), o.Proof) {
+		return errors.New("not a committed canary")
+	}
+	if err := s.debit(o.Actor, p.ChallengeBondMin); err != nil {
+		return err
+	}
+	j.Canary, j.CanaryBy, j.CanaryBond = append([]Hash(nil), o.Roots...), o.Actor, p.ChallengeBondMin
+	switch j.Status {
+	case StatusChallenge: // reopen the reveal phase: every stage must now be opened
+		j.Status, j.PhaseEnd = StatusProviderReveal, h+p.ProviderRevealWindow
+	case StatusProviderReveal:
+		j.PhaseEnd = max(j.PhaseEnd, h+p.ProviderRevealWindow)
+	}
+	return nil
+}
+
+// canaryCheck runs once every stage of a canary unit is open: the first stage whose root
+// differs from the expected one becomes a dispute played by the curator.
+func (s *State) canaryCheck(h int32, j *Job, got map[uint32]Hash) {
+	if j.Canary == nil || j.CanaryBond == 0 {
+		return
+	}
+	for st := uint32(0); st < j.Stages; st++ {
+		if got[st] != j.Canary[st] {
+			j.Disputes = append(j.Disputes, Challenge{Challenger: j.CanaryBy, Stage: st, ClaimedRoot: j.Canary[st],
+				Bond: j.CanaryBond, Height: h})
+			j.CanaryBond = 0
+			return
+		}
+	}
+	s.credit(j.CanaryBy, j.CanaryBond) // the provider matched every expected root
+	j.CanaryBond = 0
+}
+
+// ---------------------------------------------------------------- forced errors
+
+func (s *State) feCommit(p Params, h int32, o *Op) error {
+	if o.Actor != CouncilAccount || o.Amount < 0 {
+		return errors.New("only the council commits forced errors")
+	}
+	if err := s.debit(TreasuryAccount, o.Amount); err != nil {
+		return err
+	}
+	id := tagHash("fe", o.Ref[:])
+	s.FECommits[id] = &FECommit{ID: id, Commitment: o.H1, Reserve: o.Amount, Height: h, Expires: h + p.FERevealWindow}
+	return nil
+}
+
+// feReveal opens a commitment. It succeeds only once every decoy job has ended.
+func (s *State) feReveal(p Params, o *Op) error {
+	fc := s.FECommits[o.Job]
+	if fc == nil {
+		return errors.New("unknown forced-error commitment")
+	}
+	if FECommitment(o.Data, o.H1) != fc.Commitment {
+		return errors.New("record and salt do not open the commitment")
+	}
+	decoys, err := DecodeFERecord(o.Data)
+	if err != nil {
+		return err
+	}
+	set := map[AccountID]bool{}
+	for _, a := range decoys {
+		set[a] = true
+	}
+	var jobs []*Job
+	for _, j := range s.Jobs {
+		if set[j.Provider] && j.AcceptHeight > fc.Height && !j.Decoy {
+			if !j.Status.Terminal() {
+				return errors.New("a decoy job has not ended yet")
+			}
+			jobs = append(jobs, j)
+		}
+	}
+	sort.Slice(jobs, func(a, b int) bool { return bytes.Compare(jobs[a].ID[:], jobs[b].ID[:]) < 0 })
+	reserve := fc.Reserve
+	for _, j := range jobs {
+		j.Decoy = true
+		switch {
+		case j.Status == StatusFailed && len(j.Catchers) > 0:
+			s.Stats.DecoysCaught++
+			jp := min(p.Jackpot, reserve)
+			each := jp / Amount(len(j.Catchers))
+			for _, c := range j.Catchers {
+				s.credit(c, each)
+			}
+			paid := each * Amount(len(j.Catchers))
+			reserve -= paid
+			s.Stats.JackpotsPaid += paid
+			back := min(j.Bond, reserve) // the keyholders' decoy bond is reimbursed
+			s.credit(j.Provider, back)
+			reserve -= back
+		case j.Status == StatusSettled:
+			s.Stats.DecoysMissed++
+		}
+	}
+	s.credit(TreasuryAccount, reserve)
+	delete(s.FECommits, fc.ID)
+	return nil
+}
+
+// ---------------------------------------------------------------- end of block
+
+// endBlockPool resolves finished pool units, allocates this block's pool income, closes
+// epochs, and expires proposals and forced-error commitments.
+func (s *State) endBlockPool(p Params, h int32, income Amount) {
+	ids := make([]Hash, 0, len(s.Categories))
+	for id := range s.Categories {
+		ids = append(ids, id)
+	}
+	sort.Slice(ids, func(a, b int) bool { return bytes.Compare(ids[a][:], ids[b][:]) < 0 })
+	// finished units: delivered (settled) or released for another claim
+	for _, id := range ids {
+		c := s.Categories[id]
+		idx := make([]uint32, 0)
+		for i, u := range c.Units {
+			if !u.Done {
+				idx = append(idx, i)
+			}
+		}
+		sort.Slice(idx, func(a, b int) bool { return idx[a] < idx[b] })
+		for _, i := range idx {
+			j := s.Jobs[c.Units[i].Job]
+			if j == nil || !j.Status.Terminal() {
+				continue
+			}
+			c.InFlight--
+			if j.Status == StatusSettled {
+				c.Units[i] = UnitState{Job: j.ID, Done: true}
+				c.Done++
+				c.Epoch = append(c.Epoch, Delivery{Provider: j.Provider, Unit: i})
+			} else {
+				delete(c.Units, i)
+			}
+		}
+	}
+	// income allocation by cap share; the remainder stays in the pool reserve
+	if income > 0 {
+		for _, id := range ids {
+			c := s.Categories[id]
+			if c.Retired {
+				continue
+			}
+			share := income * c.Spec.CapBP / 10_000
+			if share > 0 && s.debit(PoolAccount, share) == nil {
+				c.Budget += share
+			}
+		}
+	}
+	// epoch close: equal payout per delivered unit
+	if p.PoolEpoch > 0 && (h+1)%p.PoolEpoch == 0 {
+		for _, id := range ids {
+			c := s.Categories[id]
+			if n := Amount(len(c.Epoch)); n > 0 {
+				per := c.Budget * p.PoolSpendBP / 10_000 / n
+				if per > 0 {
+					c.Price = per
+				}
+				for _, d := range c.Epoch {
+					tc := per * p.TreasuryShareBP / 10_000
+					s.credit(d.Provider, per-tc)
+					s.credit(TreasuryAccount, tc)
+				}
+				c.Budget -= per * n
+				s.Stats.PoolUnits += uint64(n)
+				s.Stats.PoolPaid += per * n
+				c.Epoch = nil
+			}
+			if !c.Closed && (c.Retired || c.Done == c.Spec.Units) && c.InFlight == 0 {
+				c.Retired, c.Closed = true, true
+				s.credit(PoolAccount, c.Budget)
+				c.Budget = 0
+			}
+		}
+	}
+	for id, pr := range s.Proposals {
+		if pr.Expires <= h {
+			delete(s.Proposals, id)
+		}
+	}
+	for id, fc := range s.FECommits {
+		if fc.Expires <= h {
+			s.credit(TreasuryAccount, fc.Reserve)
+			delete(s.FECommits, id)
+		}
+	}
+}
+
+// ---------------------------------------------------------------- encoding helpers
+
+func encodeCategory(c *Category) []byte {
+	var e enc
+	sp := c.Spec
+	e.w(sp.Model, sp.WorkRoot, sp.Units, sp.StagesPerUnit, sp.SeqLen, sp.K, sp.N, sp.UnitDeadline, sp.CapBP,
+		sp.InitPrice, sp.Grant, sp.Curator, sp.CanaryRoot, sp.CanaryLeaves,
+		c.Budget, c.Price, c.Retired, c.Closed, c.InFlight, c.Done)
+	e.u(uint64(len(c.Epoch)))
+	for _, d := range c.Epoch {
+		e.w(d.Provider, d.Unit)
+	}
+	return e.Bytes()
+}
+
+func unitKey(cat Hash, i uint32) []byte {
+	var b [36]byte
+	copy(b[:], cat[:])
+	binary.BigEndian.PutUint32(b[32:], i) // big-endian so keys sort by unit
+	return b[:]
+}
+
+func encodeUnit(u UnitState) []byte {
+	var e enc
+	e.w(u.Job, u.Done)
+	return e.Bytes()
+}
+
+func encodeProposal(pr *Proposal) []byte {
+	var e enc
+	e.w(pr.Action, pr.Expires)
+	e.u(uint64(len(pr.Approvals)))
+	for _, a := range pr.Approvals {
+		e.w(a)
+	}
+	return e.Bytes()
+}
+
+func encodeFECommit(f *FECommit) []byte {
+	var e enc
+	e.w(f.Commitment, f.Reserve, f.Height, f.Expires)
+	return e.Bytes()
+}
