+// playOut plays every dispute game on the job to the end with each party's real trace.
+func playOut(t *testing.T, w *poolWorld, tm *tinyModel, jid Hash, prov *party, salts, sl []Hash,
+	parties map[AccountID]*party) (games, oneStepOK int) {
+	for i := 0; i < 3000 && w.st.Jobs[jid].Status == StatusDisputed; i++ {
+		j := w.st.Jobs[jid]
+		var ops []*Op
+		if g := j.Game; g != nil {
+			if g.Phase == GTree && g.Lo == 0 && g.Size == g.N && !g.PMoved && !g.CMoved {
+				games++
+			}
+			disputant := parties[j.Disputes[0].Challenger]
+			switch g.Phase {
+			case GOneStep:
+				if o := prov.oneStep(tm, w.world, j, g, salts, sl); o != nil {
+					ops = append(ops, o)
+				}
+			case GReveal:
+				ops = append(ops, &Op{Kind: OpTraceReveal, Actor: prov.acct, Job: jid, Reveals: []StageReveal{
+					{Stage: g.Stage, Salt: salts[g.Stage], Root: prov.root(g.Stage), Proof: MerkleProof(sl, int(g.Stage))}}})
+			default:
+				if !g.PMoved {
+					if o := prov.move(tm, j, g); o != nil {
+						ops = append(ops, o)
+					}
+				}
+				if !g.CMoved {
+					if o := disputant.move(tm, j, g); o != nil {
+						ops = append(ops, o)
+					}
+				}
+			}
+		}
+		res := w.block(nil, ops, nil)
+		for k, o := range ops {
+			if o.Kind == OpOneStep && res.OpErrors[k] == nil {
+				oneStepOK++
+			}
+		}
+	}
+	if w.st.Jobs[jid].Status == StatusDisputed {
+		t.Fatal("game did not end")
+	}
+	return
+}
+
+// commitUnit claims unit 0 for prov and commits its trace with fixed salts.
+func commitUnit(t *testing.T, w *poolWorld, cat Hash, prov *party) (Hash, []Hash, []Hash) {
+	salts, sl := make([]Hash, 4), make([]Hash, 4)
+	for s := range salts {
+		salts[s] = tagHash("salt", u32b(uint32(s)), prov.acct[:])
+		sl[s] = StageLeaf(uint32(s), salts[s], prov.root(uint32(s)))
+	}
+	o := w.claimOp(cat, prov.acct, 0)
+	mustOK(t, w.block([]Deposit{{prov.acct, 1e9}}, []*Op{o}, nil))
+	id := tagHash("job", o.Ref[:])
+	mustOK(t, w.block(nil, []*Op{{Kind: OpTraceCommit, Actor: prov.acct, Job: id, H1: MerkleRoot(sl), H2: Hash{3}}}, nil))
+	for w.st.Jobs[id].Status == StatusCommitted {
+		w.block(nil, nil, nil)
+	}
+	return id, salts, sl
+}
