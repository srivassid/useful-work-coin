+// ---------------------------------------------------------------- forced errors
+
+func TestForcedErrorJackpots(t *testing.T) {
+	w := newPoolWorld(t, 506, 3)
+	w.block([]Deposit{{TreasuryAccount, 100_000_000}}, nil, nil)
+	decoyClient, caught, missed, early := acct(300), acct(301), acct(302), acct(303)
+	watcher := acct(81)
+	w.block([]Deposit{{decoyClient, 1e9}, {caught, 1e9}, {missed, 1e9}, {early, 1e9}, {watcher, 1e8}}, nil, nil)
+
+	// a decoy accepted before the commitment does not count
+	fee := Amount(8_000_000)
+	postEarly := &Op{Kind: OpJobPost, Actor: decoyClient, Model: w.model, H1: w.randHash(), U1: 8, Amount: fee, Deadline: w.h + 60, K: 2, N: 2, U2: 4}
+	mustOK(t, w.block(nil, []*Op{postEarly}, nil))
+	earlyID := tagHash("job", postEarly.Ref[:])
+	mustOK(t, w.block(nil, []*Op{{Kind: OpJobAccept, Actor: early, Job: earlyID, Amount: minBond(w.p, fee)}}, nil))
+
+	record := EncodeFERecord([]AccountID{caught, missed, early})
+	salt := w.randHash()
+	const reserve = 20_000_000
+	t0 := w.bal(TreasuryAccount)
+	pid, res := w.councilDo(&Op{Kind: OpFECommit, H1: FECommitment(record, salt), Amount: reserve})
+	mustOK(t, res)
+	fe := tagHash("fe", pid[:])
+	if w.bal(TreasuryAccount) != t0-reserve || w.st.FECommits[fe] == nil {
+		t.Fatal("reserve not taken from the treasury")
+	}
+
+	// two decoys, each with one wrong stage root
+	run := func(prov AccountID) (Hash, *trace, uint32) {
+		post := &Op{Kind: OpJobPost, Actor: decoyClient, Model: w.model, H1: w.randHash(), U1: 8, Amount: fee, Deadline: w.h + 60, K: 2, N: 2, U2: 4}
+		mustOK(t, w.block(nil, []*Op{post}, nil))
+		id := tagHash("job", post.Ref[:])
+		mustOK(t, w.block(nil, []*Op{{Kind: OpJobAccept, Actor: prov, Job: id, Amount: minBond(w.p, fee)}}, nil))
+		committed := w.newTrace(8)
+		truth := &trace{roots: append([]Hash(nil), committed.roots...)}
+		mustOK(t, w.block(nil, []*Op{{Kind: OpTraceCommit, Actor: prov, Job: id, H1: committed.commit(), H2: w.randHash()}}, nil))
+		for w.st.Jobs[id].Status == StatusCommitted {
+			w.block(nil, nil, nil)
+		}
+		j := w.st.Jobs[id]
+		// the forced error sits on a stage the committee did not sample (decided after their draw,
+		// so this test is deterministic; real decoys pick it in advance)
+		w.verify(j, committed, nil)
+		j = w.st.Jobs[id]
+		bad := uint32(0)
+		for ; j.requested()[bad]; bad++ {
+		}
+		truth.roots[bad] = w.randHash() // what an honest recomputation gives
+		w.revealRequested(id, prov, committed)
+		return id, truth, bad
+	}
+	idC, truthC, badC := run(caught)
+	idM, _, _ := run(missed)
+	mustOK(t, w.block(nil, []*Op{{Kind: OpChallenge, Actor: watcher, Job: idC, U1: badC, H1: truthC.roots[badC], Amount: w.p.ChallengeBondMin}}, nil))
+	if w.st.Jobs[idC].Status != StatusDisputed {
+		t.Fatal("watcher's catch not disputed")
+	}
+	// reveal fails while a decoy is still running
+	reveal := &Op{Kind: OpFEReveal, Actor: acct(5), Job: fe, H1: salt, Data: record}
+	if r := w.block(nil, []*Op{reveal}, nil); r.OpErrors[0] == nil {
+		t.Fatal("reveal accepted before the decoys ended")
+	}
+	w.block(nil, nil, []Verdict{{Job: idC, ProviderAtFault: true}})
+	w.run(int(w.p.ChallengeWindow) + 2)
+	if w.st.Jobs[idC].Status != StatusFailed || w.st.Jobs[idM].Status != StatusSettled {
+		t.Fatalf("decoys: %v %v", w.st.Jobs[idC].Status, w.st.Jobs[idM].Status)
+	}
+	for !w.st.Jobs[earlyID].Status.Terminal() {
+		w.block(nil, nil, nil)
+	}
+	// a wrong salt does not open the commitment
+	bad := *reveal
+	bad.Ref, bad.H1 = Hash{}, w.randHash()
+	wb, cb, t1 := w.bal(watcher), w.bal(caught), w.bal(TreasuryAccount)
+	r := w.block(nil, []*Op{&bad, {Kind: OpFEReveal, Actor: acct(5), Job: fe, H1: salt, Data: record}}, nil)
+	if r.OpErrors[0] == nil || r.OpErrors[1] != nil {
+		t.Fatalf("reveal: %v", r.OpErrors)
+	}
+	bond := w.st.Jobs[idC].Bond
+	if w.bal(watcher)-wb != w.p.Jackpot || w.bal(caught)-cb != bond {
+		t.Fatalf("jackpot %d (want %d), decoy bond back %d (want %d)", w.bal(watcher)-wb, w.p.Jackpot, w.bal(caught)-cb, bond)
+	}
+	if w.bal(TreasuryAccount)-t1 != reserve-w.p.Jackpot-bond {
+		t.Fatal("rest of the reserve not returned")
+	}
+	st := w.st.Stats
+	if st.DecoysCaught != 1 || st.DecoysMissed != 1 || st.JackpotsPaid != w.p.Jackpot || !w.st.Jobs[earlyID].Status.Terminal() || w.st.Jobs[earlyID].Decoy {
+		t.Fatalf("stats %+v", st)
+	}
+	if w.st.FECommits[fe] != nil {
+		t.Fatal("commitment not consumed")
+	}
+	// an unrevealed commitment expires and its reserve returns
+	pid2, res2 := w.councilDo(&Op{Kind: OpFECommit, H1: w.randHash(), Amount: 1_000_000})
+	mustOK(t, res2)
+	t2 := w.bal(TreasuryAccount)
+	w.run(int(w.p.FERevealWindow) + 1)
+	if w.st.FECommits[tagHash("fe", pid2[:])] != nil || w.bal(TreasuryAccount) < t2+1_000_000 {
+		t.Fatal("commitment did not expire")
+	}
+}
