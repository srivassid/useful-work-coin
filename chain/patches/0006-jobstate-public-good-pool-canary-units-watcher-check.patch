+func TestFERecordRoundTrip(t *testing.T) {
+	a := []AccountID{acct(1), acct(2), acct(3)}
+	b := EncodeFERecord(a)
+	d, err := DecodeFERecord(b)
+	if err != nil || len(d) != 3 || d[2] != a[2] {
+		t.Fatal(err)
+	}
+	if _, err := DecodeFERecord(append(b, 0)); err == nil {
+		t.Fatal("trailing byte accepted")
+	}
+	if _, err := DecodeFERecord(b[:len(b)-1]); err == nil {
+		t.Fatal("truncated record accepted")
+	}
+}
