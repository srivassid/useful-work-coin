+var errNoVerifier = errors.New("no staked verifier holds this job's model")
+
+// eligible: may staker a (stake st) sit on a committee for a job of model m between client and
+// provider? From Rules 5 it must have declared m (VERIFIER_MODELS).
+func (s *State) eligible(p Params, a AccountID, st Amount, m Hash, client, provider AccountID) bool {
+	if st < p.MinVerifierStake || a == client || a == provider {
+		return false
+	}
+	if p.Rules < 5 {
+		return true
+	}
+	ms := s.VerifierModels[a]
+	i := sort.Search(len(ms), func(i int) bool { return bytes.Compare(ms[i][:], m[:]) >= 0 })
+	return i < len(ms) && ms[i] == m
+}
+
+// HasVerifierFor reports whether a committee could be drawn for a job of model m between client
+// and provider. Before Rules 5 it is always true (any staker is drawn, whatever it runs); from
+// Rules 5 a provider cannot take work that no verifier would check (JOB_ACCEPT, POOL_CLAIM).
+func (s *State) HasVerifierFor(p Params, m Hash, client, provider AccountID) bool {
+	if p.Rules < 5 {
+		return true
+	}
+	for a, st := range s.Stakes {
+		if s.eligible(p, a, st, m, client, provider) {
+			return true
+		}
+	}
+	return false
+}
+
+// declareModels (VERIFIER_MODELS, Rules >= 5) replaces the actor's list of models it verifies.
+// The list must name registered models in strictly increasing order; an empty list withdraws.
+// Declaring needs no stake: the models count once the account stakes at least MinVerifierStake.
+func (s *State) declareModels(p Params, o *Op) error {
+	if p.Rules < 5 {
+		return errors.New("VERIFIER_MODELS needs Rules 5")
+	}
+	if len(o.Roots) > MaxVerifierModels {
+		return errors.New("too many models")
+	}
+	for i, m := range o.Roots {
+		if i > 0 && bytes.Compare(o.Roots[i-1][:], m[:]) >= 0 {
+			return errors.New("models are not in strictly increasing order")
+		}
+		if s.Models[m] == nil {
+			return errors.New("unknown model")
+		}
+	}
+	if len(o.Roots) == 0 {
+		delete(s.VerifierModels, o.Actor)
+		return nil
+	}
+	if s.VerifierModels == nil {
+		s.VerifierModels = map[AccountID][]Hash{}
+	}
+	s.VerifierModels[o.Actor] = append([]Hash(nil), o.Roots...)
+	return nil
+}
+
+// abortUnverifiable ends a committed job no committee could be drawn for (Rules >= 5): the
+// client's fee (a pool unit's verification pay: back to its category, which frees the unit) and
+// the provider's bond are returned; nobody is paid or penalized.
+func (s *State) abortUnverifiable(j *Job) {
+	s.refundClient(j, j.Fee)
+	s.credit(j.Provider, j.Bond)
+	s.refundCanaryBond(j)
+	j.Status, j.PhaseEnd = StatusAborted, 0
+}
