@@ -0,0 +1,231 @@
+package jobstate
+
+import (
+	"bytes"
+	"encoding/gob"
+	"errors"
+	"reflect"
+	"sort"
+	"testing"
+)
+
+// Rules 5: committees only from verifiers that hold the job's model (testnet, 2026-11-10: with
+// Qwen3, Llama and Mistral pools open, committees were drawn from every staker, so verifiers that
+// held only Qwen3 sat on Llama jobs, failed to show and were penalized, and 7 wrong Llama jobs
+// settled with no verifier that could check them).
+
+func sortedModels(ms ...Hash) []Hash {
+	out := append([]Hash(nil), ms...)
+	sort.Slice(out, func(i, j int) bool { return bytes.Compare(out[i][:], out[j][:]) < 0 })
+	return out
+}
+
+func declare(a AccountID, ms ...Hash) *Op {
+	return &Op{Kind: OpVerifierModels, Actor: a, Roots: ms}
+}
+
+// secondModel registers another model and returns its id.
+func (w *world) secondModel() Hash {
+	reg := &Op{Kind: OpModelReg, Actor: w.client, H1: w.randHash(), H2: w.randHash(), U1: 4, U2: 0, Cfg: smallCfg}
+	mustOK(w.t, w.block(nil, []*Op{reg}, nil))
+	return tagHash("model", reg.Ref[:])
+}
+
+func TestRules5VerifierModelsWireFormat(t *testing.T) {
+	for _, n := range []int{0, 1, 3, MaxVerifierModels} {
+		o := &Op{Kind: OpVerifierModels}
+		for i := 0; i < n; i++ {
+			o.Roots = append(o.Roots, Hash{byte(i + 1)})
+		}
+		d, err := DecodeOp(o.Encode())
+		if err != nil || d.Kind != OpVerifierModels || len(d.Roots) != n || (n > 0 && !reflect.DeepEqual(d.Roots, o.Roots)) {
+			t.Fatalf("%d models: %v %+v", n, err, d)
+		}
+	}
+	o := &Op{Kind: OpVerifierModels}
+	for i := 0; i <= MaxVerifierModels; i++ {
+		o.Roots = append(o.Roots, Hash{byte(i + 1)})
+	}
+	if _, err := DecodeOp(o.Encode()); err == nil {
+		t.Fatal("more than MaxVerifierModels models decoded")
+	}
+	if OpVerifierModels.String() != "VERIFIER_MODELS" {
+		t.Fatal(OpVerifierModels.String())
+	}
+}
+
+func TestRules5Declarations(t *testing.T) {
+	w := newPoolWorld(t, 701, 2)
+	v := w.verifiers[0]
+	m2 := w.secondModel()
+	both := sortedModels(w.model, m2)
+	w.p.Rules = 4
+	if r := w.block(nil, []*Op{declare(v, w.model)}, nil); r.OpErrors[0] == nil || w.st.VerifierModels != nil {
+		t.Fatal("VERIFIER_MODELS applied before Rules 5")
+	}
+	w.p.Rules = 5
+	root := w.st.Root()
+	mustOK(t, w.block(nil, []*Op{declare(v, both...)}, nil))
+	if !reflect.DeepEqual(w.st.VerifierModels[v], both) {
+		t.Fatalf("declared %v", w.st.VerifierModels[v])
+	}
+	if w.st.Root() == root {
+		t.Fatal("the state root does not commit declarations")
+	}
+	tooMany := make([]Hash, MaxVerifierModels+1)
+	for name, op := range map[string]*Op{
+		"decreasing":    declare(v, both[1], both[0]),
+		"duplicate":     declare(v, w.model, w.model),
+		"unknown model": declare(v, w.randHash()),
+		"too many":      declare(v, tooMany...),
+	} {
+		if r := w.block(nil, []*Op{op}, nil); r.OpErrors[0] == nil {
+			t.Fatalf("%s: applied", name)
+		}
+		if !reflect.DeepEqual(w.st.VerifierModels[v], both) {
+			t.Fatalf("%s: a failed declaration changed the list", name)
+		}
+	}
+	mustOK(t, w.block(nil, []*Op{declare(v, m2)}, nil)) // a new list replaces the old one
+	if !reflect.DeepEqual(w.st.VerifierModels[v], []Hash{m2}) {
+		t.Fatalf("replaced list %v", w.st.VerifierModels[v])
+	}
+	mustOK(t, w.block(nil, []*Op{declare(v)}, nil)) // an empty list withdraws
+	if _, ok := w.st.VerifierModels[v]; ok {
+		t.Fatal("an empty declaration left an entry")
+	}
+}
+
+func TestRules5CommitteeOnlyFromDeclaredVerifiers(t *testing.T) {
+	w := newWorld(t, 702, 6)
+	m2 := w.secondModel()
+	w.p.Rules = 5
+	holders := map[AccountID]bool{w.verifiers[0]: true, w.verifiers[3]: true}
+	mustOK(t, w.block(nil, []*Op{declare(w.verifiers[0], w.model), declare(w.verifiers[3], sortedModels(w.model, m2)...),
+		declare(w.verifiers[1], m2), declare(w.verifiers[2], m2)}, nil)) // 4 and 5 declare nothing
+	for i := 0; i < 12; i++ {
+		j := w.startJob(5_000_000, 8, 3, 2, w.newTrace(8))
+		if len(j.Committee) != 2 {
+			t.Fatalf("job %d: committee of %d, want the 2 holders of its model", i, len(j.Committee))
+		}
+		for _, v := range j.Committee {
+			if !holders[v.Account] {
+				t.Fatalf("job %d: %v sits without holding the model", i, v.Account)
+			}
+		}
+	}
+	// Rules 4: every staker is drawn, declared or not (the testnet's behaviour until Rules 5)
+	w.p.Rules = 4
+	j := w.startJob(5_000_000, 8, 6, 2, w.newTrace(8))
+	if len(j.Committee) != 6 {
+		t.Fatalf("Rules 4 committee of %d, want all 6 stakers", len(j.Committee))
+	}
+}
+
+func TestRules5NoWorkWithoutAVerifier(t *testing.T) {
+	w := newPoolWorld(t, 703, 2)
+	w.income = 500_000
+	w.run(2)
+	m2 := w.secondModel()
+	w.p.Rules = 5
+	sp := w.spec(4)
+	sp.Grant = 300_000
+	cat := w.openCategory(sp)
+	prov := acct(70)
+	w.block([]Deposit{{prov, 1e9}}, []*Op{{Kind: OpStake, Actor: prov, Amount: 2 * w.p.MinVerifierStake}}, nil)
+	before := w.bal(prov)
+	// nobody declared the pool's model; a verifier of another model, and the provider itself,
+	// do not count
+	mustOK(t, w.block(nil, []*Op{declare(w.verifiers[0], m2), declare(prov, w.model)}, nil))
+	r := w.block(nil, []*Op{w.claimOp(cat, prov, 0)}, nil)
+	if !errors.Is(r.OpErrors[0], errNoVerifier) || w.bal(prov) != before || len(w.st.Categories[cat].Units) != 0 {
+		t.Fatalf("claim with no verifier of the model: %v", r.OpErrors[0])
+	}
+	post := &Op{Kind: OpJobPost, Actor: w.client, Model: w.model, H1: w.randHash(), U1: 8, Amount: 5_000_000,
+		Deadline: w.h + 50, K: 2, N: 2, U2: 4}
+	mustOK(t, w.block(nil, []*Op{post}, nil))
+	id := tagHash("job", post.Ref[:])
+	acc := &Op{Kind: OpJobAccept, Actor: prov, Job: id, Amount: minBond(w.p, 5_000_000)}
+	if r := w.block(nil, []*Op{acc}, nil); !errors.Is(r.OpErrors[0], errNoVerifier) || w.st.Jobs[id].Status != StatusPosted {
+		t.Fatalf("accept with no verifier of the model: %v", r.OpErrors[0])
+	}
+	// a staked verifier declares the model: both go through
+	mustOK(t, w.block(nil, []*Op{declare(w.verifiers[1], w.model)}, nil))
+	mustOK(t, w.block(nil, []*Op{w.claimOp(cat, prov, 0), {Kind: OpJobAccept, Actor: prov, Job: id, Amount: minBond(w.p, 5_000_000)}}, nil))
+	// a declaration counts only with stake
+	w2 := newPoolWorld(t, 704, 0)
+	w2.p.Rules = 5
+	lone := acct(120)
+	mustOK(t, w2.block([]Deposit{{lone, 1e8}}, []*Op{declare(lone, w2.model)}, nil))
+	if w2.st.HasVerifierFor(w2.p, w2.model, PoolAccount, acct(70)) {
+		t.Fatal("an unstaked declaration counts as a verifier")
+	}
+	mustOK(t, w2.block(nil, []*Op{{Kind: OpStake, Actor: lone, Amount: w2.p.MinVerifierStake}}, nil))
+	if !w2.st.HasVerifierFor(w2.p, w2.model, PoolAccount, acct(70)) {
+		t.Fatal("a staked declaration does not count")
+	}
+}
+
+func TestRules5UnverifiableJobIsAborted(t *testing.T) {
+	w := newPoolWorld(t, 705, 1)
+	w.income = 500_000
+	w.run(2)
+	w.p.Rules = 5
+	sp := w.spec(2)
+	sp.Grant = 300_000
+	cat := w.openCategory(sp)
+	v, prov := w.verifiers[0], acct(70)
+	w.block([]Deposit{{prov, 1e9}}, []*Op{declare(v, w.model)}, nil)
+	provBefore, budgetBefore := w.bal(prov), w.st.Categories[cat].Budget
+	o := w.claimOp(cat, prov, 0)
+	mustOK(t, w.block(nil, []*Op{o}, nil))
+	id := tagHash("job", o.Ref[:])
+	tr := w.newTrace(8)
+	// the only verifier of the model withdraws between the claim and the draw
+	mustOK(t, w.block(nil, []*Op{{Kind: OpTraceCommit, Actor: prov, Job: id, H1: tr.commit(), H2: w.randHash()},
+		declare(v)}, nil))
+	for w.st.Jobs[id].Status == StatusCommitted {
+		w.block(nil, nil, nil)
+	}
+	j := w.st.Jobs[id]
+	if j.Status != StatusAborted || len(j.Committee) != 0 {
+		t.Fatalf("status %v with %d seats, want aborted with none", j.Status, len(j.Committee))
+	}
+	if w.bal(prov) != provBefore {
+		t.Fatalf("provider balance %d, want %d (bond returned)", w.bal(prov), provBefore)
+	}
+	if b := w.st.Categories[cat].Budget; b < budgetBefore {
+		t.Fatalf("category budget %d, below %d before the claim", b, budgetBefore)
+	}
+	if _, held := w.st.Categories[cat].Units[0]; held {
+		t.Fatal("the unit is still held")
+	}
+	// the unit can be claimed again once a verifier holds the model
+	mustOK(t, w.block(nil, []*Op{declare(v, w.model)}, nil))
+	mustOK(t, w.block(nil, []*Op{w.claimOp(cat, prov, 0)}, nil))
+}
+
+// The node keeps the job state in gob snapshots (blockchain/jobs.go): declarations survive one,
+// and a snapshot from before Rules 5 (no field) decodes to a state with the same root.
+func TestRules5StateSnapshot(t *testing.T) {
+	w := newWorld(t, 706, 2)
+	plain := w.st.Clone()
+	w.p.Rules = 5
+	mustOK(t, w.block(nil, []*Op{declare(w.verifiers[0], w.model)}, nil))
+	for _, st := range []*State{plain, w.st} {
+		var buf bytes.Buffer
+		if err := gob.NewEncoder(&buf).Encode(st); err != nil {
+			t.Fatal(err)
+		}
+		got := NewState()
+		if err := gob.NewDecoder(&buf).Decode(got); err != nil {
+			t.Fatal(err)
+		}
+		if got.Root() != st.Root() || !reflect.DeepEqual(got.VerifierModels, st.VerifierModels) {
+			t.Fatal("a gob snapshot changed the state")
+		}
+	}
+	if len(plain.VerifierModels) != 0 {
+		t.Fatal("a state from before Rules 5 has declarations")
+	}
+}
