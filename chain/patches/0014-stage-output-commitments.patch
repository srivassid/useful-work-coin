--- a/node/jobstate/program.go
+++ b/node/jobstate/program.go
@@ -266,3 +266,61 @@ func f32w(v float32) uint32 { return math.Float32bits(v) }
 func wf32(w uint32) float32 { return math.Float32frombits(w) }
 
 func sqrtF64(x float64) float64 { return math.Sqrt(x) }
+
+// ---------------------------------------------------------------- stage commitments (step 7)
+//
+// A stage is committed by its OUTPUT: the T rows the next stage reads (the last layer's R2
+// rows), as StageOutputRoot. Providers and verifiers then compute only the forward pass and
+// hash T rows per stage. The full trace is built only when a stage is disputed, as
+//   TraceCommit = nodeHash(BodyRoot, OutputRoot)
+// where the body is every program leaf except those output rows, in program order. Every op
+// still depends only on earlier leaves, so bisection over the body and then the outputs ends at
+// one element whose inputs both parties agree on.
+
+// StageOutLeaf is the output-tree leaf of token t.
+func StageOutLeaf(t int, rowRoot Hash) Hash {
+	var b [4 + 4 + 32]byte
+	copy(b[:4], "sout")
+	binary.LittleEndian.PutUint32(b[4:8], uint32(t))
+	copy(b[8:], rowRoot[:])
+	return leafHash(b[:])
+}
+
+// StageOutputRoot commits a stage's output rows (one per token, in token order).
+func StageOutputRoot(rows [][]uint32) Hash {
+	lv := make([]Hash, len(rows))
+	for t, r := range rows {
+		lv[t] = StageOutLeaf(t, RowRoot(r))
+	}
+	return MerkleRoot(lv)
+}
+
+// isOutput reports whether d is one of the stage's output rows (last layer's R2).
+func isOutput(d LeafDesc, l1 int) bool { return d.Op == LR2 && d.Layer == l1-1 }
+
+// SplitProgram returns the body (program order, outputs removed), the program index of each
+// body leaf, and the program index of each output row by token.
+func SplitProgram(prog []LeafDesc, l1 int) (body []LeafDesc, bodyAt []int, outAt []int) {
+	for i, d := range prog {
+		if isOutput(d, l1) {
+			outAt = append(outAt, i)
+		} else {
+			body = append(body, d)
+			bodyAt = append(bodyAt, i)
+		}
+	}
+	return
+}
+
+// TraceCommit splits a full trace (rows in program order) into body leaves, output leaves and
+// the dispute commitment nodeHash(BodyRoot, OutputRoot).
+func TraceCommit(prog []LeafDesc, l1 int, rows [][]uint32) (bodyLeaves, outLeaves []Hash, commit Hash) {
+	_, bodyAt, outAt := SplitProgram(prog, l1)
+	for bi, pi := range bodyAt {
+		bodyLeaves = append(bodyLeaves, TraceLeaf(bi, RowRoot(rows[pi])))
+	}
+	for t, pi := range outAt {
+		outLeaves = append(outLeaves, StageOutLeaf(t, RowRoot(rows[pi])))
+	}
+	return bodyLeaves, outLeaves, nodeHash(MerkleRoot(bodyLeaves), MerkleRoot(outLeaves))
+}
