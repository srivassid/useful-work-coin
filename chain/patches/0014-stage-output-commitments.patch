+// TestAgentTraceCommit: the agent's body/output split and output roots (runtime/agent/game.py,
+// proto.stage_output_root) match TraceCommit and StageOutputRoot.
+func TestAgentTraceCommit(t *testing.T) {
+	raw, err := os.ReadFile("testdata/agent_vectors.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var v struct {
+		TC struct {
+			T        int
+			Rows     [][]uint32
+			BodyRoot string `json:"body_root"`
+			OutRoot  string `json:"out_root"`
+			OutRoot2 string `json:"out_root2"`
+			NBody    int    `json:"n_body"`
+		} `json:"trace_commit"`
+	}
+	if err := json.Unmarshal(raw, &v); err != nil {
+		t.Fatal(err)
+	}
+	cfg := ModelCfg{D: 8, H: 2, Hkv: 1, Hd: 4, I: 8, L: 2, V: 16, Eps: 1e-6, Bs: 0, MaxPos: 64}
+	prog := Program(cfg, v.TC.T, 0, 2)
+	if len(prog) != len(v.TC.Rows) {
+		t.Fatalf("program %d leaves, agent %d", len(prog), len(v.TC.Rows))
+	}
+	body, out, commit := TraceCommit(prog, 2, v.TC.Rows)
+	br, or := MerkleRoot(body), MerkleRoot(out)
+	if hex.EncodeToString(br[:]) != v.TC.BodyRoot || hex.EncodeToString(or[:]) != v.TC.OutRoot || len(body) != v.TC.NBody {
+		t.Fatal("body or output root differs from the agent's")
+	}
+	_, _, outAt := SplitProgram(prog, 2)
+	var outs [][]uint32
+	for _, i := range outAt {
+		outs = append(outs, v.TC.Rows[i])
+	}
+	so := StageOutputRoot(outs)
+	if hex.EncodeToString(so[:]) != v.TC.OutRoot2 || so != or || commit != nodeHash(br, or) {
+		t.Fatal("stage output root differs")
+	}
+}
