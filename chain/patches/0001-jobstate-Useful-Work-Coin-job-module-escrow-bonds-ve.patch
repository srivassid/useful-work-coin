+func TestExpiryAndAcceptWithoutCommit(t *testing.T) {
+	w := newWorld(t, 6, 2)
+	c0, p0 := w.bal(w.client), w.bal(w.provider)
+	post := &Op{Kind: OpJobPost, Actor: w.client, Model: w.model, U1: 4, Amount: 1_000_000, Deadline: w.h + 5, K: 2, N: 2}
+	mustOK(t, w.block(nil, []*Op{post}, nil))
