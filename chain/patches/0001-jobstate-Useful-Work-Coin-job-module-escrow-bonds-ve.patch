+package jobstate
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"math/rand/v2"
+	"reflect"
+	"testing"
+)
+
+// ---------------------------------------------------------------- harness
+
+func acct(i int) AccountID { return AccountForScript([]byte{0x51, byte(i), byte(i >> 8)}) }
+
+type sim struct {
+	t    *testing.T
+	p    Params
+	st   *State
+	h    int32
+	rng  *rand.Rand
+	refN uint64
+}
+
+func newSim(t *testing.T, seed uint64) *sim {
+	p := DefaultParams()
+	p.ChallengeWindow, p.DisputeTimeout, p.UnbondDelay = 20, 30, 15
+	return &sim{t: t, p: p, st: NewState(), rng: rand.New(rand.NewPCG(seed, seed^0x9e37))}
+}
+
+func (s *sim) ref() Hash {
+	s.refN++
+	return tagHash("ref", u32b(uint32(s.refN)), u32b(uint32(s.refN>>32)))
+}
+
+func (s *sim) randHash() (h Hash) {
+	for i := range h {
+		h[i] = byte(s.rng.Uint32())
+	}
+	return
+}
+
+// block applies one block and checks the invariants that must hold after every block.
+func (s *sim) block(deps []Deposit, ops []*Op, verdicts []Verdict) *BlockResult {
+	s.t.Helper()
+	s.h++
+	for _, o := range ops {
+		if o.Ref == (Hash{}) {
+			o.Ref = s.ref()
+		}
+	}
+	prev := s.randHash()
+	before := s.st.Clone()
+	in := BlockInput{Height: s.h, PrevHash: prev, Deposits: deps, Ops: ops, Verdicts: verdicts}
+	res := ApplyBlock(s.st, s.p, in)
+	// replay determinism: the same block on the pre-state gives the same root and payouts
+	again := ApplyBlock(before, s.p, in)
+	if again.Root != res.Root || !reflect.DeepEqual(again.Withdrawals, res.Withdrawals) {
+		s.t.Fatalf("block %d not deterministic", s.h)
+	}
+	s.check()
+	return res
+}
+
+func (s *sim) check() {
+	s.t.Helper()
+	st := s.st
+	if got, want := st.Holdings(), st.TotalIn-st.PaidOut; got != want {
+		s.t.Fatalf("height %d: conservation broken: holdings %d, expected %d", s.h, got, want)
+	}
+	for a, v := range st.Accounts {
+		if v <= 0 {
+			s.t.Fatalf("account %v has non-positive stored balance %d", a, v)
+		}
+	}
+	for a, v := range st.Stakes {
+		if v <= 0 {
+			s.t.Fatalf("stake %v non-positive %d", a, v)
+		}
+	}
+	for _, u := range st.Unbonding {
+		if u.Amount <= 0 {
+			s.t.Fatalf("empty unbonding entry")
+		}
+	}
+	for _, w := range st.Withdrawals {
+		if w.Amount <= 0 || w.Due <= s.h {
+			s.t.Fatalf("bad pending withdrawal %+v at %d", w, s.h)
+		}
+	}
+	for _, j := range st.Jobs {
+		if j.Held() < 0 {
+			s.t.Fatalf("job %v holds %d", j.ID, j.Held())
+		}
+	}
+	if st.Clone().Root() != st.Root() {
+		s.t.Fatal("root differs between clones")
+	}
+}
+
+func (s *sim) run(n int) {
+	for i := 0; i < n; i++ {
+		s.block(nil, nil, nil)
+	}
+}
+
+func (s *sim) bal(a AccountID) Amount { return s.st.Accounts[a] }
+
+func mustOK(t *testing.T, r *BlockResult) {
+	t.Helper()
+	for _, e := range r.OpErrors {
+		if e != nil {
+			t.Fatalf("op failed: %v", e)
+		}
+	}
+}
+
+// trace is a provider's honest work: one output root per stage, salted and committed.
+type trace struct {
+	roots, salts []Hash
+	leaves       []Hash
+}
+
+func (s *sim) newTrace(stages uint32) *trace {
+	tr := &trace{}
+	for i := uint32(0); i < stages; i++ {
+		r, sl := s.randHash(), s.randHash()
+		tr.roots, tr.salts = append(tr.roots, r), append(tr.salts, sl)
+		tr.leaves = append(tr.leaves, StageLeaf(i, sl, r))
+	}
+	return tr
+}
+
+func (tr *trace) commit() Hash { return MerkleRoot(tr.leaves) }
+
+func (tr *trace) reveal(stages []uint32) []StageReveal {
+	var out []StageReveal
+	for _, st := range stages {
+		out = append(out, StageReveal{Stage: st, Salt: tr.salts[st], Root: tr.roots[st], Proof: MerkleProof(tr.leaves, int(st))})
+	}
+	return out
+}
+
+// world: funded client, provider, several staked verifiers and a registered model.
+type world struct {
+	*sim
+	client, provider AccountID
+	verifiers        []AccountID
+	model            Hash
+}
+
+func newWorld(t *testing.T, seed uint64, nVerifiers int) *world {
+	s := newSim(t, seed)
+	w := &world{sim: s, client: acct(1), provider: acct(2)}
+	deps := []Deposit{{w.client, 1e9}, {w.provider, 1e9}}
+	var ops []*Op
+	for i := 0; i < nVerifiers; i++ {
+		v := acct(100 + i)
+		w.verifiers = append(w.verifiers, v)
+		deps = append(deps, Deposit{v, 1e8})
+		ops = append(ops, &Op{Kind: OpStake, Actor: v, Amount: s.p.MinVerifierStake * 2})
+	}
+	reg := &Op{Kind: OpModelReg, Actor: w.client, H1: s.randHash(), H2: s.randHash(), U1: 4, U2: 512}
+	ops = append(ops, reg)
+	mustOK(t, s.block(deps, ops, nil))
+	w.model = tagHash("model", reg.Ref[:])
+	return w
+}
+
+// post + accept + commit, then run until the committee is drawn. Returns the job.
+func (w *world) startJob(fee Amount, stages uint32, k, n uint8, tr *trace) *Job {
+	post := &Op{Kind: OpJobPost, Actor: w.client, Model: w.model, H1: w.randHash(), U1: stages, Amount: fee,
+		Deadline: w.h + 50, K: k, N: n}
+	mustOK(w.t, w.block(nil, []*Op{post}, nil))
+	id := tagHash("job", post.Ref[:])
+	mustOK(w.t, w.block(nil, []*Op{{Kind: OpJobAccept, Actor: w.provider, Job: id, Amount: minBond(w.p, fee)}}, nil))
+	mustOK(w.t, w.block(nil, []*Op{{Kind: OpTraceCommit, Actor: w.provider, Job: id, H1: tr.commit(), H2: w.randHash()}}, nil))
+	for w.st.Jobs[id].Status == StatusCommitted {
+		w.block(nil, nil, nil)
+	}
+	return w.st.Jobs[id]
+}
+
+// verifiers (except `skip`) commit to and then reveal the roots in tr at their sampled stages.
+func (w *world) verify(j *Job, tr *trace, skip map[AccountID]bool) {
+	salts := map[AccountID]Hash{}
+	var commits []*Op
+	for _, v := range j.Committee {
+		if skip[v.Account] {
+			continue
+		}
+		salt := w.randHash()
+		salts[v.Account] = salt
+		pos := Positions(salt, j.Stages, int(j.N))
+		roots := make([]Hash, len(pos))
+		for i, p := range pos {
+			roots[i] = tr.roots[p]
+		}
+		commits = append(commits, &Op{Kind: OpVerifyCommit, Actor: v.Account, Job: j.ID,
+			H1: sha256.Sum256(salt[:]), H2: ResultHash(roots, v.Account, salt)})
+	}
+	mustOK(w.t, w.block(nil, commits, nil))
+	for w.st.Jobs[j.ID].Status == StatusVerifyCommit {
+		w.block(nil, nil, nil)
+	}
+	var reveals []*Op
+	for _, v := range j.Committee {
+		salt, ok := salts[v.Account]
+		if !ok {
+			continue
+		}
+		pos := Positions(salt, j.Stages, int(j.N))
+		roots := make([]Hash, len(pos))
+		for i, p := range pos {
+			roots[i] = tr.roots[p]
+		}
+		reveals = append(reveals, &Op{Kind: OpVerifyReveal, Actor: v.Account, Job: j.ID, H1: salt, Roots: roots})
+	}
+	mustOK(w.t, w.block(nil, reveals, nil))
+}
+
+// ---------------------------------------------------------------- scenario tests
+
+func TestHonestJobSettlesExactly(t *testing.T) {
+	w := newWorld(t, 1, 5)
+	fee := Amount(10_000_000)
+	c0, p0, tr0 := w.bal(w.client), w.bal(w.provider), w.bal(TreasuryAccount)
+	vb := map[AccountID]Amount{}
+	for _, v := range w.verifiers {
+		vb[v] = w.bal(v)
+	}
+	tr := w.newTrace(40)
+	j := w.startJob(fee, 40, 3, 2, tr)
+	if len(j.Committee) != 3 {
+		t.Fatalf("committee size %d", len(j.Committee))
+	}
+	w.verify(j, tr, nil)
+	j = w.st.Jobs[j.ID]
+	if j.Status != StatusProviderReveal {
+		t.Fatalf("status %v", j.Status)
+	}
+	var want []uint32
+	for st := range j.requested() {
+		want = append(want, st)
+	}
+	mustOK(t, w.block(nil, []*Op{{Kind: OpTraceReveal, Actor: w.provider, Job: j.ID, Reveals: tr.reveal(want)}}, nil))
+	w.block(nil, nil, nil)
+	if w.st.Jobs[j.ID].Status != StatusChallenge {
+		t.Fatalf("status %v", w.st.Jobs[j.ID].Status)
+	}
+	w.run(int(w.p.ChallengeWindow) + 1)
+	j = w.st.Jobs[j.ID]
+	if j.Status != StatusSettled {
+		t.Fatalf("status %v", j.Status)
+	}
+	vp, tc := JobPay(w.p, fee, 3, 2)
+	if d := w.bal(w.client) - c0; d != -fee {
+		t.Fatalf("client paid %d", -d)
+	}
+	if d := w.bal(w.provider) - p0; d != fee-vp-tc {
+		t.Fatalf("provider earned %d, want %d", d, fee-vp-tc)
+	}
+	each := vp / 3
+	for _, v := range j.Committee {
+		if d := w.bal(v.Account) - vb[v.Account]; d != each {
+			t.Fatalf("verifier earned %d, want %d", d, each)
+		}
+	}
+	if d := w.bal(TreasuryAccount) - tr0; d != tc+vp-3*each {
+		t.Fatalf("treasury got %d", d)
+	}
+}
+
+func TestWithholdingProviderIsSlashed(t *testing.T) {
+	w := newWorld(t, 2, 4)
+	fee := Amount(4_000_000)
+	c0, p0 := w.bal(w.client), w.bal(w.provider)
+	tr := w.newTrace(16)
+	j := w.startJob(fee, 16, 2, 3, tr)
+	w.verify(j, tr, nil)
+	w.run(int(w.p.ProviderRevealWindow) + 1) // provider never reveals
+	j = w.st.Jobs[j.ID]
+	if j.Status != StatusFailed {
+		t.Fatalf("status %v", j.Status)
+	}
+	if w.bal(w.client) != c0 {
+		t.Fatal("client not refunded")
+	}
+	if d := w.bal(w.provider) - p0; d != -minBond(w.p, fee) {
+		t.Fatalf("provider lost %d", -d)
+	}
+}
+
+func TestCheatingProviderCaughtByVerifier(t *testing.T) {
+	for _, atFault := range []bool{true, false} {
+		w := newWorld(t, 3, 4)
+		fee := Amount(6_000_000)
+		c0, p0 := w.bal(w.client), w.bal(w.provider)
+		honest := w.newTrace(24)
+		j := w.startJob(fee, 24, 2, 2, honest)
+		// the provider committed `honest`, but what it actually computed (and what an honest
+		// verifier recomputes) differs at every stage: model it as verifiers holding other roots
+		truth := w.newTrace(24)
+		w.verify(j, truth, nil)
+		j = w.st.Jobs[j.ID]
+		var want []uint32
+		for st := range j.requested() {
+			want = append(want, st)
+		}
+		mustOK(t, w.block(nil, []*Op{{Kind: OpTraceReveal, Actor: w.provider, Job: j.ID, Reveals: honest.reveal(want)}}, nil))
+		w.block(nil, nil, nil)
+		if w.st.Jobs[j.ID].Status != StatusDisputed {
+			t.Fatalf("status %v", w.st.Jobs[j.ID].Status)
+		}
+		w.block(nil, nil, []Verdict{{Job: j.ID, ProviderAtFault: atFault}})
+		j = w.st.Jobs[j.ID]
+		bond := minBond(w.p, fee)
+		if atFault {
+			if j.Status != StatusFailed || w.bal(w.client) != c0 || w.bal(w.provider)-p0 != -bond {
+				t.Fatalf("fault: status %v client %d provider %d", j.Status, w.bal(w.client)-c0, w.bal(w.provider)-p0)
+			}
+		} else if j.Status != StatusSettled {
+			t.Fatalf("no-fault verdict should settle, got %v", j.Status)
+		}
+	}
+}
+
+func TestDisputeTimeoutAbortsWithoutLoss(t *testing.T) {
+	w := newWorld(t, 4, 3)
