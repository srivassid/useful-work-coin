+func TestUnbondingStaysSlashable(t *testing.T) {
+	s := newSim(t, 9)
+	v := acct(5)
+	mustOK(t, s.block([]Deposit{{v, 1e7}}, []*Op{{Kind: OpStake, Actor: v, Amount: 3e6}}, nil))
+	mustOK(t, s.block(nil, []*Op{{Kind: OpUnstake, Actor: v, Amount: 3e6}}, nil))
+	if s.st.Stakes[v] != 0 || s.st.Accounts[v] != 7e6 {
+		t.Fatal("unstake should leave the draw immediately but not return funds")
+	}
+	if got := s.st.slash(v, 1e6); got != 1e6 {
+		t.Fatalf("slashed %d from unbonding", got)
+	}
+	s.st.credit(TreasuryAccount, 1e6)
+	s.run(int(s.p.UnbondDelay) + 1)
+	if s.st.Accounts[v] != 9e6 {
+		t.Fatalf("after unbonding balance %d", s.st.Accounts[v])
+	}
+}
+
+func TestWithdrawalsBecomeDueOnce(t *testing.T) {
+	s := newSim(t, 10)
+	a := acct(3)
+	mustOK(t, s.block([]Deposit{{a, 500}}, []*Op{{Kind: OpWithdraw, Actor: a, Amount: 200, PkScript: []byte{0x76, 0xa9}}}, nil))
+	due := s.h + s.p.WithdrawDelay
+	var seen int
+	for s.h < due+3 {
+		r := s.block(nil, nil, nil)
+		for _, w := range r.Withdrawals {
+			if s.h != due || w.Amount != 200 || !bytes.Equal(w.PkScript, []byte{0x76, 0xa9}) {
+				t.Fatalf("withdrawal %+v at height %d", w, s.h)
+			}
+			seen++
+		}
+	}
+	if seen != 1 || s.st.PaidOut != 200 || s.st.Accounts[a] != 300 {
+		t.Fatalf("seen %d paid %d balance %d", seen, s.st.PaidOut, s.st.Accounts[a])
+	}
+}
+
+// ---------------------------------------------------------------- committee, positions, merkle, encoding
+
+func TestCommitteeDrawProperties(t *testing.T) {
+	st := NewState()
+	p := DefaultParams()
+	for i := 0; i < 20; i++ {
+		st.Stakes[acct(i)] = p.MinVerifierStake * Amount(1+i%4)
+	}
+	st.Stakes[acct(50)] = p.MinVerifierStake - 1 // below minimum: never drawn
+	j := &Job{ID: Hash{1}, Client: acct(0), Provider: acct(1), K: 5}
+	c := DrawCommittee(st, p, j, Hash{9})
+	if len(c) != 5 {
+		t.Fatalf("size %d", len(c))
+	}
+	seen := map[AccountID]bool{}
+	for _, a := range c {
+		if a == j.Client || a == j.Provider || a == acct(50) || seen[a] {
+			t.Fatalf("bad member %v", a)
+		}
+		seen[a] = true
+	}
+	if !reflect.DeepEqual(c, DrawCommittee(st.Clone(), p, j, Hash{9})) {
+		t.Fatal("draw not deterministic")
+	}
+	// stake weighting with one seat: P(pick) proportional to stake
+	st2 := NewState()
+	st2.Stakes[acct(2)] = p.MinVerifierStake
+	st2.Stakes[acct(3)] = 3 * p.MinVerifierStake
+	j1 := &Job{ID: Hash{2}, K: 1}
+	wins := 0
+	const trials = 20000
+	for i := 0; i < trials; i++ {
+		if DrawCommittee(st2, p, j1, tagHash("seed", u32b(uint32(i))))[0] == acct(3) {
+			wins++
+		}
+	}
+	if f := float64(wins) / trials; f < 0.735 || f > 0.765 {
+		t.Fatalf("3x stake won %.3f of draws, want 0.75", f)
+	}
+}
+
+func TestPositions(t *testing.T) {
+	for _, S := range []uint32{1, 2, 3, 10, 1000} {
+		for n := 1; n <= 12; n++ {
+			pos := Positions(Hash{byte(S), byte(n)}, S, n)
+			want := n
+			if uint32(n) >= S {
+				want = int(S)
+			}
+			if len(pos) != want {
+				t.Fatalf("S=%d n=%d got %d", S, n, len(pos))
+			}
+			for i, p := range pos {
+				if p >= S || (i > 0 && pos[i-1] >= p) {
+					t.Fatalf("not sorted distinct in range: %v", pos)
+				}
+			}
+		}
+	}
+}
+
+func TestMerkleProofsAllSizes(t *testing.T) {
+	for n := 1; n <= 70; n++ {
+		var leaves []Hash
+		for i := 0; i < n; i++ {
+			leaves = append(leaves, leafHash([]byte{byte(i), byte(n)}))
+		}
+		root := MerkleRoot(leaves)
+		for i := 0; i < n; i++ {
+			pr := MerkleProof(leaves, i)
+			if !VerifyMerkleProof(root, leaves[i], i, n, pr) {
+				t.Fatalf("n=%d i=%d proof fails", n, i)
+			}
+			if n > 1 && VerifyMerkleProof(root, leaves[(i+1)%n], i, n, pr) {
+				t.Fatalf("n=%d i=%d wrong leaf accepted", n, i)
+			}
+			if n > 1 && VerifyMerkleProof(root, leaves[i], (i+1)%n, n, pr) {
+				t.Fatalf("n=%d i=%d proof accepted at another index", n, i)
+			}
+		}
+	}
+}
+
+func TestOpEncodingRoundTrip(t *testing.T) {
+	rng := rand.New(rand.NewPCG(11, 12))
+	rh := func() (h Hash) {
+		for i := range h {
+			h[i] = byte(rng.Uint32())
+		}
+		return
+	}
+	for i := 0; i < 2000; i++ {
+		o := &Op{Kind: OpKind(1 + rng.IntN(11)), Amount: rng.Int64(), Job: rh(), Model: rh(), H1: rh(), H2: rh(),
+			U1: rng.Uint32(), U2: rng.Uint32(), Deadline: int32(rng.Uint32()), K: uint8(rng.Uint32()), N: uint8(rng.Uint32())}
+		o.PkScript = make([]byte, rng.IntN(40))
+		for k := 0; k < rng.IntN(5); k++ {
+			o.Roots = append(o.Roots, rh())
+		}
+		for k := 0; k < rng.IntN(3); k++ {
+			o.Reveals = append(o.Reveals, StageReveal{Stage: rng.Uint32(), Salt: rh(), Root: rh(), Proof: []Hash{rh(), rh()}})
+		}
+		b := o.Encode()
+		d, err := DecodeOp(b)
+		if err != nil {
+			t.Fatalf("decode %v: %v", o.Kind, err)
+		}
+		if !bytes.Equal(d.Encode(), b) {
+			t.Fatalf("%v does not round-trip", o.Kind)
+		}
+		if _, err := DecodeOp(append(b, 0)); err == nil {
+			t.Fatal("trailing byte accepted")
+		}
+		if len(b) > 2 {
+			if _, err := DecodeOp(b[:len(b)-1]); err == nil {
+				t.Fatalf("%v: truncated payload accepted", o.Kind)
+			}
+		}
+	}
+}
+
+// ---------------------------------------------------------------- randomized property test
+
+// TestRandomizedProperties drives many random jobs (honest, cheating, withholding, lazy
+// verifiers, griefing challengers) plus random junk ops, deposits, stakes and withdrawals,
+// checking conservation, non-negativity and replay determinism after every block, and
+// liveness (every job terminal, nothing left in escrow) at the end.
+func TestRandomizedProperties(t *testing.T) {
+	seeds := 40
+	if testing.Short() {
+		seeds = 8
+	}
+	for seed := 0; seed < seeds; seed++ {
+		randomizedRun(t, uint64(seed+100))
+	}
+}
+
+func randomizedRun(t *testing.T, seed uint64) {
+	w := newWorld(t, seed, 6)
+	r := w.rng
+	type live struct {
+		id     Hash
+		tr     *trace
+		salts  map[AccountID]Hash
+		cheat  bool
+		lazy   AccountID
+		reveal bool
+	}
+	var jobs []*live
+	users := []AccountID{w.client, w.provider, acct(40), acct(41), acct(42)}
+	totalBlocks := 300
+	for b := 0; b < totalBlocks; b++ {
+		var ops []*Op
+		var deps []Deposit
+		var verdicts []Verdict
+		if r.IntN(4) == 0 {
+			deps = append(deps, Deposit{users[r.IntN(len(users))], Amount(r.IntN(5_000_000))})
+		}
+		// new jobs (posting stops well before the end so every job can finish)
+		if b < totalBlocks-150 && r.IntN(5) == 0 {
+			stages := uint32(4 * (1 + r.IntN(8)))
+			fee := Amount(1_000_000 + r.IntN(9_000_000))
+			post := &Op{Kind: OpJobPost, Actor: w.client, Model: w.model, U1: stages, Amount: fee,
+				Deadline: w.h + 1 + int32(3+r.IntN(20)), K: uint8(2 + r.IntN(3)), N: uint8(2 + r.IntN(4)), Ref: w.ref()}
+			ops = append(ops, post)
+			jobs = append(jobs, &live{id: tagHash("job", post.Ref[:]), tr: w.newTrace(stages), salts: map[AccountID]Hash{},
+				cheat: r.IntN(4) == 0, reveal: r.IntN(6) != 0})
+		}
+		for _, lj := range jobs {
+			j := w.st.Jobs[lj.id]
+			if j == nil || j.Status.Terminal() {
+				continue
+			}
+			switch j.Status {
+			case StatusPosted:
+				if r.IntN(3) != 0 {
+					ops = append(ops, &Op{Kind: OpJobAccept, Actor: w.provider, Job: j.ID, Amount: minBond(w.p, j.Fee) + Amount(r.IntN(1000))})
+				}
+			case StatusAccepted:
+				if r.IntN(3) != 0 {
+					ops = append(ops, &Op{Kind: OpTraceCommit, Actor: w.provider, Job: j.ID, H1: lj.tr.commit(), H2: w.randHash()})
+				}
+			case StatusVerifyCommit:
+				for _, v := range j.Committee {
+					if v.Committed || lj.salts[v.Account] != (Hash{}) || r.IntN(8) == 0 {
+						continue
+					}
+					salt := w.randHash()
+					lj.salts[v.Account] = salt
+					pos := Positions(salt, j.Stages, int(j.N))
+					roots := make([]Hash, len(pos))
+					for i, p := range pos {
+						roots[i] = lj.tr.roots[p]
+						if lj.cheat {
+							roots[i] = tagHash("truth", lj.tr.roots[p][:])
+						}
+					}
+					ops = append(ops, &Op{Kind: OpVerifyCommit, Actor: v.Account, Job: j.ID, H1: sha256.Sum256(salt[:]), H2: ResultHash(roots, v.Account, salt)})
+				}
+			case StatusVerifyReveal:
+				for _, v := range j.Committee {
+					salt, ok := lj.salts[v.Account]
+					if !ok || v.Revealed || !v.Committed || r.IntN(8) == 0 {
+						continue
+					}
+					pos := Positions(salt, j.Stages, int(j.N))
+					roots := make([]Hash, len(pos))
+					for i, p := range pos {
+						roots[i] = lj.tr.roots[p]
+						if lj.cheat {
+							roots[i] = tagHash("truth", lj.tr.roots[p][:])
+						}
+					}
+					ops = append(ops, &Op{Kind: OpVerifyReveal, Actor: v.Account, Job: j.ID, H1: salt, Roots: roots})
+				}
+			case StatusProviderReveal:
+				if lj.reveal {
+					var want []uint32
+					for st := range j.requested() {
+						want = append(want, st)
+					}
+					if len(want) > 0 {
+						ops = append(ops, &Op{Kind: OpTraceReveal, Actor: w.provider, Job: j.ID, Reveals: lj.tr.reveal(want)})
+					}
+				}
+			case StatusChallenge:
+				if r.IntN(15) == 0 {
+					ch := users[2+r.IntN(3)]
+					ops = append(ops, &Op{Kind: OpChallenge, Actor: ch, Job: j.ID, U1: uint32(r.IntN(int(j.Stages))), H1: w.randHash(), Amount: w.p.ChallengeBondMin})
+				}
+			case StatusDisputed:
+				if r.IntN(4) == 0 {
+					verdicts = append(verdicts, Verdict{Job: j.ID, ProviderAtFault: lj.cheat || r.IntN(2) == 0})
+				}
+			}
+		}
+		// noise: random stakes, unstakes, withdrawals and malformed or unauthorized ops
+		for k := 0; k < r.IntN(3); k++ {
+			u := users[r.IntN(len(users))]
+			switch r.IntN(6) {
+			case 0:
+				ops = append(ops, &Op{Kind: OpStake, Actor: u, Amount: Amount(r.IntN(3_000_000))})
+			case 1:
+				ops = append(ops, &Op{Kind: OpUnstake, Actor: w.verifiers[r.IntN(len(w.verifiers))], Amount: Amount(r.IntN(300_000))})
+			case 2:
+				ops = append(ops, &Op{Kind: OpWithdraw, Actor: u, Amount: Amount(r.IntN(2_000_000)), PkScript: []byte{0x51, byte(k)}})
+			case 3:
+				if len(jobs) > 0 {
+					lj := jobs[r.IntN(len(jobs))]
+					ops = append(ops, &Op{Kind: OpKind(1 + r.IntN(11)), Actor: u, Job: lj.id, Amount: Amount(r.IntN(1 << 20)), H1: w.randHash()})
+				}
+			case 4:
+				ops = append(ops, &Op{Kind: OpTraceReveal, Actor: w.provider, Job: w.randHash(), Reveals: []StageReveal{{Stage: 1}}})
+			case 5:
+				ops = append(ops, &Op{Kind: OpChallenge, Actor: w.provider, Job: w.randHash(), Amount: -5})
+			}
+		}
+		w.block(deps, ops, verdicts)
+	}
+	// liveness: with no further input every job ends and nothing stays escrowed
+	w.run(int(w.p.DisputeTimeout + w.p.ChallengeWindow + 100))
+	statuses := map[JobStatus]int{}
+	for _, j := range w.st.Jobs {
+		if !j.Status.Terminal() {
+			t.Fatalf("seed %d: job %v stuck in %v", seed, j.ID, j.Status)
+		}
+		statuses[j.Status]++
+	}
+	if len(w.st.Jobs) == 0 {
+		t.Fatalf("seed %d: no jobs were created", seed)
+	}
+	if testing.Verbose() && seed == 100 {
+		t.Logf("seed %d: %d jobs, outcomes %v", seed, len(w.st.Jobs), statuses)
+	}
+}
diff --git a/node/jobstate/merkle.go b/node/jobstate/merkle.go
new file mode 100644
index 00000000..ca9ea182
--- /dev/null
+++ b/node/jobstate/merkle.go
@@ -0,0 +1,97 @@
+package jobstate
+
+import (
+	"crypto/sha256"
+	"encoding/binary"
+)
+
+// RFC 6962 Merkle tree: leaves hashed with 0x00, interior nodes with 0x01, and the split at the
+// largest power of two below n (no duplicated leaves, so proofs are unambiguous for any size).
+
+func leafHash(data []byte) Hash {
+	h := sha256.New()
+	h.Write([]byte{0})
+	h.Write(data)
+	var o Hash
+	copy(o[:], h.Sum(nil))
+	return o
+}
+
+func nodeHash(l, r Hash) Hash {
+	h := sha256.New()
+	h.Write([]byte{1})
+	h.Write(l[:])
+	h.Write(r[:])
+	var o Hash
+	copy(o[:], h.Sum(nil))
+	return o
+}
+
+func splitPoint(n int) int {
+	k := 1
+	for k<<1 < n {
+		k <<= 1
+	}
+	return k
+}
+
+// MerkleRoot of already-hashed leaves; the empty tree hashes to sha256("").
+func MerkleRoot(leaves []Hash) Hash {
+	switch len(leaves) {
+	case 0:
+		return sha256.Sum256(nil)
+	case 1:
+		return leaves[0]
+	}
+	k := splitPoint(len(leaves))
+	return nodeHash(MerkleRoot(leaves[:k]), MerkleRoot(leaves[k:]))
+}
+
+// MerkleProof is the audit path for leaf index i (sibling hashes from the leaf upward).
+func MerkleProof(leaves []Hash, i int) []Hash {
+	if len(leaves) <= 1 {
+		return nil
+	}
+	k := splitPoint(len(leaves))
+	if i < k {
+		return append(MerkleProof(leaves[:k], i), MerkleRoot(leaves[k:]))
+	}
+	return append(MerkleProof(leaves[k:], i-k), MerkleRoot(leaves[:k]))
+}
+
+// VerifyMerkleProof checks that leaf sits at index i of a size-n tree with the given root.
+func VerifyMerkleProof(root, leaf Hash, i, n int, proof []Hash) bool {
+	if i < 0 || i >= n {
+		return false
+	}
+	h, ok := walk(leaf, i, n, proof)
+	return ok && h == root
+}
+
+func walk(leaf Hash, i, n int, proof []Hash) (Hash, bool) {
+	if n == 1 {
+		return leaf, len(proof) == 0
+	}
+	if len(proof) == 0 {
+		return Hash{}, false
+	}
+	k := splitPoint(n)
+	sib := proof[len(proof)-1]
+	rest := proof[:len(proof)-1]
+	if i < k {
+		h, ok := walk(leaf, i, k, rest)
+		return nodeHash(h, sib), ok
+	}
+	h, ok := walk(leaf, i-k, n-k, rest)
+	return nodeHash(sib, h), ok
+}
+
+// StageLeaf is the salted commitment leaf for one stage's output root.
+func StageLeaf(stage uint32, salt, root Hash) Hash {
+	var b [5 + 4 + 64]byte
+	copy(b[:5], "stage")
+	binary.LittleEndian.PutUint32(b[5:9], stage)
+	copy(b[9:41], salt[:])
+	copy(b[41:], root[:])
+	return leafHash(b[:])
+}
diff --git a/node/jobstate/ops.go b/node/jobstate/ops.go
new file mode 100644
index 00000000..e13f6539
--- /dev/null
+++ b/node/jobstate/ops.go
@@ -0,0 +1,238 @@
+package jobstate
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+)
+
+// OpKind is a job-module operation type.
+type OpKind uint8
+
+const (
+	OpWithdraw OpKind = iota + 1
+	OpStake
+	OpUnstake
+	OpModelReg
+	OpJobPost
+	OpJobAccept
+	OpTraceCommit
+	OpVerifyCommit
+	OpVerifyReveal
+	OpTraceReveal
+	OpChallenge
+)
+
+var opNames = map[OpKind]string{
+	OpWithdraw: "WITHDRAW", OpStake: "STAKE", OpUnstake: "UNSTAKE", OpModelReg: "MODEL_REG",
+	OpJobPost: "JOB_POST", OpJobAccept: "JOB_ACCEPT", OpTraceCommit: "TRACE_COMMIT",
+	OpVerifyCommit: "VERIFY_COMMIT", OpVerifyReveal: "VERIFY_REVEAL", OpTraceReveal: "TRACE_REVEAL",
+	OpChallenge: "CHALLENGE",
+}
+
+func (k OpKind) String() string { return opNames[k] }
+
+// Op is one decoded operation. Actor and Ref are filled in by the node, not encoded:
+// Actor is the account of the transaction's first input, Ref = H(txid || output index)
+// (unique per op, used to derive job and model ids).
+//
+// Field use per kind:
+//
+//	WITHDRAW       Amount, PkScript
+//	STAKE/UNSTAKE  Amount
+//	MODEL_REG      H1 weights_root, H2 runtime_hash, U1 layer_groups, U2 rotation_block
+//	JOB_POST       Model, H1 input_root, U1 stages, Amount fee, Deadline, K, N
+//	JOB_ACCEPT     Job, Amount bond
+//	TRACE_COMMIT   Job, H1 stage_root, H2 output_root
+//	VERIFY_COMMIT  Job, H1 H(salt), H2 H(roots || account || salt)
+//	VERIFY_REVEAL  Job, H1 salt, Roots (one per sampled position, in position order)
+//	TRACE_REVEAL   Job, Reveals
+//	CHALLENGE      Job, U1 stage, H1 claimed_root, Amount bond
+type Op struct {
+	Kind     OpKind
+	Actor    AccountID
+	Ref      Hash
+	Amount   Amount
+	PkScript []byte
+	Job      Hash
+	Model    Hash
+	H1, H2   Hash
+	U1, U2   uint32
+	Deadline int32
+	K, N     uint8
+	Roots    []Hash
+	Reveals  []StageReveal
+}
+
+const (
+	opVersion       = 1
+	maxPkScript     = 10_000
+	maxRoots        = 4096
+	maxReveals      = 4096
+	maxProofDepth   = 40
+	MaxOpPayloadLen = 1 << 20
+)
+
+// Encode serializes an op (without Actor and Ref).
+func (o *Op) Encode() []byte {
+	var b bytes.Buffer
+	b.WriteByte(opVersion)
+	b.WriteByte(byte(o.Kind))
+	w := func(v any) { _ = binary.Write(&b, binary.LittleEndian, v) }
+	uv := func(v uint64) {
+		var t [binary.MaxVarintLen64]byte
+		b.Write(t[:binary.PutUvarint(t[:], v)])
+	}
+	switch o.Kind {
+	case OpWithdraw:
+		w(o.Amount)
+		uv(uint64(len(o.PkScript)))
+		b.Write(o.PkScript)
+	case OpStake, OpUnstake:
+		w(o.Amount)
+	case OpModelReg:
+		b.Write(o.H1[:])
+		b.Write(o.H2[:])
+		w(o.U1)
+		w(o.U2)
+	case OpJobPost:
+		b.Write(o.Model[:])
+		b.Write(o.H1[:])
+		w(o.U1)
+		w(o.Amount)
+		w(o.Deadline)
+		b.WriteByte(o.K)
+		b.WriteByte(o.N)
+	case OpJobAccept:
+		b.Write(o.Job[:])
+		w(o.Amount)
+	case OpTraceCommit, OpVerifyCommit:
+		b.Write(o.Job[:])
+		b.Write(o.H1[:])
+		b.Write(o.H2[:])
+	case OpVerifyReveal:
+		b.Write(o.Job[:])
+		b.Write(o.H1[:])
+		uv(uint64(len(o.Roots)))
+		for _, r := range o.Roots {
+			b.Write(r[:])
+		}
+	case OpTraceReveal:
+		b.Write(o.Job[:])
+		uv(uint64(len(o.Reveals)))
+		for _, r := range o.Reveals {
+			w(r.Stage)
+			b.Write(r.Salt[:])
+			b.Write(r.Root[:])
+			uv(uint64(len(r.Proof)))
+			for _, p := range r.Proof {
+				b.Write(p[:])
+			}
+		}
+	case OpChallenge:
+		b.Write(o.Job[:])
+		w(o.U1)
+		b.Write(o.H1[:])
+		w(o.Amount)
+	}
+	return b.Bytes()
+}
+
+var errDecode = errors.New("jobstate: malformed op")
+
+type reader struct {
+	b   []byte
+	err error
+}
+
+func (r *reader) take(n int) []byte {
+	if r.err != nil || n < 0 || len(r.b) < n {
+		r.err = errDecode
+		return make([]byte, max(n, 0))
+	}
+	v := r.b[:n]
+	r.b = r.b[n:]
+	return v
+}
+func (r *reader) hash() (h Hash) { copy(h[:], r.take(32)); return }
+func (r *reader) u8() uint8      { return r.take(1)[0] }
+func (r *reader) u32() uint32    { return binary.LittleEndian.Uint32(r.take(4)) }
+func (r *reader) i32() int32     { return int32(r.u32()) }
+func (r *reader) i64() int64     { return int64(binary.LittleEndian.Uint64(r.take(8))) }
+func (r *reader) uvar(limit uint64) int {
+	if r.err != nil {
+		return 0
+	}
+	v, n := binary.Uvarint(r.b)
+	if n <= 0 || v > limit {
+		r.err = errDecode
+		return 0
+	}
+	r.b = r.b[n:]
+	return int(v)
+}
+
+// DecodeOp parses an op payload strictly (no trailing bytes, bounded lengths).
+func DecodeOp(p []byte) (*Op, error) {
+	if len(p) > MaxOpPayloadLen {
+		return nil, errDecode
+	}
+	r := &reader{b: p}
+	if r.u8() != opVersion {
+		return nil, fmt.Errorf("jobstate: unknown op version")
+	}
+	o := &Op{Kind: OpKind(r.u8())}
+	switch o.Kind {
+	case OpWithdraw:
+		o.Amount = r.i64()
+		o.PkScript = append([]byte(nil), r.take(r.uvar(maxPkScript))...)
+	case OpStake, OpUnstake:
+		o.Amount = r.i64()
+	case OpModelReg:
+		o.H1, o.H2 = r.hash(), r.hash()
+		o.U1, o.U2 = r.u32(), r.u32()
+	case OpJobPost:
+		o.Model, o.H1 = r.hash(), r.hash()
+		o.U1 = r.u32()
+		o.Amount = r.i64()
+		o.Deadline = r.i32()
+		o.K, o.N = r.u8(), r.u8()
+	case OpJobAccept:
+		o.Job = r.hash()
+		o.Amount = r.i64()
+	case OpTraceCommit, OpVerifyCommit:
+		o.Job, o.H1, o.H2 = r.hash(), r.hash(), r.hash()
+	case OpVerifyReveal:
+		o.Job, o.H1 = r.hash(), r.hash()
+		n := r.uvar(maxRoots)
+		for i := 0; i < n && r.err == nil; i++ {
+			o.Roots = append(o.Roots, r.hash())
+		}
+	case OpTraceReveal:
+		o.Job = r.hash()
+		n := r.uvar(maxReveals)
+		for i := 0; i < n && r.err == nil; i++ {
+			sr := StageReveal{Stage: r.u32(), Salt: r.hash(), Root: r.hash()}
+			d := r.uvar(maxProofDepth)
+			for j := 0; j < d && r.err == nil; j++ {
+				sr.Proof = append(sr.Proof, r.hash())
+			}
+			o.Reveals = append(o.Reveals, sr)
+		}
+	case OpChallenge:
+		o.Job = r.hash()
+		o.U1 = r.u32()
+		o.H1 = r.hash()
+		o.Amount = r.i64()
+	default:
+		return nil, fmt.Errorf("jobstate: unknown op kind %d", o.Kind)
+	}
+	if r.err != nil {
+		return nil, r.err
+	}
+	if len(r.b) != 0 {
+		return nil, fmt.Errorf("jobstate: %d trailing bytes", len(r.b))
+	}
+	return o, nil
+}
diff --git a/node/jobstate/state.go b/node/jobstate/state.go
new file mode 100644
index 00000000..f484d133
--- /dev/null
+++ b/node/jobstate/state.go
@@ -0,0 +1,218 @@
+package jobstate
+
+import (
+	"bytes"
+	"encoding/binary"
+	"sort"
+)
+
+// State is the whole job module. Zero balances and stakes are deleted so the
+// serialization (and so the root) is canonical.
+type State struct {
+	Accounts    map[AccountID]Amount // free balances
+	Stakes      map[AccountID]Amount // active verifier stake (eligible for draws)
+	Unbonding   []Unbonding          // leaving stake, still slashable, sorted by Seq
+	Models      map[Hash]*Model
+	Jobs        map[Hash]*Job
+	Withdrawals []Withdrawal // pending payouts, sorted by Seq
+	NextSeq     uint64
+	TotalIn     Amount // all deposits and pool issuance ever credited
+	PaidOut     Amount // all withdrawals ever paid in a coinbase
+}
+
+func NewState() *State {
+	return &State{Accounts: map[AccountID]Amount{}, Stakes: map[AccountID]Amount{},
+		Models: map[Hash]*Model{}, Jobs: map[Hash]*Job{}}
+}
+
+// Clone is a deep copy (used to evaluate a block without touching the chain tip's state).
+func (s *State) Clone() *State {
+	c := &State{Accounts: make(map[AccountID]Amount, len(s.Accounts)), Stakes: make(map[AccountID]Amount, len(s.Stakes)),
+		Models: make(map[Hash]*Model, len(s.Models)), Jobs: make(map[Hash]*Job, len(s.Jobs)),
+		NextSeq: s.NextSeq, TotalIn: s.TotalIn, PaidOut: s.PaidOut}
+	for k, v := range s.Accounts {
+		c.Accounts[k] = v
+	}
+	for k, v := range s.Stakes {
+		c.Stakes[k] = v
+	}
+	c.Unbonding = append([]Unbonding(nil), s.Unbonding...)
+	for k, v := range s.Models {
+		m := *v
+		c.Models[k] = &m
+	}
+	for k, v := range s.Jobs {
+		c.Jobs[k] = v.clone()
+	}
+	for _, w := range s.Withdrawals {
+		w.PkScript = append([]byte(nil), w.PkScript...)
+		c.Withdrawals = append(c.Withdrawals, w)
+	}
+	return c
+}
+
+func (j *Job) clone() *Job {
+	c := *j
+	c.Committee = make([]Verifier, len(j.Committee))
+	for i, v := range j.Committee {
+		v.Positions = append([]uint32(nil), v.Positions...)
+		v.Roots = append([]Hash(nil), v.Roots...)
+		c.Committee[i] = v
+	}
+	c.Revealed = make([]StageReveal, len(j.Revealed))
+	for i, r := range j.Revealed {
+		r.Proof = append([]Hash(nil), r.Proof...)
+		c.Revealed[i] = r
+	}
+	c.Disputes = append([]Challenge(nil), j.Disputes...)
+	return &c
+}
+
+// Holdings is everything the module currently holds; Conservation requires
+// Holdings() == TotalIn - PaidOut at every height.
+func (s *State) Holdings() Amount {
+	var t Amount
+	for _, v := range s.Accounts {
+		t += v
+	}
+	for _, v := range s.Stakes {
+		t += v
+	}
+	for _, u := range s.Unbonding {
+		t += u.Amount
+	}
+	for _, m := range s.Models {
+		t += m.Bond
+	}
+	for _, j := range s.Jobs {
+		t += j.Held()
+	}
+	for _, w := range s.Withdrawals {
+		t += w.Amount
+	}
+	return t
+}
+
+// Held is the amount escrowed for a job: fee and bond until it ends, plus open challenge bonds.
+func (j *Job) Held() Amount {
+	if j.Status.Terminal() {
+		return 0
+	}
+	t := j.Fee
+	if j.Status != StatusPosted {
+		t += j.Bond
+	}
+	for _, d := range j.Disputes {
+		t += d.Bond
+	}
+	return t
+}
+
+// ---------------------------------------------------------------- canonical encoding + root
+
+type enc struct{ bytes.Buffer }
+
+func (e *enc) w(vs ...any) {
+	for _, v := range vs {
+		switch x := v.(type) {
+		case Hash:
+			e.Write(x[:])
+		case AccountID:
+			e.Write(x[:])
+		case []byte:
+			e.u(uint64(len(x)))
+			e.Write(x)
+		case bool:
+			if x {
+				e.WriteByte(1)
+			} else {
+				e.WriteByte(0)
+			}
+		default:
+			_ = binary.Write(e, binary.LittleEndian, x)
+		}
+	}
+}
+
+func (e *enc) u(v uint64) {
+	var t [binary.MaxVarintLen64]byte
+	e.Write(t[:binary.PutUvarint(t[:], v)])
+}
+
+func encodeJob(j *Job) []byte {
+	var e enc
+	e.w(j.ID, j.Client, j.Provider, j.Model, j.InputRoot, j.Stages, j.K, j.N, j.Fee, j.VerifierPay,
+		j.TreasuryCut, j.Bond, j.Deadline, uint8(j.Status), j.PhaseEnd, j.PostHeight, j.CommitHeight,
+		j.StageRoot, j.OutputRoot)
+	e.u(uint64(len(j.Committee)))
+	for _, v := range j.Committee {
+		e.w(v.Account, v.SaltHash, v.ResultHash, v.Committed, v.Revealed, v.Flagged)
+		e.u(uint64(len(v.Positions)))
+		for i, p := range v.Positions {
+			e.w(p)
+			if i < len(v.Roots) {
+				e.w(v.Roots[i])
+			}
+		}
+	}
+	e.u(uint64(len(j.Revealed)))
+	for _, r := range j.Revealed {
+		e.w(r.Stage, r.Salt, r.Root) // proofs are checked on entry and not needed afterwards
+	}
+	e.u(uint64(len(j.Disputes)))
+	for _, d := range j.Disputes {
+		e.w(d.Challenger, d.Stage, d.ClaimedRoot, d.Bond, d.Height)
+	}
+	return e.Bytes()
+}
+
+type kv struct{ k, v []byte }
+
+// Root is the state commitment placed in each coinbase.
+func (s *State) Root() Hash {
+	var items []kv
+	add := func(prefix byte, key []byte, val []byte) {
+		items = append(items, kv{append([]byte{prefix}, key...), val})
+	}
+	for a, v := range s.Accounts {
+		var e enc
+		e.w(v)
+		add('a', a[:], e.Bytes())
+	}
+	for a, v := range s.Stakes {
+		var e enc
+		e.w(v)
+		add('s', a[:], e.Bytes())
+	}
+	for _, u := range s.Unbonding {
+		var k, e enc
+		k.w(u.Seq)
+		e.w(u.Account, u.Amount, u.Due)
+		add('u', k.Bytes(), e.Bytes())
+	}
+	for id, m := range s.Models {
+		var e enc
+		e.w(m.Registrant, m.WeightsRoot, m.RuntimeHash, m.LayerGroups, m.RotationBlock, m.Bond)
+		add('m', id[:], e.Bytes())
+	}
+	for id, j := range s.Jobs {
+		add('j', id[:], encodeJob(j))
+	}
+	for _, w := range s.Withdrawals {
+		var k, e enc
+		k.w(w.Seq)
+		e.w(w.Account, w.PkScript, w.Amount, w.Due)
+		add('w', k.Bytes(), e.Bytes())
+	}
+	var c enc
+	c.w(s.NextSeq, s.TotalIn, s.PaidOut)
+	add('c', nil, c.Bytes())
+	sort.Slice(items, func(i, j int) bool { return bytes.Compare(items[i].k, items[j].k) < 0 })
+	leaves := make([]Hash, len(items))
+	for i, it := range items {
+		var e enc
+		e.w(it.k, it.v)
+		leaves[i] = leafHash(e.Bytes())
+	}
+	return MerkleRoot(leaves)
+}
diff --git a/node/jobstate/types.go b/node/jobstate/types.go
new file mode 100644
index 00000000..9fdaf808
--- /dev/null
+++ b/node/jobstate/types.go
@@ -0,0 +1,191 @@
+// Package jobstate is the Useful-Work Coin job module: an account-based state machine that
+// lives beside the UTXO set, escrows client fees, bonds providers and verifiers, and settles
+// verified batch-inference jobs. See spec/job-module.md in the Useful-Work Coin repository.
+//
+// The package is pure and deterministic: given a starting state and a block's deposits and
+// operations, ApplyBlock always produces the same new state, state root and withdrawals.
+package jobstate
+
+import (
+	"crypto/sha256"
+	"fmt"
+)
+
+// Amount is a quantity of the base unit (grains).
+type Amount = int64
+
+// Hash is a 32-byte sha256 digest.
+type Hash [32]byte
+
+func (h Hash) String() string { return fmt.Sprintf("%x", h[:6]) }
+
+// AccountID identifies a module account: sha256 of the pkScript that authorizes it, or a
+// reserved system account.
+type AccountID [32]byte
+
+func (a AccountID) String() string { return fmt.Sprintf("%x", a[:6]) }
+
+// System accounts. Nobody can sign for them, because no pkScript hashes to these values.
+var (
+	PoolAccount     = AccountID{'u', 'w', 'c', ':', 'p', 'o', 'o', 'l'}
+	TreasuryAccount = AccountID{'u', 'w', 'c', ':', 't', 'r', 'e', 'a', 's', 'u', 'r', 'y'}
+)
+
+// AccountForScript is the module account controlled by whoever can spend pkScript.
+func AccountForScript(pkScript []byte) AccountID { return AccountID(sha256.Sum256(pkScript)) }
+
+// Params are the consensus parameters of the job module.
+type Params struct {
+	PoolShareBP     int64 // share of block subsidy credited to PoolAccount, basis points
+	VerifierShareBP int64 // verifier pay as a share of the fee
+	TreasuryShareBP int64 // treasury share of the fee
+	MinBondBP       int64 // provider bond as a share of the fee
+
+	VerifierFloorPerSample Amount // minimum verifier pay per (verifier, sample)
+	MinVerifierStake       Amount
+	VerifierNoShowPenalty  Amount
+	ChallengeBondMin       Amount
+	ModelRegBond           Amount
+
+	MinK, MaxK, MinN, MaxN int
+	MaxStages              uint32
+	MaxDeadlineBlocks      int32
+
+	CommitteeDelay       int32 // the committee is drawn from the hash of block commit+delay
+	VerifyCommitWindow   int32
+	VerifyRevealWindow   int32
+	ProviderRevealWindow int32
+	ChallengeWindow      int32
+	DisputeTimeout       int32
+	WithdrawDelay        int32
+	UnbondDelay          int32
+}
+
+// DefaultParams follow the starting values of Design v3 (fee split 98/1/1, bond >= 50% of fee,
+// k = n = 2 minimum, pool share 10%) with block counts for a 1-minute block time.
+func DefaultParams() Params {
+	return Params{
+		PoolShareBP: 1000, VerifierShareBP: 100, TreasuryShareBP: 100, MinBondBP: 5000,
+		VerifierFloorPerSample: 1_000, MinVerifierStake: 1_000_000, VerifierNoShowPenalty: 50_000,
+		ChallengeBondMin: 100_000, ModelRegBond: 1_000_000,
+		MinK: 2, MaxK: 16, MinN: 2, MaxN: 64, MaxStages: 1 << 20, MaxDeadlineBlocks: 10_080,
+		CommitteeDelay: 2, VerifyCommitWindow: 10, VerifyRevealWindow: 10, ProviderRevealWindow: 10,
+		ChallengeWindow: 1440, DisputeTimeout: 2880, WithdrawDelay: 6, UnbondDelay: 2880,
+	}
+}
+
+// JobStatus is the lifecycle phase of a job.
+type JobStatus uint8
+
+const (
+	StatusPosted         JobStatus = iota + 1 // waiting for a provider
+	StatusAccepted                            // provider bonded, waiting for TRACE_COMMIT
+	StatusCommitted                           // trace committed, committee not yet drawn
+	StatusVerifyCommit                        // drawn verifiers commit
+	StatusVerifyReveal                        // verifiers reveal salts and roots
+	StatusProviderReveal                      // provider opens the sampled stages
+	StatusChallenge                           // open challenge window
+	StatusDisputed                            // waiting for a dispute verdict
+	// terminal states
+	StatusSettled // paid out normally
+	StatusExpired // never accepted; fee refunded
+	StatusFailed  // provider at fault; bond slashed, fee refunded
+	StatusAborted // dispute timed out; everything returned
+)
+
+func (s JobStatus) Terminal() bool { return s >= StatusSettled }
+
+var statusNames = map[JobStatus]string{
+	StatusPosted: "posted", StatusAccepted: "accepted", StatusCommitted: "committed",
+	StatusVerifyCommit: "verify-commit", StatusVerifyReveal: "verify-reveal",
+	StatusProviderReveal: "provider-reveal", StatusChallenge: "challenge", StatusDisputed: "disputed",
+	StatusSettled: "settled", StatusExpired: "expired", StatusFailed: "failed", StatusAborted: "aborted",
+}
+
+func (s JobStatus) String() string { return statusNames[s] }
+
+// Model is a registered model: weights, reference runtime and verification layout.
+type Model struct {
+	ID            Hash
+	Registrant    AccountID
+	WeightsRoot   Hash
+	RuntimeHash   Hash
+	LayerGroups   uint32
+	RotationBlock uint32
+	Bond          Amount
+}
+
+// Verifier is one committee seat on a job.
+type Verifier struct {
+	Account    AccountID
+	SaltHash   Hash
+	ResultHash Hash
+	Committed  bool
+	Revealed   bool
+	Positions  []uint32
+	Roots      []Hash
+	Flagged    bool // its roots disagreed with the provider's
+}
+
+// Challenge is an open dispute.
+type Challenge struct {
+	Challenger  AccountID // zero for verifier-flagged disputes
+	Stage       uint32
+	ClaimedRoot Hash
+	Bond        Amount
+	Height      int32
+}
+
+// StageReveal is one opened stage: its output root, salt and Merkle path in StageRoot.
+type StageReveal struct {
+	Stage uint32
+	Salt  Hash
+	Root  Hash
+	Proof []Hash
+}
+
+// Job is one escrowed batch-inference job.
+type Job struct {
+	ID        Hash
+	Client    AccountID
+	Provider  AccountID
+	Model     Hash
+	InputRoot Hash
+	Stages    uint32
+	K, N      uint8
+
+	Fee         Amount
+	VerifierPay Amount
+	TreasuryCut Amount
+	Bond        Amount
+
+	Deadline     int32
+	Status       JobStatus
+	PhaseEnd     int32 // last height of the current timed phase (0 when not timed)
+	PostHeight   int32
+	CommitHeight int32
+
+	StageRoot  Hash
+	OutputRoot Hash
+
+	Committee []Verifier
+	Revealed  []StageReveal // provider's opened stages, sorted by stage
+	Disputes  []Challenge
+}
+
+// Withdrawal is a pending payout from the module to a pkScript.
+type Withdrawal struct {
+	Seq      uint64
+	Account  AccountID
+	PkScript []byte
+	Amount   Amount
+	Due      int32
+}
+
+// Unbonding is stake leaving the verifier set.
+type Unbonding struct {
+	Seq     uint64
+	Account AccountID
+	Amount  Amount
+	Due     int32
+}
