+package jobstate
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"math/big"
+	"sort"
+)
+
+// Deposit credits value that left the UTXO set through a "UWCD" output.
+type Deposit struct {
+	Account AccountID
+	Amount  Amount
+}
+
+// Verdict is the outcome of a dispute, produced by consensus (build step 4: bisection to one
+// operation, recomputed by full nodes). Step 3 only defines how verdicts move money.
+type Verdict struct {
+	Job             Hash
+	ProviderAtFault bool
+}
+
+// BlockInput is everything the module needs from one block, in transaction order.
+type BlockInput struct {
+	Height   int32
+	PrevHash Hash // hash of the previous block: randomness for committee draws in this block
+	Deposits []Deposit
+	Ops      []*Op
+	Verdicts []Verdict
+}
+
+// BlockResult is what the block's coinbase must reflect.
+type BlockResult struct {
+	Root        Hash         // must be committed in the coinbase ("UWCS")
+	Withdrawals []Withdrawal // must each be paid by a coinbase output at this height
+	OpErrors    []error      // nil for applied ops; failed ops change nothing
+}
+
+// PoolIssuance is the minimum the coinbase must deposit to PoolAccount.
+func PoolIssuance(p Params, subsidy Amount) Amount { return subsidy * p.PoolShareBP / 10_000 }
+
+// ApplyBlock applies one block to st in place. It never fails because of an operation: a
+// failed op is reported in OpErrors and has no effect.
+func ApplyBlock(st *State, p Params, b BlockInput) *BlockResult {
+	res := &BlockResult{}
+	for _, d := range b.Deposits {
+		if d.Amount > 0 {
+			st.credit(d.Account, d.Amount)
+			st.TotalIn += d.Amount
+		}
+	}
+	for _, op := range b.Ops {
+		snap := st.Clone()
+		if err := st.applyOp(p, b.Height, op); err != nil {
+			*st = *snap // all-or-nothing per op
+			res.OpErrors = append(res.OpErrors, fmt.Errorf("%v: %w", op.Kind, err))
+		} else {
+			res.OpErrors = append(res.OpErrors, nil)
+		}
+	}
+	for _, v := range b.Verdicts {
+		st.applyVerdict(p, b.Height, v)
+	}
+	st.endBlock(p, b.Height, b.PrevHash, res)
+	res.Root = st.Root()
+	return res
+}
+
+// ---------------------------------------------------------------- balances
+
+func (s *State) credit(a AccountID, v Amount) {
+	if v == 0 {
+		return
+	}
+	s.Accounts[a] += v
+	if s.Accounts[a] == 0 {
+		delete(s.Accounts, a)
+	}
+}
+
+var errFunds = errors.New("insufficient balance")
+
+func (s *State) debit(a AccountID, v Amount) error {
+	if v < 0 || s.Accounts[a] < v {
+		return errFunds
+	}
+	s.credit(a, -v)
+	return nil
+}
+
+// slash takes up to v from a's active stake, then from its unbonding entries (oldest first).
+func (s *State) slash(a AccountID, v Amount) Amount {
+	took := min(v, s.Stakes[a])
+	s.Stakes[a] -= took
+	if s.Stakes[a] == 0 {
+		delete(s.Stakes, a)
+	}
+	for i := 0; i < len(s.Unbonding) && took < v; i++ {
+		if s.Unbonding[i].Account == a {
+			t := min(v-took, s.Unbonding[i].Amount)
+			s.Unbonding[i].Amount -= t
+			took += t
+		}
+	}
+	kept := s.Unbonding[:0]
+	for _, u := range s.Unbonding {
+		if u.Amount > 0 {
+			kept = append(kept, u)
+		}
+	}
+	s.Unbonding = kept
+	return took
+}
+
+func tagHash(tag string, parts ...[]byte) Hash {
+	h := sha256.New()
+	h.Write([]byte(tag))
+	for _, p := range parts {
+		h.Write(p)
+	}
+	var o Hash
+	copy(o[:], h.Sum(nil))
+	return o
+}
+
+func u32b(v uint32) []byte { var b [4]byte; binary.LittleEndian.PutUint32(b[:], v); return b[:] }
+
+// ---------------------------------------------------------------- ops
+
+func (s *State) applyOp(p Params, h int32, o *Op) error {
+	switch o.Kind {
+	case OpWithdraw:
+		if o.Amount <= 0 || len(o.PkScript) == 0 || len(o.PkScript) > maxPkScript {
+			return errors.New("bad withdrawal")
+		}
+		if err := s.debit(o.Actor, o.Amount); err != nil {
+			return err
+		}
+		s.Withdrawals = append(s.Withdrawals, Withdrawal{Seq: s.seq(), Account: o.Actor,
+			PkScript: append([]byte(nil), o.PkScript...), Amount: o.Amount, Due: h + p.WithdrawDelay})
+	case OpStake:
+		if o.Amount <= 0 {
+			return errors.New("bad amount")
+		}
+		if err := s.debit(o.Actor, o.Amount); err != nil {
+			return err
+		}
+		s.Stakes[o.Actor] += o.Amount
+	case OpUnstake:
+		if o.Amount <= 0 || o.Amount > s.Stakes[o.Actor] {
+			return errors.New("bad amount")
+		}
+		s.Stakes[o.Actor] -= o.Amount
+		if s.Stakes[o.Actor] == 0 {
+			delete(s.Stakes, o.Actor)
+		}
+		s.Unbonding = append(s.Unbonding, Unbonding{Seq: s.seq(), Account: o.Actor, Amount: o.Amount, Due: h + p.UnbondDelay})
+	case OpModelReg:
+		if o.U1 == 0 {
+			return errors.New("model needs at least one layer group")
+		}
+		id := tagHash("model", o.Ref[:])
+		if _, ok := s.Models[id]; ok {
+			return errors.New("duplicate model")
+		}
+		if err := s.debit(o.Actor, p.ModelRegBond); err != nil {
+			return err
+		}
+		s.Models[id] = &Model{ID: id, Registrant: o.Actor, WeightsRoot: o.H1, RuntimeHash: o.H2,
+			LayerGroups: o.U1, RotationBlock: o.U2, Bond: p.ModelRegBond}
+	case OpJobPost:
+		return s.jobPost(p, h, o)
+	case OpJobAccept:
+		j, err := s.job(o.Job, StatusPosted)
+		if err != nil {
+			return err
+		}
+		if h >= j.Deadline || o.Actor == j.Client {
+			return errors.New("too late or self-dealing on the same account")
+		}
+		if o.Amount < minBond(p, j.Fee) {
+			return errors.New("bond below minimum")
+		}
+		if err := s.debit(o.Actor, o.Amount); err != nil {
+			return err
+		}
+		j.Provider, j.Bond, j.Status = o.Actor, o.Amount, StatusAccepted
+	case OpTraceCommit:
+		j, err := s.job(o.Job, StatusAccepted)
+		if err != nil {
+			return err
+		}
+		if o.Actor != j.Provider || h >= j.Deadline {
+			return errors.New("not the provider, or past the deadline")
+		}
+		j.StageRoot, j.OutputRoot, j.CommitHeight, j.Status = o.H1, o.H2, h, StatusCommitted
+		j.PhaseEnd = h + p.CommitteeDelay
+	case OpVerifyCommit:
+		j, err := s.job(o.Job, StatusVerifyCommit)
+		if err != nil {
+			return err
+		}
+		v := j.seat(o.Actor)
+		if v == nil || v.Committed {
+			return errors.New("not a committee member, or already committed")
+		}
+		v.SaltHash, v.ResultHash, v.Committed = o.H1, o.H2, true
+	case OpVerifyReveal:
+		j, err := s.job(o.Job, StatusVerifyReveal)
+		if err != nil {
+			return err
+		}
+		v := j.seat(o.Actor)
+		if v == nil || !v.Committed || v.Revealed {
+			return errors.New("not a committed seat, or already revealed")
+		}
+		if sha256.Sum256(o.H1[:]) != v.SaltHash {
+			return errors.New("salt does not match commitment")
+		}
+		pos := Positions(o.H1, j.Stages, int(j.N))
+		if len(o.Roots) != len(pos) {
+			return errors.New("wrong number of roots")
+		}
+		if ResultHash(o.Roots, o.Actor, o.H1) != v.ResultHash {
+			return errors.New("roots do not match commitment")
+		}
+		v.Positions, v.Roots, v.Revealed = pos, append([]Hash(nil), o.Roots...), true
+	case OpTraceReveal:
+		j, err := s.job(o.Job, StatusProviderReveal)
+		if err != nil {
+			return err
+		}
+		if o.Actor != j.Provider || len(o.Reveals) == 0 {
+			return errors.New("not the provider")
+		}
+		want := j.requested()
+		have := map[uint32]bool{}
+		for _, r := range j.Revealed {
+			have[r.Stage] = true
+		}
+		for _, r := range o.Reveals {
+			if !want[r.Stage] || have[r.Stage] {
+				return errors.New("stage not requested or already revealed")
+			}
+			if !VerifyMerkleProof(j.StageRoot, StageLeaf(r.Stage, r.Salt, r.Root), int(r.Stage), int(j.Stages), r.Proof) {
+				return errors.New("stage proof does not open the committed stage root")
+			}
+			have[r.Stage] = true
+			j.Revealed = append(j.Revealed, StageReveal{Stage: r.Stage, Salt: r.Salt, Root: r.Root})
+		}
+		sort.Slice(j.Revealed, func(a, b int) bool { return j.Revealed[a].Stage < j.Revealed[b].Stage })
+	case OpChallenge:
+		j, err := s.job(o.Job, StatusChallenge)
+		if err != nil {
+			return err
+		}
+		if o.Actor == j.Provider || o.U1 >= j.Stages || o.Amount < p.ChallengeBondMin {
+			return errors.New("bad challenge")
+		}
+		if err := s.debit(o.Actor, o.Amount); err != nil {
+			return err
+		}
+		j.Disputes = append(j.Disputes, Challenge{Challenger: o.Actor, Stage: o.U1, ClaimedRoot: o.H1, Bond: o.Amount, Height: h})
+		j.Status, j.PhaseEnd = StatusDisputed, h+p.DisputeTimeout
+	default:
+		return errors.New("unknown op")
+	}
+	return nil
+}
+
+func minBond(p Params, fee Amount) Amount { return (fee*p.MinBondBP + 9_999) / 10_000 }
+
+// JobPay is the verifier pay and treasury cut fixed when a job is posted.
+func JobPay(p Params, fee Amount, k, n int) (verifier, treasury Amount) {
+	verifier = max(fee*p.VerifierShareBP/10_000, Amount(k*n)*p.VerifierFloorPerSample)
+	treasury = fee * p.TreasuryShareBP / 10_000
+	return
+}
+
+func (s *State) jobPost(p Params, h int32, o *Op) error {
+	m := s.Models[o.Model]
+	switch {
+	case m == nil:
+		return errors.New("unknown model")
+	case o.U1 == 0 || o.U1 > p.MaxStages || o.U1%m.LayerGroups != 0:
+		return errors.New("stages must be batches x layer groups")
+	case int(o.K) < p.MinK || int(o.K) > p.MaxK || int(o.N) < p.MinN || int(o.N) > p.MaxN:
+		return errors.New("k or n out of range")
+	case o.Deadline <= h || o.Deadline > h+p.MaxDeadlineBlocks:
+		return errors.New("bad deadline")
+	case o.Amount <= 0:
+		return errors.New("bad fee")
+	}
+	vp, tc := JobPay(p, o.Amount, int(o.K), int(o.N))
+	if o.Amount < vp+tc {
+		return errors.New("fee does not cover verifier pay and treasury share")
+	}
+	id := tagHash("job", o.Ref[:])
+	if _, ok := s.Jobs[id]; ok {
+		return errors.New("duplicate job")
+	}
+	if err := s.debit(o.Actor, o.Amount); err != nil {
+		return err
+	}
+	s.Jobs[id] = &Job{ID: id, Client: o.Actor, Model: o.Model, InputRoot: o.H1, Stages: o.U1, K: o.K, N: o.N,
+		Fee: o.Amount, VerifierPay: vp, TreasuryCut: tc, Deadline: o.Deadline, Status: StatusPosted, PostHeight: h}
+	return nil
+}
+
+func (s *State) seq() uint64 { s.NextSeq++; return s.NextSeq }
+
+func (s *State) job(id Hash, want JobStatus) (*Job, error) {
+	j := s.Jobs[id]
+	if j == nil {
+		return nil, errors.New("unknown job")
+	}
+	if j.Status != want {
+		return nil, fmt.Errorf("job is %v, not %v", j.Status, want)
+	}
+	return j, nil
+}
+
+func (j *Job) seat(a AccountID) *Verifier {
+	for i := range j.Committee {
+		if j.Committee[i].Account == a {
+			return &j.Committee[i]
+		}
+	}
+	return nil
+}
+
+func (j *Job) requested() map[uint32]bool {
+	want := map[uint32]bool{}
+	for _, v := range j.Committee {
+		if v.Revealed {
+			for _, p := range v.Positions {
+				want[p] = true
+			}
+		}
+	}
+	return want
+}
+
+// ResultHash binds a verifier's recomputed roots to its account and salt (commit-reveal).
+func ResultHash(roots []Hash, a AccountID, salt Hash) Hash {
+	parts := make([][]byte, 0, len(roots)+2)
+	for i := range roots {
+		parts = append(parts, roots[i][:])
+	}
+	parts = append(parts, a[:], salt[:])
+	return tagHash("result", parts...)
+}
+
+// Positions are the n distinct stages a verifier with this salt rechecks (all stages if n >= S).
+func Positions(salt Hash, stages uint32, n int) []uint32 {
+	if uint32(n) >= stages {
+		out := make([]uint32, stages)
+		for i := range out {
+			out[i] = uint32(i)
+		}
+		return out
+	}
+	seen := map[uint32]bool{}
+	var out []uint32
+	for i := uint32(0); len(out) < n && i < uint32(n)*64; i++ {
+		x := tagHash("pos", salt[:], u32b(i))
+		st := uint32(binary.LittleEndian.Uint64(x[:8]) % uint64(stages))
+		if !seen[st] {
+			seen[st] = true
+			out = append(out, st)
+		}
+	}
+	for st := uint32(0); len(out) < n; st++ { // astronomically unlikely fallback, still deterministic
+		if !seen[st] {
+			seen[st] = true
+			out = append(out, st)
+		}
+	}
+	sort.Slice(out, func(a, b int) bool { return out[a] < out[b] })
+	return out
+}
+
+// DrawCommittee picks up to k distinct stakers (stake >= MinVerifierStake), excluding the job's
+// client and provider, by successive stake-weighted sampling: seat i takes
+// H(seed || job || i) mod (remaining eligible stake) and walks the cumulative stake of the
+// remaining candidates in account order. Each pick is exactly proportional to stake.
+func DrawCommittee(s *State, p Params, j *Job, seed Hash) []AccountID {
+	type cand struct {
+		a     AccountID
+		stake Amount
+	}
+	var cs []cand
+	total := Amount(0)
+	for a, st := range s.Stakes {
+		if st < p.MinVerifierStake || a == j.Client || a == j.Provider {
+			continue
+		}
+		cs = append(cs, cand{a, st})
+		total += st
+	}
+	sort.Slice(cs, func(x, y int) bool { return bytes.Compare(cs[x].a[:], cs[y].a[:]) < 0 })
+	out := []AccountID{}
+	for i := 0; i < int(j.K) && len(cs) > 0; i++ {
+		x := tagHash("draw", seed[:], j.ID[:], u32b(uint32(i)))
+		r := new(big.Int).Mod(new(big.Int).SetBytes(x[:]), big.NewInt(total)).Int64()
+		k := 0
+		for acc := cs[0].stake; acc <= r; acc += cs[k].stake {
+			k++
+		}
+		out = append(out, cs[k].a)
+		total -= cs[k].stake
+		cs = append(cs[:k], cs[k+1:]...)
+	}
+	return out
+}
+
+// ---------------------------------------------------------------- verdicts and timers
+
+func (s *State) applyVerdict(p Params, h int32, v Verdict) {
+	j := s.Jobs[v.Job]
+	if j == nil || j.Status != StatusDisputed {
+		return
+	}
+	if v.ProviderAtFault {
+		var catchers []AccountID
+		for _, d := range j.Disputes {
+			s.credit(d.Challenger, d.Bond) // honest challengers get their bond back
+			catchers = append(catchers, d.Challenger)
+		}
+		for _, c := range j.Committee {
+			if c.Flagged {
+				catchers = append(catchers, c.Account)
+			}
+		}
+		s.failProvider(j, catchers)
+		return
+	}
+	for _, d := range j.Disputes { // failed challenges: bond half to provider, half to treasury
+		half := d.Bond / 2
+		s.credit(j.Provider, half)
+		s.credit(TreasuryAccount, d.Bond-half)
+	}
+	for i := range j.Committee {
+		if j.Committee[i].Flagged { // a verifier that wrongly flagged is penalized
+			s.credit(TreasuryAccount, s.slash(j.Committee[i].Account, p.VerifierNoShowPenalty))
+		}
+	}
+	j.Disputes = nil
+	s.settle(j)
+}
+
+// failProvider: fee back to the client; bond half to catchers (equal split), half (plus remainder) to treasury.
+func (s *State) failProvider(j *Job, catchers []AccountID) {
+	s.credit(j.Client, j.Fee)
+	toCatchers := Amount(0)
+	if len(catchers) > 0 {
+		each := (j.Bond / 2) / Amount(len(catchers))
+		for _, c := range catchers {
+			s.credit(c, each)
+		}
+		toCatchers = each * Amount(len(catchers))
+	}
+	s.credit(TreasuryAccount, j.Bond-toCatchers)
+	j.Disputes = nil
+	j.Status, j.PhaseEnd = StatusFailed, 0
+}
+
+// settle pays a job that passed verification and its challenge window.
+func (s *State) settle(j *Job) {
+	var paid []AccountID
+	for _, v := range j.Committee {
+		if v.Revealed && !v.Flagged {
+			paid = append(paid, v.Account)
+		}
+	}
+	vp := Amount(0)
+	if len(paid) > 0 {
+		each := j.VerifierPay / Amount(len(paid))
+		for _, a := range paid {
+			s.credit(a, each)
+		}
+		vp = each * Amount(len(paid))
+	}
+	s.credit(TreasuryAccount, j.TreasuryCut+(j.VerifierPay-vp))
+	s.credit(j.Provider, j.Fee-j.VerifierPay-j.TreasuryCut+j.Bond)
+	j.Status, j.PhaseEnd = StatusSettled, 0
+}
+
+func (s *State) endBlock(p Params, h int32, prevHash Hash, res *BlockResult) {
+	// stake finishing its unbonding period returns to the free balance
+	kept := s.Unbonding[:0]
+	for _, u := range s.Unbonding {
+		if u.Due <= h {
+			s.credit(u.Account, u.Amount)
+		} else {
+			kept = append(kept, u)
+		}
+	}
+	s.Unbonding = kept
+	// withdrawals due now must be paid by this block's coinbase
+	pending := s.Withdrawals[:0]
+	for _, w := range s.Withdrawals {
+		if w.Due <= h {
+			res.Withdrawals = append(res.Withdrawals, w)
+			s.PaidOut += w.Amount
+		} else {
+			pending = append(pending, w)
+		}
+	}
+	s.Withdrawals = pending
+	// job timers, in job-id order
+	ids := make([]Hash, 0, len(s.Jobs))
+	for id, j := range s.Jobs {
+		if !j.Status.Terminal() {
+			ids = append(ids, id)
+		}
+	}
+	sort.Slice(ids, func(a, b int) bool { return bytes.Compare(ids[a][:], ids[b][:]) < 0 })
+	for _, id := range ids {
+		s.advance(p, h, prevHash, s.Jobs[id])
+	}
+}
+
+func (s *State) advance(p Params, h int32, prevHash Hash, j *Job) {
+	switch j.Status {
+	case StatusPosted:
+		if h >= j.Deadline {
+			s.credit(j.Client, j.Fee)
+			j.Status = StatusExpired
+		}
+	case StatusAccepted:
+		if h >= j.Deadline { // accepted but never committed: provider at fault, client compensated
+			half := j.Bond / 2
+			s.credit(j.Client, j.Fee+half)
+			s.credit(TreasuryAccount, j.Bond-half)
+			j.Status = StatusFailed
+		}
+	case StatusCommitted:
+		if h >= j.PhaseEnd {
+			for _, a := range DrawCommittee(s, p, j, prevHash) {
+				j.Committee = append(j.Committee, Verifier{Account: a})
+			}
+			if len(j.Committee) == 0 {
+				j.Status, j.PhaseEnd = StatusChallenge, h+p.ChallengeWindow
+			} else {
+				j.Status, j.PhaseEnd = StatusVerifyCommit, h+p.VerifyCommitWindow
+			}
+		}
+	case StatusVerifyCommit:
+		all := true
+		for _, v := range j.Committee {
+			all = all && v.Committed
+		}
+		if all || h >= j.PhaseEnd {
+			for i := range j.Committee {
+				if !j.Committee[i].Committed {
+					s.credit(TreasuryAccount, s.slash(j.Committee[i].Account, p.VerifierNoShowPenalty))
+				}
+			}
+			j.Status, j.PhaseEnd = StatusVerifyReveal, h+p.VerifyRevealWindow
+		}
+	case StatusVerifyReveal:
+		all := true
+		for _, v := range j.Committee {
+			all = all && (v.Revealed || !v.Committed)
+		}
+		if all || h >= j.PhaseEnd {
+			for i := range j.Committee {
+				if j.Committee[i].Committed && !j.Committee[i].Revealed {
+					s.credit(TreasuryAccount, s.slash(j.Committee[i].Account, p.VerifierNoShowPenalty))
+				}
+			}
+			if len(j.requested()) == 0 {
+				j.Status, j.PhaseEnd = StatusChallenge, h+p.ChallengeWindow
+			} else {
+				j.Status, j.PhaseEnd = StatusProviderReveal, h+p.ProviderRevealWindow
+			}
+		}
+	case StatusProviderReveal:
+		want := j.requested()
+		got := map[uint32]Hash{}
+		for _, r := range j.Revealed {
+			got[r.Stage] = r.Root
+		}
+		complete := len(got) == len(want)
+		if !complete && h < j.PhaseEnd {
+			return
+		}
+		if !complete { // withheld a requested stage
+			var catchers []AccountID
+			for _, v := range j.Committee {
+				if v.Revealed {
+					catchers = append(catchers, v.Account)
+				}
+			}
+			s.failProvider(j, catchers)
+			return
+		}
+		flagged := false
+		for i := range j.Committee {
+			v := &j.Committee[i]
+			for k, pos := range v.Positions {
+				if v.Revealed && got[pos] != v.Roots[k] {
+					v.Flagged = true
+				}
+			}
+			flagged = flagged || v.Flagged
+		}
+		if flagged {
+			j.Status, j.PhaseEnd = StatusDisputed, h+p.DisputeTimeout
+		} else {
+			j.Status, j.PhaseEnd = StatusChallenge, h+p.ChallengeWindow
+		}
+	case StatusChallenge:
+		if h >= j.PhaseEnd {
+			s.settle(j)
+		}
+	case StatusDisputed:
+		if h >= j.PhaseEnd { // no verdict in time: no-fault abort, everything returned
+			s.credit(j.Client, j.Fee)
+			s.credit(j.Provider, j.Bond)
+			for _, d := range j.Disputes {
+				s.credit(d.Challenger, d.Bond)
+			}
+			j.Disputes = nil
+			j.Status, j.PhaseEnd = StatusAborted, 0
+		}
+	}
+}
diff --git a/node/jobstate/jobstate_test.go b/node/jobstate/jobstate_test.go
new file mode 100644
index 00000000..dec687d4
--- /dev/null
+++ b/node/jobstate/jobstate_test.go
