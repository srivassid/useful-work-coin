+func TestFailedOpsAreNoOps(t *testing.T) {
+	w := newWorld(t, 8, 3)
+	before := w.st.Root()
+	junk := []*Op{
+		{Kind: OpJobAccept, Actor: w.provider, Job: w.randHash(), Amount: 5},
+		{Kind: OpWithdraw, Actor: acct(999), Amount: 10, PkScript: []byte{1}},
+		{Kind: OpUnstake, Actor: w.verifiers[0], Amount: 1 << 60},
+		{Kind: OpJobPost, Actor: w.client, Model: w.randHash(), U1: 4, Amount: 10, Deadline: w.h + 3, K: 2, N: 2},
+		{Kind: OpChallenge, Actor: w.client, Job: w.randHash(), Amount: 1 << 40},
+		{Kind: OpModelReg, Actor: acct(999), U1: 1},
+	}
+	h := w.h + 1
+	cl := w.st.Clone()
+	r := ApplyBlock(cl, w.p, BlockInput{Height: h, Ops: junk})
+	for i, e := range r.OpErrors {
