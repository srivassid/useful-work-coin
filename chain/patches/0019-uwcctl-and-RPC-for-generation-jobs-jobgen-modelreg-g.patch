From 3eacbfa9ae9cde7de38978bbc174cd336f494ad2 Mon Sep 17 00:00:00 2001
From: Siddhartha Srivastava <siddhartha@delphai.com>
Date: Sun, 8 Nov 2026 16:24:37 +0530
Subject: [PATCH] uwcctl and RPC for generation jobs: jobgen, modelreg gen,
 out_proof in JSON reveals, onestep for generation

uwcctl jobgen posts a generation job (temperature in thousandths); modelreg reads "gen" from
the model json; JSON ops carry gen/temp_milli and reveals' out_proof; onestep builds proofs for
generation stages (head stages, and layer stage 0 with the batch's head stage opened with its
output-root path); getjob reports gen and tempmilli. gofmt.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017Li1NvNdLwU8j8WLX4mWzr
---
 node/cmd/uwcctl/main.go      | 19 ++++++++++---
 node/cmd/uwcctl/onestep.go   | 33 ++++++++++++++++++++--
 node/cmd/uwcctl/opsjson.go   | 53 ++++++++++++++++++++----------------
 node/jobstate/gen_test.go    |  7 +++--
 node/jobstate/ops.go         | 42 ++++++++++++++--------------
 node/jobstate/program_gen.go |  4 +--
 node/rpcjobs.go              |  4 +++
 7 files changed, 107 insertions(+), 55 deletions(-)

diff --git a/node/cmd/uwcctl/main.go b/node/cmd/uwcctl/main.go
index b931d195..992cf910 100644
--- a/node/cmd/uwcctl/main.go
+++ b/node/cmd/uwcctl/main.go
@@ -43,6 +43,8 @@ jobs
   onestep <key> <request.json>        a provider's one-step proof for a game in its last round
   modelreg <key> <model.json>         register a model (weights_root, runtime_hash, layer_groups, block, cfg)
   jobpost <key> <model> <input_root> <stages> <fee> <deadline_blocks> <k> <n> <seq_len> [provider_account]
+  jobgen  <key> <model> <input_root> <stages> <fee> <deadline_blocks> <k> <n> <seq_len> <temp_milli> [provider_account]
+                                      a generation job (Rules 3): stages = batches x (layer groups + 1)
 
 council (actions are proposed by one member and approved by others)
   propose-category <key> <category.json>
@@ -268,6 +270,7 @@ func main() {
 			LayerGroups uint32            `json:"layer_groups"`
 			Block       uint32            `json:"rotation_block"`
 			Cfg         jobstate.ModelCfg `json:"cfg"`
+			Gen         bool              `json:"gen"` // a generation model (Rules 3)
 		}
 		raw, err := os.ReadFile(args[1])
 		if err != nil {
@@ -277,9 +280,12 @@ func main() {
 			die(err)
 		}
 		submit(key(args[0]), nil, &jobstate.Op{Kind: jobstate.OpModelReg, H1: hash32(m.WeightsRoot), H2: hash32(m.RuntimeHash),
-			U1: m.LayerGroups, U2: m.Block, Cfg: m.Cfg})
-	case "jobpost":
+			U1: m.LayerGroups, U2: m.Block, Cfg: m.Cfg, Gen: m.Gen})
+	case "jobpost", "jobgen":
 		need(args, 9)
+		if cmd == "jobgen" {
+			need(args, 10)
+		}
 		c := client()
 		var h int64
 		if err := c.Query("getblockcount", &h); err != nil {
@@ -289,8 +295,13 @@ func main() {
 		op := &jobstate.Op{Kind: jobstate.OpJobPost, Model: hash32(args[1]), H1: hash32(args[2]),
 			U1: uint32(amount(args[3])), Amount: amount(args[4]), Deadline: int32(h + amount(args[5]) + 1),
 			K: uint8(k), N: uint8(n), U2: uint32(amount(args[8]))}
-		if len(args) > 9 { // a directed job (Rules 2): only this provider account may accept
-			op.Provider = jobstate.AccountID(hash32(args[9]))
+		rest := args[9:]
+		if cmd == "jobgen" { // a generation job (Rules 3): temperature in thousandths
+			op.Gen, op.TempMilli = true, uint32(amount(rest[0]))
+			rest = rest[1:]
+		}
+		if len(rest) > 0 { // a directed job (Rules 2): only this provider account may accept
+			op.Provider = jobstate.AccountID(hash32(rest[0]))
 		}
 		submit(key(args[0]), nil, op)
 	case "propose-category":
diff --git a/node/cmd/uwcctl/onestep.go b/node/cmd/uwcctl/onestep.go
index a7597d58..3fc2b436 100644
--- a/node/cmd/uwcctl/onestep.go
+++ b/node/cmd/uwcctl/onestep.go
@@ -19,6 +19,11 @@ type oneStepReq struct {
 	Batches  [][]uint32 `json:"batches"`      // the job's token batches
 	Salts    []string   `json:"salts"`        // the provider's stage salts and roots
 	Roots    []string   `json:"roots"`
+	// generation jobs (Rules 3): Batches are the full sequences
+	Gen       bool       `json:"gen"`
+	TempMilli uint32     `json:"temp_milli"`
+	InputRows [][]uint32 `json:"input_rows"`   // the job's input rows (prompt, then the sentinel)
+	HeadRows  string     `json:"head_outputs"` // this batch's head-stage output rows (layer stage 0)
 }
 
 func readRows(path string) ([][]uint32, error) {
@@ -97,18 +102,40 @@ func oneStep(keyPath, reqPath string) {
 	}
 	in := jobstate.OneStepInput{Cfg: mi.Cfg, LayerGroups: mi.LayerGroups, Stage: g.Stage, Leaf: g.Leaf, Elem: g.Elem,
 		Rows: rows, Weights: w}
-	b := int(g.Stage) / mi.LayerGroups
+	per := mi.LayerGroups
+	if req.Gen {
+		per++
+		in.Gen = &jobstate.GenSpec{TempMilli: req.TempMilli, Key: jobstate.GumbelKey(hash32(req.Job))}
+	}
+	b := int(g.Stage) / per
 	if b >= len(req.Batches) {
 		die(fmt.Errorf("stage %d: no batch %d", g.Stage, b))
 	}
 	in.Tokens = req.Batches[b]
-	for i, toks := range req.Batches {
+	inputs := req.Batches
+	if req.Gen {
+		inputs = req.InputRows
+		in.InputRow = req.InputRows[b]
+	}
+	for i, toks := range inputs {
 		in.InputLeaves = append(in.InputLeaves, jobstate.TokenLeaf(i, jobstate.RowRoot(toks)))
 	}
 	for i := range req.Salts {
 		in.StageLeaves = append(in.StageLeaves, jobstate.StageLeaf(uint32(i), hash32(req.Salts[i]), hash32(req.Roots[i])))
 	}
-	if int(g.Stage)%mi.LayerGroups > 0 {
+	if req.Gen && int(g.Stage)%per == 0 { // layer stage 0 may read generated tokens: the batch's head stage
+		if in.HeadOutputs, err = readRows(req.HeadRows); err != nil {
+			die(err)
+		}
+		var outLv []jobstate.Hash
+		for i := range req.Batches {
+			outLv = append(outLv, jobstate.GenOutLeaf(i, hash32(req.Roots[i*per+mi.LayerGroups])))
+		}
+		hs := b*per + mi.LayerGroups
+		in.HeadReveal = &jobstate.StageReveal{Stage: uint32(hs), Salt: hash32(req.Salts[hs]), Root: hash32(req.Roots[hs]),
+			Proof: jobstate.MerkleProof(in.StageLeaves, hs), OutProof: jobstate.MerkleProof(outLv, b)}
+	}
+	if int(g.Stage)%per > 0 {
 		if in.PrevOutputs, err = readRows(req.PrevRows); err != nil {
 			die(err)
 		}
