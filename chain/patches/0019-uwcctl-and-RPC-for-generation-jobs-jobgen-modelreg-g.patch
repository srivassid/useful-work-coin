+	o := &jobstate.Op{Kind: kind, Amount: j.Amount, U1: j.U1, U2: j.U2, Deadline: j.Deadline, K: j.K, N: j.N,
+		Gen: j.Gen, TempMilli: j.TempMilli}
 	for _, f := range []struct {
 		s   string
 		dst *jobstate.Hash
@@ -115,6 +119,9 @@ func (j *opJSON) op() (*jobstate.Op, error) {
 		if sr.Proof, err = hashes(r.Proof); err != nil {
 			return nil, err
 		}
+		if sr.OutProof, err = hashes(r.OutProof); err != nil {
+			return nil, err
+		}
 		o.Reveals = append(o.Reveals, sr)
 	}
 	for _, in := range j.Inputs {
