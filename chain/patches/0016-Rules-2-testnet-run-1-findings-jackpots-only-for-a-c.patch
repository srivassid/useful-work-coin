+// FERecord is an opened forced-error record: the decoy provider accounts and, from version 2,
+// the stage key that fixes each decoy job's wrong stage (FEStage).
+type FERecord struct {
+	Version  uint8
+	Decoys   []AccountID
+	StageKey Hash
+}
+
+// FEStage is the stage a decoy job carries its wrong root at (record version 2): the keyholders
+// derive it once the job id is known, and only a catch on this stage earns the jackpot.
+func FEStage(key Hash, job Hash, stages uint32) uint32 {
+	x := tagHash("fe-stage", key[:], job[:])
+	return uint32(binary.BigEndian.Uint64(x[:8]) % uint64(stages))
