+package jobstate
+
+import (
+	"crypto/sha256"
+	"testing"
+)
+
+// Rules 2 (testnet run 1 findings): directed jobs, challenge bonds that scale with the provider's
+// bond, and forced-error jackpots only for a catch on the decoy's wrong stage.
+
+func TestRules2DirectedJobs(t *testing.T) {
+	w := newPoolWorld(t, 601, 3)
+	cl, named, other := acct(310), acct(311), acct(312)
+	w.block([]Deposit{{cl, 1e9}, {named, 1e9}, {other, 1e9}}, nil, nil)
+	fee := Amount(8_000_000)
+	post := func(prov AccountID) *Op {
+		return &Op{Kind: OpJobPost, Actor: cl, Model: w.model, H1: w.randHash(), U1: 8, Amount: fee, Deadline: w.h + 60,
+			K: 2, N: 2, U2: 4, Provider: prov}
+	}
+	if r := w.block(nil, []*Op{post(named)}, nil); r.OpErrors[0] == nil {
+		t.Fatal("directed job accepted before Rules 2")
+	}
+	w.p.Rules = 2
+	if r := w.block(nil, []*Op{post(cl)}, nil); r.OpErrors[0] == nil {
+		t.Fatal("job directed to its own client accepted")
+	}
+	p := post(named)
+	mustOK(t, w.block(nil, []*Op{p}, nil))
+	id := tagHash("job", p.Ref[:])
+	if w.st.Jobs[id].Directed != named {
+		t.Fatal("directed provider not recorded")
+	}
+	if r := w.block(nil, []*Op{{Kind: OpJobAccept, Actor: other, Job: id, Amount: minBond(w.p, fee)}}, nil); r.OpErrors[0] == nil {
+		t.Fatal("another provider accepted a directed job")
+	}
+	mustOK(t, w.block(nil, []*Op{{Kind: OpJobAccept, Actor: named, Job: id, Amount: minBond(w.p, fee)}}, nil))
+	if j := w.st.Jobs[id]; j.Status != StatusAccepted || j.Provider != named {
+		t.Fatalf("directed accept: %v %v", j.Status, j.Provider)
+	}
+	// an open job still takes anyone
+	open := post(AccountID{})
+	mustOK(t, w.block(nil, []*Op{open}, nil))
+	mustOK(t, w.block(nil, []*Op{{Kind: OpJobAccept, Actor: other, Job: tagHash("job", open.Ref[:]), Amount: minBond(w.p, fee)}}, nil))
+
+	// wire format: the provider is appended only when set; a zero provider on the wire is rejected
+	for _, o := range []*Op{post(named), post(AccountID{})} {
+		d, err := DecodeOp(o.Encode())
+		if err != nil || d.Provider != o.Provider {
+			t.Fatalf("round trip: %v %x", err, d.Provider[:4])
+		}
+	}
+	z := post(AccountID{}).Encode()
+	if _, err := DecodeOp(append(z, make([]byte, 32)...)); err == nil {
+		t.Fatal("zero directed provider decoded")
+	}
+	if _, err := DecodeOp(append(z, 1)); err == nil {
+		t.Fatal("trailing byte decoded")
+	}
+}
+
+// decoyJob posts and accepts a job, commits tr and lets the committee agree with it; returns
+// the job id with the job in its challenge window.
+func decoyJob(w *poolWorld, client, prov AccountID, fee Amount) (Hash, *trace) {
+	t := w.t
+	post := &Op{Kind: OpJobPost, Actor: client, Model: w.model, H1: w.randHash(), U1: 8, Amount: fee, Deadline: w.h + 60,
+		K: 2, N: 2, U2: 4, Provider: prov}
+	mustOK(t, w.block(nil, []*Op{post}, nil))
+	id := tagHash("job", post.Ref[:])
+	mustOK(t, w.block(nil, []*Op{{Kind: OpJobAccept, Actor: prov, Job: id, Amount: minBond(w.p, fee)}}, nil))
+	tr := w.newTrace(8)
+	w.commitAndVerify(id, prov, tr, tr)
+	return id, tr
+}
+
+func TestRules2ChallengeBondScales(t *testing.T) {
+	w := newPoolWorld(t, 602, 3)
+	w.p.Rules, w.p.ChallengeBondBP = 2, 1000
+	cl, prov, watcher := acct(320), acct(321), acct(322)
+	w.block([]Deposit{{cl, 1e9}, {prov, 1e9}, {watcher, 1e9}}, nil, nil)
+	id, _ := decoyJob(w, cl, prov, 80_000_000)
+	j := w.st.Jobs[id]
+	need := ChallengeBond(w.p, j)
+	if need != j.Bond/10 || need <= w.p.ChallengeBondMin {
+		t.Fatalf("challenge bond %d for provider bond %d", need, j.Bond)
+	}
+	if r := w.block(nil, []*Op{{Kind: OpChallenge, Actor: watcher, Job: id, U1: 3, H1: w.randHash(), Amount: need - 1}}, nil); r.OpErrors[0] == nil {
+		t.Fatal("challenge below the scaled bond accepted")
+	}
+	mustOK(t, w.block(nil, []*Op{{Kind: OpChallenge, Actor: watcher, Job: id, U1: 3, H1: w.randHash(), Amount: need}}, nil))
+	// before Rules 2 the fixed minimum applies
+	w2 := newPoolWorld(t, 603, 3)
+	w2.p.ChallengeBondBP = 1000
+	if ChallengeBond(w2.p, j) != w2.p.ChallengeBondMin {
+		t.Fatal("scaled bond applied before Rules 2")
+	}
+}
+
+func TestRules2JackpotNeedsTheWrongStage(t *testing.T) {
+	w := newPoolWorld(t, 604, 3)
+	w.p.Rules = 2
+	w.block([]Deposit{{TreasuryAccount, 100_000_000}}, nil, nil)
+	decoyClient, decoyA, decoyB, watcher, liar := acct(330), acct(331), acct(332), acct(333), acct(334)
+	w.block([]Deposit{{decoyClient, 1e9}, {decoyA, 1e9}, {decoyB, 1e9}, {watcher, 1e9}, {liar, 1e9}}, nil, nil)
+
+	key := w.randHash()
+	record := EncodeFERecordV2([]AccountID{decoyA, decoyB}, &key)
+	salt := w.randHash()
+	pid, res := w.councilDo(&Op{Kind: OpFECommit, H1: FECommitment(record, salt), Amount: 30_000_000})
+	mustOK(t, res)
+	fe := tagHash("fe", pid[:])
+
+	fee := Amount(8_000_000)
+	idA, trA := decoyJob(w, decoyClient, decoyA, fee)
+	idB, trB := decoyJob(w, decoyClient, decoyB, fee)
+	wrongA, wrongB := FEStage(key, idA, 8), FEStage(key, idB, 8)
+	_ = trA
+	_ = trB
+	// A: the watcher challenges the decoy's wrong stage. B: a liar challenges an honest stage
+	// and the (silent) decoy loses the game anyway.
+	bond := ChallengeBond(w.p, w.st.Jobs[idA])
+	mustOK(t, w.block(nil, []*Op{
+		{Kind: OpChallenge, Actor: watcher, Job: idA, U1: wrongA, H1: w.randHash(), Amount: bond},
+		{Kind: OpChallenge, Actor: liar, Job: idB, U1: (wrongB + 1) % 8, H1: w.randHash(), Amount: bond}}, nil))
+	w.block(nil, nil, []Verdict{{Job: idA, ProviderAtFault: true}, {Job: idB, ProviderAtFault: true}})
+	ja, jb := w.st.Jobs[idA], w.st.Jobs[idB]
+	if ja.Status != StatusFailed || jb.Status != StatusFailed || !ja.Caught || ja.CaughtStage != wrongA || jb.CaughtStage == wrongB {
+		t.Fatalf("A %v caught %v at %d (wrong %d); B %v at %d (wrong %d)", ja.Status, ja.Caught, ja.CaughtStage, wrongA,
+			jb.Status, jb.CaughtStage, wrongB)
+	}
+
+	// a version-1 record (no stage key) is refused under Rules 2
+	v1 := EncodeFERecord([]AccountID{acct(399)})
+	s1 := w.randHash()
+	pid1, res1 := w.councilDo(&Op{Kind: OpFECommit, H1: FECommitment(v1, s1), Amount: 1_000_000})
+	mustOK(t, res1)
+	if r := w.block(nil, []*Op{{Kind: OpFEReveal, Actor: acct(5), Job: tagHash("fe", pid1[:]), H1: s1, Data: v1}}, nil); r.OpErrors[0] == nil {
+		t.Fatal("version-1 record revealed under Rules 2")
+	}
+
+	wb, lb, ab, bb := w.bal(watcher), w.bal(liar), w.bal(decoyA), w.bal(decoyB)
+	mustOK(t, w.block(nil, []*Op{{Kind: OpFEReveal, Actor: acct(5), Job: fe, H1: salt, Data: record}}, nil))
+	if w.bal(watcher)-wb != w.p.Jackpot {
+		t.Fatalf("catch on the wrong stage paid %d, want the jackpot %d", w.bal(watcher)-wb, w.p.Jackpot)
+	}
+	if w.bal(liar) != lb {
+		t.Fatalf("the liar was paid %d at the reveal", w.bal(liar)-lb)
+	}
+	if w.bal(decoyA)-ab != ja.Bond || w.bal(decoyB) != bb {
+		t.Fatal("decoy bonds: only the decoy caught on its wrong stage is reimbursed")
+	}
+	if st := w.st.Stats; st.DecoysCaught != 1 || st.JackpotsPaid != w.p.Jackpot {
+		t.Fatalf("stats %+v", st)
+	}
+}
