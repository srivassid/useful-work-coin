+// TestRules2FieldsLeaveOldRootsUnchanged: a job without the Rules 2 fields encodes exactly as
+// before, so replaying an existing chain gives the same state roots.
+func TestRules2FieldsLeaveOldRootsUnchanged(t *testing.T) {
+	j := &Job{ID: Hash{1}, Stages: 8, Catchers: []AccountID{acct(1)}}
+	base := encodeJob(j)
+	j.Directed = acct(2)
+	if got := encodeJob(j); len(got) != len(base)+1+32+1+4 || string(got[:len(base)]) != string(base) {
+		t.Fatal("Rules 2 fields are not a pure suffix")
+	}
+}
+
+// TestFERecordV2AndStageVector: the version-2 record round-trips, and FEStage matches the
+// keyholders' Python (verifier/forced_errors.py fe_stage) on a fixed vector.
+func TestFERecordV2AndStageVector(t *testing.T) {
+	key := Hash(sha256.Sum256([]byte("fe-key")))
+	b := EncodeFERecordV2([]AccountID{acct(1), acct(2)}, &key)
+	rec, err := DecodeFERecordFull(b)
+	if err != nil || rec.Version != 2 || len(rec.Decoys) != 2 || rec.StageKey != key {
+		t.Fatalf("v2 round trip: %v %+v", err, rec)
+	}
+	if _, err := DecodeFERecordFull(b[:len(b)-1]); err == nil {
+		t.Fatal("truncated v2 record accepted")
+	}
+	job := Hash(sha256.Sum256([]byte("job")))
+	for n, want := range map[uint32]uint32{8: 7, 112: 111, 1000: 831} {
+		if got := FEStage(key, job, n); got != want {
+			t.Fatalf("FEStage(.., %d) = %d, Python gives %d", n, got, want)
+		}
+	}
+}
