+// ChallengeBond is the smallest bond a CHALLENGE on job j must carry.
+func ChallengeBond(p Params, j *Job) Amount {
+	b := p.ChallengeBondMin
+	if p.Rules >= 2 && p.ChallengeBondBP > 0 {
+		b = max(b, j.Bond/10_000*p.ChallengeBondBP+(j.Bond%10_000)*p.ChallengeBondBP/10_000)
+	}
+	return b
+}
+
+// caughtAt records (Rules >= 2) the stage a failing provider was caught on.
+func caughtAt(p Params, j *Job, stage uint32) {
+	if p.Rules >= 2 {
+		j.Caught, j.CaughtStage = true, stage
+	}
+}
