+func handleGetJobOpResult(s *rpcServer, cmd interface{}, closeChan <-chan struct{}) (interface{}, error) {
+	c := cmd.(*btcjson.GetJobOpResultCmd)
+	h, err := chainhash.NewHashFromStr(c.TxID)
+	if err != nil {
+		return nil, &btcjson.RPCError{Code: btcjson.ErrRPCInvalidParameter, Message: "bad txid: " + err.Error()}
+	}
+	var ops []interface{}
+	for _, r := range blockchain.JobOpResults(*h) {
+		ops = append(ops, map[string]interface{}{"output": r.Output, "kind": r.Kind, "ok": r.Error == "",
+			"error": r.Error, "height": r.Height, "block": r.Block.String()})
+	}
+	return map[string]interface{}{"txid": h.String(), "known": ops != nil, "ops": ops}, nil
