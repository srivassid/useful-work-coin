+package blockchain
+
+import (
+	"bytes"
+	"strings"
+	"sync"
+
+	"github.com/pearl-research-labs/pearl/node/btcutil"
+	"github.com/pearl-research-labs/pearl/node/chaincfg/chainhash"
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+)
+
+// Job operations that fail inside a mined transaction change nothing and leave no trace in
+// the chain (testnet run 1 finding). The node keeps the outcome of the job ops of recently
+// validated blocks in memory, logs failures, and serves them by txid (getjobopresult).
+
+// JobOpResult is the outcome of one job op output.
+type JobOpResult struct {
+	Output int
+	Kind   string
+	Error  string // empty when the op was applied
+	Height int32
+	Block  chainhash.Hash
+}
+
+const jobOpLogSize = 50_000 // transactions remembered
+
+var jobOpLog = struct {
+	sync.Mutex
+	byTx  map[chainhash.Hash][]JobOpResult
+	order []chainhash.Hash
+}{byTx: map[chainhash.Hash][]JobOpResult{}}
+
+// JobOpResults returns the outcomes of the job ops in transaction txid, as last validated
+// (nil if the node has not validated a block with it since it started).
+func JobOpResults(txid chainhash.Hash) []JobOpResult {
+	jobOpLog.Lock()
+	defer jobOpLog.Unlock()
+	return append([]JobOpResult(nil), jobOpLog.byTx[txid]...)
+}
+
+func recordJobOps(node *blockNode, block *btcutil.Block, ops []*jobstate.Op, res *jobstate.BlockResult) {
+	if len(ops) == 0 {
+		return
+	}
+	byRef := make(map[jobstate.Hash]int, len(ops))
+	for i, op := range ops {
+		byRef[op.Ref] = i
+	}
+	got := map[chainhash.Hash][]JobOpResult{}
+	var txs []chainhash.Hash
+	for _, tx := range block.Transactions()[1:] {
+		for oi, out := range tx.MsgTx().TxOut {
+			if tag, _ := ParseJobOutput(out.PkScript); !bytes.Equal(tag, JobOpTag) {
+				continue
+			}
+			var ref [36]byte
+			copy(ref[:32], tx.Hash()[:])
+			ref[32], ref[33], ref[34], ref[35] = byte(oi), byte(oi>>8), byte(oi>>16), byte(oi>>24)
+			r := JobOpResult{Output: oi, Height: node.height, Block: node.hash}
+			i, ok := byRef[jobstate.Hash(chainhash.HashH(ref[:]))]
+			switch {
+			case !ok:
+				r.Kind, r.Error = "?", "not decoded (malformed payload, or no authorizing input)"
+			default:
+				r.Kind = ops[i].Kind.String()
+				if i < len(res.OpErrors) && res.OpErrors[i] != nil {
+					r.Error = strings.TrimPrefix(res.OpErrors[i].Error(), r.Kind+": ")
+				}
+			}
+			if r.Error != "" {
+				log.Infof("Job op failed in block %v (height %d): tx %v output %d %s: %s", node.hash, node.height,
+					tx.Hash(), oi, r.Kind, r.Error)
+			}
+			if _, seen := got[*tx.Hash()]; !seen {
+				txs = append(txs, *tx.Hash())
+			}
+			got[*tx.Hash()] = append(got[*tx.Hash()], r)
+		}
+	}
+	jobOpLog.Lock()
+	defer jobOpLog.Unlock()
+	for _, h := range txs {
+		if _, ok := jobOpLog.byTx[h]; !ok {
+			jobOpLog.order = append(jobOpLog.order, h)
+		}
+		jobOpLog.byTx[h] = got[h]
+	}
+	for len(jobOpLog.order) > jobOpLogSize {
+		delete(jobOpLog.byTx, jobOpLog.order[0])
+		jobOpLog.order = jobOpLog.order[1:]
+	}
+}
