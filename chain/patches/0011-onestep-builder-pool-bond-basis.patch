+// TestAgentVectors checks the devnet agent's Python protocol helpers (runtime/agent/proto.py):
+// sampled positions, salted stage commitments and reveals, verifier result hashes.
+func TestAgentVectors(t *testing.T) {
+	raw, err := os.ReadFile("testdata/agent_vectors.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var v struct {
+		P20, P5, P1000 []uint32
+		StageRoot      string `json:"stage_root"`
+		Reveal3        struct {
+			Stage      uint32
+			Salt, Root string
+			Proof      []string
+		} `json:"reveal3"`
+		Result string `json:"result"`
+	}
+	var m map[string]json.RawMessage
+	if err := json.Unmarshal(raw, &m); err != nil {
+		t.Fatal(err)
+	}
+	json.Unmarshal(m["positions_20_3"], &v.P20)
+	json.Unmarshal(m["positions_5_9"], &v.P5)
+	json.Unmarshal(m["positions_1000_2"], &v.P1000)
+	json.Unmarshal(raw, &v)
+	salt := tagHash("salt")
+	eq := func(a, b []uint32) bool { return fmt.Sprint(a) == fmt.Sprint(b) }
+	if !eq(Positions(salt, 20, 3), v.P20) || !eq(Positions(salt, 5, 9), v.P5) || !eq(Positions(salt, 1000, 2), v.P1000) {
+		t.Fatalf("positions differ: %v %v %v", Positions(salt, 20, 3), Positions(salt, 5, 9), Positions(salt, 1000, 2))
+	}
+	var roots, leaves []Hash
+	for i := uint32(0); i < 5; i++ {
+		r, s := tagHash("root", u32b(i)), tagHash("s", u32b(i))
+		roots = append(roots, r)
+		leaves = append(leaves, StageLeaf(i, s, r))
+	}
+	sr := MerkleRoot(leaves)
+	if hex.EncodeToString(sr[:]) != v.StageRoot {
+		t.Fatal("stage root differs")
+	}
+	var proof []Hash
+	for _, p := range v.Reveal3.Proof {
+		var h Hash
+		b, _ := hex.DecodeString(p)
+		copy(h[:], b)
+		proof = append(proof, h)
+	}
+	if !VerifyMerkleProof(sr, leaves[3], 3, 5, proof) {
+		t.Fatal("reveal proof from the agent does not verify")
+	}
+	acct := AccountID(tagHash("acct"))
+	if rh := ResultHash(roots[:3], acct, salt); hex.EncodeToString(rh[:]) != v.Result {
+		t.Fatal("result hash differs")
+	}
+}
