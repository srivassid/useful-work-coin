+// memWeights is an in-memory WeightStore for the tiny model.
+type memWeights struct {
+	tm *tinyModel
+}
+
+func (m memWeights) Row(w WeightRow) ([]uint32, error) {
+	r, ok := m.tm.weights[w]
+	if !ok {
+		return nil, fmt.Errorf("no weight row %+v", w)
+	}
+	return r, nil
+}
+func (m memWeights) Leaves() []Hash { return m.tm.wleaves }
+
+// TestBuildOneStepDefeatsALyingChallenger: an honest provider plays a lying watcher to the
+// last round and proves the element with BuildOneStep (the devnet agent's path).
+func TestBuildOneStepDefeatsALyingChallenger(t *testing.T) {
+	tm := loadTiny(t)
+	for _, stage := range []uint32{0, 3} { // first layer group (tokens) and second (stage input)
+		w, cat, _, _ := tinyPool(t, tm, 610+uint64(stage), nil)
+		prov := tm.newParty(t, acct(74), tm.weights, tm.tokens, nil, nil)
+		id, salts, sl := commitUnit(t, w, cat, prov)
+		liar := acct(83)
+		prog := Program(tm.cfg, len(tm.tokens[0]), int(stage%2), int(stage%2)+1)
+		chal := tm.newParty(t, liar, tm.weights, tm.tokens, corruptAt(stage, len(prog)/3, 7), nil)
+		mustOK(t, w.block([]Deposit{{liar, 1e8}}, []*Op{{Kind: OpChallenge, Actor: liar, Job: id, U1: stage,
+			H1: chal.root(stage), Amount: w.p.ChallengeBondMin}}, nil))
+		il, _ := tm.inputTree()
+		steps := 0
+		for i := 0; i < 3000 && w.st.Jobs[id].Status == StatusDisputed; i++ {
+			j := w.st.Jobs[id]
+			var ops []*Op
+			if g := j.Game; g != nil {
+				switch g.Phase {
+				case GReveal:
+					ops = append(ops, &Op{Kind: OpTraceReveal, Actor: prov.acct, Job: id, Reveals: []StageReveal{
+						{Stage: g.Stage, Salt: salts[g.Stage], Root: prov.root(g.Stage), Proof: MerkleProof(sl, int(g.Stage))}}})
+				case GOneStep:
+					b := int(g.Stage) / 2
+					in := OneStepInput{Cfg: tm.cfg, LayerGroups: 2, Stage: g.Stage, Leaf: g.Leaf, Elem: g.Elem,
+						Rows: prov.rows[g.Stage], Tokens: prov.tokens[b], InputLeaves: il, StageLeaves: sl,
+						Weights: memWeights{tm}}
+					if g.Stage%2 == 1 {
+						in.PrevRows = prov.rows[g.Stage-1]
+						in.PrevReveal = &StageReveal{Stage: g.Stage - 1, Salt: salts[g.Stage-1], Root: prov.root(g.Stage - 1),
+							Proof: MerkleProof(sl, int(g.Stage-1))}
+					}
+					o, v, err := BuildOneStep(in)
+					if err != nil {
+						t.Fatal(err)
+					}
+					if v != g.PWord {
+						t.Fatalf("one-step value %08x, provider's word %08x", v, g.PWord)
+					}
+					o.Actor, o.Job = prov.acct, id
+					ops = append(ops, o)
+					steps++
+				default:
+					if !g.PMoved {
+						ops = append(ops, prov.move(tm, j, g))
+					}
+					if !g.CMoved {
+						ops = append(ops, chal.move(tm, j, g))
+					}
+				}
+			}
+			res := w.block(nil, ops, nil)
+			for k, o := range ops {
+				if o.Kind == OpOneStep && res.OpErrors[k] != nil {
+					t.Fatalf("stage %d: ONE_STEP rejected: %v", stage, res.OpErrors[k])
+				}
+			}
+		}
+		j := w.st.Jobs[id]
+		if steps != 1 || j.Status == StatusFailed || j.Status == StatusDisputed {
+			t.Fatalf("stage %d: status %v after %d one-step proofs", stage, j.Status, steps)
+		}
+	}
+}
+
+// TestPoolBondAfterABigPayout: after one unit collects a large accumulated budget, new claims
+// are still bonded against the reference cost, so providers are not priced out.
+func TestPoolBondAfterABigPayout(t *testing.T) {
+	w := newPoolWorld(t, 520, 3)
+	w.p.PoolEpoch = 200
+	w.income = 50_000_000_000 // large income: the first delivery collects a big budget
+	cat := w.openCategory(w.spec(4))
+	prov := acct(75)
+	w.block([]Deposit{{prov, 1e9}}, nil, nil)
+	tr := w.newTrace(8)
+	id := w.runUnit(cat, prov, 0, tr, tr)
+	for w.st.Jobs[id].Status != StatusSettled {
+		w.block(nil, nil, nil)
+	}
+	w.runTo(w.nextEpochEnd())
+	c := w.st.Categories[cat]
+	if c.Price <= 100*c.Spec.InitPrice {
+		t.Fatalf("expected a big payout, price %d", c.Price)
+	}
+	w.block(nil, nil, nil)
+	o := w.claimOp(cat, prov, 1) // bond from claimOp uses Price; set it to the reference basis
+	o.Amount = minBond(w.p, c.Spec.InitPrice)
+	if r := w.block(nil, []*Op{o}, nil); r.OpErrors[0] != nil {
+		t.Fatalf("claim bonded against the reference cost rejected: %v", r.OpErrors[0])
+	}
+}
