+// BondBasis is the amount a claim's bond is sized against: the last per-unit payout, but never
+// more than the council's reference unit cost (InitPrice). The bond only has to cover what the
+// withheld payout does not (F + B >= S c): a payout far above cost, as after a dry spell when
+// one unit collects the accumulated budget, already deters cheating by itself, and basing the
+// bond on it would price every provider out and freeze the category (seen on the devnet).
+func (c *Category) BondBasis() Amount { return min(c.Price, c.Spec.InitPrice) }
+
 // poolVerifierPay is escrowed from the category budget when a unit is claimed.
 func poolVerifierPay(p Params, c *CategorySpec) Amount {
 	return Amount(int(c.K)*int(c.N)) * p.VerifierFloorPerSample
@@ -278,7 +285,7 @@ func (s *State) poolClaim(p Params, h int32, o *Op) error {
 	if !VerifyMerkleProof(c.Spec.WorkRoot, UnitLeaf(o.U1, o.H1), int(o.U1), int(c.Spec.Units), o.Proof) {
 		return errors.New("input root is not this unit of the work list")
 	}
-	if o.Amount < minBond(p, c.Price) {
+	if o.Amount < minBond(p, c.BondBasis()) {
 		return errors.New("bond below minimum")
 	}
 	vp := poolVerifierPay(p, &c.Spec)
