+package main
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"os"
+
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+)
+
+// oneStepReq is written by the devnet agent when a game it plays as provider reaches its last round.
+type oneStepReq struct {
+	Job      string     `json:"job"`
+	Model    string     `json:"model"`   // model json (agent.model_info): cfg, layer_groups
+	Weights  string     `json:"weights"` // weights store directory (agent.weights_store)
+	Rows     string     `json:"rows"`    // this stage's trace rows
+	PrevRows string     `json:"prev_rows"`
+	Batches  [][]uint32 `json:"batches"` // the job's token batches
+	Salts    []string   `json:"salts"`   // the provider's stage salts and roots
+	Roots    []string   `json:"roots"`
+}
+
+func readRows(path string) ([][]uint32, error) {
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	if len(b) < 4 {
+		return nil, fmt.Errorf("%s: short", path)
+	}
+	n := binary.LittleEndian.Uint32(b)
+	p := 4
+	rows := make([][]uint32, 0, n)
+	for i := uint32(0); i < n; i++ {
+		if p+4 > len(b) {
+			return nil, fmt.Errorf("%s: truncated", path)
+		}
+		w := int(binary.LittleEndian.Uint32(b[p:]))
+		p += 4
+		if p+4*w > len(b) {
+			return nil, fmt.Errorf("%s: truncated row %d", path, i)
+		}
+		r := make([]uint32, w)
+		for k := range r {
+			r[k] = binary.LittleEndian.Uint32(b[p+4*k:])
+		}
+		p += 4 * w
+		rows = append(rows, r)
+	}
+	return rows, nil
+}
+
+func oneStep(keyPath, reqPath string) {
+	raw, err := os.ReadFile(reqPath)
+	if err != nil {
+		die(err)
+	}
+	var req oneStepReq
+	if err := json.Unmarshal(raw, &req); err != nil {
+		die(err)
+	}
+	var mi struct {
+		LayerGroups int               `json:"layer_groups"`
+		Cfg         jobstate.ModelCfg `json:"cfg"`
+	}
+	raw, err = os.ReadFile(req.Model)
+	if err != nil {
+		die(err)
+	}
+	if err := json.Unmarshal(raw, &mi); err != nil {
+		die(err)
+	}
+	c := client()
+	var job struct {
+		Game *struct {
+			Stage uint32 `json:"stage"`
+			Phase uint8  `json:"phase"`
+			Leaf  int    `json:"leaf"`
+			Elem  int    `json:"elem"`
+		} `json:"game"`
+	}
+	if err := c.Query("getjob", &job, req.Job); err != nil {
+		die(err)
+	}
+	if job.Game == nil || job.Game.Phase != jobstate.GOneStep {
+		die(fmt.Errorf("job %s is not waiting for a one-step proof", req.Job))
+	}
+	g := job.Game
+	w, err := jobstate.OpenFileWeights(req.Weights, mi.Cfg)
+	if err != nil {
+		die(err)
+	}
+	rows, err := readRows(req.Rows)
+	if err != nil {
+		die(err)
+	}
+	in := jobstate.OneStepInput{Cfg: mi.Cfg, LayerGroups: mi.LayerGroups, Stage: g.Stage, Leaf: g.Leaf, Elem: g.Elem,
+		Rows: rows, Weights: w}
+	b := int(g.Stage) / mi.LayerGroups
+	if b >= len(req.Batches) {
+		die(fmt.Errorf("stage %d: no batch %d", g.Stage, b))
+	}
+	in.Tokens = req.Batches[b]
+	for i, toks := range req.Batches {
+		in.InputLeaves = append(in.InputLeaves, jobstate.TokenLeaf(i, jobstate.RowRoot(toks)))
+	}
+	for i := range req.Salts {
+		in.StageLeaves = append(in.StageLeaves, jobstate.StageLeaf(uint32(i), hash32(req.Salts[i]), hash32(req.Roots[i])))
+	}
+	if int(g.Stage)%mi.LayerGroups > 0 {
+		if in.PrevRows, err = readRows(req.PrevRows); err != nil {
+			die(err)
+		}
+		p := g.Stage - 1
+		in.PrevReveal = &jobstate.StageReveal{Stage: p, Salt: hash32(req.Salts[p]), Root: hash32(req.Roots[p]),
+			Proof: jobstate.MerkleProof(in.StageLeaves, int(p))}
+	}
+	o, v, err := jobstate.BuildOneStep(in)
+	if err != nil {
+		die(err)
+	}
+	o.Job = hash32(req.Job)
+	fmt.Fprintf(os.Stderr, "one-step: stage %d leaf %d elem %d -> %08x, %d proven rows\n", g.Stage, g.Leaf, g.Elem, v, len(o.Inputs))
+	submit(key(keyPath), nil, o)
+}
