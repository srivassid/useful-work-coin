+++ b/node/jobstate/onestep.go
@@ -0,0 +1,228 @@
+package jobstate
+
+import (
+	"encoding/binary"
+	"fmt"
+	"io"
+	"os"
+	"path/filepath"
+)
+
+// One-step proofs for providers (build step 7): the last round of a dispute game, in which the
+// provider supplies every row the referee reads to recompute the disputed element, each with a
+// Merkle proof against a commitment (this stage's trace, the previous stage's trace, the
+// weights tree or the job's input tree).
+
+// WeightStore serves canonical weight rows and the weights-tree leaves.
+type WeightStore interface {
+	Row(w WeightRow) ([]uint32, error)
+	Leaves() []Hash
+}
+
+// FileWeights reads the store written by runtime/agent/weights_store.py.
+type FileWeights struct {
+	cfg    ModelCfg
+	f      *os.File
+	off    []uint64
+	leaves []Hash
+}
+
+func OpenFileWeights(dir string, cfg ModelCfg) (*FileWeights, error) {
+	f, err := os.Open(filepath.Join(dir, "rows.bin"))
+	if err != nil {
+		return nil, err
+	}
+	rawOff, err := os.ReadFile(filepath.Join(dir, "offsets.bin"))
+	if err != nil {
+		return nil, err
+	}
+	rawLv, err := os.ReadFile(filepath.Join(dir, "leaves.bin"))
+	if err != nil {
+		return nil, err
+	}
+	w := &FileWeights{cfg: cfg, f: f}
+	for i := 0; i+8 <= len(rawOff); i += 8 {
+		w.off = append(w.off, binary.LittleEndian.Uint64(rawOff[i:]))
+	}
+	for i := 0; i+32 <= len(rawLv); i += 32 {
+		var h Hash
+		copy(h[:], rawLv[i:])
+		w.leaves = append(w.leaves, h)
+	}
+	if len(w.off) != len(w.leaves)+1 {
+		return nil, fmt.Errorf("weights store: %d offsets for %d rows", len(w.off), len(w.leaves))
+	}
+	return w, nil
+}
+
+func (w *FileWeights) Leaves() []Hash { return w.leaves }
+
+func (w *FileWeights) Row(wr WeightRow) ([]uint32, error) {
+	i, n, err := w.cfg.weightIndex(wr)
+	if err != nil {
+		return nil, err
+	}
+	if i+1 >= len(w.off) {
+		return nil, fmt.Errorf("weight row %d not in store", i)
+	}
+	b := make([]byte, w.off[i+1]-w.off[i])
+	if _, err := w.f.ReadAt(b, int64(w.off[i])); err != nil && err != io.EOF {
+		return nil, err
+	}
+	out := make([]uint32, n)
+	switch wr.Name {
+	case "qkv", "o", "gu", "down": // int8 values, then the fp32 scale bits
+		if len(b) != n-1+4 {
+			return nil, fmt.Errorf("linear row %+v: %d bytes, want %d", wr, len(b), n+3)
+		}
+		for k := 0; k < n-1; k++ {
+			out[k] = uint32(int32(int8(b[k])))
+		}
+		out[n-1] = binary.LittleEndian.Uint32(b[n-1:])
+	default:
+		if len(b) != 4*n {
+			return nil, fmt.Errorf("row %+v: %d bytes, want %d", wr, len(b), 4*n)
+		}
+		for k := range out {
+			out[k] = binary.LittleEndian.Uint32(b[4*k:])
+		}
+	}
+	return out, nil
+}
+
+// readRecorder serves rows from memory and notes which ones the referee reads.
+type readRecorder struct {
+	mem     *MemSource
+	weights WeightStore
+	leaves  []LeafDesc
+	wrows   []WeightRow
+	inputs  []int
+	tokens  bool
+}
+
+func (r *readRecorder) Leaf(d LeafDesc) ([]uint32, error) {
+	r.leaves = append(r.leaves, d)
+	return r.mem.Leaf(d)
+}
+
+func (r *readRecorder) Weight(w WeightRow) ([]uint32, error) {
+	r.wrows = append(r.wrows, w)
+	return r.weights.Row(w)
+}
+
+func (r *readRecorder) StageInput(t int) ([]uint32, error) {
+	r.inputs = append(r.inputs, t)
+	return r.mem.StageInput(t)
+}
+
+func (r *readRecorder) Tokens() ([]uint32, error) { r.tokens = true; return r.mem.Tokens() }
+
+// OneStepInput is what a provider has when a game reaches its last round.
+type OneStepInput struct {
+	Cfg         ModelCfg
+	LayerGroups int
+	Stage       uint32
+	Leaf, Elem  int
+	Rows        [][]uint32 // this stage's trace rows, in program order
+	PrevRows    [][]uint32 // the previous stage's trace rows (layer group > 0)
+	Tokens      []uint32   // this batch's tokens
+	InputLeaves []Hash     // the job's input tree leaves (TokenLeaf per batch)
+	StageLeaves []Hash     // the provider's salted stage commitment leaves
+	PrevReveal  *StageReveal
+	Weights     WeightStore
+}
+
+// BuildOneStep returns the ONE_STEP op (Job unset) proving element Elem of leaf Leaf. It also
+// returns the value the referee will compute, which should equal the provider's own.
+func BuildOneStep(in OneStepInput) (*Op, uint32, error) {
+	G := in.LayerGroups
+	b, grp := int(in.Stage)/G, int(in.Stage)%G
+	lpg := in.Cfg.L / G
+	T := len(in.Tokens)
+	st := Stage{Cfg: in.Cfg, T: T, L0: grp * lpg, L1: (grp + 1) * lpg}
+	prog := Program(in.Cfg, T, st.L0, st.L1)
+	if len(in.Rows) != len(prog) {
+		return nil, 0, fmt.Errorf("stage has %d rows, program %d", len(in.Rows), len(prog))
+	}
+	if in.Leaf < 0 || in.Leaf >= len(prog) {
+		return nil, 0, fmt.Errorf("leaf %d out of range", in.Leaf)
+	}
+	mem := &MemSource{Toks: in.Tokens, Leaves: map[LeafDesc][]uint32{}}
+	for i, d := range prog {
+		mem.Leaves[d] = in.Rows[i]
+	}
+	var prevIdx programIndex
+	if grp > 0 {
+		pp := Program(in.Cfg, T, st.L0-lpg, st.L0)
+		if len(in.PrevRows) != len(pp) {
+			return nil, 0, fmt.Errorf("previous stage has %d rows, program %d", len(in.PrevRows), len(pp))
+		}
+		prevIdx = indexProgram(pp)
+		for t := 0; t < T; t++ {
+			mem.Input = append(mem.Input, in.PrevRows[prevIdx[LeafDesc{LR2, st.L0 - 1, t, -1}]])
+		}
+	}
+	rec := &readRecorder{mem: mem, weights: in.Weights}
+	v, err := st.Recompute(prog[in.Leaf], in.Elem, rec)
+	if err != nil {
+		return nil, 0, err
+	}
+	leafHashes := make([]Hash, len(in.Rows))
+	for i, r := range in.Rows {
+		leafHashes[i] = TraceLeaf(i, RowRoot(r))
+	}
+	idx := indexProgram(prog)
+	o := &Op{Kind: OpOneStep}
+	seen := map[string]bool{}
+	for _, d := range rec.leaves {
+		k := fmt.Sprint("l", d)
+		if seen[k] {
+			continue
+		}
+		seen[k] = true
+		i := idx[d]
+		o.Inputs = append(o.Inputs, ProvenRow{Kind: RowLeaf, Leaf: d, Words: in.Rows[i], Proof: MerkleProof(leafHashes, i)})
+	}
+	wl := in.Weights.Leaves()
+	for _, wr := range rec.wrows {
+		k := fmt.Sprint("w", wr)
+		if seen[k] {
+			continue
+		}
+		seen[k] = true
+		i, _, err := in.Cfg.weightIndex(wr)
+		if err != nil {
+			return nil, 0, err
+		}
+		row, err := in.Weights.Row(wr)
+		if err != nil {
+			return nil, 0, err
+		}
+		o.Inputs = append(o.Inputs, ProvenRow{Kind: RowWeight, W: wr, Words: row, Proof: MerkleProof(wl, i)})
+	}
+	if len(rec.inputs) > 0 {
+		prevLeaves := make([]Hash, len(in.PrevRows))
+		for i, r := range in.PrevRows {
+			prevLeaves[i] = TraceLeaf(i, RowRoot(r))
+		}
+		for _, t := range rec.inputs {
+			k := fmt.Sprint("i", t)
+			if seen[k] {
+				continue
+			}
+			seen[k] = true
+			i := prevIdx[LeafDesc{LR2, st.L0 - 1, t, -1}]
+			o.Inputs = append(o.Inputs, ProvenRow{Kind: RowInput, Index: t, Words: mem.Input[t], Proof: MerkleProof(prevLeaves, i)})
+		}
+	}
+	if rec.tokens {
+		o.Inputs = append(o.Inputs, ProvenRow{Kind: RowTokens, Index: b, Words: in.Tokens, Proof: MerkleProof(in.InputLeaves, b)})
+	}
+	if grp > 0 {
+		if in.PrevReveal == nil {
+			return nil, 0, fmt.Errorf("the previous stage must be opened")
+		}
+		o.Reveals = []StageReveal{*in.PrevReveal}
+	}
+	return o, v, nil
+}
