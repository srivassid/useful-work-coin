diff --git a/node/rpcjobs.go b/node/rpcjobs.go
new file mode 100644
index 00000000..a38d3621
--- /dev/null
+++ b/node/rpcjobs.go
@@ -0,0 +1,280 @@
+package main
+
+import (
+	"bytes"
+	"encoding/hex"
+	"sort"
+
+	"github.com/pearl-research-labs/pearl/node/btcjson"
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+)
+
+// Read-only RPCs over the Useful-Work Coin job module (build step 7).
+
+func init() {
+	h := map[string]commandHandler{
+		"getjobstate":   handleGetJobState,
+		"getjob":        handleGetJob,
+		"listjobs":      handleListJobs,
+		"getjobaccount": handleGetJobAccount,
+		"getcategory":   handleGetCategory,
+	}
+	for k, v := range h {
+		rpcHandlersBeforeInit[k] = v
+		rpcLimited[k] = struct{}{}
+		rpcResultTypes[k] = []interface{}{(*map[string]interface{})(nil)}
+	}
+	for k, v := range map[string]string{
+		"getjobstate--synopsis":   "Returns a summary of the job module after the best block: state root, statistics, system balances, categories, proposals and forced-error commitments.",
+		"getjobstate--result0":    "Job-module summary",
+		"getjob--synopsis":        "Returns one job of the job module.",
+		"getjob-jobid":            "The hex-encoded job id",
+		"getjob--result0":         "The job",
+		"listjobs--synopsis":      "Lists jobs (id, status, provider, fee), optionally only those with one status.",
+		"listjobs-status":         "Only jobs with this status (posted, accepted, committed, verify-commit, verify-reveal, provider-reveal, challenge, disputed, settled, expired, failed, aborted)",
+		"listjobs--result0":       "Jobs keyed by id",
+		"getjobaccount--synopsis": "Returns a job-module account: free balance, verifier stake, unbonding stake and pending withdrawals.",
+		"getjobaccount-account":   "The hex-encoded account (sha256 of the controlling pkScript)",
+		"getjobaccount--result0":  "The account",
+		"getcategory--synopsis":   "Returns a public-good pool category.",
+		"getcategory-categoryid":  "The hex-encoded category id",
+		"getcategory--result0":    "The category",
+	} {
+		helpDescsEnUS[k] = v
+	}
+	for k := range h { // map results: one entry per field
+		helpDescsEnUS[k+"--result0--key"] = "field"
+		helpDescsEnUS[k+"--result0--value"] = "value"
+		helpDescsEnUS[k+"--result0--desc"] = "see the synopsis"
+	}
+}
+
+func hx(b []byte) string { return hex.EncodeToString(b) }
+
+func parseHash(s string) (jobstate.Hash, error) {
+	var h jobstate.Hash
+	b, err := hex.DecodeString(s)
+	if err != nil || len(b) != 32 {
+		return h, &btcjson.RPCError{Code: btcjson.ErrRPCInvalidParameter, Message: "expected 32 hex-encoded bytes"}
+	}
+	copy(h[:], b)
+	return h, nil
+}
+
+func (s *rpcServer) jobState() (*jobstate.State, error) {
+	if s.cfg.ChainParams.JobModule == nil {
+		return nil, &btcjson.RPCError{Code: btcjson.ErrRPCMisc, Message: "this network has no job module"}
+	}
+	st, err := s.cfg.Chain.JobStateAtTip()
+	if err != nil {
+		return nil, &btcjson.RPCError{Code: btcjson.ErrRPCMisc, Message: err.Error()}
+	}
+	if st == nil {
+		return nil, &btcjson.RPCError{Code: btcjson.ErrRPCMisc, Message: "this network has no job module"}
+	}
+	return st, nil
+}
+
+func handleGetJobState(s *rpcServer, cmd interface{}, closeChan <-chan struct{}) (interface{}, error) {
+	st, err := s.jobState()
+	if err != nil {
+		return nil, err
+	}
+	statuses := map[string]int{}
+	for _, j := range st.Jobs {
+		statuses[j.Status.String()]++
+	}
+	cats := map[string]interface{}{}
+	for id, c := range st.Categories {
+		cats[hx(id[:])] = categorySummary(c)
+	}
+	props := map[string]interface{}{}
+	for id, p := range st.Proposals {
+		var ap []string
+		for _, a := range p.Approvals {
+			ap = append(ap, hx(a[:]))
+		}
+		props[hx(id[:])] = map[string]interface{}{"action": hx(p.Action), "approvals": ap, "expires": p.Expires}
+	}
+	fes := map[string]interface{}{}
+	for id, f := range st.FECommits {
+		fes[hx(id[:])] = map[string]interface{}{"commitment": hx(f.Commitment[:]), "reserve": f.Reserve,
+			"height": f.Height, "expires": f.Expires}
+	}
+	root := st.Root()
+	best := s.cfg.Chain.BestSnapshot()
+	return map[string]interface{}{
+		"height":     best.Height,
+		"root":       hx(root[:]),
+		"stats":      st.Stats,
+		"jobs":       statuses,
+		"models":     len(st.Models),
+		"pool":       st.Accounts[jobstate.PoolAccount],
+		"treasury":   st.Accounts[jobstate.TreasuryAccount],
+		"holdings":   st.Holdings(),
+		"stakers":    len(st.Stakes),
+		"categories": cats,
+		"proposals":  props,
+		"fecommits":  fes,
+	}, nil
+}
+
+func categorySummary(c *jobstate.Category) map[string]interface{} {
+	sp := c.Spec
+	return map[string]interface{}{
+		"model": hx(sp.Model[:]), "workroot": hx(sp.WorkRoot[:]), "units": sp.Units, "stagesperunit": sp.StagesPerUnit,
+		"seqlen": sp.SeqLen, "k": sp.K, "n": sp.N, "unitdeadline": sp.UnitDeadline, "capbp": sp.CapBP,
+		"curator": hx(sp.Curator[:]), "canaryleaves": sp.CanaryLeaves,
+		"budget": c.Budget, "price": c.Price, "retired": c.Retired, "closed": c.Closed,
+		"inflight": c.InFlight, "done": c.Done, "epochdeliveries": len(c.Epoch),
+	}
+}
+
+func jobJSON(j *jobstate.Job) map[string]interface{} {
+	var committee []interface{}
+	for _, v := range j.Committee {
+		committee = append(committee, map[string]interface{}{"account": hx(v.Account[:]), "committed": v.Committed,
+			"revealed": v.Revealed, "positions": v.Positions, "flagged": v.Flagged})
+	}
+	var revealed []interface{}
+	for _, r := range j.Revealed {
+		revealed = append(revealed, map[string]interface{}{"stage": r.Stage, "root": hx(r.Root[:])})
+	}
+	var disputes []interface{}
+	for _, d := range j.Disputes {
+		disputes = append(disputes, map[string]interface{}{"verifier": d.Verifier, "challenger": hx(d.Challenger[:]),
+			"stage": d.Stage, "claimedroot": hx(d.ClaimedRoot[:]), "bond": d.Bond, "height": d.Height})
+	}
+	out := map[string]interface{}{
+		"id": hx(j.ID[:]), "status": j.Status.String(), "client": hx(j.Client[:]), "provider": hx(j.Provider[:]),
+		"model": hx(j.Model[:]), "inputroot": hx(j.InputRoot[:]), "stages": j.Stages, "seqlen": j.SeqLen,
+		"k": j.K, "n": j.N, "fee": j.Fee, "verifierpay": j.VerifierPay, "treasurycut": j.TreasuryCut, "bond": j.Bond,
+		"deadline": j.Deadline, "phaseend": j.PhaseEnd, "posted": j.PostHeight, "accepted": j.AcceptHeight,
+		"committedat": j.CommitHeight, "stageroot": hx(j.StageRoot[:]), "outputroot": hx(j.OutputRoot[:]),
+		"challengeend": j.ChallengeEnd, "committee": committee, "revealed": revealed, "disputes": disputes,
+		"decoy": j.Decoy,
+	}
+	if j.IsPool() {
+		out["pool"] = hx(j.Pool[:])
+		out["unit"] = j.Unit
+		out["canary"] = j.Canary != nil
+	}
+	if g := j.Game; g != nil {
+		out["game"] = map[string]interface{}{"stage": g.Stage, "phase": g.Phase, "lo": g.Lo, "size": g.Size,
+			"n": g.N, "leaf": g.Leaf, "block": g.Block, "elem": g.Elem, "pmoved": g.PMoved, "cmoved": g.CMoved,
+			"deadline": g.Deadline, "provroot": hx(g.ProvRoot[:]), "chalroot": hx(g.ChalRoot[:])}
+	}
+	var reqs []interface{}
+	for _, r := range j.DataReqs {
+		served := 0
+		for _, x := range r.Served {
+			if x {
+				served++
+			}
+		}
+		reqs = append(reqs, map[string]interface{}{"stage": r.Stage, "requester": hx(r.Requester[:]), "due": r.Due,
+			"served": served, "rows": len(r.Served)})
+	}
+	if reqs != nil {
+		out["datarequests"] = reqs
+	}
+	return out
+}
+
+func handleGetJob(s *rpcServer, cmd interface{}, closeChan <-chan struct{}) (interface{}, error) {
+	c := cmd.(*btcjson.GetJobCmd)
+	id, err := parseHash(c.JobID)
+	if err != nil {
+		return nil, err
+	}
+	st, err := s.jobState()
+	if err != nil {
+		return nil, err
+	}
+	j := st.Jobs[id]
+	if j == nil {
+		return nil, &btcjson.RPCError{Code: btcjson.ErrRPCInvalidParameter, Message: "unknown job"}
+	}
+	return jobJSON(j), nil
+}
+
+func handleListJobs(s *rpcServer, cmd interface{}, closeChan <-chan struct{}) (interface{}, error) {
+	c := cmd.(*btcjson.ListJobsCmd)
+	st, err := s.jobState()
+	if err != nil {
+		return nil, err
+	}
+	ids := make([]jobstate.Hash, 0, len(st.Jobs))
+	for id, j := range st.Jobs {
+		if c.Status == nil || j.Status.String() == *c.Status {
+			ids = append(ids, id)
+		}
+	}
+	sort.Slice(ids, func(a, b int) bool { return bytes.Compare(ids[a][:], ids[b][:]) < 0 })
+	out := map[string]interface{}{}
+	for _, id := range ids {
+		j := st.Jobs[id]
+		e := map[string]interface{}{"status": j.Status.String(), "provider": hx(j.Provider[:]), "client": hx(j.Client[:]),
+			"fee": j.Fee, "stages": j.Stages, "posted": j.PostHeight, "phaseend": j.PhaseEnd}
+		if j.IsPool() {
+			e["pool"], e["unit"] = hx(j.Pool[:]), j.Unit
+		}
+		out[hx(id[:])] = e
+	}
+	return out, nil
+}
+
+func handleGetJobAccount(s *rpcServer, cmd interface{}, closeChan <-chan struct{}) (interface{}, error) {
+	c := cmd.(*btcjson.GetJobAccountCmd)
+	h, err := parseHash(c.Account)
+	if err != nil {
+		return nil, err
+	}
+	a := jobstate.AccountID(h)
+	st, err := s.jobState()
+	if err != nil {
+		return nil, err
+	}
+	var unb, wds []interface{}
+	for _, u := range st.Unbonding {
+		if u.Account == a {
+			unb = append(unb, map[string]interface{}{"amount": u.Amount, "due": u.Due})
+		}
+	}
+	for _, w := range st.Withdrawals {
+		if w.Account == a {
+			wds = append(wds, map[string]interface{}{"amount": w.Amount, "due": w.Due, "pkscript": hx(w.PkScript)})
+		}
+	}
+	return map[string]interface{}{"account": hx(a[:]), "balance": st.Accounts[a], "stake": st.Stakes[a],
+		"unbonding": unb, "withdrawals": wds}, nil
+}
+
+func handleGetCategory(s *rpcServer, cmd interface{}, closeChan <-chan struct{}) (interface{}, error) {
+	c := cmd.(*btcjson.GetCategoryCmd)
+	id, err := parseHash(c.CategoryID)
+	if err != nil {
+		return nil, err
+	}
+	st, err := s.jobState()
+	if err != nil {
+		return nil, err
+	}
+	cat := st.Categories[id]
+	if cat == nil {
+		return nil, &btcjson.RPCError{Code: btcjson.ErrRPCInvalidParameter, Message: "unknown category"}
+	}
+	out := categorySummary(cat)
+	var inflight, done []uint32
+	for i, u := range cat.Units {
+		if u.Done {
+			done = append(done, i)
+		} else {
+			inflight = append(inflight, i)
+		}
+	}
+	sort.Slice(inflight, func(a, b int) bool { return inflight[a] < inflight[b] })
+	out["inflightunits"] = inflight
+	out["doneunits"] = len(done)
+	return out, nil
+}
