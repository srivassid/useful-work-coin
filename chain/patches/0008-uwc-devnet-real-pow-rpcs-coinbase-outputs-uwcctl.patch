+package btcjson
+
+// Useful-Work Coin job-module queries (read-only).
+
+// GetJobStateCmd defines the getjobstate JSON-RPC command.
+type GetJobStateCmd struct{}
+
+// GetJobCmd defines the getjob JSON-RPC command.
+type GetJobCmd struct {
+	JobID string
+}
+
+// ListJobsCmd defines the listjobs JSON-RPC command.
+type ListJobsCmd struct {
+	Status *string
+}
+
+// GetJobAccountCmd defines the getjobaccount JSON-RPC command.
+type GetJobAccountCmd struct {
+	Account string
+}
+
+// GetCategoryCmd defines the getcategory JSON-RPC command.
+type GetCategoryCmd struct {
+	CategoryID string
+}
+
+func init() {
+	flags := UsageFlag(0)
+	MustRegisterCmd("getjobstate", (*GetJobStateCmd)(nil), flags)
+	MustRegisterCmd("getjob", (*GetJobCmd)(nil), flags)
+	MustRegisterCmd("listjobs", (*ListJobsCmd)(nil), flags)
+	MustRegisterCmd("getjobaccount", (*GetJobAccountCmd)(nil), flags)
+	MustRegisterCmd("getcategory", (*GetCategoryCmd)(nil), flags)
+}
diff --git a/node/chaincfg/uwc_devnet.go b/node/chaincfg/uwc_devnet.go
new file mode 100644
index 00000000..c0586c73
--- /dev/null
+++ b/node/chaincfg/uwc_devnet.go
@@ -0,0 +1,83 @@
+package chaincfg
+
+import (
+	"encoding/hex"
+	"math/big"
+	"time"
+
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+	"github.com/pearl-research-labs/pearl/node/wire"
+)
+
+// Useful-Work Coin development network (build step 7). Unlike UWC SimNet it verifies proof of
+// work for real: blocks carry zk certificates mined with cuPOW. It is private: no DNS seeds,
+// peers are added by hand.
+
+// uwcDevNetPowLimit is the easiest target: 2^212. At one block a minute that suits about 1 TMAC/s
+// of noise mining; retargeting raises difficulty from there.
+var uwcDevNetPowLimit = new(big.Int).Lsh(bigOne, 212)
+
+// uwcDevNetCouncil are the accounts (sha256 of P2TR scripts) of the devnet's 2-of-3 council.
+// Their keys are kept outside the repository.
+var uwcDevNetCouncil = []string{
+	"894d710011fce6d2275d73973964012b09176dd76c4faf1a2ac72bbf6c0c9b54",
+	"bf95254d25d6c79352f4836988d36a0aad22d7d35fe58d7697728c1412c70b4e",
+	"6c5501426cdc8b53974dd218b071eb7acfe7377e2a116d7768a356f6ff988b01",
+}
+
+func uwcDevNetJobParams() *jobstate.Params {
+	p := jobstate.DefaultParams()
+	for _, h := range uwcDevNetCouncil {
+		var a jobstate.AccountID
+		b, err := hex.DecodeString(h)
+		if err != nil || len(b) != 32 {
+			panic("chaincfg: bad UWC devnet council account " + h)
+		}
+		copy(a[:], b)
+		p.Council = append(p.Council, a)
+	}
+	p.CouncilThreshold = 2
+	return &p
+}
+
+var uwcDevNetGenesisBlock = func() wire.MsgBlock {
+	b := wire.MsgBlock{
+		MsgHeader: wire.MsgHeader{
+			BlockHeader: wire.BlockHeader{
+				Version:    1,
+				MerkleRoot: genesisMerkleRoot,
+				Timestamp:  time.Unix(1793923200, 0), // 2026-11-06 00:00:00 UTC
+				Bits:       0x1a020000,               // 2^201: about one block a minute at 550 TMAC/s
+			},
+		},
+		Transactions: []*wire.MsgTx{&genesisCoinbaseTx},
+	}
+	h := b.BlockHash()
+	b.MsgHeader.MsgCertificate = wire.MsgCertificate{Certificate: &wire.CertificateV1{
+		Hash: h, ProofData: []byte{0x75, 0x77, 0x63, 0x64}, // genesis is not verified
+	}}
+	return b
+}()
+
+var uwcDevNetGenesisHash = uwcDevNetGenesisBlock.BlockHash()
+
+// UWCDevNetParams are the parameters of the Useful-Work Coin development network.
+var UWCDevNetParams = func() Params {
+	p := SimNetParams
+	p.Name = "uwc-devnet"
+	p.Net = wire.UWCDevNet
+	p.DefaultPort = "18670"
+	p.GenesisBlock = &uwcDevNetGenesisBlock
+	p.GenesisHash = &uwcDevNetGenesisHash
+	p.PowLimit = uwcDevNetPowLimit
+	p.PowLimitBits = 0x1b100000 // 2^212
+	p.PoWNoRetargeting = false
+	p.TargetTimePerBlock = time.Minute
+	p.WTEMAHalfLife = time.Hour
+	p.ReduceMinDifficulty = false
+	p.MinDiffReductionTime = 0
+	p.GenerateSupported = false
+	p.CoinbaseMaturity = 10
+	p.JobModule = uwcDevNetJobParams()
+	return p
+}()
diff --git a/node/cmd/uwcctl/keys.go b/node/cmd/uwcctl/keys.go
new file mode 100644
index 00000000..93c2d1c3
--- /dev/null
+++ b/node/cmd/uwcctl/keys.go
@@ -0,0 +1,69 @@
+package main
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+
+	"github.com/pearl-research-labs/pearl/node/btcec"
+	"github.com/pearl-research-labs/pearl/node/btcutil"
+	"github.com/pearl-research-labs/pearl/node/chaincfg"
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+	"github.com/pearl-research-labs/pearl/node/txscript"
+)
+
+// key is a Taproot key-path key: its P2TR output script controls one job-module account.
+type key struct {
+	Priv    *btcec.PrivateKey
+	Script  []byte
+	Account jobstate.AccountID
+}
+
+type keyFile struct {
+	Priv string `json:"priv"`
+}
+
+func keyFromPriv(b []byte) *key {
+	priv, _ := btcec.PrivKeyFromBytes(b)
+	script, _ := txscript.PayToTaprootScript(txscript.ComputeTaprootKeyNoScript(priv.PubKey()))
+	return &key{Priv: priv, Script: script, Account: jobstate.AccountForScript(script)}
+}
+
+func newKey() *key {
+	var b [32]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		panic(err)
+	}
+	return keyFromPriv(b[:])
+}
+
+func loadKey(path string) (*key, error) {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var kf keyFile
+	if err := json.Unmarshal(raw, &kf); err != nil {
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+	b, err := hex.DecodeString(kf.Priv)
+	if err != nil || len(b) != 32 {
+		return nil, fmt.Errorf("%s: bad private key", path)
+	}
+	return keyFromPriv(b), nil
+}
+
+func (k *key) save(path string) error {
+	raw, _ := json.Marshal(keyFile{Priv: hex.EncodeToString(k.Priv.Serialize())})
+	return os.WriteFile(path, raw, 0o600)
+}
+
+func (k *key) address(p *chaincfg.Params) string {
+	a, err := btcutil.NewAddressTaproot(k.Script[2:], p)
+	if err != nil {
+		return "?"
+	}
+	return a.EncodeAddress()
+}
diff --git a/node/cmd/uwcctl/main.go b/node/cmd/uwcctl/main.go
new file mode 100644
index 00000000..47170247
--- /dev/null
+++ b/node/cmd/uwcctl/main.go
@@ -0,0 +1,62 @@
+// Command uwcctl manages Useful-Work Coin keys and job-module transactions: deposits, job
+// operations and job-state queries against a pearld node.
+package main
+
+import (
+	"encoding/hex"
+	"fmt"
+	"os"
+
+	"github.com/pearl-research-labs/pearl/node/chaincfg"
+)
+
+func usage() {
+	fmt.Fprintln(os.Stderr, `usage: uwcctl <command> [args]
+
+  keygen <file>          new key (Taproot key path); prints its account and address
+  info <keyfile>         account, P2TR script and address of a key`)
+	os.Exit(2)
+}
+
+var netParams = &chaincfg.UWCDevNetParams
+
+func main() {
+	if len(os.Args) < 2 {
+		usage()
+	}
+	args := os.Args[2:]
+	var err error
+	switch os.Args[1] {
+	case "keygen":
+		if len(args) != 1 {
+			usage()
+		}
+		if _, e := os.Stat(args[0]); e == nil {
+			err = fmt.Errorf("%s exists", args[0])
+			break
+		}
+		k := newKey()
+		if err = k.save(args[0]); err == nil {
+			printKey(k)
+		}
+	case "info":
+		if len(args) != 1 {
+			usage()
+		}
+		var k *key
+		if k, err = loadKey(args[0]); err == nil {
+			printKey(k)
+		}
+	default:
+		usage()
+	}
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "uwcctl:", err)
+		os.Exit(1)
+	}
+}
+
+func printKey(k *key) {
+	fmt.Printf("account %s\nscript  %s\naddress %s\n", hex.EncodeToString(k.Account[:]),
+		hex.EncodeToString(k.Script), k.address(netParams))
+}
