+// Package uwcclient builds, signs and submits Useful-Work Coin job-module transactions
+// (deposits and job operations) and reads job state from a pearld node. It is shared by
+// uwcctl and the provider, verifier and watcher daemons.
+package uwcclient
+
+import (
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"sort"
+	"sync"
+
+	"github.com/pearl-research-labs/pearl/node/blockchain"
+	"github.com/pearl-research-labs/pearl/node/btcec"
+	"github.com/pearl-research-labs/pearl/node/btcjson"
+	"github.com/pearl-research-labs/pearl/node/btcutil"
+	"github.com/pearl-research-labs/pearl/node/chaincfg"
+	"github.com/pearl-research-labs/pearl/node/chaincfg/chainhash"
+	"github.com/pearl-research-labs/pearl/node/jobstate"
+	"github.com/pearl-research-labs/pearl/node/rpcclient"
+	"github.com/pearl-research-labs/pearl/node/txscript"
+	"github.com/pearl-research-labs/pearl/node/wire"
+)
+
+// ---------------------------------------------------------------- keys
+
+// Key is a Taproot key-path key; its P2TR script controls one job-module account.
+type Key struct {
+	Priv    *btcec.PrivateKey
+	Script  []byte
+	Account jobstate.AccountID
+}
+
+type keyFile struct {
+	Priv string `json:"priv"`
+}
+
+func KeyFromPriv(b []byte) *Key {
+	priv, _ := btcec.PrivKeyFromBytes(b)
+	script, _ := txscript.PayToTaprootScript(txscript.ComputeTaprootKeyNoScript(priv.PubKey()))
+	return &Key{Priv: priv, Script: script, Account: jobstate.AccountForScript(script)}
+}
+
+func NewKey() *Key {
+	var b [32]byte
+	if _, err := rand.Read(b[:]); err != nil {
+		panic(err)
+	}
+	return KeyFromPriv(b[:])
+}
+
+func LoadKey(path string) (*Key, error) {
+	raw, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var kf keyFile
+	if err := json.Unmarshal(raw, &kf); err != nil {
+		return nil, fmt.Errorf("%s: %w", path, err)
+	}
+	b, err := hex.DecodeString(kf.Priv)
+	if err != nil || len(b) != 32 {
+		return nil, fmt.Errorf("%s: bad private key", path)
+	}
+	return KeyFromPriv(b), nil
+}
+
+func (k *Key) Save(path string) error {
+	raw, _ := json.Marshal(keyFile{Priv: hex.EncodeToString(k.Priv.Serialize())})
+	return os.WriteFile(path, raw, 0o600)
+}
+
+func (k *Key) Address(p *chaincfg.Params) (btcutil.Address, error) {
+	return btcutil.NewAddressTaproot(k.Script[2:], p)
+}
+
+// ---------------------------------------------------------------- client
+
+// Client talks to one pearld over JSON-RPC (HTTP POST).
+type Client struct {
+	RPC    *rpcclient.Client
+	Params *chaincfg.Params
+	// FeePerVByte is the fee rate in grains per virtual byte.
+	FeePerVByte int64
+
+	mu      sync.Mutex
+	pending map[wire.OutPoint]bool // spent by our own transactions not yet seen by the node
+}
+
+func Dial(host, user, pass string, p *chaincfg.Params) (*Client, error) {
+	c, err := rpcclient.New(&rpcclient.ConnConfig{Host: host, User: user, Pass: pass, HTTPPostMode: true,
+		DisableTLS: true}, nil)
+	if err != nil {
+		return nil, err
+	}
+	return &Client{RPC: c, Params: p, FeePerVByte: 5, pending: map[wire.OutPoint]bool{}}, nil
+}
+
+// Coin is a spendable output of a key.
+type Coin struct {
+	Out   wire.OutPoint
+	Value int64
+}
+
+// Coins returns the key's unspent outputs (mempool included), skipping immature coinbases.
+func (c *Client) Coins(k *Key) ([]Coin, error) {
+	addr, err := k.Address(c.Params)
+	if err != nil {
+		return nil, err
+	}
+	var txs []*rawTx
+	for skip := 0; ; skip += 100 {
+		page, err := c.searchRaw(addr, skip, 100)
+		if err != nil {
+			return nil, err
+		}
+		txs = append(txs, page...)
+		if len(page) < 100 {
+			break
+		}
+	}
+	scriptHex := hex.EncodeToString(k.Script)
+	var coins []Coin
+	seen := map[wire.OutPoint]bool{}
+	for _, t := range txs {
+		h, err := chainhash.NewHashFromStr(t.Txid)
+		if err != nil {
+			continue
+		}
+		for _, v := range t.Vout {
+			if v.ScriptPubKey.Hex != scriptHex {
+				continue
+			}
+			op := wire.OutPoint{Hash: *h, Index: v.N}
+			if seen[op] {
+				continue
+			}
+			seen[op] = true
+			c.mu.Lock()
+			spent := c.pending[op]
+			c.mu.Unlock()
+			if spent {
+				continue
+			}
+			res, err := c.RPC.GetTxOut(h, v.N, true)
+			if err != nil || res == nil {
+				continue // spent (or unknown)
+			}
+			if res.Coinbase && res.Confirmations < int64(c.Params.CoinbaseMaturity) {
+				continue
+			}
+			amt, err := btcutil.NewAmount(res.Value)
+			if err != nil {
+				continue
+			}
+			coins = append(coins, Coin{Out: op, Value: int64(amt)})
+		}
+	}
+	// gettxout does not see spends by mempool transactions; drop those coins
+	if len(coins) > 0 {
+		ops := make([]wire.OutPoint, len(coins))
+		for i, cn := range coins {
+			ops[i] = cn.Out
+		}
+		res, err := c.RPC.GetTxSpendingPrevOut(ops)
+		if err != nil {
+			return nil, err
+		}
+		spent := map[wire.OutPoint]bool{}
+		for i, r := range res {
+			if r.SpendingTxid != "" {
+				spent[ops[i]] = true
+			}
+		}
+		kept := coins[:0]
+		for _, cn := range coins {
+			if !spent[cn.Out] {
+				kept = append(kept, cn)
+			}
+		}
+		coins = kept
+	}
+	sort.Slice(coins, func(a, b int) bool { return coins[a].Value > coins[b].Value })
+	return coins, nil
+}
+
+type rawTx struct {
+	Txid string `json:"txid"`
+	Vout []struct {
+		N            uint32 `json:"n"`
+		ScriptPubKey struct {
+			Hex string `json:"hex"`
+		} `json:"scriptPubKey"`
+	} `json:"vout"`
+}
+
+func (c *Client) searchRaw(addr btcutil.Address, skip, count int) ([]*rawTx, error) {
+	params := []interface{}{addr.EncodeAddress(), 1, skip, count, 0, false}
+	var raw []json.RawMessage
+	for _, p := range params {
+		b, _ := json.Marshal(p)
+		raw = append(raw, b)
+	}
+	res, err := c.RPC.RawRequest("searchrawtransactions", raw)
+	if err != nil {
+		// no transactions for this address yet
+		if e, ok := err.(*btcjson.RPCError); ok && e.Code == btcjson.ErrRPCNoTxInfo {
+			return nil, nil
+		}
+		return nil, err
+	}
+	var out []*rawTx
+	if err := json.Unmarshal(res, &out); err != nil {
+		return nil, err
+	}
+	return out, nil
+}
+
+// Send spends the key's coins into outs plus change back to the key, signs and broadcasts.
+// Every input is the key's, so the transaction's job operations act for the key's account.
+func (c *Client) Send(k *Key, outs []*wire.TxOut) (*chainhash.Hash, error) {
+	coins, err := c.Coins(k)
+	if err != nil {
+		return nil, err
+	}
+	need := int64(0)
+	for _, o := range outs {
+		need += o.Value
+	}
+	tx := wire.NewMsgTx(2)
+	prev := map[wire.OutPoint]*wire.TxOut{}
+	have := int64(0)
+	for _, o := range outs {
+		tx.AddTxOut(o)
+	}
+	change := wire.NewTxOut(0, k.Script)
+	tx.AddTxOut(change)
+	for _, cn := range coins {
+		tx.AddTxIn(&wire.TxIn{PreviousOutPoint: cn.Out, Sequence: wire.MaxTxInSequenceNum})
+		prev[cn.Out] = &wire.TxOut{Value: cn.Value, PkScript: k.Script}
+		have += cn.Value
+		if have >= need+c.fee(tx) {
+			break
+		}
+	}
+	fee := c.fee(tx)
+	if have < need+fee {
+		return nil, fmt.Errorf("insufficient funds: have %d, need %d + fee %d", have, need, fee)
+	}
+	change.Value = have - need - fee
+	if change.Value < 1000 { // dust: give it to the fee
+		tx.TxOut = tx.TxOut[:len(tx.TxOut)-1]
+	}
+	fetcher := txscript.NewMultiPrevOutFetcher(prev)
+	sh := txscript.NewTxSigHashes(tx, fetcher)
+	for i, in := range tx.TxIn {
+		p := prev[in.PreviousOutPoint]
+		wit, err := txscript.TaprootWitnessSignature(tx, sh, i, p.Value, p.PkScript, txscript.SigHashDefault, k.Priv)
+		if err != nil {
+			return nil, err
+		}
+		in.SetWitness(wit)
+	}
+	h, err := c.RPC.SendRawTransaction(tx, false)
+	if err != nil {
+		return nil, err
+	}
+	c.mu.Lock()
+	for _, in := range tx.TxIn {
+		c.pending[in.PreviousOutPoint] = true
+	}
+	c.mu.Unlock()
+	return h, nil
+}
+
+// fee estimates the fee of tx once each input carries a 64-byte Schnorr signature.
+func (c *Client) fee(tx *wire.MsgTx) int64 {
+	base := int64(tx.SerializeSizeStripped())
+	wit := int64(len(tx.TxIn)) * (1 + 1 + 64) // stack count, push, signature
+	if wit > 0 {
+		wit += 2 // segwit marker and flag
+	}
+	vsize := base + (wit+3)/4
+	return max(vsize*c.FeePerVByte, 1000)
+}
+
+// OpRef is the reference the node gives the op in output index i of tx: sha256(txid || i).
+func OpRef(txid *chainhash.Hash, i uint32) jobstate.Hash {
+	var ref [36]byte
+	copy(ref[:32], txid[:])
+	ref[32], ref[33], ref[34], ref[35] = byte(i), byte(i>>8), byte(i>>16), byte(i>>24)
+	return jobstate.Hash(chainhash.HashH(ref[:]))
+}
+
+// SubmitOps sends one transaction carrying the ops (in order) and the deposits. It returns the
+// txid and each op's reference (job ids are tagHash("job", ref), model ids tagHash("model", ref)).
+func (c *Client) SubmitOps(k *Key, deposits []jobstate.Deposit, ops ...*jobstate.Op) (*chainhash.Hash, []jobstate.Hash, error) {
+	var outs []*wire.TxOut
+	for _, o := range ops {
+		s, err := blockchain.JobOpScript(o.Encode())
+		if err != nil {
+			return nil, nil, err
+		}
+		outs = append(outs, wire.NewTxOut(0, s))
+	}
+	for _, d := range deposits {
+		outs = append(outs, wire.NewTxOut(d.Amount, blockchain.JobDepositScript(d.Account)))
+	}
+	h, err := c.Send(k, outs)
+	if err != nil {
+		return nil, nil, err
+	}
+	refs := make([]jobstate.Hash, len(ops))
+	for i := range ops {
+		refs[i] = OpRef(h, uint32(i))
+	}
+	return h, refs, nil
+}
+
+// Query calls one of the job-state RPCs and decodes the result into out.
+func (c *Client) Query(method string, out interface{}, args ...interface{}) error {
+	var raw []json.RawMessage
+	for _, a := range args {
+		b, _ := json.Marshal(a)
+		raw = append(raw, b)
+	}
+	res, err := c.RPC.RawRequest(method, raw)
+	if err != nil {
+		return err
+	}
+	return json.Unmarshal(res, out)
+}
