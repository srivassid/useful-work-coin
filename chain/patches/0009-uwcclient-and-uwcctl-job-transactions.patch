+func client() *uwcclient.Client {
+	host := os.Getenv("UWC_RPC")
+	if host == "" {
+		host = "127.0.0.1:18671"
+	}
+	c, err := uwcclient.Dial(host, os.Getenv("UWC_RPC_USER"), os.Getenv("UWC_RPC_PASS"), netParams)
+	if err != nil {
+		die(err)
+	}
+	return c
+}
+
+func key(path string) *uwcclient.Key {
+	k, err := uwcclient.LoadKey(path)
