+func amount(s string) int64 {
+	v, err := strconv.ParseInt(s, 10, 64)
+	if err != nil || v < 0 {
+		die(fmt.Errorf("bad amount %q", s))
+	}
+	return v
+}
+
+func hash32(s string) jobstate.Hash {
+	var h jobstate.Hash
+	b, err := hex.DecodeString(s)
+	if err != nil || len(b) != 32 {
+		die(fmt.Errorf("expected 32 hex bytes: %q", s))
+	}
+	copy(h[:], b)
+	return h
+}
+
+func printJSON(v interface{}) {
+	b, _ := json.MarshalIndent(v, "", "  ")
+	fmt.Println(string(b))
+}
+
+func hx(b []byte) string { return hex.EncodeToString(b) }
+
+// submit sends ops (and deposits) from key and prints the txid and each op's reference.
+func submit(k *uwcclient.Key, deps []jobstate.Deposit, ops ...*jobstate.Op) {
+	h, refs, err := client().SubmitOps(k, deps, ops...)
+	if err != nil {
+		die(err)
+	}
+	out := map[string]interface{}{"txid": h.String()}
+	var rs []string
+	for i, r := range refs {
+		rs = append(rs, hx(r[:]))
+		switch ops[i].Kind {
+		case jobstate.OpJobPost, jobstate.OpPoolClaim:
+			id := jobstate.TagHash("job", r[:])
+			out["job"] = hx(id[:])
+		case jobstate.OpModelReg:
+			id := jobstate.TagHash("model", r[:])
+			out["model"] = hx(id[:])
+		case jobstate.OpPropose:
+			id := jobstate.TagHash("proposal", r[:])
+			out["proposal"] = hx(id[:])
+		}
+	}
+	if rs != nil {
+		out["refs"] = rs
+	}
+	printJSON(out)
+}
+
+// propose wraps a council action in PROPOSE.
+func propose(k *uwcclient.Key, action *jobstate.Op) {
+	submit(k, nil, &jobstate.Op{Kind: jobstate.OpPropose, Data: action.Encode()})
+}
